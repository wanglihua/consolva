<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context=".ui.pickup.booking.PickupBookingDetailActivity">

    <TextView
        android:id="@+id/tvOrderCode"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:singleLine="false"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="8.0dip"
        android:text="TextView"
        android:textColor="@color/colorAccent"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvCustomerCode"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvStatusName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvWarehouseName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvPickupStationName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvPickupBookingTime"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvStockPlaceList"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textSize="16.0sp" />

    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.0dip"
        android:background="@color/colorPrimary"
        android:text="确认预约"
        android:textColor="@android:color/white"
        android:textSize="20.0sp" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.photo.PhotoHomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPhotoSignIn"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:background="#ffef5973"
            android:drawableStart="@drawable/order_photo"
            android:gravity="center_vertical|center_horizontal"
            android:padding="5dp"
            android:text="签收照片"
            android:textColor="#ffffffff"
            android:textSize="28.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPhotoCheckIn"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:background="#fff78221"
            android:drawableStart="@drawable/order_photo"
            android:gravity="center_vertical|center_horizontal"
            android:padding="5dp"
            android:text="入库照片"
            android:textColor="#ffffffff"
            android:textSize="28.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPhotoIssue"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:background="#fffe5000"
            android:drawableStart="@drawable/order_photo"
            android:gravity="center_vertical|center_horizontal"
            android:padding="5dp"
            android:text="问题件照片"
            android:textColor="#ffffffff"
            android:textSize="28.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPhotoCnDamage"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:background="#ff00bece"
            android:drawableStart="@drawable/order_photo"
            android:gravity="center_vertical|center_horizontal"
            android:padding="5dp"
            android:text="中国损毁照片"
            android:textColor="#ffffffff"
            android:textSize="28.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPhotoReturn"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:background="#ffa650b5"
            android:drawableStart="@drawable/order_photo"
            android:gravity="center_vertical|center_horizontal"
            android:padding="5dp"
            android:text="退运照片"
            android:textColor="#ffffffff"
            android:textSize="28.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPhotoShip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:background="#fff8c708"
            android:drawableStart="@drawable/order_photo"
            android:gravity="center_vertical|center_horizontal"
            android:padding="5dp"
            android:text="发货照片"
            android:textColor="#ffffffff"
            android:textSize="28.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPhotoAuDamage"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:background="#fff8c708"
            android:drawableStart="@drawable/order_photo"
            android:gravity="center_vertical|center_horizontal"
            android:padding="5dp"
            android:text="澳洲损毁照片"
            android:textColor="#ffffffff"
            android:textSize="28.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPhotoDeliver"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:background="#ffef5973"
            android:drawableStart="@drawable/order_photo"
            android:gravity="center_vertical|center_horizontal"
            android:padding="5dp"
            android:text="交付照片"
            android:textColor="#ffffffff"
            android:textSize="28.0sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
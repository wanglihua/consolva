<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fadingEdge="vertical"
    android:scrollbars="vertical"
    tools:context=".ui.query.PackBoxStockPlaceActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <TextView
            android:id="@+id/tvPackBoxCodeScanTip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="false"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="8.0dip"
            android:text="扫描箱号，查询箱号仓位信息"
            android:textColor="@color/colorAccent"
            android:textSize="16.0sp" />

        <Button
            android:id="@+id/btnPackBoxScan"
            android:layout_width="fill_parent"
            android:layout_height="35dip"
            android:layout_marginTop="20.0dip"
            android:background="@color/colorPrimary"
            android:text="扫描箱号"
            android:textColor="@android:color/white"
            android:textSize="20.0sp" />

        <TextView
            android:id="@+id/tvOrderPackBoxCode"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="false"
            android:layout_marginTop="12.0dp"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="8.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvOrderPackBoxShortCode"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="false"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="8.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvCustomerCode"
            android:layout_width="fill_parent"
            android:layout_height="35dip"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvOrderCode"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="8.0dip"
            android:singleLine="false"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvArrearsAmount"
            android:layout_width="fill_parent"
            android:layout_height="35dip"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvTotalPackBoxCount"
            android:layout_width="fill_parent"
            android:layout_height="35dip"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvShipContainerCustomerCode"
            android:layout_width="fill_parent"
            android:layout_height="35dip"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="fill_parent"
            android:layout_height="35dip"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvDeliverPackBoxCount"
            android:layout_width="fill_parent"
            android:layout_height="35dip"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvNotUnloadPackBoxCount"
            android:layout_width="fill_parent"
            android:layout_height="35dip"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvNotUnloadPackBoxNums"
            android:layout_width="fill_parent"
            android:layout_height="35dip"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text=""
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvStockPlaceList"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text=""
            android:textSize="16.0sp" />

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context=".ui.unload.StockPlaceDetailActivity">

    <TextView
        android:id="@+id/tvStockPlaceName"
        android:layout_width="fill_parent"
        android:layout_height="40dip"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textColor="@color/colorAccent"
        android:textSize="20.0sp" />

    <Button
        android:id="@+id/btnScan"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.0dip"
        android:background="@color/colorPrimary"
        android:text="扫描卸货"
        android:textColor="@android:color/white"
        android:textSize="20.0sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dip"
        android:layout_marginTop="20dip"
        android:background="@android:color/white"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="连续扫码："
            android:textSize="20.0sp" />

        <Switch
            android:id="@+id/swAutoContinueScan"
            android:layout_width="wrap_content"
            android:layout_height="20dip"
            android:textOn="开启"
            android:textOff="关闭"
            android:showText="true"
            android:switchPadding="15dip"
            android:switchMinWidth="50dip"
            android:checked="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPackBoxCount"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="4dp"
        android:text="共件" />

    <ListView
        android:id="@+id/lvPackBoxList"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="4dp" />
</LinearLayout>
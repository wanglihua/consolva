<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvTrackingNo"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textColor="@color/colorAccent"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvAoPinTrackingNo"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textColor="#666666"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCustomerCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingEnd="4.0dip"
            android:paddingBottom="1.0dip"
            android:text="TextView"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPackageCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="TextView"
            android:textColor="#666666"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAddUserNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingEnd="0dip"
            android:paddingBottom="1.0dip"
            android:text="入库："
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAddUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dip"
            android:paddingTop="1.0dip"
            android:paddingEnd="4.0dip"
            android:paddingBottom="1.0dip"
            android:text="TextView"
            android:textColor="@color/colorRed"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAddTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="TextView"
            android:textColor="#666666"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvStorageLocName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="6.0dip"
        android:text="TextView"
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvShelfStatus"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="6.0dip"
        android:text="TextView"
        android:textColor="#666666"
        android:textSize="14sp" />

</LinearLayout>

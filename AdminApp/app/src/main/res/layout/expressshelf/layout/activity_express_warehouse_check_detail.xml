<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context=".ui.expressshelf.ExpressWarehouseCheckDetailActivity">

    <TextView
        android:id="@+id/tvTrackingNo"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="6.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textColor="@color/colorAccent"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvAoPinTrackingNo"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvStorageLocFullName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textColor="@color/colorRed"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvClaimShelfStatus"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textColor="#666666"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvChatCustomerCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingEnd="4.0dip"
            android:paddingBottom="1.0dip"
            android:text="TextView"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvChatUserLoginName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="TextView"
            android:textColor="#666666"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingEnd="4.0dip"
            android:paddingBottom="1.0dip"
            android:text="TextView"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCreateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="TextView"
            android:textColor="#666666"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvChatMessage"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="TextView"
        android:textColor="@color/colorRed"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvReplyMessage"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:text="消息回复："
        android:textColor="#666666"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etReplyMessage"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:enabled="true"
        android:gravity="top"
        android:hint="在这里输入消息回复"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:minLines="3"
        android:paddingLeft="8.0dip"
        android:paddingTop="1.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="1.0dip"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/btnSetChecked"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20.0dip"
        android:layout_marginBottom="20.0dip"
        android:background="@color/colorPrimary"
        android:text="设置已完成"
        android:textColor="@android:color/white"
        android:textSize="20.0sp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivBigImage"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/tvImageNum"
            android:layout_alignParentTop="true"
            android:contentDescription=""
            android:scaleType="center" />

        <TextView
            android:id="@+id/tvImageNum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#ff000000"
            android:paddingLeft="8.0dip"
            android:paddingTop="3.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="3.0dip"
            android:text=""
            android:textAlignment="center"
            android:textColor="#ffffffff"
            android:textFontWeight="500"
            android:textSize="12sp" />

    </RelativeLayout>

</LinearLayout>
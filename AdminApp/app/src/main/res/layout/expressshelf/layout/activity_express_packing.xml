<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fadingEdge="vertical"
    android:scrollbars="vertical"
    tools:context=".ui.expressshelf.ExpressPackingActivity">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <TextView
            android:id="@+id/tvAoPinTrackingNo"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="澳拼入库号：请扫描澳拼入库号或快递单号！"
            android:textColor="@color/colorAccent"
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvTrackingNo"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="快递单号："
            android:textColor="@color/colorAccent"
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvShelfStatus"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="下架状态："
            android:textColor="@color/colorLogoYellow"
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvPackageCount"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="包裹数量："
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="快递状态："
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvOrderPackingStorageLocName"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="订单仓位："
            android:textSize="16.0sp" />

        <Button
            android:id="@+id/btnScanExpress"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:layout_marginBottom="10.0dip"
            android:background="@color/colorPrimary"
            android:text="扫描快递单号"
            android:textColor="@android:color/white"
            android:textSize="20.0sp" />

        <TextView
            android:id="@+id/tvStorageLocName"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="仓位名称：请扫描仓位号标签！"
            android:textColor="@color/colorAccent"
            android:textSize="16.0sp" />

        <TextView
            android:id="@+id/tvStorageLocExpressCount"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="快递数量："
            android:textSize="16.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStorageLocPackageCount"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="包裹数量："
            android:textSize="16.0sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnScanStorageLoc"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:layout_marginBottom="10.0dip"
            android:background="@color/colorPrimary"
            android:text="扫描仓位号"
            android:textColor="@android:color/white"
            android:textSize="20.0sp"/>

        <TextView
            android:id="@+id/tvMatchSuccess"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="快递单号与仓位匹配成功！"
            android:textColor="@color/colorGreen"
            android:textSize="16.0sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMatchFail"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8.0dip"
            android:paddingTop="1.0dip"
            android:paddingRight="8.0dip"
            android:paddingBottom="1.0dip"
            android:text="快递单号与仓位匹配失败！"
            android:textColor="@color/colorRed"
            android:textSize="16.0sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnComplete"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:layout_marginBottom="10.0dip"
            android:background="@color/colorLogoYellow"
            android:text="确认入流动仓"
            android:textColor="@android:color/white"
            android:textSize="20.0sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dip"
            android:layout_marginTop="20dip"
            android:background="@android:color/white"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="连续扫码："
                android:textSize="20.0sp" />

            <Switch
                android:id="@+id/swAutoContinueScan"
                android:layout_width="wrap_content"
                android:layout_height="20dip"
                android:textOn="开启"
                android:textOff="关闭"
                android:showText="true"
                android:switchPadding="15dip"
                android:switchMinWidth="50dip"
                android:checked="false" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
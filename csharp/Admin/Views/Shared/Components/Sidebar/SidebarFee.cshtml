@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Pass.PassRes
@model shunda.Admin.Models.Sidebar.SidebarModel
@{
    Layout = null;
}
@if (Model.HasOneOfPassRes(PassRes.Fee.All))
{
    <li id="fee-menu">
        <a href="#" class="dropdown-toggle">
            <i class="menu-icon fa fa-dollar"></i>
            <span class="menu-text">费用管理</span>
            <b class="arrow fa fa-angle-down"></b>
        </a>
        <b class="arrow"></b>
        <ul class="submenu">

            @if (Model.HasPassRes(PassRes.Fee.ManualIncreaseFee))
            {
                <li id="fee-manual-increase-fee-index-menu">
                    <a asp-area="Fee" asp-controller="ManualIncreaseFee" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        增加费用
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasOneOfPassRes(PassRes.Fee.ManualDecreaseFeeApply, PassRes.Fee.ManualDecreaseFeeApprove, PassRes.Fee.ManualDecreaseFee))
            {
                <li id="fee-manual-decrease-fee-menu">
                    <a href="#" class="dropdown-toggle">
                        <span class="menu-text">减少费用</span>
                        <b class="arrow fa fa-angle-down"></b>
                    </a>
                    <b class="arrow"></b>
                    <ul class="submenu">

                        @if (Model.HasPassRes(PassRes.Fee.ManualDecreaseFeeApply))
                        {
                            <li id="fee-manual-fee-apply-index-menu">
                                <a asp-area="Fee" asp-controller="ManualFeeApply" asp-action="Index">
                                    <i class="menu-icon fa fa-caret-right"></i>
                                    减少费用申请
                                </a>
                                <b class="arrow"></b>
                            </li>
                        }

                        @if (Model.HasPassRes(PassRes.Fee.ManualDecreaseFeeApprove))
                        {
                            <li id="fee-manual-fee-approve-index-menu">
                                <a asp-area="Fee" asp-controller="ManualFeeApprove" asp-action="Index">
                                    <i class="menu-icon fa fa-caret-right"></i>
                                    减少费用审核
                                </a>
                                <b class="arrow"></b>
                            </li>
                        }

                        @if (Model.HasPassRes(PassRes.Fee.ManualDecreaseFee))
                        {
                            <li id="fee-manual-decrease-fee-index-menu">
                                <a asp-area="Fee" asp-controller="ManualDecreaseFee" asp-action="Index">
                                    <i class="menu-icon fa fa-caret-right"></i>
                                    减少费用
                                </a>
                                <b class="arrow"></b>
                            </li>
                        }

                    </ul>
                </li>
            }

            @if (Model.HasOneOfPassRes(PassRes.Fee.WriteOffFeeApply, PassRes.Fee.WriteOffFeeApprove, PassRes.Fee.WriteOffFee))
            {
                <li id="fee-write-off-fee-menu">
                    <a href="#" class="dropdown-toggle">
                        <span class="menu-text">费用核销</span>
                        <b class="arrow fa fa-angle-down"></b>
                    </a>
                    <b class="arrow"></b>
                    <ul class="submenu">

                        @if (Model.HasPassRes(PassRes.Fee.WriteOffFeeApply))
                        {
                            <li id="fee-write-off-apply-index-menu">
                                <a asp-area="Fee" asp-controller="FeeWriteOffApply" asp-action="Index">
                                    <i class="menu-icon fa fa-caret-right"></i>
                                    费用核销申请
                                </a>
                                <b class="arrow"></b>
                            </li>
                        }

                        @if (Model.HasPassRes(PassRes.Fee.WriteOffFeeApprove))
                        {
                            <li id="fee-write-off-approve-index-menu">
                                <a asp-area="Fee" asp-controller="FeeWriteOffApprove" asp-action="Index">
                                    <i class="menu-icon fa fa-caret-right"></i>
                                    费用核销审核
                                </a>
                                <b class="arrow"></b>
                            </li>
                        }

                        @if (Model.HasPassRes(PassRes.Fee.WriteOffFee))
                        {
                            <li id="fee-write-off-fee-index-menu">
                                <a asp-area="Fee" asp-controller="WriteOffFee" asp-action="Index">
                                    <i class="menu-icon fa fa-caret-right"></i>
                                    费用核销
                                </a>
                                <b class="arrow"></b>
                            </li>
                        }
                    </ul>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Fee.ManualFeeReason))
            {
                <li id="fee-manual-fee-reason-index-menu">
                    <a asp-area="Fee" asp-controller="ManualFeeReason" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        增减核销费用原因
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasOneOfPassRes(PassRes.Fee.FeeRefundApply, PassRes.Fee.FeeRefundApprove, PassRes.Fee.FeeRefund))
            {
                <li id="fee-refund-menu">
                    <a href="#" class="dropdown-toggle">
                        <span class="menu-text">退赔款</span>
                        <b class="arrow fa fa-angle-down"></b>
                    </a>
                    <b class="arrow"></b>
                    <ul class="submenu">

                        @if (Model.HasPassRes(PassRes.Fee.FeeRefundApply))
                        {
                            <li id="fee-refund-apply-index-menu">
                                <a asp-area="Fee" asp-controller="FeeRefundApply" asp-action="Index">
                                    <i class="menu-icon fa fa-caret-right"></i>
                                    退赔款申请
                                </a>
                                <b class="arrow"></b>
                            </li>
                        }

                        @if (Model.HasPassRes(PassRes.Fee.FeeRefundApprove))
                        {
                            <li id="fee-refund-approve-index-menu">
                                <a asp-area="Fee" asp-controller="FeeRefundApprove" asp-action="Index">
                                    <i class="menu-icon fa fa-caret-right"></i>
                                    退赔款审核
                                </a>
                                <b class="arrow"></b>
                            </li>
                        }

                        @if (Model.HasPassRes(PassRes.Fee.FeeRefund))
                        {
                            <li id="fee-refund-index-menu">
                                <a asp-area="Fee" asp-controller="FeeRefund" asp-action="Index">
                                    <i class="menu-icon fa fa-caret-right"></i>
                                    退赔款
                                </a>
                                <b class="arrow"></b>
                            </li>
                        }

                    </ul>
                </li>
            }
            
            @if (Model.HasPassRes(PassRes.Fee.FeeRefundReason))
            {
                <li id="fee-manual-fee-reason-index-menu">
                    <a asp-area="Fee" asp-controller="FeeRefundReason" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        退赔原因
                    </a>
                    <b class="arrow"></b>
                </li>
            }            

            @if (Model.HasPassRes(PassRes.Fee.LogisticsOrderPay))
            {
                <li id="fee-logistics-order-pay-index-menu">
                    <a asp-area="Fee" asp-controller="LogisticsOrderPay" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        实时收入
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Fee.CustomerCharge))
            {
                <li id="fee-customer-charge-index-menu">
                    <a asp-area="Fee" asp-controller="CustomerCharge" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        余额充值
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Fee.ManualChargeReason))
            {
                <li id="fee-manual-charge-reason-index-menu">
                    <a asp-area="Fee" asp-controller="ManualChargeReason" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        手动充值原因
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Fee.ExpressReturnPay))
            {
                <li id="fee-express-return-pay-index-menu">
                    <a asp-area="Fee" asp-controller="ExpressReturnPay" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        退运支付
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Fee.Coupon))
            {
                <li id="fee-coupon-batch-index-menu">
                    <a asp-area="Fee" asp-controller="CouponBatch" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        优惠券批次
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Fee.Coupon))
            {
                <li id="fee-coupon-index-menu">
                    <a asp-area="Fee" asp-controller="Coupon" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        优惠券总览
                    </a>
                    <b class="arrow"></b>
                </li>
            }

        </ul>
    </li>
}
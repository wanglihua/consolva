@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Pass.PassRes
@model shunda.Admin.Models.Sidebar.SidebarModel
@{
    Layout = null;
}
@if (Model.HasOneOfPassRes(PassRes.Express.All))
{
    <li id="express-menu">
        <a href="#" class="dropdown-toggle">
            <i class="menu-icon fa fa-file-o"></i>
            <span class="menu-text">快递管理</span>
            <b class="arrow fa fa-angle-down"></b>
        </a>
        <b class="arrow"></b>
        <ul class="submenu">

            @if (Model.HasPassRes(PassRes.Express.ExpressExpect))
            {
                <li id="express-express-expect-menu">
                    <a asp-area="Express" asp-controller="ExpressExpect" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>预报单号
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Express.ExpressPhoto))
            {
                <li id="express-photo-index-menu">
                    <a asp-area="Express" asp-controller="ExpressPhoto" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>快递单图片
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Express.ExpressPhoto))
            {
                <li id="express-video-index-menu">
                    <a asp-area="Express" asp-controller="ExpressVideo" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        快递单视频
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Express.ExpressSizeWeight))
            {
                <li id="express-size-weight-index-menu">
                    <a asp-area="Express" asp-controller="ExpressSizeWeight" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        快递单尺寸重量
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Express.ExpressRemarkPresetSelect))
            {
                <li id="express-express-remark-preset-select-menu">
                    <a asp-area="Express" asp-controller="ExpressRemarkPresetSelect" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>快递单备注预设
                    </a>
                    <b class="arrow"></b>
                </li>
            }

        </ul>
    </li>
}
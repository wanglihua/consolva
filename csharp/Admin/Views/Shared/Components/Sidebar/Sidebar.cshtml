    <script type="text/javascript">
        function toggleSidebar() {
            @*这是点击之前的状态*@
            var isMenuMin = $("#sidebar").hasClass("menu-min");

            $.ajax({
                    url: '@Url.Action("SetSidebarState", "Home")',
                    type: "POST",
                    data: {
                        isMin: !isMenuMin 

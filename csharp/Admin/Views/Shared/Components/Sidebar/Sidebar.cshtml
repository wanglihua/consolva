@using Microsoft.AspNetCore.Mvc.TagHelpers
@model shunda.Admin.Models.Sidebar.SidebarModel
@{
    Layout = null;
}

@{
    string sidebarMinClassStr = "";
    if (Model.IsSidebarMin)
    {
        sidebarMinClassStr = " menu-min ";
    }
}
<div id="sidebar" class="sidebar responsive @(sidebarMinClassStr)">
    <ul class="nav nav-list">

        <li id="storage-menu">
            <a href="#" class="dropdown-toggle">
                <i class="menu-icon fa fa-cubes"></i>
                <span class="menu-text">仓储管理</span>
                <b class="arrow fa fa-angle-down"></b>
            </a>
            <b class="arrow"></b>
            <ul class="submenu">

                <li id="storage-warehouse-index-menu">
                    <a asp-area="Storage" asp-controller="Warehouse" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        仓库
                    </a>
                    <b class="arrow"></b>
                </li>


                <li id="storage-storage-loc-spec-index-menu">
                    <a asp-area="Storage" asp-controller="StorageLocSpec" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        仓位规格
                    </a>
                    <b class="arrow"></b>
                </li>
            </ul>
        </li>

        @if (Model.IsAdmin)
        {
            <li id="auth-menu">
                <a href="#" class="dropdown-toggle">
                    <i class="menu-icon fa fa-user"></i>
                    <span class="menu-text">权限管理</span>
                    <b class="arrow fa fa-angle-down"></b>
                </a>
                <b class="arrow"></b>
                <ul class="submenu">

                    <li id="auth-user-index-menu">
                        <a asp-area="Pass" asp-controller="User" asp-action="Index">
                            <i class="menu-icon fa fa-caret-right"></i>用户列表
                        </a>
                        <b class="arrow"></b>
                    </li>

                    <li id="auth-user-login-log-index-menu">
                        <a asp-area="Pass" asp-controller="UserLoginLog" asp-action="Index">
                            <i class="menu-icon fa fa-caret-right"></i>
                            用户登录日志
                        </a>
                        <b class="arrow"></b>
                    </li>

                    <li id="auth-group-index-menu">
                        <a asp-area="Pass" asp-controller="Group" asp-action="Index">
                            <i class="menu-icon fa fa-caret-right"></i>群组列表
                        </a>
                        <b class="arrow"></b>
                    </li>

                    <li id="auth-pass-res-index-menu">
                        <a asp-area="Pass" asp-controller="PassRes" asp-action="Index">
                            <i class="menu-icon fa fa-caret-right"></i>权限资源
                        </a>
                        <b class="arrow"></b>
                    </li>

                    <li id="auth-admin-index-menu">
                        <a asp-area="Pass" asp-controller="Admin" asp-action="Index">
                            <i class="menu-icon fa fa-caret-right"></i>管理员
                        </a>
                        <b class="arrow"></b>
                    </li>

                </ul>
            </li>
        }

    </ul>

    <div id="sidebar-collapse" class="sidebar-toggle sidebar-collapse" onclick="toggleSidebar()">
        @if (Model.IsSidebarMin)
        {
            <i class="ace-icon fa fa-angle-double-right" data-icon1="ace-icon fa fa-angle-double-left" data-icon2="ace-icon fa fa-angle-double-right"></i>
        }
        else
        {
            <i class="ace-icon fa fa-angle-double-left" data-icon1="ace-icon fa fa-angle-double-left" data-icon2="ace-icon fa fa-angle-double-right"></i>
        }
    </div>

    @*
        <script type="text/javascript">
            try {
                ace.settings.check('sidebar', 'collapsed');
            } catch (e) {
            }
        </script>
    *@

    <script type="text/javascript">
        function toggleSidebar() {
            @*这是点击之前的状态*@
            var isMenuMin = $("#sidebar").hasClass("menu-min");

            $.ajax({
                    url: '@Url.Action("SetSidebarState", "Home")',
                    type: "POST",
                    data: {
                        isMin: !isMenuMin 
                    },
                    success: function(data) {
                    }
                }
            );
        }
    </script>

</div>
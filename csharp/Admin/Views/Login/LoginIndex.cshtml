@{
    Layout = "_AdminSite";
    ViewData[ViewDataKey.Title] = "舜达后台管理登录";
}
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Core.Web
@model shunda.Admin.Models.Login.LoginModel
<div id="navbar" class="navbar navbar-default">
    <div class="navbar-container" id="navbar-container">
        <div class="navbar-header pull-left" style="height: 80px; line-height: 80px;">
            <a href='@Url.Action("AdminIndex", "Home")' class="navbar-brand clearfix" id="admin-top-logo" style="margin-top: 15px;">
                舜达
            </a>
        </div>
    </div>
</div>
<div class="widget-box" style="width: 600px; margin: 50px auto 0 auto;">
    <div class="widget-header widget-header-flat" style="height: 50px;">
        <h3 class="widget-title lighter" style="line-height: 50px;">舜达后台管理登录</h3>
    </div>
    <div class="widget-body">
        <div class="widget-main">
            <form class="form-horizontal" id="loginForm" method="post" style="margin: 20px 0 30px 0;" onsubmit="submitLogin();return false;">

                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label asp-for="LoginName" class="col-xs-3 control-label" style="margin-top: 5px; line-height: 30px;">登录名</label>
                    <div class="col-xs-8">
                        <span class="block input-icon">
                            <i class="ace-icon fa fa-user" style="line-height: 40px;"></i>
                            <input asp-for="LoginName" type="text" class="form-control" placeholder="请输入您的登录名" onkeydown="inputOnKeyDown(event)" style="height: 40px;"/>
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="col-xs-3 control-label" style="margin-top: 5px; line-height: 30px;">密码</label>
                    <div class="col-xs-8">
                        <span class="block input-icon">
                            <i class="ace-icon fa fa-key" style="line-height: 40px;"></i>
                            <input asp-for="Password" type="password" class="form-control" placeholder="请输入您的密码" onkeydown="inputOnKeyDown(event)" style="height: 40px;"/>
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="captcha" class="col-xs-3 control-label" style="margin-top: 5px; line-height: 30px;">验证码</label>
                    <div class="col-xs-4">
                        <span class="block input-icon">
                            <i class="ace-icon fa fa-asterisk" style="line-height: 40px;"></i>
                            <input id="captcha" asp-for="Captcha" type="text" class="form-control" placeholder="请输入您的验证码" onkeydown="inputOnKeyDown(event)" style="height: 40px;" autocomplete="off"/>
                        </span>
                    </div>
                    <div class="col-xs-4" onclick="refreshCaptcha();" style="cursor: pointer;">
                        <img id="imgCaptcha" alt="验证码" src=""/>
                        <span style="padding-left: 15px; line-height: 40px; color: lightgray;">点击刷新</span>
                    </div>
                </div>

            </form>
            <hr>
            <div class="wizard-actions">
                <button type="button" class="btn btn-primary" onclick="submitLogin()">
                    <i class="ace-icon fa fa-user"></i>
                    登录
                </button>
                <button type="button" class="btn btn-default" onclick="resetForm()">
                    <i class="ace-icon fa fa-undo"></i>
                    重置
                </button>

                <script type="text/javascript">

                    $(function() {
                        refreshCaptcha();
                    });

                    function refreshCaptcha() {
                        var timestamp = new Date().getTime();
                        $("#imgCaptcha").attr("src", "@Url.Action("Index", "Captcha", new { area = "" })?" + timestamp);
                        $("#captcha").val("");
                    }

                    function inputOnKeyDown(e) {
                        var ev = window.event || e;
                        if (ev.keyCode === 13) {
                            submitLogin();
                        }
                    }

                    function submitLogin() {

                        $.ajax({
                                url: '@Url.Action("Login", "Login")',
                                type: "POST",
                                data: $("#loginForm").serialize(),
                                success: function(data) {
                                    if (data.success === true) {
                                        window.location.href = '@Url.Action("AdminIndex", "Home")';
                                        //return;
                                    } else {
                                        refreshCaptcha();
                                        $.msg.error(data.message);
                                        //return;
                                    }
                                }
                            }
                        );
                    }

                    function resetForm() {
                        $('#loginForm')[0].reset();
                    }
                </script>
            </div>
        </div>
    </div>
</div>
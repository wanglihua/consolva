@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Models.PassRes
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Pass
@model shunda.Admin.Models.PassRes.PassResIndexModel
@{
    ViewData[ViewDataKey.Title] = "权限资源";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="auth-menu">权限管理</li>
    <li class="active" data-menu="auth-pass-res-index-menu">权限资源</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadPassResList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-pink btn-sm" onclick="initData()">
        <i class="ace-icon fa fa-plus"></i>
        初始化数据
    </button>
    <button type="button" class="btn btn-purple btn-sm" onclick="refreshCache()">
        <i class="ace-icon fa fa-gears"></i>
        刷新资源授权缓存
    </button>    
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="cateIdQuery">类别</label>&nbsp;
    <select id="cateIdQuery" style="width: 150px; height: 30px;" onchange="loadPassResList()">
        <option value="0">资源类别查询</option>
        @foreach (PassResCateInfo cate in Model.CateList)
        {
            <option value="@(cate.Id)">@(cate.Name)</option>
        }
    </select>
    <label for="nameQuery">名称</label>&nbsp;<input id="nameQuery" name="nameQuery" style="width: 150px; height: 30px;" placeholder="名称查询" />&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadPassResList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="passResList" data-page-index="0" data-sort-field="@(Model.PassResCateAlias).@(nameof(PassResInfo.Cate.Id))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="passResDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadPassResList();
    });

    function sortPassResList(sortField, sortDir) {
        var list = $('#passResList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadPassResList();
    }

    function loadPassResList(pageIndex) {
        var list = $('#passResList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "PassRes")",
            type: "POST",
            data: {
                '@(nameof(PassResListQueryParam.CateIdQuery))': $('#cateIdQuery').val(),
                '@(nameof(PassResListQueryParam.NameQuery))': $('#nameQuery').val(),
                '@(nameof(PassResListQueryParam.PageIndex))': pageIndex,
                '@(nameof(PassResListQueryParam.SortField))': sortField,
                '@(nameof(PassResListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#passResList').html(data);

                initListTable("#tblPassResList");
            }
        });
    }

    function initData() {
        $.msg.confirm("确认要初始化数据吗？",
            function() {
                $.ajax({
                    url: '@Url.Action("InitData", "PassRes")',
                    type: "POST",
                    success: function(data) {
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } else {
                            $.msg.show(data.message);
                        }

                        loadPassResList();
                    }
                });
            }
        );
    }
    
    function refreshCache() {
        $.ajax({
            url: '@Url.Action("RefreshCache", "PassRes")',
            type: "POST",
            success: function(data) {
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $.msg.show(data.message);
            }
        });
    }    

</script>
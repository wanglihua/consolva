@{
    Layout = null;
}
@using shunda.Domain.Pass
@model shunda.Admin.Models.UserLoginLog.UserLoginLogListModel

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadUserLoginLogList"})

<table id="tblUserLoginLogList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 150px;">
                <a field="@(nameof(UserLoginLogInfo.User)).@(nameof(UserLoginLogInfo.User.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortUserLoginLogList">登录用户</a>
            </th>
            <th style="width: 200px;">
                <span>登录IP</span>
            </th>
            <th style="width: 350px;">
                <span>用户代理</span>
            </th>
            <th style="width: 120px;">
                <a field="@(nameof(UserLoginLogInfo.LoginTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortUserLoginLogList">登录时间</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.UserLoginLogList != null && Model.UserLoginLogList.Count() != 0)
        {
            int order = 1;
            foreach (UserLoginLogInfo userLoginLog in Model.UserLoginLogList)
            {
                <tr>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td class="break-word">
                        @(userLoginLog.User.LoginName)(@(userLoginLog.User.UserName))
                    </td>
                    <td class="break-word">
                        @userLoginLog.IpAddress
                    </td>
                    <td class="break-word">
                        @userLoginLog.UserAgent
                    </td>
                    <td>
                        @(userLoginLog.LoginTime.ToString("yyyy-MM-dd HH:mm"))
                    </td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadUserLoginLogList"})
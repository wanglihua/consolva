
@using shunda.Admin.Areas.Storage.Models.StorageLocSpec
@using shunda.Core
@using shunda.Domain.Storage
@model shunda.Admin.Areas.Storage.Models.StorageLocSpec.StorageLocSpecIndexModel
@{
    ViewBag.Title = "库位规格列表";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="storage-menu">仓储管理</li>
    <li class="active" data-menu="storage-storage-loc-spec-index-menu">库位规格列表</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadStorageLocSpecList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showStorageLocSpecDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteStorageLocSpec()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="typeQuery">类型</label>&nbsp;
    <select id="typeQuery" name="typeQuery" style="width: 100px; height: 30px;" onchange="loadStorageLocSpecList();">
        <option value="0">类型查询</option>
        @foreach (ShelfType type in Model.TypeList)
        {
            <option value="@(type.Id)">@(type.Name)</option>
        }
    </select>&nbsp;
    <label for="codeQuery">编码</label>&nbsp;<input id="codeQuery" name="codeQuery" style="width: 100px; height: 30px;" placeholder="编码查询"/>&nbsp;
    <label for="nameQuery">名称</label>&nbsp;<input id="nameQuery" name="nameQuery" style="width: 100px; height: 30px;" placeholder="名称查询"/>&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadStorageLocSpecList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="storageLocSpecList" data-page-index="0" data-sort-field="@(nameof(StorageLocSpecInfo.Id))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="storageLocSpecDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadStorageLocSpecList();
    });

    function sortStorageLocSpecList(sortField, sortDir) {
        var list = $('#storageLocSpecList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadStorageLocSpecList();
    }

    function loadStorageLocSpecList(pageIndex) {
        var list = $('#storageLocSpecList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "StorageLocSpec")",
            type: "POST",
            data: {
                '@(nameof(StorageLocSpecListQueryParam.TypeQuery))': $('#typeQuery').val(),
                '@(nameof(StorageLocSpecListQueryParam.CodeQuery))': $('#codeQuery').val(),
                '@(nameof(StorageLocSpecListQueryParam.NameQuery))': $('#nameQuery').val(),
                '@(nameof(StorageLocSpecListQueryParam.PageIndex))': pageIndex,
                '@(nameof(StorageLocSpecListQueryParam.SortField))': sortField,
                '@(nameof(StorageLocSpecListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#storageLocSpecList').html(data);

                initListTable("#tblStorageLocSpecList");
            }
        });
    }

    function showStorageLocSpecDetail(id) {
        $("#storageLocSpecDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#storageLocSpecDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "StorageLocSpec")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#storageLocSpecDetailDialogWrapper").html(data);
                $("#storageLocSpecDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveStorageLocSpec() {
        var form = $("#storageLocSpecDetailForm");
        var valid = validate(form,
            {
                'StorageLocSpec.Code': {
                    required: true,
                    maxlength: 1
                },
                'StorageLocSpec.Name': {
                    required: false,
                    maxlength: 255
                },
                'StorageLocSpec.Width': {
                    required: true,
                    digits: true
                },
                'StorageLocSpec.Height': {
                    required: true,
                    digits: true
                },
                'StorageLocSpec.Length': {
                    required: true,
                    digits: true
                },
                'StorageLocSpec.Color': {
                    required: true,
                    maxlength: 10
                }
            });

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "StorageLocSpec")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        //return;
                    } else {
                        $.msg.show(data.message);
                        $('#storageLocSpecDetailDialog').modal('hide');
                        loadStorageLocSpecList();
                        //return;
                    }
                }
            });
        }
    }

    function deleteStorageLocSpec() {
        var idList = getSelectIdList('#tblStorageLocSpecList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "StorageLocSpec")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } else {
                            $.msg.show(data.message);
                        }

                        loadStorageLocSpecList();
                    }
                });
            }
        );
    }

</script>
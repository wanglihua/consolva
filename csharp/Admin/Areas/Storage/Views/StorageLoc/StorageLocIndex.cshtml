@using shunda.Admin.Areas.Storage.Models.StorageLoc
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Storage
@model shunda.Admin.Areas.Storage.Models.StorageLoc.StorageLocIndexModel
@{
    ViewData[ViewDataKey.Title] = "库位列表";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="storage-menu">仓储管理</li>
    <li class="active" data-menu="storage-warehouse-index-menu">
        <a asp-controller="Warehouse" asp-action="Index">仓库列表</a>
    </li>
    <li>
        <a asp-controller="Shelf" asp-action="Index" asp-route-warehouseId="@(Model.Warehouse.Id)">
            仓库（<span>@Model.Warehouse.Code</span>&nbsp;<span>@Model.Warehouse.Name</span>）货架列表
        </a>
    </li>
    <li>
        货架（<span>@Model.Shelf.Code</span>&nbsp;<span>@Model.Shelf.Name</span>）@(ViewData[ViewDataKey.Title])
    </li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadStorageLocList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showStorageLocDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-purple btn-sm" onclick="enableStorageLoc()">
        <i class="ace-icon fa fa-plus"></i>
        启用
    </button>
    <button type="button" class="btn btn-pink btn-sm" onclick="disableStorageLoc()">
        <i class="ace-icon fa fa-trash-o"></i>
        停用
    </button>
    <button type="button" class="btn btn-purple btn-sm" onclick="batchEnableStorageLoc()">
        <i class="ace-icon fa fa-plus"></i>
        批量启用
    </button>
    <button type="button" class="btn btn-pink btn-sm" onclick="batchDisableStorageLoc()">
        <i class="ace-icon fa fa-trash-o"></i>
        批量停用
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteStorageLoc()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>

    <button type="button" class="btn btn-default btn-sm" onclick="labelPrint()">
        <i class="ace-icon fa fa-print"></i>
        标签打印
    </button>
    <button type="button" class="btn btn-default btn-sm" onclick="labelPrintBatch()">
        <i class="ace-icon fa fa-print"></i>
        批量打印
    </button>

    <button type="button" class="btn btn-purple btn-sm" onclick="autoGenerateOffShelfOrderNum()">
        <i class="ace-icon fa fa-gear"></i>
        自动生成下架顺序
    </button>
    <button class="btn btn-purple btn-sm" onclick="exportData()">
        <i class="ace-icon fa fa-file-excel-o"></i>
        导出下架顺序
    </button>
    <button id="btnImportOffShelfOrder" class="btn btn-purple btn-sm">
        <i class="ace-icon fa fa-file-excel-o"></i>
        导入下架顺序
    </button>

    <a type="button" class="btn btn-info btn-sm" asp-controller="Shelf" asp-action="Index" asp-route-warehouseId="@(Model.Warehouse.Id)">
        <i class="ace-icon fa fa-arrow-left"></i>
        返回
    </a>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="rowNumQuery">层数</label>&nbsp;<input id="rowNumQuery" name="rowNumQuery" style="width: 60px; height: 30px;" placeholder="层数查询"/>&nbsp;
    <label for="colNumQuery">列数</label>&nbsp;<input id="colNumQuery" name="colNumQuery" style="width: 60px; height: 30px;" placeholder="列数查询"/>&nbsp;

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadStorageLocList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>


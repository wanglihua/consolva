@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Express
@model shunda.Admin.Areas.Express.Models.ExpressPhoto.ExpressPhotoDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="expressPhotoDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">订单图片详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="expressPhotoDetailForm" class="form-horizontal" role="form">
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="OrderCode" class="col-xs-2 control-label">物流订单</label>
                                <div class="col-xs-10">
                                    <input asp-for="OrderCode" type="text" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="TrackingNo" class="col-xs-2 control-label">快递单号</label>
                                <div class="col-xs-10">
                                    <input asp-for="TrackingNo" type="text" required="required" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>


                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="PhotoType" class="col-xs-2 control-label">类型</label>
                                <div class="col-xs-10">
                                    <select asp-for="PhotoType" type="text" class="input-sm form-control">
                                        @foreach (ExpressPhotoType photoType in Model.PhotoTypeList)
                                        {
                                            if (Model.PhotoType == photoType)
                                            {
                                                <option value="@(photoType.Id)" selected="selected">@(photoType.Name)</option>
                                            }
                                            else
                                            {
                                                <option value="@(photoType.Id)">@(photoType.Name)</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12" style="display: none;">
                            <div class="form-group">
                                <label for="storePath" class="col-xs-2 control-label">存储路径</label>
                                <div class="col-xs-10">
                                    <input id="storePath" asp-for="StorePath" type="text" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12" style="display: none;">
                            <div class="form-group">
                                <label for="storeName" class="col-xs-2 control-label">存储名称</label>
                                <div class="col-xs-10">
                                    <input id="storeName" asp-for="StoreName" type="text" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label class="col-xs-2 control-label">图片</label>
                                <div class="col-xs-10" style="vert-align: top;">
                                    <span>&nbsp;&nbsp;</span>
                                    @{
                                        string fullImageUrl = Model.FullImageUrl;
                                        if (string.IsNullOrWhiteSpace(fullImageUrl))
                                        {
                                            fullImageUrl = "/static/images/noimg.jpg";
                                        }
                                    }
                                    <img id="orderPhotoImg" alt="" src="@(fullImageUrl)" style="max-width: 200px; max-height: 180px;"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button id="btnUploadImage" type="button" class="btn btn-primary btn-sm">
                    <i class="fa fa-arrow-up" aria-hidden="true"></i>
                    上传图片
                </button>
                <button type="button" class="btn btn-success btn-sm" onclick="saveExpressPhoto();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    $(function(){
        initUploader();
    });

    function initUploader() {

        var url = '@Url.Action("Upload", "ExpressPhoto")';

        var uploader = new plupload.Uploader({
            runtimes: 'html5,flash,html4',
            multi_selection: false,

            browse_button: 'btnUploadImage',
            file_data_name: "imageFile",
            url: url,

            filters: {
                max_file_size: '1000kb',
                mime_types: [
                    {title: "图像文件", extensions: "jpg,jpeg,png"}
                ]
            },

            flash_swf_url: '/plupload/js/Moxie.swf',

            init: {
                FilesAdded: function () {
                    showMask("上传中，请稍候...");
                    uploader.start();
                },
                FileUploaded: function (up, file, response) {
                    hideMask();
                    var result = JSON.parse(response.response);
                    if (result.success !== true) {
                        $.msg.error(result.message);
                    } else {
                        $("#storePath").val(result.storePath);
                        $("#storeName").val(result.storeName);
                        $("#orderPhotoImg").attr("src", result.imageFileUrl);
                    }
                },
                Error: function (up, err) {
                    $.msg.error("上传发生错误：" + err.code + ", " + err.message);
                }
            }
        });

        uploader.init();
    }

</script>
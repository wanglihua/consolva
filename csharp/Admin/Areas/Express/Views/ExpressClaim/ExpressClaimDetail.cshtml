@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.Express.Models.ExpressClaim
@using shunda.Domain.Express
@using shunda.Service.Express
@model shunda.Admin.Areas.Express.Models.ExpressClaim.ExpressClaimDetailModel

@{
    ViewBag.Title = "快递详细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="express-menu">快递管理</li>
    @if (Model.Cate == ExpressListMenuCate.All)
    {
        <li class="active" data-menu="express-claim-detail-menu">快递详细</li>
    }
    else if (Model.Cate == ExpressListMenuCate.Expect)
    {
        <li class="active" data-menu="express-claim-expect-menu">已预报</li>
    }
    else if (Model.Cate == ExpressListMenuCate.NotOrderLong)
    {
        <li class="active" data-menu="express-claim-not-order-long-menu">长期未出库</li>
    }
    else if (Model.Cate == ExpressListMenuCate.NotPicked)
    {
        <li class="active" data-menu="express-claim-not-picked-menu">未认领</li>
    }
    else if (Model.Cate == ExpressListMenuCate.NotPickedLong)
    {
        <li class="active" data-menu="express-claim-not-picked-long-menu">长期未认领</li>
    }
    else if (Model.Cate == ExpressListMenuCate.Dumped)
    {
        <li class="active" data-menu="express-claim-dumped-menu">已堆存</li>
    }
    else if (Model.Cate == ExpressListMenuCate.OnShelf)
    {
        <li class="active" data-menu="express-claim-on-shelf-menu">已上架</li>
    }
    else if (Model.Cate == ExpressListMenuCate.Picked)
    {
        <li class="active" data-menu="express-claim-picked-menu">已认领</li>
    }
    else if (Model.Cate == ExpressListMenuCate.ToOffShelf)
    {
        <li class="active" data-menu="express-claim-to-off-shelf-menu">待下架</li>
    }
    else if (Model.Cate == ExpressListMenuCate.ToOnShelf)
    {
        <li class="active" data-menu="express-claim-to-on-shelf-menu">待上架</li>
    }
    else if (Model.Cate == ExpressListMenuCate.Return)
    {
        <li class="active" data-menu="express-return-index-menu">退运池</li>
    }
    else if (Model.Cate == ExpressListMenuCate.WoodFrame)
    {
        <li class="active" data-menu="express-wood-frame-menu">打木架</li>
    }
    else if (Model.Cate == ExpressListMenuCate.BarkClean)
    {
        <li class="active" data-menu="express-bark-clean-menu">清理树皮杂物</li>
    }
    else
    {
        <li class="active" data-menu="express-claim-detail-menu">快递详细</li>
    }
    <li>
        <span>快递单号</span>
        <span>
            @(Model.ClaimGoods?.TrackingNo ?? string.Empty)
        </span>
        <span>&nbsp;</span>
        <span>入库号跟踪号</span>
        <span>
            @(Model.ClaimGoods?.CheckinTrackingNo ?? string.Empty)
        </span>
    </li>
}

@section Style {
    <style type="text/css">
    
        div.detailSubTitle {
            margin: 10px 0;
            padding: 5px 0;
            font-weight: bold;
            border-bottom: lightgray 1px solid;
            color: #2a62bc;
        }
        
        
    </style>
}

<div class="widget-box" style="border-style: none; width: 1100px;">
    <div class="widget-body">
        <div class="widget-main">
            <form id="expressDetailForm" class="form-horizontal" role="form">
                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelBaseInfo').toggle();">
                            <div style="float: left;">
                                基本信息
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>

                        <div id="panelBaseInfo" style="display: block;">
                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.CheckinTrackingNo" class="col-xs-4 control-label">澳拼入库号</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.CheckinTrackingNo" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.TrackingNo" class="col-xs-4 control-label">快递单号</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.TrackingNo" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.ExpressCompany" class="col-xs-4 control-label">快递公司</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.ExpressCompany" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.Status.Name" class="col-xs-4 control-label">状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.Status.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.PackageCount" class="col-xs-4 control-label">包裹数量</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.PackageCount" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.BillCustomerCode" class="col-xs-4 control-label">面单客户</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.BillCustomerCode" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ExpressExpect.CustomerCodeCache" class="col-xs-4 control-label">预报客户</label>
                                        <div class="col-xs-8">
                                            @if (Model.ExpressExpect != null)
                                            {
                                                <label class="control-label">
                                                    <a href="@Url.Action("Detail", "Customer", new { id = Model.ExpressExpect?.Customer?.Id ?? 0 })" target="_blank">@(Model.ExpressExpect?.CustomerCodeCache)</a>
                                                </label>
                                            }
                                            else
                                            {
                                                <input asp-for="ExpressExpect.CustomerCodeCache" type="text" disabled="disabled" class="input-sm form-control"/>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.ShelfStatus.Name" class="col-xs-4 control-label">上架状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.ShelfStatus.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="AddUser.UserName" class="col-xs-4 control-label">入库人员</label>
                                        <div class="col-xs-8">
                                            <input asp-for="AddUser.UserName" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.AddTime" class="col-xs-4 control-label">入库时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.AddTime" type="text" value="@(Model.ClaimGoods.AddTime.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="OrderPack.User.UserName" class="col-xs-4 control-label">打包人员</label>
                                        <div class="col-xs-8">
                                            <input asp-for="OrderPack.User.UserName" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="OrderPack.PackTime" class="col-xs-4 control-label">打包时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="OrderPack.PackTime" type="text" value="@(Model.OrderPack?.PackTime.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.OnShelfUser.UserName" class="col-xs-4 control-label">上架人员</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.OnShelfUser.UserName" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.OnShelfTime" class="col-xs-4 control-label">上架时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.OnShelfTime" type="text" value="@(Model.ClaimGoods.OnShelfTime?.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.OffShelfUser.UserName" class="col-xs-4 control-label">下架人员</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.OffShelfUser.UserName" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.OffShelfTime" class="col-xs-4 control-label">下架时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.OffShelfTime" type="text" value="@(Model.ClaimGoods.OffShelfTime?.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.PackingUser.UserName" class="col-xs-4 control-label">入流动仓人员</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.PackingUser.UserName" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.PackingTime" class="col-xs-4 control-label">入流动仓时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.PackingTime" type="text" value="@(Model.ClaimGoods.PackingTime?.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                @{
                                    int seq = 0;
                                    foreach (UserTimeItem userTime in Model.PackUserTimeList)
                                    {
                                        seq = seq + 1;

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="pack_user_@(seq)" class="col-xs-4 control-label">打包人员@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="pack_user_@(seq)" type="text" disabled="disabled" class="input-sm form-control" value="@(userTime.User.UserName)"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="pack_time_@(seq)" class="col-xs-4 control-label">打包时间@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="pack_time_@(seq)" type="text" value="@(userTime?.Time.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                            </div>

                            <div class="row">

                                @{
                                    seq = 0;
                                    foreach (LoadUnloadUserTime loadUnloadUserTime in Model.LoadUnloadUserTimeList)
                                    {
                                        seq = seq + 1;

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="load_user_@(seq)" class="col-xs-4 control-label">装箱人员@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="load_user_@(seq)" type="text" disabled="disabled" class="input-sm form-control" value="@(loadUnloadUserTime?.LoadUserTime.User.UserName)"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="load_time_@(seq)" class="col-xs-4 control-label">装箱时间@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="load_time_@(seq)" type="text" value="@(loadUnloadUserTime?.LoadUserTime?.Time.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="unload_user_@(seq)" class="col-xs-4 control-label">卸货人员@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="unload_user_@(seq)" type="text" disabled="disabled" class="input-sm form-control" value="@(loadUnloadUserTime?.UnloadUserTime.User.UserName)"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="unload_time_@(seq)" class="col-xs-4 control-label">卸货时间@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="unload_time_@(seq)" type="text" value="@(loadUnloadUserTime?.UnloadUserTime?.Time.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                            </div>

                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Customer.CustomerCode" class="col-xs-4 control-label">认领客户</label>
                                        <div class="col-xs-8">
                                            @*<input asp-for="Customer.CustomerCode" type="text" disabled="disabled" class="input-sm form-control"/>*@
                                            @if (Model.Customer != null)
                                            {
                                                <label class="control-label">
                                                    <a href="@Url.Action("Detail", "Customer", new { id = Model.Customer?.Id ?? 0 })" target="_blank">@(Model.Customer?.CustomerCode)</a>
                                                </label>
                                            }
                                            else
                                            {
                                                <input asp-for="Customer.CustomerCode" type="text" disabled="disabled" class="input-sm form-control"/>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.ClaimTime" class="col-xs-4 control-label">认领时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.ClaimTime" type="text" value="@(Model.ClaimGoods?.ClaimTime?.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.Order.Code" class="col-xs-4 control-label">所在订单</label>
                                        <div class="col-xs-8">
                                            @if (Model.ClaimGoods.Order != null)
                                            {
                                                <label class="control-label">
                                                    <a href="@Url.Action("Detail", "LogisticsOrder", new { id = Model.ClaimGoods?.Order?.Id ?? 0 })" target="_blank">@(Model.ClaimGoods?.Order?.Code)</a>
                                                </label>
                                            }
                                            else
                                            {
                                                <input asp-for="ClaimGoods.Order.Code" type="text" disabled="disabled" class="input-sm form-control"/>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.Order.OrderStatus.Name" class="col-xs-4 control-label">订单状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.Order.OrderStatus.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">

                                <div class="col-xs-12">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.Description" class="col-xs-1 control-label">申领件描述</label>
                                        <div class="col-xs-11">
                                            <textarea asp-for="ClaimGoods.Description" rows="1" disabled="disabled" class="input-sm form-control"></textarea>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label for="serviceRemark" class="col-xs-2 control-label">客服备注</label>
                                        <div class="col-xs-10">
                                            @if (Model.CanCustomerServiceRemark == false)
                                            {
                                                <textarea id="serviceRemark" asp-for="ClaimGoods.ServiceRemark" rows="2" disabled="disabled" class="input-sm form-control"></textarea>
                                            }
                                            else
                                            {
                                                <textarea id="serviceRemark" asp-for="ClaimGoods.ServiceRemark" rows="2" class="input-sm form-control"></textarea>
                                                <div style="padding: 5px 0; text-align: right; width: 100%">
                                                    <button type="button" class="btn btn-xs btn-default" onclick="saveServiceRemark()">保存客服留言</button>
                                                </div>
                                            }
                                        </div>

                                        <script type="text/javascript">
                                            function saveServiceRemark()
                                            {
                                                showMask("数据加载中，请稍候");
                                        
                                                $.ajax({
                                                    url: "@Url.Action("SaveExpressCustomerServiceRemark", "ExpressClaim")",
                                                    type: "POST",
                                                    data: {
                                                        'claimId': @(Model.ClaimGoods.Id),
                                                        'serviceRemark': $('#serviceRemark').val()
                                                    },
                                                    success: function(data) {
                                                        hideMask();
                                        
                                                        if (data.success === false) {
                                                            $.msg.error(data.message);
                                                            return;
                                                        }
                                                        
                                                        $.msg.show(data.message);
                                                    }
                                                });
                                            }
                                        </script>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.ServiceRemark" class="col-xs-2 control-label">仓库备注</label>
                                        <div class="col-xs-10">
                                            <textarea asp-for="ClaimGoods.ServiceRemark" rows="2" disabled="disabled" class="input-sm form-control"></textarea>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-xs-12">
                                    <div class="form-group">
                                        <label class="col-xs-1 control-label">标签预览</label>
                                        <div class="col-xs-11">
                                            <a href="javascript:printLabelW10H05();">
                                                <label class="control-label" style="cursor: pointer;">10*5标签</label>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:printLabelW05H05();">
                                                <label class="control-label" style="cursor: pointer;">5*5标签</label>
                                            </a>&nbsp;&nbsp;
                                            <a href="javascript:printLabelW10H05Old();">
                                                <label class="control-label" style="cursor: pointer;">原10*5标签</label>
                                            </a>
                                            <div>
                                                <script type="text/javascript" src="/static/lodop/LodopFuncs.js?v=20191002"></script>
                                                <script type="text/javascript" src="@Url.Action("Index", "LodopScript")"></script>
                                                <script type="text/javascript">

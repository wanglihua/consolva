                                                @Html.Partial("~/Areas/Admin/Views/ExpressCheckinConfig/ExpressCheckinConfigPrintLabelW10H05.cshtml", true)
                                                @Html.Partial("~/Areas/Admin/Views/ExpressCheckinConfig/ExpressCheckinConfigPrintLabelW05H05.cshtml", true)
                                                @Html.Partial("~/Areas/Admin/Views/ExpressCheckinConfig/ExpressCheckinConfigPrintLabelW10H05Old.cshtml", true)
                                                
                                                *@

                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>

                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelWoodFrame').toggle();">
                            <div style="float: left;">
                                快递退运
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>

                        <div id="panelWoodFrame" style="display: block;">
                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.ReturnPickupCode" class="col-xs-4 control-label" style="color: blue;">退运取货码</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.ReturnPickupCode" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.ReturnApplyTime" class="col-xs-4 control-label">退运申请时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.ReturnApplyTime" type="text" value="@(Model.ClaimGoods.ReturnApplyTime?.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.ReturnTime" class="col-xs-4 control-label">实际退运时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.ReturnTime" type="text" value="@(Model.ClaimGoods.ReturnTime?.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.ReturnTrackingNo" class="col-xs-4 control-label">退运快递单号</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.ReturnTrackingNo" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ClaimGoods.ReturnExpressCompany" class="col-xs-4 control-label">退运快递公司</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ClaimGoods.ReturnExpressCompany" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>

                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelEntryList').toggle();">
                            <div style="float: left;">
                                物品列表
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>

                        <div id="panelEntryList" style="display: block;">
                            <table class="data-list-table table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 50px; text-align: center;">序号</th>
                                        <th style="width: 280px; text-align: center;">
                                            物品名称
                                        </th>
                                        <th style="width: 100px; text-align: center;">
                                            单价
                                        </th>
                                        <th style="width: 100px; text-align: center;">
                                            数量
                                        </th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.EntryList != null && Model.EntryList.Count() != 0)
                                    {
                                        int order = 1;
                                        foreach (ExpressGoodsInfo item in Model.EntryList)
                                        {
                                            <tr>
                                                <td style="text-align: center;">@(order++)</td>
                                                <td style="text-align: center;">@item.GoodsNameCache</td>
                                                <td style="text-align: center;">
                                                    <span>
                                                        @(item.Price)
                                                    </span>
                                                    <span>
                                                        元
                                                    </span>
                                                </td>
                                                <td style="text-align: center;">
                                                    <span>
                                                        @(item.Quantity)
                                                    </span>
                                                    <span>
                                                        @(item.Unit)
                                                    </span>
                                                </td>
                                                <td></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5">
                                                暂时没有数据！
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelSizeWeight').toggle();">
                            <div style="float: left;">
                                尺寸重量
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>

                        <div id="panelSizeWeight" style="display: block;">
                            <table class="data-list-table table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 50px; text-align: center;">序号</th>
                                        <th style="width: 150px; text-align: center;">
                                            单号/子单号
                                        </th>
                                        <th style="width: 80px; text-align: center;">
                                            长cm
                                        </th>
                                        <th style="width: 80px; text-align: center;">
                                            宽cm
                                        </th>
                                        <th style="width: 80px; text-align: center;">
                                            高cm
                                        </th>
                                        <th style="width: 100px; text-align: center;">
                                            体积m<sup>3</sup>
                                        </th>
                                        <th style="width: 100px; text-align: center;">
                                            体积重kg
                                        </th>
                                        <th style="width: 100px; text-align: center;">
                                            实际重kg
                                        </th>
                                        <th style="width: 100px; text-align: center;">
                                            数量
                                        </th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ExpressItemList != null && Model.ExpressItemList.Count() != 0)
                                    {
                                        int order = 1;
                                        foreach (ExpressSizeWeightInfo item in Model.ExpressItemList)
                                        {
                                            <tr>
                                                <td style="text-align: center;">@(order++)</td>
                                                <td style="text-align: center;">@item.TrackingNoSub</td>
                                                <td style="text-align: center;">@item.Length.ToString("#0.0")</td>
                                                <td style="text-align: center;">@item.Width.ToString("#0.0")</td>
                                                <td style="text-align: center;">@item.Height.ToString("#0.0")</td>
                                                <td style="text-align: center;">@item.VolumeCache.ToString("#0.000000")</td>
                                                <td style="text-align: center;">@item.VolumeWeightCache.ToString("#0.000")</td>
                                                <td style="text-align: center;">@item.Weight.ToString("#0.000")</td>
                                                <td style="text-align: center;">@item.PackageCount</td>
                                                <td></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="10">
                                                暂时没有数据！
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelPhoto').toggle();">
                            <div style="float: left;">
                                订单照片
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelPhoto" style="display: block;">
                            @{
                                IList<ExpressPhotoType> photoTypeList = Model.OrderPhotoList.Select(e => e.Type).Distinct().OrderBy(e => e.Id).ToList();
                            }

                            @if (Model.OrderPhotoList != null && Model.OrderPhotoList.Count() != 0)
                            {
                                <ul id="orderPhotoList" class="nav nav-tabs">
                                    @{
                                        int index = 0;
                                        foreach (ExpressPhotoType photoType in photoTypeList)
                                        {
                                            if (index == 0)
                                            {
                                                <li class="active">
                                                    <a data-toggle="tab" href="#photoTab_@(photoType.Id)" aria-expanded="true">
                                                        @(photoType.Name)
                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <a data-toggle="tab" href="#photoTab_@(photoType.Id)" aria-expanded="false">
                                                        @(photoType.Name)
                                                    </a>
                                                </li>
                                            }

                                            index += 1;
                                        }
                                    }
                                </ul>

                                <div class="tab-content">
                                    @{
                                        index = 0;
                                        foreach (ExpressPhotoType photoType in photoTypeList)
                                        {
                                            string activeClass = "";
                                            if (index == 0)
                                            {
                                                activeClass = " active in ";
                                            }

                                            <div id="photoTab_@(photoType.Id)" class="tab-pane fade @(activeClass)">

                                                @{
                                                    IList<ExpressPhotoInfo> typePhotoList = Model.OrderPhotoList.Where(e => e.Type.Id == photoType.Id).ToList();

                                                    foreach (ExpressPhotoInfo expressPhoto in typePhotoList)
                                                    {
                                                        <a href="@(expressPhoto.BigImageFullUrlCache)" target="_blank" style="display: inline-block; margin: 5px;">
                                                            <img alt="" src="@(expressPhoto.SmallImageFullUrlCache)" style="height: 100px;"/>
                                                        </a>
                                                    }
                                                }

                                            </div>

                                            index += 1;
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="padding: 5px;">
                                    暂时没有数据！
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelExpressLog').toggle();">
                            <div style="float: left;">
                                操作日志
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>

                        <div id="panelExpressLog" style="display: block;">
                            <table class="data-list-table table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 50px; text-align: center;">序号</th>
                                        <th style="width: 100px; text-align: center;">
                                            操作人
                                        </th>
                                        <th style="width: 120px; text-align: center;">
                                            操作时间
                                        </th>
                                        <th style="width: 150px; text-align: center;">
                                            操作类型
                                        </th>
                                        <th>
                                            操作描述
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ExpressLogList != null && Model.ExpressLogList.Count() != 0)
                                    {
                                        int order = 1;
                                        foreach (ExpressLogInfo log in Model.ExpressLogList)
                                        {
                                            <tr>
                                                <td style="text-align: center;">@(order++)</td>
                                                <td style="text-align: center;">@log.User?.UserName</td>
                                                <td style="text-align: center;">@log.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td style="text-align: center;">@log.Type.Name</td>
                                                <td class="break-word">
                                                    @if (log.Order != null)
                                                    {
                                                        <a asp-area="LogisticsOrder" asp-controller="LogisticsOrder" asp-action="Detail" asp-route-id="@(log.Order.Id)" target="_blank">@(log.Order.Code)</a>
                                                    }
                                                    <span>&nbsp;</span>
                                                    <span>
                                                        @log.Description
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5">
                                                暂时没有数据！
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
    function freezeCustomer() {
        $.msg.confirm("确认要冻结客户吗？",
            function() {
                $.ajax({
                    url: '@Url.Action("Freeze", "Customer")',
                    type: "POST",
                    data: { "id": @(Model.Customer.Id) },
                    success: function(data) {
                        if (data.success === false) {
                            $.msg.error(data.message);
                        } else {
                            $.msg.show(data.message);
                            setTimeout("window.location.reload()", 1000);
                        }
                    }
                });
            }
        );
    }

    function unfreezeCustomer() {
        $.msg.confirm("确认要解冻客户吗？",
            function() {
                $.ajax({
                    url: '@Url.Action("Unfreeze", "Customer")',
                    type: "POST",
                    data: { "id": @(Model.Customer.Id) },
                    success: function(data) {
                        if (data.success === false) {
                            $.msg.error(data.message);
                        } else {
                            $.msg.show(data.message);
                            setTimeout("window.location.reload()", 1000);
                        }
                    }
                });
            }
        );
    }

    function resetPassword() {
        $.msg.confirm("确认要重设客户密码吗？",
            function() {
                $.ajax({
                    url: '@Url.Action("ResetPassword", "Customer")',
                    type: "POST",
                    data: { "id": @(Model.Customer.Id) },
                    success: function(data) {
                        if (data.success === false) {
                            $.msg.error(data.message);
                        } else {
                            $.msg.show(data.message);
                        }
                    }
                });
            }
        );
    }
</script>
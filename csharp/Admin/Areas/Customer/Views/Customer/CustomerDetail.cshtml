@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Core.Web
@using shunda.Domain.Customer
@using shunda.Domain.Fee
@model shunda.Admin.Areas.Customer.Models.Customer.CustomerDetailModel
@{
    ViewData[ViewDataKey.Title] = "会员详细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="customer-menu">会员管理</li>
    <li class="active" data-menu="customer-customer-index-menu">
        <a href="@Url.Action("Index", "Customer")">会员列表</a>
    </li>
    <li>@(Model.Customer?.CustomerCodeCache)</li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

@section Style
{
    <style>
        div.detailSubTitle {
            margin: 10px 0;
            padding: 5px 0;
            font-weight: bold;
            border-bottom: lightgray 1px solid;
            color: #2a62bc;
        }

        div.detailSubTitle:after {
            clear: both;
        }
        
        div.more {
            margin: 10px 0;
            padding: 5px 0;        
            font-weight: bold;
            float: right;
        }        
    </style>
}


<div class="gridToolBar clearfix">
    @*
        <button type="button" class="btn btn-success btn-sm">
            <i class="ace-icon fa fa-floppy-o"></i>
            保存
        </button>
    *@
    <button type="button" class="btn btn-primary btn-sm" onclick="refreshCustomer()">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>

    @if (Model.CanFreezeCustomer)
    {
        if (Model.Customer.Status != CustomerStatus.Frozen)
        {
            <button type="button" class="btn btn-warning btn-sm" onclick="freezeCustomer()">
                <i class="ace-icon fa fa-trash-o"></i>
                冻结
            </button>
        }

        if (Model.Customer.Status == CustomerStatus.Frozen)
        {
            <button type="button" class="btn btn-warning btn-sm" onclick="unfreezeCustomer()">
                <i class="ace-icon fa fa-trash-o"></i>
                解冻
            </button>
        }
    }

    @*
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteCustomer()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
    *@

    @if (Model.CanResetPassword)
    {
        <button type="button" class="btn btn-pink btn-sm" onclick="resetPassword();">
            <i class="ace-icon fa fa-calculator"></i>
            重设密码
        </button>
    }

    @* 多个地方引用了这个详细界面，如果都加上返回，就感觉不太好
    <a type="button" class="btn btn-info btn-sm" href="@Url.Action("Index", "Customer")">
        <i class="ace-icon fa fa-arrow-left"></i>
        返回
    </a>
    *@
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="orderCodeQuery">订单编号</label>&nbsp;<input id="orderCodeQuery" name="orderCodeQuery" style="width: 100px; height: 30px;" placeholder="订单编号查询"/>&nbsp;
    <label for="trackingNoQuery">快递单号</label>&nbsp;<input id="trackingNoQuery" name="trackingNoQuery" style="width: 180px; height: 30px;" placeholder="快递单号查询"/>&nbsp;

    <button type="button" class="btn btn-mini btn-primary" style="height: 30px;" onclick="searchData()">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>

    <script type="text/javascript">
        
        function searchData() {
            
            // loadLogisticsOrderPhotoList();
            // loadLogisticsOrderList();
            // loadLogisticsOrderPackBoxList();
            
            // loadClaimGoodsList();
            // loadLogisticsIssueGoodsList();
            
            $('#panelBasic').show();
            $('#panelOrderPhotoList').show();
            $('#panelOrderList').show();
            $('#panelOrderPackBoxList').show();
            $('#panelClaimGoods').show();
            $('#panelIssueGoods').show();
            $('#panelOrderPay').show();
            $('#panelCustomerAccountEntry').show();
            $('#panelCustomerScoreLog').show();
            $('#panelAddress').show();
        }
    
    </script>
</div>

<div class="widget-box" style="border-style: none; width: 1000px;">
    <div class="widget-body">
        <div class="widget-main">
            <div class="row" style="margin-bottom: 10px;">
                <div class="col-xs-12">
                    <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelBasic').toggle();">
                        <div style="float: left;">
                            <span>基本信息</span>
                            @if (Model.Customer.Status == CustomerStatus.Frozen)
                            {
                                <span style="color: white; background-color: red;padding: 0 5px;">已冻结</span>
                            }
                        </div>
                        <div style="float: right;">
                            显示/隐藏
                        </div>
                        <div style="clear: both;"></div>
                    </div>
                    <div id="panelBasic" style="display: none;">
                        <form id="customerDetailForm" class="form-horizontal" role="form">
                            <input asp-for="Customer.Id" type="hidden"/>
                            <div class="row">

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Customer.CustomerCodeCache" class="col-xs-2 control-label">客户ID</label>
                                        <div class="col-xs-10">
                                            <input asp-for="Customer.CustomerCodeCache" type="text" class="input-sm form-control" disabled="disabled"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label for="customerLevel" class="col-xs-2 control-label">客户级别</label>
                                        <div class="col-xs-10">
                                            <input id="customerLevel" type="text" class="input-sm form-control" value="@(Model.Customer.Level.Name) @(Model.Customer.VipRank?.Name ?? string.Empty)" disabled="disabled"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Customer.Mobile" class="col-xs-2 control-label">手机号码</label>
                                        <div class="col-xs-10">
                                            <input asp-for="Customer.Mobile" type="text" class="input-sm form-control" disabled="disabled"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label for="mobileValidated" class="col-xs-2 control-label">手机验证</label>
                                        <div class="col-xs-10">
                                            @if (Model.Customer.MobileValidated)
                                            {
                                                <input id="mobileValidated" name="mobileValidated" value="已验证" type="text" class="input-sm form-control" disabled="disabled"/>
                                            }
                                            else
                                            {
                                                <input id="mobileValidated" name="mobileValidated" value="未验证" type="text" class="input-sm form-control" disabled="disabled"/>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Customer.RegTime" class="col-xs-2 control-label">注册时间</label>
                                        <div class="col-xs-10">
                                            <input asp-for="Customer.RegTime" value="@(Model.Customer.RegTime.ToString("yyyy-MM-dd HH:mm:ss"))" type="text" class="input-sm form-control" disabled="disabled"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Customer.LastLogin" class="col-xs-2 control-label">最后登录</label>
                                        <div class="col-xs-10">
                                            <input asp-for="Customer.LastLogin" value="@(Model.Customer.LastLogin.ToString("yyyy-MM-dd HH:mm:ss"))" type="text" class="input-sm form-control" disabled="disabled"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Customer.LastIp" class="col-xs-2 control-label">登录IP</label>
                                        <div class="col-xs-10">
                                            <input asp-for="Customer.LastIp" type="text" class="input-sm form-control" disabled="disabled"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Customer.Account" class="col-xs-2 control-label">海运余额</label>
                                        <div class="col-xs-10">
                                            <input asp-for="Customer.Account" type="text" class="input-sm form-control" disabled="disabled"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Customer.ValidScore" class="col-xs-2 control-label">有效积分</label>
                                        <div class="col-xs-10">
                                            <input asp-for="Customer.ValidScore" type="text" class="input-sm form-control" disabled="disabled"/>
                                        </div>
                                    </div>
                                </div>


                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Customer.TotalScore" class="col-xs-2 control-label">历史积分</label>
                                        <div class="col-xs-10">
                                            <input asp-for="Customer.TotalScore" type="text" class="input-sm form-control" disabled="disabled"/>
                                        </div>
                                    </div>
                                </div>

                                @if (Model.CanEditCharacter)
                                {
                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="Customer.CustomerCharacter" class="col-xs-2 control-label">会员性质</label>
                                            <div class="col-xs-6">
                                                <select id="customerCharacter" asp-for="Customer.CustomerCharacter" class="input-sm form-control">
                                                    <option value=""></option>
                                                    @foreach (var customerCharacter in Model.CustomerCharacterList)
                                                    {
                                                        <option value="@(customerCharacter.Content)">@(customerCharacter.Content)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-xs-4">
                                                <button type="button" class="btn btn-primary btn-sm" onclick="editCustomerCharacter()">
                                                    <i class="ace-icon fa fa-floppy-o"></i>
                                                    保存会员性质
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <script type="text/javascript">
                                
                                    function editCustomerCharacter() {
                   
                                        $.ajax({
                                            url: '@Url.Action("EditCharacter", "Customer")',
                                            type: "POST",
                                            data: { 
                                                "customerId": @(Model.Customer.Id),
                                                "character": $("#customerCharacter").val()
                                            },
                                            success: function(data) {
                                                if (data.success === false) {
                                                    $.msg.error(data.message);
                                                } else {
                                                    $.msg.show(data.message);
                                                    setTimeout("window.location.reload()", 1000);
                                                }
                                            }
                                        });
                                    }
    
                                </script>
                                }
                                else
                                {
                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="Customer.CustomerCharacter" class="col-xs-2 control-label">客户性质</label>
                                            <div class="col-xs-10">
                                                <input asp-for="Customer.CustomerCharacter" type="text" class="input-sm form-control" disabled="disabled"/>
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </form>
                    </div>
                </div>
            </div>


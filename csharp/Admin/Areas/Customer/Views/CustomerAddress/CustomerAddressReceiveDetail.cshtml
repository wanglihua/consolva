@using Microsoft.AspNetCore.Mvc.TagHelpers
@model shunda.Admin.Areas.Customer.Models.CustomerAddress.CustomerAddressReceiveDetailModel

@{
    Layout = null;
}

<div class="modal fade" id="customerAddressReceiverDetailDialog">
    <div class="modal-dialog" style="width: 780px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">客户收货地址详细</h4>
            </div>
            <div class="modal-body clearfix">

                <form id="customerAddressReceiverDetailForm" action="" method="post" class="form-horizontal" role="form">
                    <input asp-for="CustomerAddress.Id" type="hidden"/>
                    <div class="col-xs-12">
                        <div class="row">

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.FirstName" class="col-xs-4 control-label">名(first name)</label>
                                    <div class="col-xs-8">
                                        <input asp-for="CustomerAddress.FirstName" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.LastName" class="col-xs-4 control-label">姓(last name)</label>
                                    <div class="col-xs-8">
                                        <input asp-for="CustomerAddress.LastName" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.Mobile" class="col-xs-4 control-label">手机号码</label>
                                    <div class="col-xs-8">
                                        <input asp-for="CustomerAddress.Mobile" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.UnitLoc" class="col-xs-4 control-label">Unit号</label>
                                    <div class="col-xs-8">
                                        <input asp-for="CustomerAddress.UnitLoc" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">

                            <div class="col-xs-12">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.Address" class="col-xs-2 control-label">门牌号/路名</label>
                                    <div class="col-xs-10">
                                        <input asp-for="CustomerAddress.Address" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-12">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.City" class="col-xs-2 control-label">区/Suburb</label>
                                    <div class="col-xs-10">
                                        <input asp-for="CustomerAddress.City" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.State" class="col-xs-4 control-label">省/州</label>
                                    <div class="col-xs-8">
                                        <input asp-for="CustomerAddress.State" type="text" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.Zipcode" class="col-xs-4 control-label">邮编</label>
                                    <div class="col-xs-8">
                                        <input asp-for="CustomerAddress.Zipcode" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.Tfn" class="col-xs-4 control-label">ABN/ACN</label>
                                    <div class="col-xs-8">
                                        <input asp-for="CustomerAddress.Tfn" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="CustomerAddress.Company" class="col-xs-4 control-label">公司</label>
                                    <div class="col-xs-8">
                                        <input asp-for="CustomerAddress.Company" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="receiveSave();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
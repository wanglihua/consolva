@using shunda.Admin.Areas.Customer.Models.CustomerVipDiscount
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Customer
@model shunda.Admin.Areas.Customer.Models.CustomerVipDiscount.CustomerVipDiscountIndexModel
@{
    ViewData[ViewDataKey.Title] = "VIP折扣设置";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="customer-menu">会员管理</li>
    <li class="active" data-menu="customer-customer-vip-discount-index-menu">VIP折扣设置</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadCustomerVipDiscountList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showCustomerVipDiscountDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteCustomerVipDiscount()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
    <button id="btnImport" class="btn btn-success btn-sm">
        <i class="ace-icon fa fa-plus"></i>
        导入
    </button>
    <button class="btn btn-purple btn-sm" onclick="exportData()">
        <i class="ace-icon fa fa-file-excel-o"></i>
        导出
    </button>

    <button class="btn btn-pink btn-sm" onclick="updateCustomerVip()">
        <i class="ace-icon fa fa-gear"></i>
        手动更新会员VIP标识
    </button>
</div>

<div id="customerVipDiscountList" data-page-index="0" data-sort-field="@(nameof(CustomerVipDiscountInfo.Score))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="customerVipDiscountDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadCustomerVipDiscountList();
    });

    function sortCustomerVipDiscountList(sortField, sortDir) {
        var list = $('#customerVipDiscountList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadCustomerVipDiscountList();
    }

    function loadCustomerVipDiscountList(pageIndex) {
        var list = $('#customerVipDiscountList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "CustomerVipDiscount")",
            type: "POST",
            data: {
                '@(nameof(CustomerVipDiscountListQueryParam.PageIndex))': pageIndex,
                '@(nameof(CustomerVipDiscountListQueryParam.SortField))': sortField,
                '@(nameof(CustomerVipDiscountListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#customerVipDiscountList').html(data);

                initListTable("#tblCustomerVipDiscountList");
            }
        });
    }

    function showCustomerVipDiscountDetail(id) {
        $("#customerVipDiscountDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#customerVipDiscountDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "CustomerVipDiscount")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#customerVipDiscountDetailDialogWrapper").html(data);
                $("#customerVipDiscountDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveCustomerVipDiscount() {
        var form = $("#customerVipDiscountDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "CustomerVipDiscount")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        //return;
                    } else {
                        $.msg.show(data.message);
                        $('#customerVipDiscountDetailDialog').modal('hide');
                        loadCustomerVipDiscountList();
                        //return;
                    }
                }
            });
        }
    }

    function deleteCustomerVipDiscount() {
        var idList = getSelectIdList('#tblCustomerVipDiscountList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "CustomerVipDiscount")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } else {
                            $.msg.show(data.message);
                        }

                        loadCustomerVipDiscountList();
                    }
                });
            }
        );
    }

    $(function(){
        initUploader();
    });

    function initUploader() {

        var url = '@Url.Action("Import", "CustomerVipDiscount")';

        var uploader = new plupload.Uploader({
            runtimes: 'html5,flash,html4',
            multi_selection: false,

            browse_button: 'btnImport',
            file_data_name: "excelFile",
            url: url,
            max_file_size: '10000kb',

            filters: [
                {title: "Excel文件", extensions: "xlsx"}
            ],

            flash_swf_url: '/plupload/js/Moxie.swf',

            init: {
                FilesAdded: function () {
                    showMask("上传中，请稍候...");
                    uploader.start();
                },
                FileUploaded: function (up, file, response) {
                    hideMask();
                    var result = JSON.parse(response.response);
                    if (result.success !== true) {
                        $.msg.error(result.message);
                    } else {
                        loadCustomerVipDiscountList();
                        $.msg.show(result.message);
                    }
                },
                Error: function (up, err) {
                    $.msg.error("上传发生错误：" + err.code + ", " + err.message);
                }
            }
        });

        uploader.init();
    }

    function exportData() {
        var url = '@Url.Action("Export", "CustomerVipDiscount")';
        $('<form method="post" action="' + url + '"></form>').appendTo('body').submit().remove();
    }

    function updateCustomerVip() {

        showMask("处理中，请稍候");

        $.ajax({
            url: "@Url.Action("UpdateVip", "Customer")",
            type: "POST",
            data: {
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $.msg.show(data.message);
            }
        });
    }

</script>
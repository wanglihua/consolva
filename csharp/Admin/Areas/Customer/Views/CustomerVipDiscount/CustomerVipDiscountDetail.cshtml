@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Customer
@model shunda.Admin.Areas.Customer.Models.CustomerVipDiscount.CustomerVipDiscountDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="customerVipDiscountDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">VIP折扣设置详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="customerVipDiscountDetailForm" class="form-horizontal" role="form">
                    <input asp-for="CustomerVipDiscountId" type="hidden"/>
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Rank" class="col-xs-2 control-label">会员VIP等级</label>
                                <div class="col-xs-10">
                                    <select asp-for="Rank" required="required" class="input-sm form-control">
                                        <option value="">会员VIP等级</option>
                                        @foreach (CustomerVipRank rank in Model.CustomerVipRankList)
                                        {
                                            <option value="@(rank.Id)">@(rank.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Score" class="col-xs-2 control-label">历史总积分</label>
                                <div class="col-xs-10">
                                    <input asp-for="Score" type="number" required="required" min="1" step="1" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Discount" class="col-xs-2 control-label">折扣</label>
                                <div class="col-xs-10">
                                    <div class="input-group">
                                        <input asp-for="Discount" type="number" required="required" min="0" max="100" step="1" class="input-sm form-control"/>
                                        <span class="input-group-addon">%</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveCustomerVipDiscount();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
@using shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderRemarkReason
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.LogisticsOrder
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderRemarkReason.LogisticsOrderRemarkReasonIndexModel
@{
    ViewData[ViewDataKey.Title] = "订单备注原因";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-order-menu">物流订单</li>
    <li class="active" data-menu="logistics-order-remark-reason-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadLogisticsOrderRemarkReasonList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showLogisticsOrderRemarkReasonDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteLogisticsOrderRemarkReason()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px; display: none;">
    <label for="reasonQuery">原因</label>&nbsp;<input id="reasonQuery" name="reasonQuery" style="width: 100px; height: 30px;" placeholder="原因查询"/>&nbsp;
    <label for="descriptionQuery">备注</label>&nbsp;<input id="descriptionQuery" name="descriptionQuery" style="width: 100px; height: 30px;" placeholder="备注查询"/>&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadLogisticsOrderRemarkReasonList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="logisticsOrderRemarkReasonList" data-page-index="0" data-sort-field="@(nameof(LogisticsOrderRemarkReasonInfo.Id))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="logisticsOrderRemarkReasonDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadLogisticsOrderRemarkReasonList();
    });

    function sortLogisticsOrderRemarkReasonList(sortField, sortDir) {
        var list = $('#logisticsOrderRemarkReasonList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadLogisticsOrderRemarkReasonList();
    }

    function loadLogisticsOrderRemarkReasonList(pageIndex) {
        var list = $('#logisticsOrderRemarkReasonList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "LogisticsOrderRemarkReason")",
            type: "POST",
            data: {
                '@(nameof(LogisticsOrderRemarkReasonListQueryParam.ReasonQuery))': $('#reasonQuery').val(),
                '@(nameof(LogisticsOrderRemarkReasonListQueryParam.DescriptionQuery))': $('#descriptionQuery').val(),
                '@(nameof(LogisticsOrderRemarkReasonListQueryParam.PageIndex))': pageIndex,
                '@(nameof(LogisticsOrderRemarkReasonListQueryParam.SortField))': sortField,
                '@(nameof(LogisticsOrderRemarkReasonListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsOrderRemarkReasonList').html(data);

                initListTable("#tblLogisticsOrderRemarkReasonList");
            }
        });
    }

    function showLogisticsOrderRemarkReasonDetail(id) {
        $("#logisticsOrderRemarkReasonDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#logisticsOrderRemarkReasonDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "LogisticsOrderRemarkReason")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#logisticsOrderRemarkReasonDetailDialogWrapper").html(data);
                $("#logisticsOrderRemarkReasonDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveLogisticsOrderRemarkReason() {
        var form = $("#logisticsOrderRemarkReasonDetailForm");
        var valid = validate(form,
            {
                'LogisticsOrderRemarkReason.Reason': {
                    required: true,
                    maxlength: 100
                },
                'LogisticsOrderRemarkReason.Description': {
                    required: false,
                    maxlength: 300
                }
            });

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "LogisticsOrderRemarkReason")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        //return;
                    } else {
                        $.msg.show(data.message);
                        $('#logisticsOrderRemarkReasonDetailDialog').modal('hide');
                        loadLogisticsOrderRemarkReasonList();
                        //return;
                    }
                }
            });
        }
    }

    function deleteLogisticsOrderRemarkReason() {
        var idList = getSelectIdList('#tblLogisticsOrderRemarkReasonList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "LogisticsOrderRemarkReason")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } else {
                            $.msg.show(data.message);
                        }

                        loadLogisticsOrderRemarkReasonList();
                    }
                });
            }
        );
    }

</script>
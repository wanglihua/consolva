@{
    Layout = null;
}
@using shunda.Domain.Pass
@model shunda.Admin.Areas.Pass.Models.Group.GroupListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadGroupList" })

<table id="tblGroupList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="groupCheckAll"></label><input id="groupCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 100px;">
                <a field="@(nameof(GroupInfo.Code))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortGroupList">编码</a>
            </th>
            <th style="width: 150px;">
                <a field="@(nameof(GroupInfo.Name))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortGroupList">名称</a>
            </th>
            <th style="width: 320px;">描述</th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(GroupInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortGroupList">创建时间</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(GroupInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortGroupList">修改时间</a>
            </th>
            <th style="width: 150px; text-align: center;">操作</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.GroupList != null && Model.GroupList.Count() != 0)
        {
            var order = 1;
            foreach (var group in Model.GroupList)
            {
                <tr ondblclick="showGroupDetail(@(group.Id));">
                    <td style="text-align: center;">
                        <label for="groupCheck_@(group.Id)"></label><input id="groupCheck_@(group.Id)" type="checkbox" class="ace" value="@group.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td>@group.Code</td>
                    <td>@group.Name</td>
                    <td>@group.Description</td>
                    <td style="text-align: center;">@group.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="text-align: center;">@group.UpdateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="text-align: center;">
                        <a asp-controller="GroupMember" asp-action="Index" asp-route-groupId="@(group.Id)"><i class="fa fa-pencil-square-o"></i>&nbsp;群组成员</a>&nbsp;
                        <a asp-controller="GroupPassRes" asp-action="Index" asp-route-groupId="@(group.Id)"><i class="fa fa-pencil-square-o"></i>&nbsp;资源授权</a>
                    </td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadGroupList" })
@model shunda.Admin.Areas.Pass.Models.Group.GroupDetailModel
@{
    Layout = null;
}

<div class="modal fade" id="groupDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">群组详细</h4>
            </div>
            <div class="modal-body clearfix">

                <form id="groupDetailForm" class="form-horizontal" role="form">
                    <input asp-for="GroupId" type="hidden"/>
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Code" class="col-xs-2 control-label">编码</label>
                                <div class="col-xs-10">
                                    <input asp-for="Code" type="text" required="required" maxlength="50" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Name" class="col-xs-2 control-label">名称</label>
                                <div class="col-xs-10">
                                    <input asp-for="Name" type="text" required="required" maxlength="50" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Description" class="col-xs-2 control-label">描述</label>
                                <div class="col-xs-10">
                                    <textarea asp-for="Description" rows="3" maxlength="200" class="input-sm form-control"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveGroup();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
@{
    Layout = null;
}
@using shunda.Domain.Pass
@model shunda.Admin.Areas.Pass.Models.GroupMember.GroupMemberListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadGroupMemberList" })

<table id="tblGroupMemberList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="groupMemberCheckAll"></label><input id="groupMemberCheckAll" type="checkbox" class="ace checkall" /><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 120px;">
                <a field="@(nameof(GroupMemberInfo.User)).@(nameof(GroupMemberInfo.User.LoginName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortGroupMemberList">登录名</a>
            </th>
            <th style="width: 180px;">
                <a field="@(nameof(GroupMemberInfo.User)).@(nameof(GroupMemberInfo.User.UserName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortGroupMemberList">用户名</a>
            </th>
            <th style="width: 120px;">
                <a field="@(nameof(GroupMemberInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortGroupMemberList">添加时间</a>
            </th>
            <td></td>
        </tr>
    </thead>
    <tbody>
        @if (Model.GroupMemberList != null && Model.GroupMemberList.Count() != 0)
        {
            int order = 1;
            foreach (GroupMemberInfo groupMember in Model.GroupMemberList)
            {
                <tr>
                    <td style="text-align: center;">
                        <label for="groupMemberCheck_@(groupMember.Id)"></label><input id="groupMemberCheck_@(groupMember.Id)" type="checkbox" class="ace" value="@groupMember.Id" /><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td>@groupMember.User?.LoginName</td>
                    <td>@groupMember.User?.UserName</td>
                    <td>@groupMember.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadGroupMemberList" })
@using shunda.Admin.Areas.Pass.Models.GroupMember
@using shunda.Core.Web
@using shunda.Domain.Pass
@using shunda.Core
@model shunda.Admin.Areas.Pass.Models.GroupMember.GroupMemberIndexModel
@{
    ViewData[ViewDataKey.Title] = "群组成员列表";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="auth-menu">权限管理</li>
    <li class="active" data-menu="auth-group-index-menu">
        <a asp-controller="Group" asp-action="Index">群组列表</a>
    </li>
    <li>群组（<span>@(Model.Group.Code)</span>&nbsp;<span>@(Model.Group.Name)</span>）成员列表</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadGroupMemberList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showGroupMemberAdd(0)">
        <i class="ace-icon fa fa-plus"></i>
        添加
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="removeGroupMember()">
        <i class="ace-icon fa fa-trash-o"></i>
        移除
    </button>
    <a type="button" class="btn btn-info btn-sm" asp-controller="Group" asp-action="Index">
        <i class="ace-icon fa fa-arrow-left"></i>
        返回
    </a>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="loginNameQuery">登录名</label>&nbsp;<input id="loginNameQuery" name="loginNameQuery" style="width: 100px; height: 30px;" placeholder="登录名查询"/>&nbsp;
    <label for="userNameQuery">用户名</label>&nbsp;<input id="userNameQuery" name="userNameQuery" style="width: 100px; height: 30px;" placeholder="用户名查询"/>&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadGroupMemberList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="groupMemberList" data-page-index="0" data-sort-field="@(nameof(GroupMemberInfo.Id))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="groupMemberAddDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadGroupMemberList();
    });

    function sortGroupMemberList(sortField, sortDir) {
        var list = $('#groupMemberList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadGroupMemberList();
    }

    function loadGroupMemberList(pageIndex) {
        var list = $('#groupMemberList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "GroupMember")",
            type: "POST",
            data: {
                '@(nameof(GroupMemberListQueryParam.GroupId))': @(Model.GroupId),
                '@(nameof(GroupMemberListQueryParam.LoginNameQuery))': $('#loginNameQuery').val(),
                '@(nameof(GroupMemberListQueryParam.UserNameQuery))': $('#userNameQuery').val(),
                '@(nameof(GroupMemberListQueryParam.PageIndex))': pageIndex,
                '@(nameof(GroupMemberListQueryParam.SortField))': sortField,
                '@(nameof(GroupMemberListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#groupMemberList').html(data);

                initListTable("#tblGroupMemberList");
            }
        });
    }

    function showGroupMemberAdd(id) {
        $("#groupMemberAddDialogWrapper").html("");

        showMask("加载中...");
        // $("#groupMemberAddForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Add", "GroupMember", new { groupId = Model.GroupId })',
            type: "POST",
            data: {},
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#groupMemberAddDialogWrapper").html(data);
                $("#groupMemberAddDialog").modal(modalOptions);
            }
        });
    }

    function saveGroupMember() {
        var form = $("#groupMemberAddForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("AddSave", "GroupMember")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        //return;
                    } else {
                        $.msg.show(data.message);
                        $('#groupMemberAddDialog').modal('hide');
                        loadGroupMemberList();
                        //return;
                    }
                }
            });
        }
    }

    function removeGroupMember() {
        var idList = getSelectIdList('#tblGroupMemberList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要移除吗？",
            function() {
                $.ajax({
                    url: '@Url.Action("Remove", "GroupMember")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } else {
                            $.msg.show(data.message);
                        }

                        loadGroupMemberList();
                    }
                });
            }
        );
    }

</script>
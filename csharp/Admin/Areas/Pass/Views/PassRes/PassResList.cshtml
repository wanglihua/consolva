@{
    Layout = null;
}
@using shunda.Domain.Pass
@model shunda.Admin.Areas.Pass.Models.PassRes.PassResListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadPassResList" })

<table id="tblPassResList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="passResCheckAll"></label><input id="passResCheckAll" type="checkbox" class="ace checkall" /><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 100px;">
                <a field="@($"{Model.PassResCateAlias}.{nameof(PassResCateInfo.Name)}")" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortPassResList">类别</a>
            </th>
            <th style="width: 150px;">
                <a field="@(nameof(PassResInfo.Name))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortPassResList">名称</a>
            </th>
            <th style="width: 220px;">
                <a field="@(nameof(PassResInfo.Description))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortPassResList">描述</a>
            </th>
            <th style="width: 130px; text-align: center;">操作</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.PassResList != null && Model.PassResList.Count() != 0)
        {
            int order = 1;
            foreach (PassResInfo passRes in Model.PassResList)
            {
                <tr ondblclick="showPassResDetail(@(passRes.Id));">
                    <td style="text-align: center;">
                        <label for="passResCheck_@(passRes.Id)"></label><input id="passResCheck_@(passRes.Id)" type="checkbox" class="ace" value="@passRes.Id" /><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td>@passRes.Cate.Name</td>
                    <td>@passRes.Name</td>
                    <td>@passRes.Description</td>
                    <td style="text-align: center;">
                        <a href="@Url.Action("Index", "PassResUser", new { passResId = passRes.Id })"><i class="fa fa-pencil-square-o"></i>&nbsp;授权用户</a>&nbsp;
                        <a href="@Url.Action("Index", "PassResGroup", new { passResId = passRes.Id })"><i class="fa fa-pencil-square-o"></i>&nbsp;授权群组</a>
                    </td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadPassResList" })
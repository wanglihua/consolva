@{
    Layout = null;
}
@using shunda.Domain.Pass
@model shunda.Admin.Areas.Pass.Models.Admin.AdminListModel

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadAdminList" }))

<table id="tblAdminList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="adminCheckAll"></label><input id="adminCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 120px;">
                <a field="@(nameof(AdminInfo.User)).@(nameof(UserInfo.LoginName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortAdminList">登录名</a>
            </th>
            <th style="width: 200px;">
                <a field="@(nameof(AdminInfo.User)).@(nameof(UserInfo.UserName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortAdminList">用户名</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(AdminInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortAdminList">添加时间</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.AdminList != null && Model.AdminList.Count() != 0)
        {
            var order = 1;
            foreach (var admin in Model.AdminList)
            {
                <tr>
                    <td style="text-align: center;">
                        <label for="adminCheck_@(admin.Id)"></label><input id="adminCheck_@(admin.Id)" type="checkbox" class="ace" value="@admin.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td>@admin.User.LoginName</td>
                    <td>@admin.User.UserName</td>
                    <td style="text-align: center;">@admin.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadAdminList" }))
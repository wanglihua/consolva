@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.Fee.Models.ManualDecreaseFee
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Fee
@model shunda.Admin.Areas.Fee.Models.ManualDecreaseFee.ManualDecreaseFeeIndexModel
@{
    ViewData[ViewDataKey.Title] = "减少费用";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="pparent" data-menu="fee-menu">费用管理</li>
    <li class="parent" data-menu="fee-manual-decrease-fee-menu">减少费用</li>
    <li class="active" data-menu="fee-manual-decrease-fee-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="manualReasonIdQuery">减少费用原因</label>&nbsp;
    <select id="manualReasonIdQuery" name="manualReasonIdQuery" style="width: 150px; height: 30px;">
        <option value="0">减少费用原因</option>
        @foreach (ManualFeeReasonInfo feeReason in Model.FeeReasonList)
        {
            <option value="@(feeReason.Id)">@(feeReason.Content)</option>
        }
    </select>&nbsp;

    <label for="orderCodeQuery">订单编号</label>&nbsp;
    <input id="orderCodeQuery" name="orderCodeQuery" style="width: 120px; height: 30px;" placeholder="订单编号查询"/>&nbsp;

    <label for="customerIdQuery">客户ID</label>&nbsp;
    <input id="customerIdQuery" name="customerIdQuery" style="width: 120px; height: 30px;" placeholder="客户ID查询"/>&nbsp;

    <label for="beginDateQuery">开始日期</label>&nbsp;<input id="beginDateQuery" name="beginDateQuery" style="width: 90px; height: 30px;" placeholder="开始日期" autocomplete="off"/>&nbsp;
    <label for="endDateQuery">截止日期</label>&nbsp;<input id="endDateQuery" name="endDateQuery" style="width: 90px; height: 30px;" placeholder="截止日期" autocomplete="off"/>&nbsp;

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadLogisticsOrderFeeList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
    <button class="btn btn-purple btn-sm" style="margin-bottom: 3px; height: 30px;" onclick="exportExcel()">
        <i class="ace-icon fa fa-file-excel-o"></i>
        导出
    </button>     
</div>

<div id="logisticsOrderFeeList" data-page-index="0" data-sort-field="@(nameof(LogisticsOrderFeeInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="logisticsOrderFeeDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        $('#beginDateQuery').datetimepicker({
            locale: "zh-cn",
            format: 'L'
        });

        $('#endDateQuery').datetimepicker({
            locale: "zh-cn",
            format: 'L',
            useCurrent: false
        });

        $("#beginDateQuery").on("dp.change", function (e) {
            $('#endDateQuery').data("DateTimePicker").minDate(e.date);
        });

        $("#endDateQuery").on("dp.change", function (e) {
            $('#beginDateQuery').data("DateTimePicker").maxDate(e.date);
        });
        
        loadLogisticsOrderFeeList();
    });

    function sortLogisticsOrderFeeList(sortField, sortDir) {
        var list = $('#logisticsOrderFeeList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadLogisticsOrderFeeList();
    }

    function loadLogisticsOrderFeeList(pageIndex) {
        var list = $('#logisticsOrderFeeList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "ManualDecreaseFee")",
            type: "POST",
            data: {
                '@(nameof(ManualDecreaseFeeListQueryParam.ManualReasonIdQuery))': $('#manualReasonIdQuery').val(),
                '@(nameof(ManualDecreaseFeeListQueryParam.OrderCodeQuery))': $('#orderCodeQuery').val(),
                '@(nameof(ManualDecreaseFeeListQueryParam.CustomerCodeQuery))': $('#customerIdQuery').val(),
                '@(nameof(ManualDecreaseFeeListQueryParam.BeginDateQuery))': $('#beginDateQuery').val(),
                '@(nameof(ManualDecreaseFeeListQueryParam.EndDateQuery))': $('#endDateQuery').val(),
                '@(nameof(ManualDecreaseFeeListQueryParam.PageIndex))': pageIndex,
                '@(nameof(ManualDecreaseFeeListQueryParam.SortField))': sortField,
                '@(nameof(ManualDecreaseFeeListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsOrderFeeList').html(data);

                initListTable("#tblLogisticsOrderFeeList");
            }
        });
    }

    function orderSelectChange() {
        $("#OrderCode").val($("#orderSelect").val());
    }

    function customerCodeChange() {
        $.ajax({
            url: '@Url.Action("GetCustomerRecentOrderSelect", "FeeCommon")',
            type: "POST",
            data: {
                "customerCode": $("#CustomerCode").val()
            },
            success: function(data) {
                if (data.success === false) {
                    // $.msg.error(data.message);
                    return;
                } else {
                    $("#orderSelectWrapper").html(data);
                    return;
                }
            }
        });        
    }

    function orderCodeChange() {
        $.ajax({
            url: '@Url.Action("GetCustomerCodeByOrderCode", "FeeCommon")',
            type: "POST",
            data: {
                "orderCode": $("#OrderCode").val()
            },
            success: function(data) {
                if (data.success === false) {
                    // $.msg.error(data.message);
                    return;
                } else {
                    $("#CustomerCode").val(data.customerCode);
                    return;
                }
            }
        }); 
    }
    
    function exportExcel() {
        var params = $.param({
                '@(nameof(ManualDecreaseFeeListQueryParam.ManualReasonIdQuery))': $('#manualReasonIdQuery').val(),
                '@(nameof(ManualDecreaseFeeListQueryParam.OrderCodeQuery))': $('#orderCodeQuery').val(),
                '@(nameof(ManualDecreaseFeeListQueryParam.CustomerCodeQuery))': $('#customerIdQuery').val(),
                '@(nameof(ManualDecreaseFeeListQueryParam.BeginDateQuery))': $('#beginDateQuery').val(),
                '@(nameof(ManualDecreaseFeeListQueryParam.EndDateQuery))': $('#endDateQuery').val()
        });

        var url = '@Url.Action("Export", "ManualDecreaseFee")?' + params;
        $('<form method="post" action="' + url + '"></form>').appendTo('body').submit().remove();
    }     

</script>
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model shunda.Admin.Areas.Fee.Models.CustomerCharge.CustomerChargeDetailModel

@{
    Layout = null;
}

<div class="modal fade" id="customerChargeDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">手工客户余额充值</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="customerChargeDetailForm" class="form-horizontal" role="form">
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="CustomerCode" class="col-xs-2 control-label">会员ID</label>
                                <div class="col-xs-10">
                                    <input asp-for="CustomerCode" type="text" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Amount" class="col-xs-2 control-label">充值金额</label>
                                <div class="col-xs-10">
                                    <input asp-for="Amount" type="text" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ChargeReason" class="col-xs-2 control-label">充值原因</label>
                                <div class="col-xs-10">
                                    <select asp-for="ChargeReason" class="input-sm form-control">
                                        <option value=""></option>
                                        @foreach (var reason in Model.ChargeReasonList)
                                        {
                                            <option value="@(reason.Content)">@(reason.Content)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveCustomerCharge();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
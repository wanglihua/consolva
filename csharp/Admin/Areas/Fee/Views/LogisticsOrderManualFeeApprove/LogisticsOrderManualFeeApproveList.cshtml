@{
    Layout = null;
}
@using Domain
@using Domain.LogisticsOrder
@model Web.Areas.Admin.Models.ManualFeeApprove.ManualFeeApproveListModel

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadManualFeeApplyList"})

<table id="tblManualFeeApplyList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="logisticsOrderManualFeeApplyCheckAll"></label><input id="logisticsOrderManualFeeApplyCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(ManualFeeApplyInfo.Customer))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList"> 客户</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ManualFeeApplyInfo.Order))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">订单</a>
            </th>
            <th style="width: 90px; text-align: center;">
                <a field="@(nameof(ManualFeeApplyInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">费用类型</a>
            </th>
            <th style="width: 90px; text-align: right;">
                <a field="@(nameof(ManualFeeApplyInfo.Fee))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">金额RMB</a>
            </th>
            <th style="width: 180px;">
                <div>
                    <a field="@(nameof(ManualFeeApplyInfo.ManualReasonContent))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">减少费用原因</a>
                </div>
                <div>
                    <a field="@(nameof(ManualFeeApplyInfo.Description))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">描述</a>
                </div>
            </th>
            <th style="width: 90px; text-align: center;">
                <div>
                    <a field="@(nameof(ManualFeeApplyInfo.ApplyUser))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">申请用户</a>
                </div>
                <div>
                    <a field="@(nameof(ManualFeeApplyInfo.ApproveUser))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">审核用户</a>
                </div>
            </th>
            <th style="width: 90px; text-align: center;">
                <a field="@(nameof(ManualFeeApplyInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">审核状态</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(ManualFeeApplyInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">创建时间</a>
                </div>
                <div>
                    <a field="@(nameof(ManualFeeApplyInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortManualFeeApplyList">修改时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ManualFeeApplyList != null && Model.ManualFeeApplyList.Count() != 0)
        {
            int order = 1;
            foreach (ManualFeeApplyInfo logisticsOrderManualFeeApply in Model.ManualFeeApplyList)
            {
                string applyCountStyleColor = "";
                if (logisticsOrderManualFeeApply.OrderApplyCountCache > 1)
                {
                    applyCountStyleColor = "color: red;";
                }

                <tr>
                    <td style="text-align: center;">
                        <label for="logisticsOrderManualFeeApplyCheck_@(logisticsOrderManualFeeApply.Id)"></label><input id="logisticsOrderManualFeeApplyCheck_@(logisticsOrderManualFeeApply.Id)" type="checkbox" class="ace" value="@logisticsOrderManualFeeApply.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">
                        <a target="_blank" href="@Url.Action("Detail", "Customer", new {id = logisticsOrderManualFeeApply.Customer?.Id})">
                            @logisticsOrderManualFeeApply.Customer?.CustomerCode
                        </a>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            <a target="_blank" href="@Url.Action("Detail", "LogisticsOrder", new {id = logisticsOrderManualFeeApply.Order?.Id})">
                                @logisticsOrderManualFeeApply.Order?.Code
                            </a>
                        </div>
                        <div>
                            <a href="javascript:loadListByOrderCode('@(logisticsOrderManualFeeApply.Order?.Code)')">
                                订单共<span style="@(applyCountStyleColor)">@(logisticsOrderManualFeeApply.OrderApplyCountCache)</span>条申请
                            </a>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        @logisticsOrderManualFeeApply.Type?.Name
                    </td>
                    <td style="text-align: right;">
                        @logisticsOrderManualFeeApply.Fee
                    </td>
                    <td class="break-word">
                        <div>
                            @logisticsOrderManualFeeApply.ManualReasonContent
                        </div>
                        <div style="color: #08008c;">
                            @ListDataUtil.RenderStringWithDiv(logisticsOrderManualFeeApply.Description)
                        </div>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @(logisticsOrderManualFeeApply.ApplyUser?.LoginName)&nbsp;@(logisticsOrderManualFeeApply.ApplyUser?.UserName)
                        </div>
                        <div style="color: #08008c;">
                            @if (logisticsOrderManualFeeApply.ApproveUser != null)
                            {
                                @(logisticsOrderManualFeeApply.ApproveUser?.LoginName)
                                <span>&nbsp;</span>
                                @(logisticsOrderManualFeeApply.ApproveUser?.UserName)
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: center;">
                        @logisticsOrderManualFeeApply.Status?.Name
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @logisticsOrderManualFeeApply.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                        <div>
                            @logisticsOrderManualFeeApply.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="15">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadManualFeeApplyList"})
@{
    Layout = null;
}
@model shunda.Admin.Areas.Fee.Models.LogisticsOrderPay.LogisticsOrderPayDateStatListModel

<table id="tblDateStatList" class="data-list-table table table-striped table-bordered table-hover">
    <caption>按日期汇总</caption>
    <thead>
        <tr>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 80px; text-align: center;">
                日期
            </th>
            <th style="width: 110px; text-align: right;">
                支付宝
            </th>
            <th style="width: 110px; text-align: right;">
                微信
            </th>
            <th style="width: 110px; text-align: right;">
                PayPal
            </th>
            <th style="width: 110px; text-align: right;">
                余额
            </th>
            <th style="width: 110px; text-align: right;">
                核销
            </th>
            <th style="width: 110px; text-align: right;">
                总金额
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.DateStatList != null && Model.DateStatList.Count != 0)
        {
            var order = 1;
            foreach (var  dateStat in Model.DateStatList)
            {
                <tr>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">
                        @dateStat.Date.ToString("yyyy-MM-dd")
                    </td>
                    <td style="text-align: right;">@dateStat.AlipayAmount.ToString("#0.00")</td>
                    <td style="text-align: right;">@dateStat.WechatAmount.ToString("#0.00")</td>
                    <td style="text-align: right;">@dateStat.PaypalAmount.ToString("#0.00")</td>
                    <td style="text-align: right;">@dateStat.BalanceAmount.ToString("#0.00")</td>
                    <td style="text-align: right;">@dateStat.WriteOffAmount.ToString("#0.00")</td>
                    <td style="text-align: right;">@dateStat.TotalAmount.ToString("#0.00")</td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadDateStatList" })
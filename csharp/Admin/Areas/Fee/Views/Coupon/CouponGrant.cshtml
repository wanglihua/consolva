@using Microsoft.AspNetCore.Mvc.TagHelpers
@model shunda.Admin.Areas.Fee.Models.Coupon.CouponGrantModel

@{
    Layout = null;
}

<div class="modal fade" id="couponGrantDialog">
    <div class="modal-dialog" style="width: 440px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">优惠券发放</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="couponGrantForm" class="form-horizontal" role="form">
                    <input asp-for="BatchId" type="hidden"/>
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="CustomerCode" class="col-xs-2 control-label">客户ID</label>
                                <div class="col-xs-10">
                                    <input asp-for="CustomerCode" type="text" required="required" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Quantity" class="col-xs-2 control-label">发放数量</label>
                                <div class="col-xs-10">
                                    <input asp-for="Quantity" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="false"/>
                                </div>
                            </div>
                        </div>


                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveGrant();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
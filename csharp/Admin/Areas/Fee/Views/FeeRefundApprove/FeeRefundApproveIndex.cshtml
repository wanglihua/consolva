@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.Fee.Models.FeeRefundApprove
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Fee
@model shunda.Admin.Areas.Fee.Models.FeeRefundApprove.FeeRefundApproveIndexModel
@{
    ViewData[ViewDataKey.Title] = "退赔款审核";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="pparent" data-menu="fee-menu">费用管理</li>
    <li class="parent" data-menu="fee-refund-menu">退赔款</li>
    <li class="active" data-menu="fee-refund-approve-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadFeeRefundApplyList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-pink btn-sm" onclick="showFeeRefundApplyDetailBySelect()">
        <i class="ace-icon fa fa-reply fa-flip-horizontal"></i>
        审批
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="typeQuery">类型</label>
    <select id="typeQuery" name="typeQuery" style="width: 90px; height: 30px;">
        <option value="">类型查询</option>
        @foreach (var type in Model.TypeList)
        {
            <option value="@(type.Id)">@(type.Name)</option>
        }
    </select>&nbsp;

    <label for="orderCodeQuery">订单编号</label>&nbsp;
    <input id="orderCodeQuery" name="orderCodeQuery" style="width: 120px; height: 30px;" placeholder="订单编号查询"/>&nbsp;

    <label for="customerIdQuery">客户ID</label>&nbsp;
    <input id="customerIdQuery" name="customerIdQuery" style="width: 100px; height: 30px;" placeholder="客户ID查询"/>&nbsp;

    <label for="reasonQuery">退赔款原因</label>&nbsp;<input id="reasonQuery" name="reasonQuery" style="width: 100px; height: 30px;" placeholder="退赔款原因查询"/>&nbsp;

    <label for="statusQuery">状态</label>
    <select id="statusQuery" name="statusQuery" style="width: 90px; height: 30px;">
        <option value="">状态查询</option>
        @foreach (var status in Model.StatusList)
        {
            <option value="@(status.Id)">@(status.Name)</option>
        }
    </select>&nbsp;
    
    <label for="applyUserQuery">申请人</label>
    <select id="applyUserQuery" name="applyUserQuery" style="width: 100px; height: 30px;" class="ui search dropdown">
        <option value="">申请人查询</option>
        @foreach (var user in Model.ApplyUserList)
        {
            <option value="@(user.Id)">@(user.LoginName)&nbsp;@(user.UserName)</option>
        }
    </select>

    <script type="text/javascript">
    
    $(function() {
        $("#applyUserQuery").dropdown();
    });
    
    </script>    
    
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadFeeRefundApplyList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="logisticsOrderRefundApplyList" data-page-index="0" data-sort-field="@(nameof(FeeRefundApplyInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="logisticsOrderRefundApplyDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadFeeRefundApplyList();
    });

    function sortFeeRefundApplyList(sortField, sortDir) {
        var list = $('#logisticsOrderRefundApplyList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadFeeRefundApplyList();
    }

    function loadListByOrderCode(orderCode) {
        $('#typeQuery').val("");
        $('#orderCodeQuery').val(orderCode);
        $('#customerIdQuery').val("");
        $('#reasonQuery').val("");
        $('#statusQuery').val("");
        $('#viewScopeQuery').val("");
        
        loadFeeRefundApplyList(0);
    }   
        
    function loadFeeRefundApplyList(pageIndex) {
        var list = $('#logisticsOrderRefundApplyList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "FeeRefundApprove")",
            type: "POST",
            data: {
                '@(nameof(FeeRefundApproveListQueryParam.TypeQuery))': $('#typeQuery').val(),
                '@(nameof(FeeRefundApproveListQueryParam.OrderCodeQuery))': $('#orderCodeQuery').val(),
                '@(nameof(FeeRefundApproveListQueryParam.CustomerCodeQuery))': $('#customerIdQuery').val(),
                '@(nameof(FeeRefundApproveListQueryParam.ReasonQuery))': $('#reasonQuery').val(),
                '@(nameof(FeeRefundApproveListQueryParam.StatusQuery))': $('#statusQuery').val(),
                '@(nameof(FeeRefundApproveListQueryParam.ApplyUserIdQuery))': $('#applyUserQuery').val(),
                '@(nameof(FeeRefundApproveListQueryParam.PageIndex))': pageIndex,
                '@(nameof(FeeRefundApproveListQueryParam.SortField))': sortField,
                '@(nameof(FeeRefundApproveListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsOrderRefundApplyList').html(data);

                initListTable("#tblFeeRefundApplyList");
            }
        });
    }
    
    function showFeeRefundApplyDetailBySelect() 
    {
        var idList = getSelectIdList('#tblFeeRefundApplyList');

        if (idList.length !== 1) {
            $.msg.alert("请选择一行数据！");
            return;
        }
        
        showFeeRefundApplyDetail(idList[0]);
    }

    function showFeeRefundApplyDetail(id) {
        $("#logisticsOrderRefundApplyDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#logisticsOrderRefundApplyDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "FeeRefundApprove")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#logisticsOrderRefundApplyDetailDialogWrapper").html(data);
                $("#logisticsOrderRefundApplyDetailDialog").modal(modalOptions);
            }
        });
    }

    function backFeeRefundApply() {
        var form = $("#logisticsOrderRefundApplyDetailForm");
        var valid = validate(form,
            {
                'ApplyId': {
                    required: true,
                    digits: true 
                },
                'ApproveMemo': {
                    required: false,
                    maxlength: 300
                }
            });

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Back", "FeeRefundApprove")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        //return;
                    } else {
                        $.msg.show(data.message);
                        $('#logisticsOrderRefundApplyDetailDialog').modal('hide');
                        loadFeeRefundApplyList();
                        //return;
                    }
                }
            });
        }
    }
    
    function approveFeeRefundApply() {
        var form = $("#logisticsOrderRefundApplyDetailForm");
        var valid = validate(form,
            {
                'ApplyId': {
                    required: true,
                    digits: true 
                },
                'ApproveMemo': {
                    required: false,
                    maxlength: 300
                }
            });

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Approve", "FeeRefundApprove")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        //return;
                    } else {
                        $.msg.show(data.message);
                        $('#logisticsOrderRefundApplyDetailDialog').modal('hide');
                        loadFeeRefundApplyList();
                        //return;
                    }
                }
            });
        }
    }

</script>
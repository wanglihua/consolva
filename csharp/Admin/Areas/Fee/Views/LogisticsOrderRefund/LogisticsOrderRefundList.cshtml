@{
    Layout = null;
}
@using Domain
@using Domain.LogisticsOrder
@model Web.Areas.Admin.Models.FeeRefund.FeeRefundListModel

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadFeeRefundList"})

<table id="tblFeeRefundList" class="data-list-table table table-striped table-bordered table-hover">
    <caption style="margin: 10px 0; color: #393939;">
        <span>汇总信息，</span>
        <span>客户数量：</span><span style="color:blue;">@(Model.CustomerCount)</span>，
        <span>订单数量：</span><span style="color: blue;">@(Model.OrderCount)</span>，
        <span>金额合计：</span><span style="color: blue;">@(Model.AmountSum.ToString("#0.00"))</span>
    </caption>
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="logisticsOrderRefundCheckAll"></label><input id="logisticsOrderRefundCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(FeeRefundInfo.Customer)).@(nameof(FeeRefundInfo.Customer.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundList">客户</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(FeeRefundInfo.Order)).@(nameof(FeeRefundInfo.Order.Code))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundList">订单</a>
            </th>
            <th style="width: 80px; text-align: center;">
                <a field="@(nameof(FeeRefundInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundList">类型</a>
            </th>
            <th style="width: 90px; text-align: right;">
                <a field="@(nameof(FeeRefundInfo.Amount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundList">退赔金额</a>
            </th>
            <th style="width: 180px;">
                <a field="@(nameof(FeeRefundInfo.ReasonContent))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundList">退赔款原因</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(FeeRefundInfo.PayType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundList">退赔支付方式</a>
            </th>
            <th style="width: 90px; text-align: center;">
                <a field="@(nameof(FeeRefundInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundList">状态</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(FeeRefundInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundList">生成时间</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.FeeRefundList != null && Model.FeeRefundList.Count() != 0)
        {
            int order = 1;
            foreach (FeeRefundInfo logisticsOrderRefund in Model.FeeRefundList)
            {
                <tr>
                    <td style="text-align: center;">
                        <label for="logisticsOrderRefundCheck_@(logisticsOrderRefund.Id)"></label><input id="logisticsOrderRefundCheck_@(logisticsOrderRefund.Id)" type="checkbox" class="ace" value="@logisticsOrderRefund.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">
                        <a target="_blank" href="@Url.Action("Detail", "Customer", new { id = logisticsOrderRefund.Customer?.Id})">
                            @logisticsOrderRefund.Customer?.CustomerCode
                        </a>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <a target="_blank" href="@Url.Action("Detail", "LogisticsOrder", new { id = logisticsOrderRefund.Order?.Id})">
                            @logisticsOrderRefund.Order?.Code
                        </a>
                    </td>
                    <td style="text-align: center;">
                        @logisticsOrderRefund.Type?.Name
                    </td>
                    <td style="text-align: right;">@logisticsOrderRefund.Amount</td>
                    <td class="break-word">
                        @ListDataUtil.RenderStringWithDiv(logisticsOrderRefund.ReasonContent)
                    </td>
                    <td style="text-align: center;">
                        @logisticsOrderRefund.PayType?.Name
                    </td>
                    <td style="text-align: center;">
                        @logisticsOrderRefund.Status?.Name
                    </td>
                    <td style="text-align: center;">@logisticsOrderRefund.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="11">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadFeeRefundList"})
@using shunda.Admin.Areas.ReceivePack.Models.ExpressRemarkPresetSelect
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Express
@model shunda.Admin.Areas.ReceivePack.Models.ExpressRemarkPresetSelect.ExpressRemarkPresetSelectIndexModel
@{
    ViewData[ViewDataKey.Title] = "快递单备注预设";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="express-menu">快递管理</li>
    <li class="active" data-menu="express-express-remark-preset-select-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadExpressRemarkPresetSelectList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showExpressRemarkPresetSelectDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteExpressRemarkPresetSelect()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

@*

@using shunda.Admin.Areas.Logistics.Models.LogisticsInsurance
@using shunda.Core
@using shunda.Domain.Logistics
@{
    ViewBag.Title = "保险列表";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-menu">物流设置</li>
    <li class="active" data-menu="logistics-logistics-insurance-index-menu">保险列表</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadLogisticsInsuranceList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showLogisticsInsuranceDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteLogisticsInsurance()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="nameQuery">名称</label>&nbsp;<input id="nameQuery" name="nameQuery" style="width: 180px; height: 30px;" placeholder="名称查询"/>&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadLogisticsInsuranceList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="logisticsInsuranceList" data-page-index="0" data-sort-field="@(nameof(LogisticsInsuranceInfo.Id))" data-sort-dir="@(SortDirection.Asc)">
</div>

<script type="text/javascript">

    $(function() {
        loadLogisticsInsuranceList();
    });

    function sortLogisticsInsuranceList(sortField, sortDir) {
        var list = $('#logisticsInsuranceList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadLogisticsInsuranceList();
    }

    function loadLogisticsInsuranceList(pageIndex) {
        var list = $('#logisticsInsuranceList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "LogisticsInsurance")",
            type: "POST",
            data: {
                '@(nameof(LogisticsInsuranceListQueryParam.NameQuery))': $('#nameQuery').val(),
                '@(nameof(LogisticsInsuranceListQueryParam.PageIndex))': pageIndex,
                '@(nameof(LogisticsInsuranceListQueryParam.SortField))': sortField,
                '@(nameof(LogisticsInsuranceListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsInsuranceList').html(data);

                initListTable("#tblLogisticsInsuranceList");
            }
        });
    }

    function showLogisticsInsuranceDetail(id) {
        var url = "@Url.Action("Detail", "LogisticsInsurance", new { id = 88888})";
        url = url.replace("88888", id);
        window.location.href = url;
    }

    function deleteLogisticsInsurance() {
        var idList = getSelectIdList('#tblLogisticsInsuranceList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "LogisticsInsurance")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } else {
                            $.msg.show(data.message);
                        }

                        loadLogisticsInsuranceList();
                    }
                });
            }
        );
    }

</script>
    function showSelectHsCodeDialog() {
        $("#selectHsCodeDialogWrapper").html("");

        showMask("加载中...");
        // $("#userDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("ShowSelectHsCode", "LogisticsGoodsTrade")',
            type: "POST",
            data: { },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#selectHsCodeDialogWrapper").html(data);
                $("#selectHsCodeDialog").modal(modalOptions);

                loadHsGoodsList(0);
            }
        });
    }

    function loadHsGoodsList(pageIndex) {
        var list = $('#hsGoodsList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("ShowSelectHsCodeList", "LogisticsGoodsTrade")",
            type: "POST",
            data: {
                '@(nameof(HsGoodsListQueryParam.CnHsNameQuery))': $('#cnHsNameQuery').val(),
                '@(nameof(HsGoodsListQueryParam.PageIndex))': pageIndex,
                '@(nameof(HsGoodsListQueryParam.SortField))': sortField,
                '@(nameof(HsGoodsListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#hsGoodsList').html(data);

                initListTable("#tblHsGoodsList");
            }
        });
    }

    function selectHsCode() {
        var idList = getSelectIdList('#tblHsGoodsList');

        if (idList.length !== 1) {
            $.msg.alert("请选择一项数据！");
            return;
        }

        $.ajax({
            url: '@Url.Action("DetailData", "HsGoods")',
            type: "POST",
            data: {
                id: idList[0]
            },
            success: function(data) {
                if (data.success === false) {
                    $.msg.error(data.message);
                    //return;
                } else {
                    var hsGoods = data.hsGoods;
                    $("#HsGoodsId").val(hsGoods.id);
                    $("#CnHsCode").val(hsGoods.cnHsCode);
                    $("#CnHsName").val(hsGoods.cnHsName);
                    $("#EnHsCode").val(hsGoods.enHsCode);
                    $("#EnHsName").val(hsGoods.enHsName);
                    $("#Elem01").val(hsGoods.elem01);
                    $("#Elem02").val(hsGoods.elem02);
                    $("#Elem03").val(hsGoods.elem03);
                    $("#Elem04").val(hsGoods.elem04);
                    $("#Elem05").val(hsGoods.elem05);
                    $("#Elem06").val(hsGoods.elem06);
                    $("#Elem07").val(hsGoods.elem07);
                    $("#Elem08").val(hsGoods.elem08);

                    $("#selectHsCodeDialog").modal("hide");
                }

                hideMask();
            }
        });

    }


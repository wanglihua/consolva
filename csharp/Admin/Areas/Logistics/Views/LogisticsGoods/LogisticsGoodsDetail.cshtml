@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.Logistics.Models.HsGoods
@using shunda.Core.Web
@using shunda.Domain.Express
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsGoods.LogisticsGoodsDetailModel
@{
    ViewData[ViewDataKey.Title] = "物品品名详细";
    Layout = "_AdminLayout";

    bool autoSelectHsGoods = Model.HsGoodsId != 0;
    Model.HsGoodsAutoSelect = autoSelectHsGoods;
}

@section Breadcrumb {
    <li class="parent" data-menu="goods-menu">物品管理</li>

    @if (Model.IsViewOnly)
    {
        <li class="active" data-menu="goods-logistics-goods@(Model.LogisticsGoods.Type.Id)-index-menu">
            <a href="@Url.Action("Index", "LogisticsGoods", new { typeId = Model.LogisticsGoods.Type.Id })">@(Model.LogisticsGoods.Type.Name)清单</a>
        </li>
        <li>物品详细</li>
    }
    else
    {
        <li class="active" data-menu="goods-logistics-goods-trade-search-menu">
            <a href="@Url.Action("Index", "LogisticsGoodsTrade", new { statusId = Model.StatusId ?? 0 })">扩展名确认</a>
        </li>
        <li>物品详细</li>
    }
}

@section Style
{
    <style type="text/css">

        div.detailSubTitle {
            margin: 10px 0;
            padding: 5px 0;
            font-weight: bold;
            border-bottom: lightgray 1px solid;
            color: #2a62bc;
        }

    </style>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="refreshLogisticsGoods()">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    @if (Model.IsViewOnly == false)
    {
        <button type="button" class="btn btn-success btn-sm" onclick="saveLogisticsGoods();">
            <i class="ace-icon fa fa-floppy-o"></i>
            保存
        </button>


        @if (Model.LogisticsGoods.Status != LogisticsGoodsStatus.Confirmed)
        {
            <button type="button" class="btn btn-pink btn-sm" onclick="saveAndConfirmLogisticsGoods();">
                <i class="ace-icon fa fa-hand-paper-o"></i>
                保存并确认
            </button>
        }
    }
    else
    {
        <a class="btn btn-pink btn-sm" target="_blank" href="@Url.Action("Detail", "LogisticsGoods", new { id = Model.LogisticsGoods.Id, statusId = (Model.LogisticsGoods.Status?.Id ?? 0) })">
            <i class="ace-icon fa fa-pencil"></i>
            编辑
        </a>
    }

    @if (Model.IsViewOnly)
    {
        <a type="button" class="btn btn-info btn-sm" href="@Url.Action("Index", "LogisticsGoods", new { typeId = Model.LogisticsGoods.Type.Id })">
            <i class="ace-icon fa fa-arrow-left"></i>
            返回
        </a>
    }
    else
    {
        <a type="button" class="btn btn-info btn-sm" href="@Url.Action("Index", "LogisticsGoodsTrade", new { statusId = Model.StatusId ?? 0 })">
            <i class="ace-icon fa fa-arrow-left"></i>
            返回
        </a>
    }

</div>


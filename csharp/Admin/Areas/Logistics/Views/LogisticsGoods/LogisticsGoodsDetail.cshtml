    function deleteLogisticsGoods() {
        var idList = [@(Model.LogisticsGoods.Id)];

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "LogisticsGoods")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } else {
                            $.msg.show(data.message);
                            window.location.href = "@Url.Action("Index", "LogisticsGoods", new { typeId = Model.LogisticsGoods.Type.Id })";
                            return;
                        }
                    }
                });
            }
        );

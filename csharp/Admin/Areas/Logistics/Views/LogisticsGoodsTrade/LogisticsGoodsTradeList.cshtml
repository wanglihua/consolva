@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsGoodsTrade.LogisticsGoodsTradeListModel

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadLogisticsGoodsList"})

<table id="tblLogisticsGoodsList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="logisticsGoodsCheckAll"></label><input id="logisticsGoodsCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">ID</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.Cate))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">类别</a>
                </div>
            </th>
            <th style="width: 150px;">
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.Name))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">扩展名</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">物品类型</a>
                </div>
            </th>
            <th style="width: 180px;">
                <div>
                    <a field="@($"{nameof(LogisticsGoodsInfo.HsGoods)}.{nameof(HsGoodsInfo.CnHsCode)}")" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">中国海关编码</a>
                </div>
                <div>
                    <a field="@($"{nameof(LogisticsGoodsInfo.HsGoods)}.{nameof(HsGoodsInfo.CnHsName)}")" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">中国海关申报名</a>
                </div>
                <div>
                    <a field="@($"{nameof(LogisticsGoodsInfo.HsGoods)}.{nameof(HsGoodsInfo.EnHsCode)}")" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">英文海关编码</a>
                </div>
                <div>
                    <a field="@($"{nameof(LogisticsGoodsInfo.HsGoods)}.{nameof(HsGoodsInfo.EnHsName)}")" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">英文海关申报名</a>
                </div>
            </th>
            <th style="width: 150px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.BrandName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">品牌名</a>
                </div>
            </th>
            <th style="width: 80px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">状态</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.CreateExpressTrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">创建单号</a>
                </div>
            </th>
            <th style="width: 130px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.AddUser))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">添加人员</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">添加时间</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.UpdateUser))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">修改人员</a>
                </div>                
                <div>
                    <a field="@(nameof(LogisticsGoodsInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGoodsList">修改时间</a>
                </div>
            </th>
            <th style="width: 80px; text-align: center;">
                操作
            </th>
            <th style="max-width: 200px">创建单号图片</th>
            <th style="max-width: 200px">订单1图片</th>
            <th style="max-width: 200px">订单2图片</th>
            <th style="max-width: 200px">订单3图片</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.LogisticsGoodsList != null && Model.LogisticsGoodsList.Count() != 0)
        {
            int order = 1;
            foreach (LogisticsGoodsInfo logisticsGoods in Model.LogisticsGoodsList)
            {
                <tr ondblclick="showLogisticsGoodsDetail(@(logisticsGoods.Id));">
                    <td style="text-align: center;">
                        <label for="logisticsGoodsCheck_@(logisticsGoods.Id)"></label><input id="logisticsGoodsCheck_@(logisticsGoods.Id)" type="checkbox" class="ace" value="@logisticsGoods.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">
                        <div>
                            @(logisticsGoods.Id)
                        </div>
                        <div>
                            @(logisticsGoods.Cate?.Name)
                        </div>
                    </td>
                    <td>
                        <div style="color: blue;">
                            @logisticsGoods.Name
                        </div>
                        <div>
                            @logisticsGoods.Type.Name
                        </div>
                    </td>
                    <td>
                        <div>
                            @ListDataUtil.RenderStringWithDiv(logisticsGoods.HsGoods?.CnHsCode)
                        </div>
                        <div>
                            @ListDataUtil.RenderStringWithDiv(logisticsGoods.HsGoods?.CnHsName)
                        </div>
                        <div style="color: blue;">
                            @ListDataUtil.RenderStringWithDiv(logisticsGoods.HsGoods?.EnHsCode)
                        </div>
                        <div style="color: blue;">
                            @ListDataUtil.RenderStringWithDiv(logisticsGoods.HsGoods?.EnHsName)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            <span>（@logisticsGoods.BrandName）</span>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div style="color: blue;">
                            @logisticsGoods.Status.Name
                        </div>
                        <div>
                            @ListDataUtil.Render(logisticsGoods.CreateExpressTrackingNo)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            <span>
                                @(logisticsGoods.AddUser.UserName)<span>(@(logisticsGoods.AddUser.LoginName))</span>
                            </span>
                        </div>
                        <div style="color: blue;">
                            @(logisticsGoods.CreateTime.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                        <div>    
                            <span>
                                @(logisticsGoods.UpdateUser.UserName)<span>(@(logisticsGoods.UpdateUser.LoginName))</span>
                            </span>
                        </div>
                        <div style="color: blue;">
                            @(logisticsGoods.UpdateTime.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </td>
                    <td style="text-align: center;">
                        @if (logisticsGoods.Status == LogisticsGoodsStatus.NotConfirmed)
                        {
                            <a class="btn btn-mini btn-primary" onclick="showLogisticsGoodsDetail(@(logisticsGoods.Id));">确认</a>
                        }

                        @if (logisticsGoods.Status == LogisticsGoodsStatus.Confirmed)
                        {
                            <a class="btn btn-mini btn-primary" onclick="showLogisticsGoodsDetail(@(logisticsGoods.Id));">修改</a>
                        }
                    </td>
                    <td class="break-word">
                        @if (logisticsGoods.CreateExpressPhotoListCache != null && logisticsGoods.CreateExpressPhotoListCache.Count != 0)
                        {
                            foreach (var expressPhoto in logisticsGoods.CreateExpressPhotoListCache)
                            {
                                <a href="@(expressPhoto.BigImageFullUrlCache)" target="_blank">
                                    <img src="@(expressPhoto.SmallImageFullUrlCache)" alt=""/>
                                </a>
                            }
                        }
                        else
                        {
                            <span>暂无</span>
                        }
                    </td>
                    <td class="break-word">
                        @if (logisticsGoods.FirstOrderExpressPhotoListCache != null && logisticsGoods.FirstOrderExpressPhotoListCache.Count != 0)
                        {
                            foreach (var expressPhoto in logisticsGoods.FirstOrderExpressPhotoListCache)
                            {
                                <a href="@(expressPhoto.BigImageFullUrlCache)" target="_blank">
                                    <img src="@(expressPhoto.SmallImageFullUrlCache)" alt=""/>
                                </a>
                            }
                        }
                        else
                        {
                            <span>暂无</span>
                        }
                    </td>
                    <td class="break-word">
                        @if (logisticsGoods.SecondOrderExpressPhotoListCache != null && logisticsGoods.SecondOrderExpressPhotoListCache.Count != 0)
                        {
                            foreach (var expressPhoto in logisticsGoods.SecondOrderExpressPhotoListCache)
                            {
                                <a href="@(expressPhoto.BigImageFullUrlCache)" target="_blank">
                                    <img src="@(expressPhoto.SmallImageFullUrlCache)" alt=""/>
                                </a>
                            }
                        }
                        else
                        {
                            <span>暂无</span>
                        }
                    </td>
                    <td class="break-word">
                        @if (logisticsGoods.ThirdOrderExpressPhotoListCache != null && logisticsGoods.ThirdOrderExpressPhotoListCache.Count != 0)
                        {
                            foreach (var expressPhoto in logisticsGoods.ThirdOrderExpressPhotoListCache)
                            {
                                <a href="@(expressPhoto.BigImageFullUrlCache)" target="_blank">
                                    <img src="@(expressPhoto.SmallImageFullUrlCache)" alt=""/>
                                </a>
                            }
                        }
                        else
                        {
                            <span>暂无</span>
                        }
                    </td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="14">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadLogisticsGoodsList"})
@{
    Layout = null;
}
@using shunda.Domain.Logistics
@using shunda.Domain.Storage
@model shunda.Admin.Areas.Logistics.Models.LogisticsMode.LogisticsModeListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsModeList" })

<table id="tblLogisticsModeList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="logisticsModeCheckAll"></label><input id="logisticsModeCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 250px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsModeInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsModeList">类型</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsModeInfo.Code))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsModeList">编码</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsModeInfo.Name))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsModeList">名称</a>
                </div>
            </th>

            <th style="width: 180px;">
                <a>通用费率</a>
            </th>

            <th style="width: 100px;">

                <div>
                    <a field="@($"{nameof(LogisticsModeInfo.Warehouse)}.{nameof(WarehouseInfo.Id)}")" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsModeList">收货仓库</a>
                </div>

            </th>


            <th style="width: 100px;">

                <div>
                    <a field="@(nameof(LogisticsModeInfo.PackLabelType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsModeList">打印标签</a>
                </div>

            </th>


            <th style="width: 90px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsModeInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsModeList">状态</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsModeInfo.InnerStatus))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsModeList">内部状态</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <span>操作</span>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.LogisticsModeList != null && Model.LogisticsModeList.Count() != 0)
        {
            int order = 1;
            foreach (LogisticsModeInfo logisticsMode in Model.LogisticsModeList)
            {
                <tr ondblclick="showLogisticsModeDetail(@(logisticsMode.Id));">
                    <td style="text-align: center;">
                        <label for="logisticsModeCheck_@(logisticsMode.Id)"></label><input id="logisticsModeCheck_@(logisticsMode.Id)" type="checkbox" class="ace" value="@logisticsMode.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @logisticsMode.Type.Name
                        </div>
                        <div style="color: blue;">
                            @logisticsMode.Code
                        </div>
                        <div>
                            <span style="color: red;">@(logisticsMode.Name)</span>
                        </div>
                    </td>

                    <td>

                        <div>
                            <span>普通类：</span><span>@logisticsMode.CommonFeeRate?.Name</span>
                        </div>

                        <div>
                            <span>特货类：</span><span>@logisticsMode.SpecialFeeRate?.Name</span>
                        </div>

                    </td>

                    <td>
                        <div>
                            <span>@logisticsMode.Warehouse?.Name</span>
                        </div>
                    </td>


                    <td>
                        <div style="color: blue;">
                            @if (logisticsMode.PackLabelType == null || logisticsMode.PackLabelType == LogisticsPackLabelType.None)
                            {
                                <span>此处不考虑打包标签</span>
                            }
                            else
                            {
                                <span>@(logisticsMode.PackLabelType?.Name)</span>
                            }
                        </div>

                    </td>


                    <td style="text-align: center;">
                        <div style="color: blue;">
                            @(logisticsMode.Status?.Name)
                        </div>
                        <div>
                            @(logisticsMode.InnerStatus?.Name)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div style="margin-bottom: 5px;">
                            <a class="btn btn-xs btn-info" href="@Url.Action("Detail", "LogisticsMode", new { id = logisticsMode.Id })" style="width: 90px;">
                                <i class="ace-icon fa fa-pencil bigger-120"></i>&nbsp;修&nbsp;改&nbsp;
                            </a>
                        </div>

                        <div>
                            <a class="btn btn-xs btn-info" href="@Url.Action("Index", "LogisticsModeFeeRate", new { logisticsModeId = logisticsMode.Id })" style="width: 80px;">
                                <i class="ace-icon fa fa-pencil bigger-120"></i>费率设置
                            </a>
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsModeList" })
@using shunda.Domain
@model shunda.Admin.Areas.Logistics.Models.LogisticsModeFeeRate.LogisticsModeFeeRateDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="logisticsModeFeeRateDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">物流方式通用费率详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="logisticsModeFeeRateDetailForm" class="form-horizontal" role="form">
                    <input asp-for="LogisticsModeFeeRateId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ModeId" class="col-xs-2 control-label">物流方式</label>
                                <div class="col-xs-10">
                                    <input asp-for="ModeId" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="GoodsType" class="col-xs-2 control-label">物品类型</label>
                                <div class="col-xs-10">
                                    <select asp-for="GoodsType" required="required" digits="true" class="input-sm form-control">
                                        <option value=""></option>
                                        @foreach(LogisticsGoodsType type in Model.GoodsTypeList) {
                                            <option value="@(type.Id)">@(type.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="FeeRateId" class="col-xs-2 control-label">通用费率</label>
                                <div class="col-xs-10">
                                    <input asp-for="FeeRateId" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveLogisticsModeFeeRate();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
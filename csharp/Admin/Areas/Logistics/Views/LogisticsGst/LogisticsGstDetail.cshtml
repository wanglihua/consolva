@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsGst.LogisticsGstDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="logisticsGstDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">GST详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="logisticsGstDetailForm" class="form-horizontal" role="form">
                    <input asp-for="LogisticsGst.Id" type="hidden"/>
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsGst.Name" class="col-xs-2 control-label">名称</label>
                                <div class="col-xs-10">
                                    <textarea asp-for="LogisticsGst.Name" rows="3" class="input-sm form-control"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsGst.CalcBaseType" class="col-xs-2 control-label">计算基数</label>
                                <div class="col-xs-10">
                                    <select asp-for="LogisticsGst.CalcBaseType" class="input-sm form-control">
                                        @foreach (var baseType in Model.FeeCalcBaseTypeList)
                                        {
                                            <option value="@baseType.Id">@baseType.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsGst.StartAmount" class="col-xs-2 control-label">启征金额</label>
                                <div class="col-xs-10">
                                    <div class="input-group">
                                        <input asp-for="LogisticsGst.StartAmount" type="text" class="input-sm form-control" />
                                        <span class="input-group-addon">RMB</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsGst.FeeRate" class="col-xs-2 control-label">费率</label>
                                <div class="col-xs-10">
                                    <div class="input-group">
                                        <input asp-for="LogisticsGst.FeeRate" type="text" class="input-sm form-control" />
                                        <span class="input-group-addon">%</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsGst.OrderNum" class="col-xs-2 control-label">排序</label>
                                <div class="col-xs-10">
                                    <input asp-for="LogisticsGst.OrderNum" type="text" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsGst.Status" class="col-xs-2 control-label">状态</label>
                                <div class="col-xs-10">
                                    <select asp-for="LogisticsGst.Status" class="input-sm form-control">
                                        @foreach (LogisticsGstStatus logisticsGstStatus in Model.GstStatusList)
                                        {
                                            <option value="@logisticsGstStatus.Id">@logisticsGstStatus.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveLogisticsGst();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
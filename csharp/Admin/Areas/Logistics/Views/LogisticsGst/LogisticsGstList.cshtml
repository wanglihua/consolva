@{
    Layout = null;
}
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsGst.LogisticsGstListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsGstList" })

<table id="tblLogisticsGstList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="logisticsGstCheckAll"></label><input id="logisticsGstCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 350px;">
                <a field="@(nameof(LogisticsGstInfo.Name))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGstList">名称</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(LogisticsGstInfo.CalcBaseType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGstList">计算基数</a>
            </th>
            <th style="width: 100px; text-align: right;">
                <a field="@(nameof(LogisticsGstInfo.StartAmount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGstList">启征金额</a>
            </th>
            <th style="width: 80px; text-align: right;">
                <a field="@(nameof(LogisticsGstInfo.FeeRate))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGstList">费率</a>
            </th>
            <th style="width: 80px; text-align: center;">
                <a field="@(nameof(LogisticsGstInfo.OrderNum))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGstList">排序</a>
            </th>
            <th style="width: 80px; text-align: center;">
                <a field="@(nameof(LogisticsGstInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGstList">状态</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(LogisticsGstInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGstList">创建时间</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(LogisticsGstInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsGstList">修改时间</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.GstList != null && Model.GstList.Count() != 0)
        {
            var order = 1;
            foreach (var logisticsGst in Model.GstList)
            {
                <tr ondblclick="showLogisticsGstDetail(@(logisticsGst.Id));">
                    <td style="text-align: center;">
                        <label for="logisticsGstCheck_@(logisticsGst.Id)"></label><input id="logisticsGstCheck_@(logisticsGst.Id)" type="checkbox" class="ace" value="@logisticsGst.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td class="break-word">@logisticsGst.Name</td>
                    <td style="text-align: center;">@logisticsGst.CalcBaseType.Name</td>
                    <td style="text-align: right;">
                        @logisticsGst.StartAmount<span>&nbsp;</span><span>RMB</span>
                    </td>
                    <td style="text-align: right;">
                        @logisticsGst.FeeRate.ToString("#0.00")<span>&nbsp;</span><span>%</span>
                    </td>
                    <td style="text-align: center;">@logisticsGst.OrderNum</td>
                    <td style="text-align: center;">@logisticsGst.Status.Name</td>
                    <td style="text-align: center;">@logisticsGst.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="text-align: center;">@logisticsGst.UpdateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="11">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsGstList" })
@using shunda.Admin.Areas.Logistics.Models.LogisticsFeeRate
@using shunda.Domain.Logistics
@using shunda.Core
@using shunda.Core.Web
@model shunda.Admin.Areas.Logistics.Models.LogisticsFeeRate.LogisticsFeeRateIndexModel
@{
    ViewData[ViewDataKey.Title] = "通用费率";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-menu">物流设置</li>
    <li class="active" data-menu="logistics-logistics-fee-rate-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadLogisticsFeeRateList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showLogisticsFeeRateDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteLogisticsFeeRate()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="nameQuery">名称</label>&nbsp;<input id="nameQuery" name="nameQuery" style="width: 150px; height: 30px;" placeholder="名称查询"/>&nbsp;
    <label for="statusQuery">状态</label>&nbsp;
    <select id="statusQuery" name="statusQuery" style="width: 100px; height: 30px;" onchange="loadLogisticsFeeRateList()">
        <option value="0">状态查询</option>
        @foreach (LogisticsFeeRateStatus status in Model.StatusList)
        {
            <option value="@status.Id">@status.Name</option>
        }
    </select>&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadLogisticsFeeRateList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="logisticsFeeRateList" data-page-index="0" data-sort-field="@(nameof(LogisticsFeeRateInfo.Id))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="logisticsFeeRateDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadLogisticsFeeRateList();
    });

    function sortLogisticsFeeRateList(sortField, sortDir) {
        var list = $('#logisticsFeeRateList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadLogisticsFeeRateList();
    }

    function loadLogisticsFeeRateList(pageIndex) {
        var list = $('#logisticsFeeRateList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "LogisticsFeeRate")",
            type: "POST",
            data: {
                '@(nameof(LogisticsFeeRateListQueryParam.NameQuery))': $('#nameQuery').val(),
                '@(nameof(LogisticsFeeRateListQueryParam.StatusQuery))': $('#statusQuery').val(),
                '@(nameof(LogisticsFeeRateListQueryParam.PageIndex))': pageIndex,
                '@(nameof(LogisticsFeeRateListQueryParam.SortField))': sortField,
                '@(nameof(LogisticsFeeRateListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsFeeRateList').html(data);

                initListTable("#tblLogisticsFeeRateList");
            }
        });
    }

    function showLogisticsFeeRateDetail(id) {
        @*
        $("#logisticsFeeRateDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#logisticsFeeRateDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "LogisticsFeeRate")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#logisticsFeeRateDetailDialogWrapper").html(data);
                $("#logisticsFeeRateDetailDialog").modal(modalOptions);
            }
        });
        *@

        var url = "@Url.Action("Detail", "LogisticsFeeRate", new {id = 88888})";
        url = url.replace("88888", id);
        window.location.href = url;
    }

    function deleteLogisticsFeeRate() {
        var idList = getSelectIdList('#tblLogisticsFeeRateList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "LogisticsFeeRate")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } else {
                            $.msg.show(data.message);
                        }

                        loadLogisticsFeeRateList();
                    }
                });
            }
        );
    }

</script>
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Order
@model shunda.Admin.Areas.OrderFee.Models.ManualFeeReason.ManualFeeReasonDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="manualFeeReasonDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">增减核销费用原因详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="manualFeeReasonDetailForm" class="form-horizontal" role="form">
                    <input asp-for="ManualFeeReason.Id" type="hidden"/>
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ManualFeeReason.FeeType" class="col-xs-2 control-label">费用类型</label>
                                <div class="col-xs-10">
                                    <select asp-for="ManualFeeReason.FeeType" class="input-sm form-control">
                                        @foreach (ManualFeeType feeType in Model.FeeTypeList)
                                        {
                                            <option value="@(feeType.Id)">@(feeType.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ManualFeeReason.Content" class="col-xs-2 control-label">内容</label>
                                <div class="col-xs-10">
                                    <textarea asp-for="ManualFeeReason.Content" rows="3" class="input-sm form-control"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ManualFeeReason.Status" class="col-xs-2 control-label">状态</label>
                                <div class="col-xs-10">
                                    <select asp-for="ManualFeeReason.Status" class="input-sm form-control">
                                        @foreach (ManualFeeReasonStatus status in Model.StatusList)
                                        {
                                            <option value="@(status.Id)">@(status.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveManualFeeReason();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
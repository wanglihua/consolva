@{
    Layout = null;
}
@using shunda.Domain.Customer
@model shunda.Admin.Areas.OrderFee.Models.CustomerCharge.CustomerChargeListModel

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadCustomerChargeList"})

<table id="tblCustomerChargeList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="customerChargeCheckAll"></label><input id="customerChargeCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>           
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(CustomerChargeInfo.ChargeType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerChargeList">充值方式</a>
            </th>
            <th style="width: 80px; text-align: center;">
                <a field="@(nameof(CustomerChargeInfo.Customer))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerChargeList">客户ID</a>
            </th>
            <th style="width: 120px; text-align: right;">
                <a field="@(nameof(CustomerChargeInfo.Amount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerChargeList">充值金额</a>
            </th>
            <th style="width: 120px; text-align: right;">
                <a field="@(nameof(CustomerChargeInfo.Award))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerChargeList">赠送金额</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(CustomerChargeInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerChargeList">充值状态</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(CustomerChargeInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerChargeList">充值时间</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(CustomerChargeInfo.User))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerChargeList">操作用户</a>
            </th>            
            <th style="width: 200px;">
                <a field="@(nameof(CustomerChargeInfo.ManualChargeReason))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerChargeList">充值原因</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CustomerChargeList != null && Model.CustomerChargeList.Count() != 0)
        {
            int order = 1;
            foreach (CustomerChargeInfo customerCharge in Model.CustomerChargeList)
            {
                <tr>
                    <td style="text-align: center;">
                        <label for="customerChargeCheck_@(customerCharge.Id)"></label><input id="customerChargeCheck_@(customerCharge.Id)" type="checkbox" class="ace" value="@customerCharge.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">@customerCharge.ChargeType?.Name</td>
                    <td style="text-align: center;">@customerCharge.Customer.Id</td>
                    <td style="text-align: right;">
                        @customerCharge.Amount.ToString("0.00")<span>&nbsp;</span><span>RMB</span>
                    </td>
                    <td style="text-align: right;">
                        @customerCharge.Award.ToString("0.00")<span>&nbsp;</span><span>RMB</span>
                    </td>
                    <td style="text-align: center;">@customerCharge.Status?.Name</td>
                    <td style="text-align: center;">@customerCharge.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="text-align: center;">@customerCharge.User?.LoginName</td>                    
                    <td>@customerCharge.ManualChargeReason</td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="11">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadCustomerChargeList"})
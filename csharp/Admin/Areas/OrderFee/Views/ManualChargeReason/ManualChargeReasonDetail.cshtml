@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Customer
@model shunda.Admin.Areas.OrderFee.Models.ManualChargeReason.ManualChargeReasonDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="manualChargeReasonDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">手动充值原因详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="manualChargeReasonDetailForm" class="form-horizontal" role="form">
                    <input asp-for="ManualChargeReason.Id" type="hidden"/>
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ManualChargeReason.Content" class="col-xs-2 control-label">内容</label>
                                <div class="col-xs-10">
                                    <input asp-for="ManualChargeReason.Content" type="text" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ManualChargeReason.Status" class="col-xs-2 control-label">状态</label>
                                <div class="col-xs-10">
                                    <select asp-for="ManualChargeReason.Status" type="text" class="input-sm form-control">
                                        @foreach (ManualChargeReasonStatus status in Model.ReasonStatusList)
                                        {
                                            <option value="@(status.Id)">@(status.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveManualChargeReason();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>

@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Pass.PassRes
@model shunda.Admin.Models.Sidebar.SidebarModel
@{
    Layout = null;
}
@if (Model.HasOneOfPassRes(PassRes.LogisticsTrack.All)) {
    <li id="logistics-order-menu">
        <a href="#" class="dropdown-toggle">
            <i class="menu-icon fa fa-copy"></i>
            <span class="menu-text">物流跟踪</span>
            <b class="arrow fa fa-angle-down"></b>
        </a>
        <b class="arrow"></b>
        <ul class="submenu">

            @if (Model.HasPassRes(PassRes.LogisticsTrack.SeventeenTrackCarrier)) {
                <li id="logistics-order-seventeen-track-carrier-menu">
                    <a asp-area="LogisticsOrder" asp-controller="SeventeenTrackCarrier" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        17track运输商
                    </a>
                    <b class="arrow"></b>
                </li>
            }
        </ul>
    </li>
}
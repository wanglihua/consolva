@using Microsoft.AspNetCore.Mvc.TagHelpers
@model shunda.Admin.Models.Sidebar.SidebarModel
@{
    Layout = null;
}

@{
    var sidebarMinClassStr = "";
    if (Model.IsSidebarMin) {
        sidebarMinClassStr = " menu-min ";
    }
}
<div id="sidebar" class="sidebar responsive @(sidebarMinClassStr)">
    <ul class="nav nav-list">
        <partial name="Components/Sidebar/SidebarLogisticsOrder" model="Model"/>
        <partial name="Components/Sidebar/SidebarExpress" model="Model"/>
        <partial name="Components/Sidebar/SidebarReceivePack" model="Model"/>
        <partial name="Components/Sidebar/SidebarFee" model="Model"/>
        <partial name="Components/Sidebar/SidebarCustomer" model="Model"/>
        <partial name="Components/Sidebar/SidebarStorage" model="Model"/>
        <partial name="Components/Sidebar/SidebarLogistics" model="Model"/>
        <partial name="Components/Sidebar/SidebarGoods" model="Model"/>
        <partial name="Components/Sidebar/SidebarMessage" model="Model"/>
        <partial name="Components/Sidebar/SidebarPass" model="Model"/>
        <partial name="Components/Sidebar/SidebarSetting" model="Model"/>
    </ul>

    <div id="sidebar-collapse" class="sidebar-toggle sidebar-collapse" onclick="toggleSidebar()">
        @if (Model.IsSidebarMin) {
            <i class="ace-icon fa fa-angle-double-right" data-icon1="ace-icon fa fa-angle-double-left" data-icon2="ace-icon fa fa-angle-double-right"></i>
        } else {
            <i class="ace-icon fa fa-angle-double-left" data-icon1="ace-icon fa fa-angle-double-left" data-icon2="ace-icon fa fa-angle-double-right"></i>
        }
    </div>

    @*
        <script type="text/javascript">
            try {
                ace.settings.check('sidebar', 'collapsed');
            } catch (e) {
            }
        </script>
    *@

    <script type="text/javascript">
        function toggleSidebar() {
            @*这是点击之前的状态*@
            var isMenuMin = $("#sidebar").hasClass("menu-min");

            $.ajax({
                    url: '@Url.Action("SetSidebarState", "Home")',
                    type: "POST",
                    data: {
                        isMin: !isMenuMin 
                    },
                    success: function(data) {
                    }
                }
            );
        }
    </script>

</div>
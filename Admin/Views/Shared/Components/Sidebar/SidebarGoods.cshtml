@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Logistics
@using shunda.Domain.Pass.PassRes
@model shunda.Admin.Models.Sidebar.SidebarModel
@{
    Layout = null;
}
@if (Model.HasOneOfPassRes(PassRes.Goods.All))
{
    <li id="goods-menu">
        <a href="#" class="dropdown-toggle">
            <i class="menu-icon fa fa-barcode"></i>
            <span class="menu-text">物品管理</span>
            <b class="arrow fa fa-angle-down"></b>
        </a>
        <b class="arrow"></b>
        <ul class="submenu">
        
            @if (Model.HasPassRes(PassRes.Goods.GoodsTrade) || Model.HasPassRes(PassRes.Goods.GoodsListByType))
            {
                <li id="goods-logistics-goods-type-setting-menu">
                    <a asp-area="Logistics" asp-controller="LogisticsGoodsTypeSetting" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>物品类型设置
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Goods.GoodsWarehouse))
            {
                <li id="goods-logistics-goods-warehouse-search-menu">
                    <a asp-area="Logistics" asp-controller="LogisticsGoodsWarehouse" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        扩展名添加
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Goods.GoodsTrade))
            {
                <li id="goods-logistics-goods-trade-search-menu">
                    <a asp-area="Logistics" asp-controller="LogisticsGoodsTrade" asp-action="Index" asp-route-statusId="@(LogisticsGoodsStatus.NotConfirmed.Id)">
                        <i class="menu-icon fa fa-caret-right"></i>
                        扩展名确认
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Goods.GoodsListByType))
            {
                foreach (LogisticsGoodsType goodsType in Model.LogisticsGoodsTypeList)
                {
                    <li id="goods-logistics-goods@(goodsType.Id)-index-menu">
                        <a asp-area="Logistics" asp-controller="LogisticsGoods" asp-action="Index" asp-route-typeId="@(goodsType.Id)">
                            <i class="menu-icon fa fa-caret-right"></i>
                            @(goodsType.Name)清单
                        </a>
                        <b class="arrow"></b>
                    </li>
                }
            }

            @if (Model.HasPassRes(PassRes.Goods.HsGoods))
            {
                <li id="goods-hs-goods-index-menu">
                    <a asp-area="Logistics" asp-controller="HsGoods" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        海关物品名
                    </a>
                    <b class="arrow"></b>
                </li>
            }

        </ul>
    </li>
}
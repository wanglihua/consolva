@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Pass.PassRes
@model shunda.Admin.Models.Sidebar.SidebarModel
@{
    Layout = null;
}
@if (Model.HasOneOfPassRes(PassRes.CustomerMessage.All)) {
    <li id="message-menu">
        <a href="#" class="dropdown-toggle">
            <i class="menu-icon fa fa-envelope"></i>
            <span class="menu-text">消息推送</span>
            <b class="arrow fa fa-angle-down"></b>
        </a>
        <b class="arrow"></b>
        <ul class="submenu">

            @if (Model.HasPassRes(PassRes.CustomerMessage.ManualSend)) {
                <li id="message-manual-send-index-menu">
                    <a asp-area="Message" asp-controller="CustomerMessageManualSend" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        手动推送
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.CustomerMessage.MessageSetting)) {
                <li id="message-customer-message-cycle-timing-send-setting-index-menu">
                    <a asp-area="Message" asp-controller="CustomerMessageCycleTimingSendSetting" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        定时任务推送
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.CustomerMessage.MessageSetting)) {
                <li id="message-customer-message-real-time-send-setting-index-menu">
                    <a asp-area="Message" asp-controller="CustomerMessageRealTimeSendSetting" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        实时任务提醒
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.CustomerMessage.ManualSendAll)) {
                <li id="message-manual-send-all-menu">
                    <a asp-area="Message" asp-controller="CustomerMessageManualSend" asp-action="SendAll">
                        <i class="menu-icon fa fa-caret-right"></i>
                        全员推送
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.CustomerMessage.MessageView)) {
                <li id="message-customer-message-index-menu">
                    <a asp-area="Message" asp-controller="CustomerMessage" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        客户消息列表
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.CustomerMessage.MessageView)) {
                <li id="message-sms-send-record-index-menu">
                    <a asp-area="Message" asp-controller="SmsSendRecord" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        短信发送记录
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @*
            这个不用了
            @if (Model.HasPassRes(PassRes.CustomerMessage.MessageSetting))
            {
                <li id="message-customer-message-client-url-menu">
                    <a asp-area="Message" asp-controller="CustomerMessageClientUrl" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>客户消息链接
                    </a>
                    <b class="arrow"></b>
                </li>
            }
            *@

        </ul>
    </li>
}
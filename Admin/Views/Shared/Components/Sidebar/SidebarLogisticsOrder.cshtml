@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Pass.PassRes
@model shunda.Admin.Models.Sidebar.SidebarModel
@{
    Layout = null;
}
@if (Model.HasOneOfPassRes(PassRes.LogisticsOrder.All)) {
    <li id="logistics-order-menu">
        <a href="#" class="dropdown-toggle">
            <i class="menu-icon fa fa-copy"></i>
            <span class="menu-text">物流订单</span>
            <b class="arrow fa fa-angle-down"></b>
        </a>
        <b class="arrow"></b>
        <ul class="submenu">

            @if (Model.HasPassRes(PassRes.LogisticsOrder.OrderListActive)) {
                <li id="logistics-order-order-list-active-menu">
                    <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderList" asp-action="IndexActive">
                        <i class="menu-icon fa fa-caret-right"></i>
                        活动订单
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.LogisticsOrder.OrderListComplete)) {
                <li id="logistics-order-order-list-complete-menu">
                    <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderList" asp-action="IndexComplete">
                        <i class="menu-icon fa fa-caret-right"></i>
                        正常结束订单
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.LogisticsOrder.OrderListCancel)) {
                <li id="logistics-order-order-list-cancel-menu">
                    <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderList" asp-action="IndexCancel">
                        <i class="menu-icon fa fa-caret-right"></i>
                        作废订单
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.LogisticsOrder.OrderPackBox)) {
                <li id="logistics-order-order-pack-box-index-menu">
                    <a href="#">
                        <i class="menu-icon fa fa-caret-right"></i>
                        箱号跟踪
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.LogisticsOrder.OrderAirExpress)) {
                <li id="logistics-order-air-order-index-menu">
                    <a href="#">
                        <i class="menu-icon fa fa-caret-right"></i>
                        国际单号
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.LogisticsOrder.CustomerOrderCount)) {
                <li id="logistics-order-customer-order-count-index-menu">
                    <a href="#">
                        <i class="menu-icon fa fa-caret-right"></i>
                        会员订单统计
                    </a>
                    <b class="arrow"></b>
                </li>
            }
        </ul>
    </li>
}
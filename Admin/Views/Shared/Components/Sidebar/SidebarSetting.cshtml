@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Pass.PassRes
@model shunda.Admin.Models.Sidebar.SidebarModel
@{
    Layout = null;
}
@if (Model.HasOneOfPassRes(PassRes.Setting.All)) {
    <li id="settings-menu">
        <a href="#" class="dropdown-toggle">
            <i class="menu-icon fa fa-gears"></i>
            <span class="menu-text">系统设置</span>
            <b class="arrow fa fa-angle-down"></b>
        </a>
        <b class="arrow"></b>
        <ul class="submenu">

            @if (Model.HasPassRes(PassRes.Setting.ClientNotice)) {
                <li id="settings-client-notice-menu">
                    <a asp-area="Setting" asp-controller="ClientNotice" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        客户端公告
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Setting.AdvertBanner)) {
                <li id="settings-advert-banner-menu">
                    <a asp-area="Setting" asp-controller="AdvertBanner" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>广告横幅
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Setting.ExchangeRate)) {
                <li id="settings-exchange-rate-index-menu">
                    <a asp-area="Setting" asp-controller="ExchangeRate" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        汇率
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Setting.ClientAgreement)) {
                <li id="settings-client-agreement-index-menu">
                    <a asp-area="Setting" asp-controller="ClientAgreement" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        客户端下单协议
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Setting.ClientInstruction)) {
                <li id="settings-client-instruction-index-menu">
                    <a asp-area="Setting" asp-controller="ClientInstruction" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        客户端文本菜单
                    </a>
                    <b class="arrow"></b>
                </li>
            }

            @if (Model.HasPassRes(PassRes.Setting.AutoMeasureMachine)) {
                <li id="settings-auto-measure-machine-index-menu">
                    <a asp-area="Setting" asp-controller="AutoMeasureMachine" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>
                        自动秤设备
                    </a>
                    <b class="arrow"></b>
                </li>
            }
        </ul>
    </li>
}
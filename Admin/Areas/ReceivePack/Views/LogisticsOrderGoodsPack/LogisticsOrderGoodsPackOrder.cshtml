@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderRemark
@using shunda.Admin.Areas.ReceivePack.Models.LogisticsOrderGoodsPack
@using shunda.Core.Web
@model shunda.Admin.Areas.ReceivePack.Models.LogisticsOrderGoodsPack.LogisticsOrderGoodsPackOrderModel

@{
    Layout = null;
}

<input id="orderId" type="hidden" value="@Model.Order.Id"/>

@if (Model.Order.Id <= 0) {
    <div style="margin: 10px 0;padding: 10px;border: 1px solid red; background-color: #F8A1A4;">
        <i class="fa fa-warning" style="color:red;"></i>
        没有待打包的后续订单，或指定的订单不存在！请刷新页面，重新尝试获取打包订单。
    </div>
} else {
    <style type="text/css">
        table#orderDetail {
            background-color: white;
        }

        table#orderDetail td {
            text-align: center;
            padding: 8px 0;
        }

        table#orderDetail td.lbl {
            background-color: #F2F2F2;
            text-align: center;
        }

        table#orderDetail td.break-word {
            white-space: normal;
            word-wrap: break-word;
            word-break: break-all;
        }

        table.express tr.checked {
            background-color: #DFF0D8;
        }

        div.search-success {
            margin: 10px 0;
            padding: 10px;
            border: 1px solid green;
            background-color: #C3D08B;
        }

        div.search-failed-but-in-order {
            margin: 10px 0;
            padding: 10px;
            border: 1px solid red;
            background-color: #FFE894;
        }

        div.search-failed {
            margin: 10px 0;
            padding: 10px;
            border: 1px solid red;
            background-color: #F8A1A4;
        }
        
        .nodisplay {
            display: none;
        }
    </style>
    <div style="width: 980px;">
        <div style="margin-top: 20px;">
            <div id="orderDetailWrapper" style="width: 980px; z-index: 1000">
                <table id="orderDetail" class="data-list-table table table-bordered" style="box-shadow: 0 0 2px rgba(0,0,0,.14), 0 2px 4px rgba(0,0,0,.28);">
                    <tbody>
                        <tr>
                            <td style="width: 70px;" class="lbl">
                                订单编号
                            </td>
                            <td style="width: 150px;" class="break-word">
                                <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(Model.Order.Id)" target="_blank">@(Model.Order.Code)</a>
                            </td>
                            <td style="width: 70px;" class="lbl">
                                客户ID
                            </td>
                            <td style="width: 140px;">
                                <a asp-area="Customer" asp-controller="Customer" asp-action="Detail" asp-route-id="@(Model.Order.Customer.Id)" target="_blank">@(Model.Order.CustomerCode)</a>
                                @if (string.IsNullOrWhiteSpace(Model.Order.Customer.CustomerCharacter) == false) {
                                    <span>(@(Model.Order.Customer.CustomerCharacter))</span>
                                }
                            </td>
                            <td class="lbl" style="width: 70px;">
                                打包方式
                            </td>
                            <td style="width: 145px;" class="break-word">
                                @(Model.RepackTypeTitle)
                            </td>
                            <td style="width: 70px;" class="lbl">
                                头程物流
                            </td>
                            <td style="width: 259px; font-size: 10px;" class="break-word" colspan="3">
                                <span style="font-size: 10px;">@(Model.Order.FirstMode.Name)(@(Model.Order.FirstModeType.Name))</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="lbl">
                                <span style="color:red; font-weight: bold;">
                                    订单合计
                                </span>
                            </td>
                            <td class="break-word">
                                <span>共&nbsp;</span>
                                <span style="color:red; font-weight: bold;">
                                    @Model.OrderTotalExpressPackageCount
                                </span>
                                <span>&nbsp;个快递包裹</span>
                            </td>
                            <td class="lbl">
                                <span style="color:red; font-weight: bold;">
                                    普通类
                                </span>
                            </td>
                            <td>
                                <span>共&nbsp;</span>
                                <span style="color:red; font-weight: bold;">
                                    @(Model.GoodsTypeCommonExpressPackageCount)
                                </span>
                                <span>&nbsp;个快递包裹</span>
                            </td>
                            <td class="lbl">
                                <span style="color:red; font-weight: bold; width: 80px;">
                                    其他类型
                                </span>
                            </td>
                            <td>
                                <span>共&nbsp;</span>
                                <span style="color:red; font-weight: bold;">
                                    @(Model.OrderTotalExpressPackageCount - Model.GoodsTypeCommonExpressPackageCount)
                                </span>
                                <span>&nbsp;个快递包裹</span>
                            </td>

                            <td class="lbl">
                                打包排班
                            </td>
                            <td style="width: 130px;">
                                <span>@(Model.PackScheduleUserName)</span>
                            </td>
                            <td class="lbl" style="width: 70px;">
                                订单备注
                            </td>
                            <td>
                                <a href="javascript:document.getElementById('orderRemark').scrollIntoView(false);">
                                    @if (Model.RemarkTotalCount != 0) {
                                        <span>@(Model.RemarkTotalCount)&nbsp;个</span>
                                    } else {
                                        <span>暂无</span>
                                    }
                                </a>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>

        <div id="orderRemark">
            <div id="orderRemarkListWrapper">
                @(await Component.InvokeAsync("LogisticsOrderRemarkList", new { orderId = Model.Order.Id, showOrderRemarkAdd = false }))
            </div>
        </div>

        <div id="expressList">
            <script type="text/javascript">

                function loadOrderPackList(goodsTypeId)
                {
                    showMask("加载中...");

                    $.ajax({
                        url: '@Url.Action("OrderPackList", "LogisticsOrderGoodsPack")',
                        type: "POST",
                        data: {
                            "orderId": @(Model.Order.Id),
                            "goodsTypeId": goodsTypeId,
                            'repack': $("#repack"+goodsTypeId).val()
                        },
                        success: function(data) {
                            hideMask();

                            if (data.success === false) {
                                $.msg.error(data.message);
                                return;
                            } else {
                                $("#OrderPackListWrapper" + goodsTypeId).html(data);
                                return;
                            }
                        }
                    });
                }

            </script>
            @{
                var orderExpressListModel = new LogisticsOrderGoodsPackOrderExpressListModel() {
                    Debug = Model.Debug,
                    GoodsType = Model.Order.GoodsType,
                    GoodsTypeExpressList = Model.ExpressList,
                    GoodsTypePackCompleteDict = Model.GoodsTypePackCompleteDict,
                };

                <partial name="LogisticsOrderGoodsPackOrderExpressList" model="orderExpressListModel"/>
            }
        </div>

        <div style="text-align: right; padding: 5px 0;">

            @if (Model.IsOrderPackComplete == false) {
                <div>
                    <button class="btn btn-xs btn-purple" onclick="completeOrderPack();return false;" style="width: 130px;">
                        <i class="ace-icon fa fa fa-check-square-o"></i>&nbsp;完成订单打包
                    </button>
                </div>
            }

            <div style="margin-top: 10px;">
                <button class="btn btn-xs btn-primary" onclick="showLogisticsOrderRemarkDetail();" style="width: 130px;">添加备注</button>
            </div>
        </div>

    </div>

    <div style="height: 2800px; width: 100px;">@*保证不跳闪*@</div>
    @if (Model.IsAdmin || Model.TrackingNoManualInputEnabled) {
        <script type="text/javascript">
            var shouldCheckFirstKeyDownTime = false;
        </script>
    } else {
        <script type="text/javascript">
            var shouldCheckFirstKeyDownTime = true;
        </script>
    }

    <script type="text/javascript" src="/static/lodop/LodopFuncs.js?v=20191002"></script>
    <script type="text/javascript" src="@Url.Action("Index", "LodopScript")"></script>

    <script type="text/javascript">
        var trackingNoInputFirstKeyDownTime = null;
        
        function emptyFirstKeyDownTime() {
            trackingNoInputFirstKeyDownTime = null;
        }
        
        function setFirstKeyDownTime(event) {
            if($(event.target).val() === "" || trackingNoInputFirstKeyDownTime == null) {
                trackingNoInputFirstKeyDownTime = new Date().getTime();
            }
        }
        
    </script>

    <script type="text/javascript">                                           
        function checkFirstKeyDownTime() {
            @*
            console.log(trackingNoInputFirstKeyDownTime);
            console.log((new Date().getTime() - trackingNoInputFirstKeyDownTime));
            *@
            if(shouldCheckFirstKeyDownTime) {
                if(trackingNoInputFirstKeyDownTime !== null && (new Date().getTime() - trackingNoInputFirstKeyDownTime) > 3000) {
                    $.msg.error("请用扫描枪输入，不能使用键盘录入！");
                    return false;
                }
            }
            
            return true;
        }    
    </script>

    <script type="text/javascript">        
    
        $(function (){
            $("input.expressTrackingNo:first").focus();
        });
    </script>


    <script type="text/javascript">

        var scannedExpressTrackingNoList = [];

        $(function(){
             $('#orderDetailWrapper').stickUp();
        });

        function searchExpress(goodsTypeId)
        {
            if(checkFirstKeyDownTime() != true) {
                $("#goodsType" + goodsTypeId + " input.expressTrackingNo").val(""); @* 清空刚刚输入的 *@
                return;
            }

            showMask("加载中...");

            $.ajax({
                url: '@Url.Action("SearchExpress", "LogisticsOrderGoodsPack")',
                type: "POST",
                data: {
                    "orderId": @(Model.Order.Id),
                    "goodsTypeId": goodsTypeId,
                    "expressTrackingNo": $("#goodsType" + goodsTypeId + " input.expressTrackingNo").val()
                },
                success: function(data) {
                    hideMask();

                    hideAllSearchMessage();

                    if (data.success === false) {
                        if(data.expressInOrder === true) {
                            $("#goodsType" + goodsTypeId + " div.search-failed-but-in-order span.message-text").html(data.message);
                            $("#goodsType" + goodsTypeId + " div.search-failed-but-in-order").fadeIn();

                            return;
                        } else {
                            $("#goodsType" + goodsTypeId + " div.search-failed span.message-text").html(data.message);
                            $("#goodsType" + goodsTypeId + " div.search-failed").fadeIn();

                            return;
                        }
                    }

                    if (data.success === true) {
                        $("#goodsType" + goodsTypeId + " div.search-success span.message-text").html(data.message);
                        $("#goodsType" + goodsTypeId + " div.search-success").fadeIn();

                        $("tr#express" + data.expressId).addClass("checked");

                        var checkbox = $("input#express" + data.expressId + "checkbox");
                        if(checkbox.size() !== 0) {
                            checkbox[0].checked = true;
                            checkbox.removeAttr("disabled");
                        }

                        if(scannedExpressTrackingNoList[goodsTypeId] === undefined){
                            scannedExpressTrackingNoList[goodsTypeId] = [];
                        }

                        scannedExpressTrackingNoList[goodsTypeId].push(data.expressTrackingNo);

                        $('input.expressTrackingNo').val(''); // 自动清空前面扫描的单号，接下来可以自动继续扫
                        
                        return;
                    }                    
                }
            });
        }
        
        function expressCheckboxClick(tr, checkbox, goodsTypeId, expressTrackingNo) {
            var expressTrackingNoList = scannedExpressTrackingNoList[goodsTypeId];

            if(checkbox.checked === false) {
                var index = -1;
                for(var i = 0; i < expressTrackingNoList.length; i++) {
                    if(expressTrackingNoList[i] === expressTrackingNo) {
                        index = i;
                        break;
                    }
                }
                
                if(index >= 0) {
                    expressTrackingNoList.splice(index, 1);  
                    tr.removeClass("checked");
                    $(checkbox).attr("disabled", "disabled");
                }
            }
            @* 取消选中后，就不能再简单的点选选择了，一定要扫描或者录入快递单号搜索才行
            else {
                var has = false;
                for(var i = 0; i < expressTrackingNoList.length; i++) {
                    if(expressTrackingNoList[i] === expressTrackingNo) {
                        has = true;
                        break;
                    }
                }

                if(has === false) {
                    expressTrackingNoList.push(expressTrackingNo);
                }
            }
            *@
        }

        function hideAllSearchMessage()
        {
            $("div.search-success").hide();
            $("div.search-success span.message-text").html("");

            $("div.search-failed-but-in-order").hide();
            $("div.search-failed-but-in-order span.message-text").html("");

            $("div.search-failed").hide();
            $("div.search-failed span.message-text").html("");
        }

        function showSavePack(packBoxId, goodsTypeId)
        {
            $('#packBoxIdToSavePack').val(packBoxId);
            $('#goodsTypeIdToSavePack').val(goodsTypeId);

            $("#packConfirmDialog").modal(modalOptions);
        }

        function hideSavePack()
        {
            $('#packBoxIdToSavePack').val(0);
            $('#goodsTypeIdToSavePack').val(0);

            $("#packConfirmDialog").modal("hide");
        }

        var preSavePackSumitTime = new Date(); 

        function savePack(packBoxId, goodsTypeId)
        {
            if(new Date() - preSavePackSumitTime <= 3000) { @* 3 秒内不能重复提交，一般对话框重新打开才会第二次提交 *@
                return;
            }
            
            preSavePackSumitTime = new Date();
            
            hideSavePack();
                                    
            showMask("加载中...");

            $.ajax({
                url: '@Url.Action("SavePack", "LogisticsOrderGoodsPack")',
                type: "POST",
                data: {
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.PackId))": $("#" + packBoxId +" input.pack-id").val(),
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.OrderId))": @(Model.Order.Id),
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.GoodsType))": $("#" + packBoxId +" select.pack-goods-type").val(),
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.FirstModeId))": $("#" + packBoxId +" select.pack-first-mode").val(),
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.Length))": $("#" + packBoxId +" input.pack-length").val(),
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.Width))": $("#" + packBoxId +" input.pack-width").val(),
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.Height))": $("#" + packBoxId +" input.pack-height").val(),
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.Weight))": $("#" + packBoxId +" input.pack-weight").val(),
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.PackageCount))": $("#" + packBoxId +" input.pack-package-count").val(),
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.TrackingNoList))": scannedExpressTrackingNoList[goodsTypeId],
                    "@(nameof(LogisticsOrderGoodsPackSavePackParam.ExpressCanPackAgain))": $("#expressCanPackAgain").val()
                },
                success: function(data) {
                    if (data.success === false) {
                        $.msg.error(data.message);
                    } else {
                        if (data.hasPackWarning === true)
                        {
                            $.msg.alert(data.packWarningMessage);
                        }
                        else 
                        {
                            $.msg.show(data.message);
                        }

                        scannedExpressTrackingNoList[goodsTypeId] = []; @* 把当前物品类型的已扫描的记录清空 *@

                        $("#goodsType" + goodsTypeId + " input.scanCheckbox").each(function(index, element){
                            // console.log(element);
                            element.checked = false;
                        });

                        loadOrderPackList(goodsTypeId);

                        printPackLabel(data.orderPackId);
                    }

                    hideMask();
                }
            });
        }

        function removePack(packBoxId, goodsTypeId)
        {
            $.msg.confirm("确认要移除当前打包信息吗？",function(){
                showMask("加载中...");
                $.ajax({
                    url: '@Url.Action("RemovePack", "LogisticsOrderGoodsPack")',
                    type: "POST",
                    data: {
                        "@(nameof(LogisticsOrderGoodsPackRemovePackParam.PackId))": $("#" + packBoxId +" input.pack-id").val(),
                        "@(nameof(LogisticsOrderGoodsPackRemovePackParam.OrderId))": @(Model.Order.Id),
                        "@(nameof(LogisticsOrderGoodsPackRemovePackParam.TrackingNoList))": scannedExpressTrackingNoList[goodsTypeId]
                    },
                    success: function(data) {
                        hideMask();

                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } else {
                            $.msg.show(data.message);
                            loadOrderPackList(goodsTypeId);
                            return;
                        }
                    }
                });
            });
        }
        
        function printPdfContent(pdfUrl, printCount)
        {
            var LODOP = getLodopWithLicenses();
            LODOP.PRINT_INIT("TLA打印标签");

            LODOP.SET_PRINT_PAGESIZE(1, "100mm", "150mm", "TLA标签打印");

            LODOP.SET_PRINT_MODE("PRINT_NOCOLLATE",1)            
            LODOP.SET_PRINT_COPIES(printCount);            
            
            LODOP.NEWPAGE();
            LODOP.ADD_PRINT_PDF(0, 0, "100%", "100%", pdfUrl);

            @if (Model.Debug) {
                <text>
                    LODOP.PREVIEW();
                </text>
            } else {
                <text>
                    LODOP.PRINT();
                </text>
            }
        }

        function completeGoodsTypePack(goodsTypeId)
        {
            $.msg.confirm("确认要完成订单当前物品类型的打包吗？",function(){
                showMask("加载中...");
                $.ajax({
                    url: '@Url.Action("CompleteGoodsTypePack", "LogisticsOrderGoodsPack")',
                    type: "POST",
                    data: {
                        "@(nameof(LogisticsOrderGoodsPackCompleteGoodsTypePackParam.OrderId))": @(Model.Order.Id),
                        "@(nameof(LogisticsOrderGoodsPackCompleteGoodsTypePackParam.GoodsType))": goodsTypeId,
                        "@(nameof(LogisticsOrderGoodsPackCompleteGoodsTypePackParam.TrackingNoList))": scannedExpressTrackingNoList[goodsTypeId]
                    },
                    success: function(data) {
                        hideMask();

                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        if(data.orderPackComplete){
                            $.msg.show(data.message);
                            getPackOrder();
                            return;
                        }

                        scannedExpressTrackingNoList[goodsTypeId] = [];
                        loadOrderPackList(goodsTypeId);
                    }
                });
            });
        }
        
        function completeOrderPack()
        {
            $.msg.confirm("确认要完成当前订单打包吗？",function(){
                showMask("加载中...");
                $.ajax({
                    url: '@Url.Action("CompleteOrderPack", "LogisticsOrderGoodsPack")',
                    type: "POST",
                    data: {
                        "@(nameof(LogisticsOrderGoodsPackCompleteOrderPackParam.OrderId))": @(Model.Order.Id),
                    },
                    success: function(data) {
                        hideMask();

                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        } 

                        $.msg.show(data.message);
                        getPackOrder();
                    }
                });
            });
        }        

        function repack(goodsTypeId)
        {
            $.msg.confirm("确认要对订单当前物品类型重新打包吗？",function(){
                $("#repack"+goodsTypeId).val("@(true.ToString())");
                loadOrderPackList(goodsTypeId);
            });
        }

    </script>
}

<div id="logisticsOrderRemarkDetailDialogWrapper"></div>

<div id="packConfirmDialog" class="dialog modal fade in">
    <div class="modal-dialog" style="width:600px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True">×</button>
                <h4 class="modal-title">保存打包确认</h4>
            </div>
            <div class="modal-body">
                <div>
                    <div class="huaduConfirm">
                        <i class="fa fa-question-circle fa-5x orange2"></i><br><br>
                        是否确认保存当前打包信息？
                    </div>

                    <input id="packBoxIdToSavePack" type="hidden"/>
                    <input id="goodsTypeIdToSavePack" type="hidden"/>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="savePack($('#packBoxIdToSavePack').val(), $('#goodsTypeIdToSavePack').val())">
                    <i class="ace-icon fa fa-check"></i>确认保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>取消
                </button>
            </div>
        </div>
    </div>
</div>


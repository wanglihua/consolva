@model bool

@{
    Layout = null;
}

<script type="text/javascript">

    function printPackLabelCommonW5H5(data) {
        var LODOP = getLodopWithLicenses();
        LODOP.PRINT_INIT("打包标签打印W5H5");
        LODOP.SET_PRINT_PAGESIZE(1, "50mm", "50mm", "打包标签打印W5H5");

        LODOP.SET_PRINT_STYLE("FontName", "微软雅黑");
        LODOP.SET_PRINT_STYLE("Bold", 0);
        LODOP.SET_PRINT_STYLE("FontSize",12);
            
        for(var index = 0; index < data.orderPackBoxCodeList.length; index++) {

            for(var j = 0; j < data.printCount; j++) {
                LODOP.NEWPAGE();
                
                LODOP.ADD_PRINT_TEXT("2.00mm","5.00mm","50.00mm","7.30mm", data.targetWarehouseName);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",16);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
                
                LODOP.ADD_PRINT_TEXT("2.00mm","40.00mm","50.00mm","7.30mm", data.firstLogistics);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",16);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
        
                LODOP.ADD_PRINT_BARCODE("7mm","7mm","40.50mm","40.50mm","QRCode",data.orderPackBoxCodeList[index]);
                LODOP.SET_PRINT_STYLEA(0,"DataCharset","UTF-8");
                LODOP.SET_PRINT_STYLEA(0,"QRCodeErrorLevel","M");
                
                LODOP.ADD_PRINT_TEXT("43.00mm","5.00mm","50.00mm","7.30mm", data.secondLogisticsShortName);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",16);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
                
                LODOP.ADD_PRINT_TEXT("43.00mm","40.00mm","50.00mm","7.30mm", data.terminalShortName);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",16);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
            }
        }
        
        @if (Model)
        {
            <text>
            // LODOP.PRINT_DESIGN();
            // LODOP.PREVIEW();
            LODOP.PRINT();
            </text>
        }
        else
        {
            <text>
            LODOP.PRINT();
            </text>
        }
    }

</script>
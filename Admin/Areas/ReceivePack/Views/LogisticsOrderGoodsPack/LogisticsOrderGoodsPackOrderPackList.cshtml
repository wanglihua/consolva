@using shunda.Domain.LogisticsOrder
@model shunda.Admin.Areas.ReceivePack.Models.LogisticsOrderGoodsPack.LogisticsOrderGoodsPackOrderPackListModel

@{
    Layout = null;
}

<table id="orderPackList@(Model.GoodsType.Id)" class="data-list-table table table-bordered">
    <thead>
        <tr>
            <td style="width: 50px; text-align: center;">序号</td>
            <td style="width: 170px; text-align: center;">长-宽-高/cm</td>
            <td style="width: 80px; text-align: center;">重量/kg</td>
            <td style="width: 80px; text-align: center;">箱数</td>
            <td style="width: 80px; text-align: center;">物品类型</td>
            <td style="text-align: center;">物流方式</td>
            <td style="text-align: center;">操作</td>
        </tr>
    </thead>
    <tbody>

        @{
            int index = 1;
            foreach (LogisticsOrderPackInfo orderPack in Model.OrderPackList) {
                <tr id="packBox@(Model.GoodsType)@(orderPack.Id)">
                    <td style="text-align: center;">
                        <span>@(index++)</span>
                        <input class="pack-id" type="hidden" value="@(orderPack.Id)"/>
                    </td>
                    <td style="text-align: center;">
                        <input type="text" style="width: 50px; text-align: center;" value="@(orderPack.Length.ToString("#0.00"))" disabled="disabled"/>
                        <input type="text" style="width: 50px; text-align: center;" value="@(orderPack.Width.ToString("#0.00"))" disabled="disabled"/>
                        <input type="text" style="width: 50px; text-align: center;" value="@(orderPack.Height.ToString("#0.00"))" disabled="disabled"/>
                    </td>
                    <td style="text-align: center;">
                        <input type="text" style="width: 55px; text-align: center;" value="@(orderPack.Weight.ToString("#0.00"))" disabled="disabled"/>
                    </td>
                    <td style="text-align: center;">
                        <input type="text" style="width: 50px; text-align: center;" value="@(orderPack.PackageCount)" disabled="disabled"/>
                    </td>
                    <td>
                        <span>@(orderPack.OrderFirstMode.GoodsType.Name)</span>
                    </td>
                    <td>
                        <span>@(orderPack.OrderFirstMode.FirstMode.Name)</span>
                    </td>
                    <td style="text-align: center;">
                        @*
                        <button class="btn btn-xs btn-primary" onclick="savePack('packBox@(Model.GoodsType)@(orderPack.Id)', @(Model.GoodsType.Id));return false;">
                            <i class="ace-icon fa fa-floppy-o"></i>&nbsp;保存并打印标签
                        </button>
                        *@
                        @if (Model.Repack == true) {
                            <button type="button" class="btn btn-xs btn-danger" onclick="removePack('packBox@(Model.GoodsType)@(orderPack.Id)', @(Model.GoodsType.Id));return false;">
                                <i class="ace-icon fa fa-remove"></i>&nbsp;移除打包
                            </button>
                        } else {
                            <button type="button" class="btn btn-xs btn-info" onclick="printPackLabel(@(orderPack.Id))">
                                <i class="ace-icon fa fa-print"></i>&nbsp;补打标签
                            </button>
                        }
                    </td>
                </tr>
            }

            @if (Model.GoodsTypePackComplete == false || Model.Repack == true) {
                <tr id="packBox@(Model.GoodsType)New">
                    <td style="text-align: center;">
                        <span>@(index)</span>
                        <input class="pack-id" type="hidden" value="0"/>
                    </td>
                    <td style="text-align: center;">
                        <input class="pack-length" type="text" placeholder="长/cm" style="width: 50px; text-align: center;"/>
                        <input class="pack-width" type="text" placeholder="宽/cm" style="width: 50px; text-align: center;"/>
                        <input class="pack-height" type="text" placeholder="高/cm" style="width: 50px; text-align: center;"/>
                    </td>
                    <td style="text-align: center;">
                        <input class="pack-weight" type="text" placeholder="重量/kg" style="width: 55px; text-align: center;"/>
                    </td>
                    <td style="text-align: center;">
                        <input class="pack-package-count" type="text" placeholder="箱数" style="width: 50px; text-align: center;"/>
                    </td>
                    <td>
                        <select class="pack-goods-type">
                            @foreach (var goodsType in Model.GoodsTypeList) {
                                <option value="@(goodsType.Id)">@(goodsType.Name)</option>
                            }
                        </select>
                    </td>
                    <td>
                        <select class="pack-first-mode">
                            @foreach (var firstMode in Model.FirstModeList) {
                                <option value="@(firstMode.Id)">@(firstMode.Name)</option>
                            }
                        </select>
                    </td>
                    <td style="text-align: center; width: 120px;">
                        <button class="btn btn-xs btn-primary" onclick="showSavePack('packBox@(Model.GoodsType)New', @(Model.GoodsType.Id));return false;">
                            <i class="ace-icon fa fa-floppy-o"></i>&nbsp;保存并标签
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
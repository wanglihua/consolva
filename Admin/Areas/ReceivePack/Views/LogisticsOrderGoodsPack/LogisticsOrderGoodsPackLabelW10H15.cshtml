@model bool
@{
    Layout = null;
}

<script type="text/javascript">

    function printPackLabelCommonW10H15(data) {
        var LODOP = getLodopWithLicenses();
        LODOP.PRINT_INIT("打包标签打印W10H15");
        LODOP.SET_PRINT_PAGESIZE(1, "100mm", "152mm", "打包标签打印W10H15");

        LODOP.SET_PRINT_STYLE("FontName", "微软雅黑");
        LODOP.SET_PRINT_STYLE("Bold", 0);
        LODOP.SET_PRINT_STYLE("FontSize",12);        
        
        for(var index = 0; index < data.orderPackBoxCodeList.length; index++) {
            for(var j = 0; j < data.printCount; j++) {
                LODOP.NEWPAGE();
        
                LODOP.ADD_PRINT_RECT("7mm", "2mm", "96.0mm", "138mm", 0, 2);
                LODOP.ADD_PRINT_LINE("65mm", "2mm", "65mm", "98mm", 0, 2);
                LODOP.ADD_PRINT_LINE("138mm", "2mm", "138mm", "98mm", 0, 2);
        
                // LODOP.ADD_PRINT_TEXT("8.90mm","4.6mm","50.8mm","7.30mm", data.customerCode);
                LODOP.ADD_PRINT_TEXT("8.90mm","4.6mm","50.8mm","7.30mm", data.customerCodeList[index]);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",18);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
        
                // LODOP.ADD_PRINT_TEXT("9.50mm","43mm","58.47mm","7.30mm", data.orderCode);
                LODOP.ADD_PRINT_TEXT("9.50mm","43mm","58.47mm","7.30mm", data.orderCodeList[index]);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",12);
                
                // LODOP.ADD_PRINT_TEXT("15.00mm","48mm","58.47mm","7.30mm", "( " + data.orderId + " )");
                LODOP.ADD_PRINT_TEXT("15.00mm","48mm","58.47mm","7.30mm", "( " + data.orderIdList[index] + " )");
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",10);
                
                LODOP.ADD_PRINT_TEXT("8.90mm","87.00mm","50.8mm","7.30mm", data.packSplitCodeList[index]);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",18);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
        
                LODOP.ADD_PRINT_TEXT("20.00mm","4.6mm","100.00mm","7.30mm", data.firstLogisticsTypeName);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",18);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
        
                LODOP.ADD_PRINT_TEXT("29.00mm","4.6mm","100.00mm","7.30mm", data.targetWarehouseName);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",18);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
        
                LODOP.ADD_PRINT_TEXT("38.00mm","4.6mm","100.00mm","7.30mm", data.secondLogisticsTypeName);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",18);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
        
                LODOP.ADD_PRINT_TEXT("47.00mm","4.60mm","43.92mm","5.29mm", "实重：" + data.weight);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",10);
        
                LODOP.ADD_PRINT_TEXT("47.00mm","31.00mm","37.57mm","5.29mm", "体积重：" + data.volumeWeight);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",10);
        
                LODOP.ADD_PRINT_TEXT("47.00mm","61.41mm","38.6mm","5.29mm", "体积：" + data.volume);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",10);
                
                LODOP.ADD_PRINT_TEXT("51.50mm","4.60mm","60.0mm","5.29mm", "L*W*H：" + data.lwh);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",10);
        
                LODOP.ADD_PRINT_TEXT("57.00mm","4.6mm","92.34mm","5.29mm", "箱号：" + data.orderPackBoxCodeList[index]);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",12);
        
                LODOP.ADD_PRINT_HTML("69.00mm","4.0mm","12mm","40mm", "<div style='font-family: \"微软雅黑\"; font-size: 28px; font-weight: 900; line-height: 28px; width:20px;'>" + data.orderGoodsTypeName + "</div>");
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",18);
                LODOP.SET_PRINT_STYLEA(0,"Bold", 1);
        
                LODOP.ADD_PRINT_TEXT("80.00mm","18.0mm","40mm","40mm", "(" + data.expressGoodsTypeName + ")");
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",10);
                LODOP.SET_PRINT_STYLEA(0,"Angle",270);
        
                LODOP.ADD_PRINT_BARCODE("70mm","33mm","65mm","65mm","QRCode", data.orderPackBoxCodeList[index]);
                LODOP.SET_PRINT_STYLEA(0,"DataCharset","UTF-8");
                LODOP.SET_PRINT_STYLEA(0,"QRCodeErrorLevel","M");
                LODOP.SET_PRINT_STYLEA(0,"Horient",3);
                LODOP.SET_PRINT_STYLEA(0,"Vorient",3);
                
                // LODOP.ADD_PRINT_BARCODE("112mm","3mm","28mm","28mm","QRCode", data.orderPackBoxShortCodeList[index]);
                LODOP.ADD_PRINT_BARCODE("112mm","3mm","28mm","28mm","QRCode", data.orderPackBoxCodeList[index]);
                LODOP.SET_PRINT_STYLEA(0,"DataCharset","UTF-8");
                LODOP.SET_PRINT_STYLEA(0,"QRCodeErrorLevel","M");
                LODOP.SET_PRINT_STYLEA(0,"Horient",3);
                LODOP.SET_PRINT_STYLEA(0,"Vorient",3);        
        
                LODOP.ADD_PRINT_BARCODE("69.00mm", "26.00mm", "7mm", "65mm", "128Auto", data.orderPackBoxCodeList[index]);
                LODOP.SET_PRINT_STYLEA(0,"FontSize", 10);
                LODOP.SET_PRINT_STYLEA(0,"ShowBarText", 0);
                LODOP.SET_PRINT_STYLEA(0,"Angle", 90);
                LODOP.SET_PRINT_STYLEA(0,"DataCharset", "UTF-8");
                LODOP.SET_PRINT_STYLEA(0,"Horient",3);
                LODOP.SET_PRINT_STYLEA(0,"Vorient",3);
        
                LODOP.ADD_PRINT_TEXT("139.00mm","4.60mm","53.00mm","7.01mm", "打包工： " + data.userName);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",10);
        
                LODOP.ADD_PRINT_TEXT("139.00mm","58.26mm","39.00mm","7.01mm", "时间： " + data.packTime);
                LODOP.SET_PRINT_STYLEA(0,"FontName","微软雅黑");
                LODOP.SET_PRINT_STYLEA(0,"FontSize",10);
            }
        }
        
        @if (Model)
        {
            <text>
            // LODOP.PRINT_DESIGN();
            // LODOP.PREVIEW();
            LODOP.PRINT();
            </text>
        }
        else
        {
            <text>
            LODOP.PRINT();
            </text>
        }        
    }

</script>
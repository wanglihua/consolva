@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.ReceivePack.Models.ExpressCheckin
@using shunda.Domain.Express
@using shunda.Domain.Storage
@using shunda.Service.Express
@model shunda.Admin.Areas.ReceivePack.Models.ExpressCheckin.LogisticsExpressCheckinExpressDetailModel

@{
    Layout = null;

    bool autoRecordCheckinVideo = Model.AutoRecordCheckinVideo;
}

@if (Model.Warehouse == null) {
    autoRecordCheckinVideo = false;
    <h3 id="warehouseError" class="well">仓库参数不对，您进入的页面是否有误？</h3>
} else if (string.IsNullOrWhiteSpace(Model.TrackingNo)) {
    autoRecordCheckinVideo = false;
    <h3 id="expressTrackingNoError" class="well">请输入快递单号</h3>
} else {
    <div style="margin: 5px 0;">
        <div style="width: 980px;">
            <form id="logisticsExpressCheckinForm" class="form-horizontal" method="post">

                @if (string.IsNullOrWhiteSpace(Model.Message) == false) {
                    autoRecordCheckinVideo = false;
                    <h3 id="expressTrackingNoError" class="well">
                        @(Model.Message)
                    </h3>
                } else if (Model.ExpressId != 0) {
                    autoRecordCheckinVideo = false;
                    <h3 id="expressTrackingNoError" class="well">
                        快递单号 @(Model.TrackingNo) 已成功入库，修改保存后将更新入库记录信息！
                    </h3>
                }

                <input type="hidden" asp-for="WarehouseId"/>
                <input type="hidden" asp-for="ExpressId"/>

                <div>
                    <table id="express" class="data-list-table table table-bordered" style="margin-bottom: 8px;">
                        @* <caption>单号详情</caption> *@
                        <tbody>

                            <tr>
                                <td style="width: 100px" class="lbl">
                                    <label for="expressTrackingNo">
                                        快递单号
                                    </label>
                                </td>
                                <td style="width: 175px">
                                    <input id="expressTrackingNo" asp-for="TrackingNo" type="hidden" required="required" class="input-sm form-control"/>
                                    @if (Model.ExpressId == 0) {
                                        <span>@(Model.TrackingNo)</span>
                                    } else {
                                        <a asp-area="Express" asp-controller="ExpressDetail" asp-action="Index" asp-route-cateId="@(ExpressListMenuCate.All)" asp-route-id="@(Model.ExpressId)" target="_blank">@(Model.TrackingNo)</a>
                                    }
                                </td>
                                <td style="width: 100px;" class="lbl">状态</td>
                                <td style="width: 180px">
                                    @if (Model.ExpressStatus != ExpressStatus.None) {
                                        <span>@(Model.ExpressStatus.Name)</span>
                                    } else {
                                        <span>未入库</span>
                                    }
                                    @*
                                    <select asp-for="GoodsType" class="input-sm form-control" style="margin-top: 2px;">
                                        <option value="">选择快递物品类型</option>
                                        @foreach (var goodsType in Model.GoodsTypeList) {
                                            <option value="@(goodsType.Id)">@(goodsType.Name)</option>
                                        }
                                    </select>
                                    *@
                                </td>
                                <td style="width: 100px" class="lbl">
                                    <label for="expressCompany">物流公司</label>
                                </td>
                                <td>
                                    <input id="expressCompany" asp-for="ExpressCompany" type="text" class="input-sm form-control"/>
                                </td>
                            </tr>

                            <tr>
                                @if (Model.ExpressExpect == null) {
                                    <td class="lbl">
                                        <label asp-for="BillCustomerCode">面单客户ID</label>
                                    </td>
                                    <td>
                                        <input asp-for="BillCustomerCode" autocomplete="off" type="text" placeholder="大小写字母均可" class="input-sm form-control"/>
                                    </td>
                                } else {
                                    <td class="lbl" style="height: 37px;">
                                        <label asp-for="BillCustomerCode">预报客户ID</label>
                                    </td>
                                    <td>
                                        <input asp-for="BillCustomerCode" type="hidden" value="@(Model.ExpressExpect?.Customer.CheckinCode.ToUpper())" class="input-sm form-control"/>
                                        <a asp-area="Customer" asp-controller="Customer" asp-action="Detail" asp-route-id="@(Model.ExpressExpect?.Customer.Id)" target="_blank">
                                            <span style="color: red; font-weight: bold;">@(Model.ExpressExpect?.Customer.CheckinCode.ToUpper())</span>
                                        </a>
                                    </td>
                                }

                                <td class="lbl">
                                    <label asp-for="ShelfId">货架</label>
                                </td>
                                <td>
                                    <select id="shelfId" asp-for="ShelfId" class="input-sm form-control" onchange="shelfSelectChange()">
                                        <option value="0">选择入库货架</option>
                                        @foreach (ShelfInfo shelf in Model.ShelfList) {
                                            if (shelf.Id == Model.ShelfId) {
                                                <option selected="selected" value="@(shelf.Id)">@(shelf.Name)</option>
                                            } else {
                                                <option value="@(shelf.Id)">@(shelf.Name)</option>
                                            }
                                        }
                                    </select>

                                    <script type="text/javascript">
                                        
                                        function shelfSelectChange() {
                                            
                                            var shelfId = $("#shelfId").val();
                                            
                                            showMask("加载中...");
                                            $.ajax({
                                                url: '@Url.Action("StorageLocSpecList", "ExpressCheckin")',
                                                type: "POST",
                                                data: {
                                                    "shelfId": shelfId
                                                },
                                                success: function(data) {
                                                    hideMask();
                                                    if (data.success === false) {
                                                        $.msg.error(data.message);
                                                        return;
                                                    }
                                                    
                                                    $("#storageLocSpecWrapper").html(data);
                                                }
                                            });
                                        }  
                                    
                                    </script>

                                    @*
                                    用这里的代码，就是不可以手工选择货架
                                    <select asp-for="ShelfId" class="input-sm form-control" disabled="disabled">
                                        @foreach (ShelfInfo shelf in Model.ShelfList)
                                        {
                                            <option value="@(shelf.Id)">@(shelf.Name)</option>
                                        }
                                    </select>
                                    <input asp-for="ShelfId" value="@((Model.ShelfId ?? 0) != 0 ? (Model.ShelfId ?? 0) : Model.ShelfList.FirstOrDefault()?.Id)" type="hidden"/>
                                    *@
                                </td>
                                <td class="lbl">仓位规格</td>
                                <td style="vert-align: middle;">
                                    <div id="storageLocSpecWrapper">
                                        <partial name="ExpressCheckinStorageLocSpecList" model="@(Model)"/>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td class="lbl">
                                    <label for="checkinPackageCount" style="color: red;">入库包裹数量</label>
                                </td>
                                <td>
                                    <input id="checkinPackageCount" asp-for="PackageCount" type="number" autocomplete="off" class="input-sm form-control" readonly="readonly"/>
                                </td>
                                <td class="lbl">仓位</td>
                                <td colspan="3" style="vert-align: middle;">
                                    <span style="color: blue;">@(Model.StorageLocName)</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">
                                    <label for="description">入库备注</label>
                                </td>
                                <td colspan="5">
                                    <div class="row">
                                        <div class="col-xs-8">
                                            <textarea id="description" asp-for="WarehouseRemark" rows="1" autocomplete="off" class="input-sm form-control"></textarea>
                                        </div>
                                        <div class="col-xs-4">
                                            <select id="remarkList" class="input-sm form-control" style="margin-top: 2px;" onchange="remarkSelectChange()">
                                                <option value="">选择预设入库备注</option>
                                                @foreach (ExpressRemarkPresetSelectInfo remarkPreset in Model.RemarkPresetList) {
                                                    <option value="@(remarkPreset.Remark)">@(remarkPreset.Remark)</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            @{
                                string customerExpectRemark = Model.ExpressExpect?.Description ?? string.Empty;
                                @if (string.IsNullOrWhiteSpace(customerExpectRemark) == false) {
                                    <tr>
                                        <td class="lbl">
                                            <span>客户备注</span>
                                        </td>
                                        <td colspan="5" class="break-word">
                                            <span style="color: blue;">@(customerExpectRemark)</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div style="margin: 8px 0;">
                    <table id="goodsList" class="data-list-table table table-bordered table-hover" style="margin-bottom: 8px;">
                        @* <caption>物品列表</caption> *@
                        <thead>
                            <tr>
                                <th style="text-align: center; font-weight: normal;"><span style="display: block;float: left; font-weight: bold;">物品列表</span> 扩展名</th>
                                <th style="width: 130px; text-align: center; font-weight: normal;">物品类型</th>
                                <th style="width: 170px; text-align: center; font-weight: normal;">数量</th>
                                <th style="width: 130px; text-align: center; font-weight: normal;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.GoodsList != null && Model.GoodsList.Count != 0) {
                                foreach (LogisticsExpressCheckinExpressGoodsModel goodsModel in Model.GoodsList) {
                                    <partial name="ExpressCheckinExpressGoods" model="@(goodsModel)"/>
                                }
                            }

                            <tr id="addGoodsTr" style="height: 37px;">
                                <td style="border: 0;"></td>
                                <td style="border: 0;"></td>
                                <td style="border: 0;"></td>
                                <td style="text-align: center;border: 0;">
                                    <a class="del" href="javascript: addGoods();">
                                        <span class="glyphicon glyphicon-plus-sign" style="color: green;"></span>
                                        <span class="badge">添加物品</span>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div style="margin: 5px 0;">
                    <partial name="ExpressCheckinSizeWeight" model="@(Model)"/>
                </div>

                <div style="margin-top: -20px; text-align: center;">
                    <button type="button" class="btn btn-pink" onclick="saveAndPrint();">
                        <i class="ace-icon fa fa-floppy-o"></i>
                        保存入库并打印标签
                    </button>
                    <button type="button" class="btn btn-purple" onclick="printExpressLabelManual($('#expressTrackingNo').val(), parseInt($('#checkinPackageCount').val()))">
                        <i class="ace-icon fa fa-print"></i>
                        手动补打标签
                    </button>
                </div>

            </form>
        </div>
    </div>

    <script type="text/javascript">
        $(function() {
            getExpressComName($("#expressTrackingNo").val());
        });
    </script>

    @if (Model.ExpressId == 0) {
        <script type="text/javascript">
            $(function() {
                addGoods();
            });
        </script>
    }

    @if (autoRecordCheckinVideo) {
        <script type="text/javascript">
            recordStart("@(Model.TrackingNo)");
        </script>
    }

    @if (autoRecordCheckinVideo) {
        <script type="application/javascript">
            function saveAndPrint() {
                recordFinish('@(Model.TrackingNo)');
                saveExpressPrintLabel('@(Model.TrackingNo)');
            }
        </script>
    } else {
        <script type="application/javascript">
            function saveAndPrint() {
                saveExpressPrintLabel('@(Model.TrackingNo)');
            }
        </script>
    }
}
@{
    Layout = null;
}
@* 是不是预览 *@
@model bool

<script type="text/javascript">

    @* type: 1 正常件, 2 申领件， 3 问题件 *@
    function printCheckinLabelCommonW05H05(data, packageCount, printCount, type) {
        var LODOP = getLodopWithLicenses();
        LODOP.PRINT_INIT("入库标签打印W05H05");

        LODOP.SET_PRINT_PAGESIZE(1, "50mm", "50mm", "入库标签打印W05H05");

        LODOP.SET_PRINT_STYLE("FontName", "微软雅黑");
        LODOP.SET_PRINT_STYLE("Bold", 0);
        LODOP.SET_PRINT_STYLE("FontSize", 10);

        for (var index = 0; index < packageCount * printCount; index++) {
            LODOP.NEWPAGE();

            LODOP.ADD_PRINT_TEXT("2.00mm","2.00mm","25.0mm","13.00mm", data.storageLoc.substr(0, 2));
            LODOP.SET_PRINT_STYLEA(0,"FontName", "微软雅黑");
            LODOP.SET_PRINT_STYLEA(0,"FontSize", 25);
            LODOP.SET_PRINT_STYLEA(0,"Bold", 1);  
            
            LODOP.ADD_PRINT_TEXT("18.00mm","7.00mm","18.00mm","6.60mm", "【" + data.checkinPackageCount + "】");
            LODOP.SET_PRINT_STYLEA(0,"FontName", "微软雅黑");
            LODOP.SET_PRINT_STYLEA(0,"FontSize", 10);            
            
            LODOP.ADD_PRINT_BARCODE("2.00mm","20.00mm","29.00mm","29.00mm", "QRCode", data.expressTrackingNo);
            LODOP.SET_PRINT_STYLEA(0,"FontSize", 10);
            LODOP.SET_PRINT_STYLEA(0,"DataCharset", "UTF-8");
            
            LODOP.ADD_PRINT_TEXT("27.00mm", "2.00mm", "46.00mm", "6.60mm", data.customerCode);
            LODOP.SET_PRINT_STYLEA(0,"FontName", "微软雅黑");
            LODOP.SET_PRINT_STYLEA(0,"FontSize", 10);            

            LODOP.ADD_PRINT_TEXT("32.00mm", "2.00mm", "46.00mm", "6.60mm", data.expressTrackingNo);
            LODOP.SET_PRINT_STYLEA(0,"FontName", "微软雅黑");
            LODOP.SET_PRINT_STYLEA(0,"FontSize", 10);

            LODOP.ADD_PRINT_TEXT("37.00mm","2.00mm","80.00mm","6.60mm", data.storageLoc);
            LODOP.SET_PRINT_STYLEA(0,"FontName", "微软雅黑");
            LODOP.SET_PRINT_STYLEA(0,"FontSize", 12);
            LODOP.SET_PRINT_STYLEA(0,"Bold", 1);    
            
            LODOP.ADD_PRINT_TEXT("44.00mm", "2.00mm", "46.00mm", "6.60mm", "备注: " + data.warehouseNote);
            LODOP.SET_PRINT_STYLEA(0,"FontName", "微软雅黑");
            LODOP.SET_PRINT_STYLEA(0,"FontSize", 10);
        }
        
        @if (Model)
        {
            <text>
                // LODOP.PRINT_DESIGN();
                // LODOP.PREVIEW();
                LODOP.PRINT();
            </text>
        }
        else
        {
            <text>
                LODOP.PRINT();
            </text>
        }        
    }

</script>
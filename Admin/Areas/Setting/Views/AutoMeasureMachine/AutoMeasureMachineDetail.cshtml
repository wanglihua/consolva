@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Storage
@model shunda.Admin.Areas.Setting.Models.AutoMeasureMachine.AutoMeasureMachineDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="autoMeasureMachineDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">自动秤设备详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="autoMeasureMachineDetailForm" class="form-horizontal" role="form">
                    <input asp-for="AutoMeasureMachineId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Name" class="col-xs-2 control-label">名称</label>
                                <div class="col-xs-10">
                                    <input asp-for="Name" type="text" required="required" maxlength="100" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Description" class="col-xs-2 control-label">描述</label>
                                <div class="col-xs-10">
                                    <input asp-for="Description" type="text" maxlength="300" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="WarehouseId" class="col-xs-2 control-label">仓库</label>
                                <div class="col-xs-10">
                                    <select asp-for="WarehouseId" type="number" required="required" digits="true" class="input-sm form-control">
                                        <option value="">选择仓库</option>
                                        @foreach (WarehouseInfo warehouse in Model.WarehouseList) {
                                            <option value="@(warehouse.Id)">@(warehouse.Name)</option>
                                        }
                                    </select>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="AppKey" class="col-xs-2 control-label">app key</label>
                                <div class="col-xs-10">
                                    <input asp-for="AppKey" type="text" required="required" maxlength="50" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Secret" class="col-xs-2 control-label">secret</label>
                                <div class="col-xs-10">
                                    <input asp-for="Secret" type="text" required="required" maxlength="50" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveAutoMeasureMachine();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
<div id="clientNoticeList" data-page-index="0" data-sort-field="@(nameof(ClientNoticeInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="clientNoticeDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadClientNoticeList();
    });

    function sortClientNoticeList(sortField, sortDir) {
        var list = $('#clientNoticeList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadClientNoticeList();
    }

    function loadClientNoticeList(pageIndex) {
        var list = $('#clientNoticeList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "ClientNotice")",
            type: "POST",
            data: {
                "@(nameof(ClientNoticeListQueryParam.PageIndex))": pageIndex,
                "@(nameof(ClientNoticeListQueryParam.SortField))": sortField,
                "@(nameof(ClientNoticeListQueryParam.SortDir))": sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#clientNoticeList').html(data);

                initListTable("#tblClientNoticeList");
            }
        });
    }

    function showClientNoticeDetail(id) {
        $("#clientNoticeDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#clientNoticeDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "ClientNotice")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#clientNoticeDetailDialogWrapper").html(data);
                $("#clientNoticeDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveClientNotice() {
        var form = $("#clientNoticeDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "ClientNotice")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#clientNoticeDetailDialog').modal('hide');
                    loadClientNoticeList();
                }
            });
        }
    }

    function deleteClientNotice() {
        var idList = getSelectIdList('#tblClientNoticeList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "ClientNotice")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        loadClientNoticeList();
                    }
                });
            }
        );
    }

</script>
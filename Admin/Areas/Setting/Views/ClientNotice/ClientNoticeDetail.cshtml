@using shunda.Domain
@model shunda.Admin.Areas.Setting.Models.ClientNotice.ClientNoticeDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="clientNoticeDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">客户端公告详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="clientNoticeDetailForm" class="form-horizontal" role="form">
                    <input asp-for="ClientNoticeId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Title" class="col-xs-2 control-label">标题</label>
                                <div class="col-xs-10">
                                    <input asp-for="Title" type="text" required="required" maxlength="300" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Url" class="col-xs-2 control-label">URL</label>
                                <div class="col-xs-10">
                                    <input asp-for="Url" type="text" required="required" maxlength="500" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ListTop" class="col-xs-2 control-label">是否置顶</label>
                                <div class="col-xs-10">
                                    <select asp-for="ListTop" required="required" class="input-sm form-control">
                                        <option value="@(true.ToString())">是，要置顶</option>
                                        <option value="@(false.ToString())">否，不置顶</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Important" class="col-xs-2 control-label">重要公告</label>
                                <div class="col-xs-10">
                                    <select asp-for="ListTop" required="required" class="input-sm form-control">
                                        <option value="@(true.ToString())">是，是重要公告</option>
                                        <option value="@(false.ToString())">否，非重要公告</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveClientNotice();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Client
@model shunda.Admin.Areas.Setting.Models.AdvertBanner.AdvertBannerListModel

<table id="tblAdvertBannerList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="advertBannerCheckAll"></label><input id="advertBannerCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 120px; text-align: center;">
                <div>
                    位置
                </div>
            </th>

            <th style="width: 180px; text-align: center;">
                <div>
                    名称
                </div>
            </th>

            <th style="width: 130px; text-align: center;">
                <div>
                    客户端显示
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                图片
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.AdvertBannerList.Count != 0) {
            int order = 1;
            foreach (AdvertBannerInfo advertBanner in Model.AdvertBannerList) {
                <tr ondblclick="showAdvertBannerDetail(@(advertBanner.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="advertBannerCheck_@(advertBanner.Id)"></label><input id="advertBannerCheck_@(advertBanner.Id)" type="checkbox" class="ace" value="@advertBanner.Id"/><span class="lbl"></span>
                        </div>
                    </td>

                    <td style="text-align: center;">@(order++)</td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(advertBanner.Loc.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(advertBanner.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(advertBanner.ClientShow)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <a asp-area="Setting" asp-controller="AdvertBannerImage" asp-action="Index" asp-route-bannerId="@(advertBanner.Id)">广告图片</a>
                    </td>

                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="7">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>
@using shunda.Domain
@model shunda.Admin.Areas.Setting.Models.AdvertBanner.AdvertBannerDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="advertBannerDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">广告横幅详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="advertBannerDetailForm" class="form-horizontal" role="form">
                    <input asp-for="AdvertBannerId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Loc" class="col-xs-2 control-label">位置</label>
                                <div class="col-xs-10">
                                    <select asp-for="Loc" required="required" digits="true" class="input-sm form-control">
                                        <option value=""></option>
                                        @foreach(AdvertBannerLoc type in Model.LocList) {
                                            <option value="@(type.Id)">@(type.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Name" class="col-xs-2 control-label">名称</label>
                                <div class="col-xs-10">
                                    <input asp-for="Name" type="text" required="required" maxlength="200" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ClientShow" class="col-xs-2 control-label">是否客户端显示</label>
                                <div class="col-xs-10">
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveAdvertBanner();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
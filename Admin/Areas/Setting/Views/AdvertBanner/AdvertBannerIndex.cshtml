@using shunda.Core.Web
@using shunda.Domain.Client
@model AdvertBannerIndexModel
@using shunda.Admin.Areas.Setting.Models.AdvertBanner
@{
    ViewData[ViewDataKey.Title] = "广告横幅";
    Layout = "_AdminLayout";
}


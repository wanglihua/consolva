@{
    Layout = null;
}

@using shunda.Domain.Client
@model shunda.Admin.Areas.Setting.Models.ClientAgreement.ClientAgreementListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadClientAgreementList" })

<table id="tblClientAgreementList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="clientAgreementCheckAll"></label><input id="clientAgreementCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 200px;">
                <a field="@(nameof(ClientAgreementInfo.Title))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientAgreementList">标题</a>
            </th>
            <th style="width: 80px; text-align: center;">
                <a field="@(nameof(ClientAgreementInfo.Country))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientAgreementList">国家</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(ClientAgreementInfo.Creator)).@(nameof(ClientAgreementInfo.Creator.LoginName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientAgreementList">添加人</a>
            </th>
            <th style="width: 80px; text-align: center;">
                <a field="@(nameof(ClientAgreementInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientAgreementList">状态</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ClientAgreementInfo.PublishTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientAgreementList">发布时间</a>
            </th>
            <th style="width: 65px; text-align: center;">
                <a field="@(nameof(ClientAgreementInfo.OrderNum))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientAgreementList">排序</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ClientAgreementInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientAgreementList">创建时间</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ClientAgreementInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientAgreementList">修改时间</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ClientAgreementList != null && Model.ClientAgreementList.Count != 0) {
            int order = 1;
            foreach (ClientAgreementInfo clientAgreement in Model.ClientAgreementList) {
                <tr ondblclick="showClientAgreementDetail(@(clientAgreement.Id));">
                    <td style="text-align: center;">
                        <label for="clientAgreementCheck_@(clientAgreement.Id)"></label><input id="clientAgreementCheck_@(clientAgreement.Id)" type="checkbox" class="ace" value="@clientAgreement.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td class="break-word">
                        @clientAgreement.Title
                    </td>
                    <td style="text-align: center;">
                        @clientAgreement.Country.Name
                    </td>
                    <td style="text-align: center;">
                        @(clientAgreement.Creator?.LoginName)(@(clientAgreement.Creator?.UserName))
                    </td>
                    <td style="text-align: center;">
                        @(clientAgreement.Status?.Name)
                    </td>
                    <td style="text-align: center;">
                        @(clientAgreement.PublishTime?.ToString("yyyy-MM-dd HH:mm"))
                    </td>
                    <td style="text-align: center;">
                        @(clientAgreement.OrderNum)
                    </td>
                    <td style="text-align: center;">
                        @(clientAgreement.CreateTime.ToString("yyyy-MM-dd HH:mm"))
                    </td>
                    <td style="text-align: center;">
                        @(clientAgreement.UpdateTime.ToString("yyyy-MM-dd HH:mm"))
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="12">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadClientAgreementList" })
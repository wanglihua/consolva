@using shunda.Domain
@model shunda.Admin.Areas.Setting.Models.ClientPopup.ClientPopupDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="clientPopupDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">客户端弹窗详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="clientPopupDetailForm" class="form-horizontal" role="form">
                    <input asp-for="ClientPopupId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ShouldPopup" class="col-xs-2 control-label">是否弹窗</label>
                                <div class="col-xs-10">
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Content" class="col-xs-2 control-label">内容</label>
                                <div class="col-xs-10">
                                    <input asp-for="Content" type="text" required="required" maxlength="1000" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="EditTime" class="col-xs-2 control-label">编辑时间</label>
                                <div class="col-xs-10">
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveClientPopup();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
@section Breadcrumb {
    <li class="parent" data-menu="settings-menu">系统设置</li>
    <li class="active" data-menu="settings-client-popup-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadClientPopupList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showClientPopupDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteClientPopup()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadClientPopupList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="clientPopupList" data-page-index="0" data-sort-field="@(nameof(ClientPopupInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="clientPopupDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadClientPopupList();
    });

    function sortClientPopupList(sortField, sortDir) {
        var list = $('#clientPopupList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadClientPopupList();
    }

    function loadClientPopupList(pageIndex) {
        var list = $('#clientPopupList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "ClientPopup")",
            type: "POST",
            data: {
                "@(nameof(ClientPopupListQueryParam.PageIndex))": pageIndex,
                "@(nameof(ClientPopupListQueryParam.SortField))": sortField,
                "@(nameof(ClientPopupListQueryParam.SortDir))": sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#clientPopupList').html(data);

                initListTable("#tblClientPopupList");
            }
        });
    }

    function showClientPopupDetail(id) {
        $("#clientPopupDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#clientPopupDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "ClientPopup")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#clientPopupDetailDialogWrapper").html(data);
                $("#clientPopupDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveClientPopup() {
        var form = $("#clientPopupDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "ClientPopup")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#clientPopupDetailDialog').modal('hide');
                    loadClientPopupList();
                }
            });
        }
    }

    function deleteClientPopup() {
        var idList = getSelectIdList('#tblClientPopupList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "ClientPopup")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        loadClientPopupList();
                    }
                });
            }
        );
    }

</script>
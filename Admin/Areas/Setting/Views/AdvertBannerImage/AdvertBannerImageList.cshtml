@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Client
@model shunda.Admin.Areas.Setting.Models.AdvertBannerImage.AdvertBannerImageListModel

<table id="tblAdvertBannerImageList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="advertBannerImageCheckAll"></label><input id="advertBannerImageCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 150px; text-align: center;">
                <div>
                    广告横幅
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    图片序号
                </div>
            </th>

            <th style="width: 200px; text-align: center;">
                <div>
                    图片
                </div>
            </th>

            <th style="width: 250px; text-align: center;">
                <div>
                    链接地址
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.AdvertBannerImageList.Count != 0) {
            int order = 1;
            foreach (AdvertBannerImageInfo advertBannerImage in Model.AdvertBannerImageList) {
                <tr ondblclick="showAdvertBannerImageDetail(@(advertBannerImage.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="advertBannerImageCheck_@(advertBannerImage.Id)"></label><input id="advertBannerImageCheck_@(advertBannerImage.Id)" type="checkbox" class="ace" value="@advertBannerImage.Id"/><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(order++)</td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(advertBannerImage.Banner?.Name)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @if (string.IsNullOrWhiteSpace(advertBannerImage.Province))
                            {
                                <span>全澳洲</span>
                            }
                            else
                            {
                                @ListDataUtil.Render(advertBannerImage.Province)
                            }
                        </div>
                    </td>                    
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(advertBannerImage.ImageNum)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            <a href="@(advertBannerImage.ImageFullUrlCache)" target="_blank">
                                <img src="@(advertBannerImage.ImageFullUrlCache)" alt="" style="max-width: 180px; max-height: 100px;"/>
                            </a>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            <a href="@Html.Raw(advertBannerImage.LinkUrl)" target="_blank">
                                @ListDataUtil.Render(advertBannerImage.LinkUrl)
                            </a>
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="11">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Client
@model AdvertBannerImageIndexModel
@using shunda.Admin.Areas.Setting.Models.AdvertBannerImage
@{
    ViewData[ViewDataKey.Title] = "广告横幅图片";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="settings-menu">系统设置</li>
    <li class="active" data-menu="settings-advert-banner-index-menu">
        <a href="@Url.Action("Index", "AdvertBanner")">广告横幅</a>
    </li>
    <li>@(Model.AdvertBanner?.Name)</li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadAdvertBannerImageList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showAdvertBannerImageDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteAdvertBannerImage()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadAdvertBannerImageList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="advertBannerImageList" data-page-index="0" data-sort-field="@(nameof(AdvertBannerImageInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="advertBannerImageDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadAdvertBannerImageList();
    });

    function sortAdvertBannerImageList(sortField, sortDir) {
        var list = $('#advertBannerImageList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadAdvertBannerImageList();
    }

    function loadAdvertBannerImageList(pageIndex) {
        var list = $('#advertBannerImageList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "AdvertBannerImage")",
            type: "POST",
            data: {
                "@(nameof(AdvertBannerImageListQueryParam.AdvertBannerId))": "@(Model.AdvertBanner.Id)",
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#advertBannerImageList').html(data);

                initListTable("#tblAdvertBannerImageList");
            }
        });
    }

    function showAdvertBannerImageDetail(id) {
        $("#advertBannerImageDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#advertBannerImageDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "AdvertBannerImage")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#advertBannerImageDetailDialogWrapper").html(data);
                $("#advertBannerImageDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveAdvertBannerImage() {
        var form = $("#advertBannerImageDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "AdvertBannerImage")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#advertBannerImageDetailDialog').modal('hide');
                    loadAdvertBannerImageList();
                }
            });
        }
    }

    function deleteAdvertBannerImage() {
        var idList = getSelectIdList('#tblAdvertBannerImageList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "AdvertBannerImage")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        loadAdvertBannerImageList();
                    }
                });
            }
        );
    }

</script>
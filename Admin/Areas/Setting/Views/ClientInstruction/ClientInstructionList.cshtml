@{
    Layout = null;
}
@using shunda.Domain.Client
@model shunda.Admin.Areas.Setting.Models.ClientInstruction.ClientInstructionListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadClientInstructionList" })

<table id="tblClientInstructionList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="clientInstructionCheckAll"></label><input id="clientInstructionCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ClientInstructionInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientInstructionList">类型</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(ClientInstructionInfo.Creator)).@(nameof(ClientInstructionInfo.Creator.LoginName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientInstructionList">添加人</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ClientInstructionInfo.PublishTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientInstructionList">发布时间</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ClientInstructionInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientInstructionList">创建时间</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ClientInstructionInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortClientInstructionList">修改时间</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ClientInstructionList != null && Model.ClientInstructionList.Count != 0) {
            int order = 1;
            foreach (ClientInstructionInfo clientInstruction in Model.ClientInstructionList) {
                <tr ondblclick="showClientInstructionDetail(@(clientInstruction.Id));">
                    <td style="text-align: center;">
                        <label for="clientInstructionCheck_@(clientInstruction.Id)"></label><input id="clientInstructionCheck_@(clientInstruction.Id)" type="checkbox" class="ace" value="@clientInstruction.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td class="break-word">
                        @(clientInstruction.Type.Name)
                    </td>
                    <td style="text-align: center;">
                        @(clientInstruction.Creator.LoginName)(@(clientInstruction.Creator?.UserName))
                    </td>
                    <td style="text-align: center;">
                        @(clientInstruction.PublishTime?.ToString("yyyy-MM-dd HH:mm"))
                    </td>
                    <td style="text-align: center;">
                        @(clientInstruction.CreateTime.ToString("yyyy-MM-dd HH:mm"))
                    </td>
                    <td style="text-align: center;">
                        @(clientInstruction.UpdateTime.ToString("yyyy-MM-dd HH:mm"))
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="8">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadClientInstructionList" })
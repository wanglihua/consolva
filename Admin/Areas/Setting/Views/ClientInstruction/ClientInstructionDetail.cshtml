@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Core.Web
@model shunda.Admin.Areas.Setting.Models.ClientInstruction.ClientInstructionDetailModel

@{
    ViewData[ViewDataKey.Title] = "客户端文本菜单详细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="settings-menu">系统设置</li>
    <li class="active" data-menu="settings-client-instruction-index-menu">
        <a href="@Url.Action("Index", "ClientInstruction")">客户端文本菜单</a>
    </li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button class="btn btn-success btn-sm" onclick="saveClientInstruction();">
        <i class="ace-icon fa fa-floppy-o"></i>
        保存
    </button>
    <a type="button" class="btn btn-info btn-sm" href="@Url.Action("Index", "ClientInstruction")">
        <i class="ace-icon fa fa-arrow-left"></i>
        返回
    </a>
</div>

<div>
    <div class="widget-box" style="border-style: none; width: 980px;">
        <div class="widget-body">
            <div class="widget-main">
                <form id="clientInstructionDetailForm" class="form-horizontal" role="form">
                    <input asp-for="Id" type="hidden"/>
                    
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Type" class="col-xs-2 control-label">类型</label>
                                <div class="col-xs-10">
                                    <input asp-for="Type" value="@(Model.Type.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Title" class="col-xs-2 control-label">标题</label>
                                <div class="col-xs-10">
                                    <input asp-for="Title" type="text" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xs-12">
                            <div class="form-group">
                                <label for="content" class="col-xs-2 control-label">内容</label>
                                <div class="col-xs-10">
                                    <textarea id="content" asp-for="Content" class="input-sm form-control"></textarea>

                                    <div class="help-block">{auto_copy_begin_1}, {auto_copy_end_1}, ... , {auto_copy_begin_8}, {auto_copy_end_8} 从这里复制放入地址描述，不要应用任何文本格式。</div>
                                </div>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function saveClientInstruction() {
        
        var content = CKEDITOR.instances.content.getData();
        $("#content").val(content);        
        
        var form = $("#clientInstructionDetailForm");
        var valid = validate(form,
            {
                'Title': {
                    required: true,
                    maxlength: 200
                },
                'Content': {
                    required: false
                }
            });

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "ClientInstruction")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    if (data.success === false) {
                        $.msg.error(data.message);
                    } else {
                        $.msg.show(data.message);

                        if (data.create) {
                            setTimeout("showClientInstructionDetail(" + data.id + ")", 1000);
                        }
                    }

                    hideMask();
                }
            });
        }
    }

    function showClientInstructionDetail(id) {
        var url = "@Url.Action("Detail", "ClientInstruction", new {id = 88888})";
        url = url.replace("88888", id);
        window.location.href = url;
    }

</script>

<script type="text/javascript">
    if (CKEDITOR.env.ie && CKEDITOR.env.version < 9) {
        CKEDITOR.tools.enableHtml5Elements(document);
    }

    CKEDITOR.config.height = 520;
    CKEDITOR.config.width = 'auto';

    var initCkEditor = (function () {
        return function () {
            CKEDITOR.replace('content');
        };
    })();

    initCkEditor();
</script>
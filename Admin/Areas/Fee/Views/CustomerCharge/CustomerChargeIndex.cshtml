@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.Fee.Models.CustomerCharge
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Customer
@model shunda.Admin.Areas.Fee.Models.CustomerCharge.CustomerChargeIndexModel
@{
    ViewData[ViewDataKey.Title] = "余额充值";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="fee-menu">费用管理</li>
    <li class="active" data-menu="fee-customer-charge-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadCustomerChargeList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>

    @if (Model.HasManualChargePass)
    {
        <button type="button" class="btn btn-pink btn-sm" onclick="showCustomerChargeDetail(0)">
            <i class="ace-icon fa fa-plus"></i>
            手工充值
        </button>

        <button id="btnImportSea" class="btn btn-success btn-sm">
            <i class="ace-icon fa fa-plus"></i>
            导入充值
        </button>

        <a style="margin-left: 20px; display: inline-block;" href="/static/excel-template/customer-charge/customer-charge-import.xlsx">下载余额充值导入模板</a>
    }

    @*
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteCustomerCharge()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
    *@
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="customerCodeQuery">客户ID</label>&nbsp;<input id="customerCodeQuery" name="customerCodeQuery" style="width: 100px; height: 30px;" placeholder="客户ID查询"/>&nbsp;
    <label for="chargeTypeQuery">充值方式</label>&nbsp;
    <select id="chargeTypeQuery" name="chargeTypeQuery" style="width: 100px; height: 30px;">
        <option value="">充值方式</option>
        @foreach (var chargeType in Model.ChargeTypeList)
        {
            <option value="@(chargeType.Id)">@(chargeType.Name)</option>
        }
    </select>&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadCustomerChargeList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="customerChargeList" data-page-index="0" data-sort-field="@(nameof(CustomerChargeInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="customerChargeDetailDialogWrapper"></div>

<script type="text/javascript">

    $(function() {
        loadCustomerChargeList();
    });

    function sortCustomerChargeList(sortField, sortDir) {
        var list = $('#customerChargeList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadCustomerChargeList();
    }

    function loadCustomerChargeList(pageIndex) {
        var list = $('#customerChargeList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "CustomerCharge")",
            type: "POST",
            data: {
                '@(nameof(CustomerChargeListQueryParam.CustomerCodeQuery))': $('#customerCodeQuery').val(),
                '@(nameof(CustomerChargeListQueryParam.ChargeTypeQuery))': $('#chargeTypeQuery').val(),
                '@(nameof(CustomerChargeListQueryParam.PageIndex))': pageIndex,
                '@(nameof(CustomerChargeListQueryParam.SortField))': sortField,
                '@(nameof(CustomerChargeListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#customerChargeList').html(data);

                initListTable("#tblCustomerChargeList");
            }
        });
    }
    
    function saveCustomerCharge() {
        var form = $("#customerChargeDetailForm");
        var valid = validate(form,
            {
                'CustomerCode': {
                    required: true
                },
                'Amount': {
                    required: true,
                    number: true
                }
            });

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("ManualChargeSave", "CustomerCharge")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    if (data.success === false) {
                        $.msg.error(data.message);
                    }

                    $.msg.show(data.message);
                    $('#customerChargeDetailDialog').modal('hide');
                    loadCustomerChargeList();

                    hideMask();
                }
            });
        }
    }   

    function showCustomerChargeDetail(id) {
        $("#customerChargeDetailDialogWrapper").html("");

        showMask("加载中...");

        $.ajax({
            url: '@Url.Action("ManualCharge", "CustomerCharge")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#customerChargeDetailDialogWrapper").html(data);
                $("#customerChargeDetailDialog").modal(modalOptions);
            }
        });
    }   


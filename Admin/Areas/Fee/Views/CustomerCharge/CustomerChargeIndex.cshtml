    $(function(){
        initUploaderSea();
        initUploaderAir();
    });

    function initUploaderSea() {

        var url = '@Url.Action("ImportSea", "CustomerCharge")';

        var uploader = new plupload.Uploader({
            runtimes: 'html5,flash,html4',
            multi_selection: false,

            browse_button: 'btnImportSea',
            file_data_name: "excelFile",
            url: url,
            max_file_size: '10000kb',

            filters: [
                {title: "Excel文件", extensions: "xlsx"}
            ],

            flash_swf_url: '/plupload/js/Moxie.swf',

            init: {
                FilesAdded: function () {
                    showMask("上传中，请稍候...");
                    uploader.start();
                },
                FileUploaded: function (up, file, response) {
                    hideMask();
                    var result = JSON.parse(response.response);
                    if (result.success !== true) {
                        $.msg.error(result.message);
                        return;
                    }
                    loadCustomerChargeList();
                    $.msg.show(result.message);
                },
                Error: function (up, err) {
                    $.msg.error("上传发生错误：" + err.code + ", " + err.message);
                }
            }
        });

        uploader.init();
    }  
    

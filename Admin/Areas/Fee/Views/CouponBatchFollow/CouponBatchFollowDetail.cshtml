@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Core
@using shunda.Domain.Coupon
@model shunda.Admin.Areas.Fee.Models.CouponBatchFollow.CouponBatchFollowDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="couponBatchDetailDialog">
    <div class="modal-dialog" style="width: 920px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">优惠券批次详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="couponBatchDetailForm" class="form-horizontal" role="form">
                    <input asp-for="CouponBatchId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-6">
                            <div class="form-group">
                                <label asp-for="Name" class="col-xs-4 control-label">批次名称</label>
                                <div class="col-xs-8">
                                    @if (Model.Released)
                                    {
                                        <input asp-for="Name" type="text" required="required" maxlength="200" class="input-sm form-control" disabled="disabled"/>
                                    }
                                    else
                                    {
                                        <input asp-for="Name" type="text" required="required" maxlength="200" class="input-sm form-control"/>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-6">
                            <div class="form-group">
                                <label asp-for="Type" class="col-xs-4 control-label">优惠券类型</label>
                                <div class="col-xs-8">
                                    @if (Model.Released)
                                    {
                                        <select asp-for="Type" required="required" digits="true" class="input-sm form-control" disabled="disabled">
                                            <option value="">请选择优惠券类型</option>
                                            @foreach (CouponType type in Model.TypeList)
                                            {
                                                <option value="@(type.Id)">@(type.Name)</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <select asp-for="Type" required="required" digits="true" class="input-sm form-control">
                                            <option value="">请选择类型</option>
                                            @foreach (CouponType type in Model.TypeList)
                                            {
                                                <option value="@(type.Id)">@(type.Name)</option>
                                            }
                                        </select>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-6">
                            <div class="form-group">
                                <label asp-for="Rule" class="col-xs-4 control-label">规则</label>
                                <div class="col-xs-8">
                                    <input asp-for="Rule" type="text" maxlength="20" class="input-sm form-control" disabled="disabled"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-6">
                            <div class="form-group">
                                <label asp-for="RuleDesc" class="col-xs-4 control-label">规则描述</label>
                                <div class="col-xs-8">
                                    <input asp-for="RuleDesc" type="text" maxlength="500" class="input-sm form-control" disabled="disabled"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-6">
                            <div class="form-group">
                                <label asp-for="TotalQuantity" class="col-xs-4 control-label">总数量</label>
                                <div class="col-xs-8">
                                    @if (Model.Released)
                                    {
                                        <input asp-for="TotalQuantity" type="number" required="required" digits="true" class="input-sm form-control" disabled="disabled"/>
                                    }
                                    else
                                    {
                                        <input asp-for="TotalQuantity" type="number" required="required" digits="true" class="input-sm form-control"/>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-6">
                            <div class="form-group">
                                <label asp-for="MaxQtyPerCustomer" class="col-xs-4 control-label">每客户可领取</label>
                                <div class="col-xs-8">
                                    @if (Model.Released)
                                    {
                                        <select asp-for="MaxQtyPerCustomer" required="required" class="input-sm form-control" disabled="disabled">
                                            <option value="1">1 张</option>
                                            <option value="2">2 张</option>
                                            <option value="3">3 张</option>
                                            <option value="4">4 张</option>
                                            <option value="5">5 张</option>
                                            <option value="6">6 张</option>
                                            <option value="7">7 张</option>
                                            <option value="8">8 张</option>
                                            <option value="9">9 张</option>
                                            <option value="10">10 张</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <select asp-for="MaxQtyPerCustomer" required="required" class="input-sm form-control">
                                            <option value="1">1 张</option>
                                            <option value="2">2 张</option>
                                            <option value="3">3 张</option>
                                            <option value="4">4 张</option>
                                            <option value="5">5 张</option>
                                            <option value="6">6 张</option>
                                            <option value="7">7 张</option>
                                            <option value="8">8 张</option>
                                            <option value="9">9 张</option>
                                            <option value="10">10 张</option>
                                        </select>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-6">
                            <div class="form-group">
                                <label for="expire" class="col-xs-4 control-label">有效期</label>
                                <div class="col-xs-8">
                                    @if (Model.Released)
                                    {
                                        <input id="expire" asp-for="Expire" value="@(Model.Expire.ToString("yyyy-MM-dd"))" type="text" required="required" class="input-sm form-control" disabled="disabled"/>
                                    }
                                    else
                                    {
                                        <input id="expire" asp-for="Expire" value="@(Model.Expire.ToString("yyyy-MM-dd"))" type="text" required="required" class="input-sm form-control"/>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-6">
                            <div class="form-group">
                                <label asp-for="Status" class="col-xs-4 control-label">状态</label>
                                <div class="col-xs-8">
                                    <select asp-for="Status" required="required" digits="true" class="input-sm form-control" disabled="disabled">
                                        <option value="">请选择状态</option>
                                        @foreach (CouponBatchStatus type in Model.StatusList)
                                        {
                                            <option value="@(type.Id)">@(type.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                @if (Model.Released == false)
                {
                    <button type="button" class="btn btn-success btn-sm" onclick="saveCouponBatch();">
                        <i class="ace-icon fa fa-floppy-o"></i>
                        保存
                    </button>
                }
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">  

    $(function() {
        $('#expire').datetimepicker({
            locale: "zh-cn",
            format: 'L'
        });
    });   
   
</script>
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model shunda.Admin.Areas.Fee.Models.CouponRuleDiscount.CouponRuleDiscountDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="couponRuleDialog">
    <div class="modal-dialog" style="width: 540px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">优惠券折扣规则详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="couponRuleForm" class="form-horizontal" role="form">
                    <input asp-for="CouponRuleDiscountId" type="hidden"/>
                    <input asp-for="BatchId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Rate" class="col-xs-2 control-label">折率</label>
                                <div class="col-xs-10">
                                    @if (Model.CanModify == true)
                                    {
                                        <input asp-for="Rate" type="number" required="required" number="true" class="input-sm form-control">
                                    }
                                    else
                                    {
                                        <input asp-for="Rate" type="number" required="required" number="true" class="input-sm form-control" disabled="disabled">
                                    }
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                @if (Model.CanModify == true)
                {
                    <button type="button" class="btn btn-success btn-sm" onclick="saveCouponRuleDiscount();">
                        <i class="ace-icon fa fa-floppy-o"></i>
                        保存
                    </button>
                }
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function saveCouponRuleDiscount() {
        var form = $("#couponRuleForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "CouponRuleDiscount")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#couponRuleDialog').modal('hide');
                    
                    loadCouponBatchList();
                }
            });
        }
    }
</script>
@{
    Layout = null;
}
@using shunda.Domain.Fee
@model shunda.Admin.Areas.Fee.Models.FeeRefundReason.FeeRefundReasonListModel

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadRefundReasonList"})

<table id="tblRefundReasonList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="refundReasonCheckAll"></label><input id="refundReasonCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 300px;">
                <a field="@(nameof(FeeRefundReasonInfo.Content))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortRefundReasonList">内容</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(FeeRefundReasonInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortRefundReasonList">状态</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(FeeRefundReasonInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortRefundReasonList">创建时间</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(FeeRefundReasonInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortRefundReasonList">修改时间</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RefundReasonList != null && Model.RefundReasonList.Count() != 0)
        {
            int order = 1;
            foreach (FeeRefundReasonInfo refundReason in Model.RefundReasonList)
            {
                <tr ondblclick="showRefundReasonDetail(@(refundReason.Id));">
                    <td style="text-align: center;">
                        <label for="refundReasonCheck_@(refundReason.Id)"></label><input id="refundReasonCheck_@(refundReason.Id)" type="checkbox" class="ace" value="@refundReason.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td>@refundReason.Content</td>
                    <td style="text-align: center;">
                        @(refundReason.Status?.Name)
                    </td>
                    <td style="text-align: center;">@refundReason.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="text-align: center;">@refundReason.UpdateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadRefundReasonList"})
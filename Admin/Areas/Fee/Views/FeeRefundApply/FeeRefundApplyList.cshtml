@{
    Layout = null;
}

@using shunda.Core.Web
@using shunda.Domain.Fee
@model shunda.Admin.Areas.Fee.Models.FeeRefundApply.FeeRefundApplyListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadFeeRefundApplyList" })

<table id="tblFeeRefundApplyList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="logisticsOrderRefundApplyCheckAll"></label><input id="logisticsOrderRefundApplyCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 130px; text-align: center;">
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.Customer)).@(nameof(FeeRefundApplyInfo.Customer.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">客户</a>
                </div>
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.Order)).@(nameof(FeeRefundApplyInfo.Order.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">订单</a>
                </div>
            </th>
            <th style="width: 80px; text-align: center;">
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">类型</a>
                </div>
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">状态</a>
                </div>
            </th>

            <th style="width: 100px; text-align: right;">
                <a field="@(nameof(FeeRefundApplyInfo.Amount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">退赔金额</a>
            </th>
            <th style="width: 180px;">
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.PayType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">退赔支付方式</a>
                </div>
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.ReasonContent))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">退赔原因</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.ApplyUser)).@(nameof(FeeRefundApplyInfo.ApplyUser.UserName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">申请人</a>
                </div>
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.ApplyTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">申请时间</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.ApproveUser))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">审核人</a>
                </div>
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.ApproveTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">审核时间</a>
                </div>
            </th>
            <th style="width: 200px;">
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.ApplyMemo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">申请备注</a>
                </div>
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.ApproveMemo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">审核备注</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">创建时间</a>
                </div>
                <div>
                    <a field="@(nameof(FeeRefundApplyInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortFeeRefundApplyList">修改时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.FeeRefundApplyList != null && Model.FeeRefundApplyList.Count() != 0) {
            int order = 1;
            foreach (FeeRefundApplyInfo feeRefundApply in Model.FeeRefundApplyList) {
                string applyCountStyleColor = "";
                if (feeRefundApply.OrderApplyCountCache > 1) {
                    applyCountStyleColor = "color: red;";
                }

                <tr ondblclick="showFeeRefundApplyDetail(@(feeRefundApply.Id));">
                    <td style="text-align: center;">
                        <label for="logisticsOrderRefundApplyCheck_@(feeRefundApply.Id)"></label><input id="logisticsOrderRefundApplyCheck_@(feeRefundApply.Id)" type="checkbox" class="ace" value="@feeRefundApply.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            <a target="_blank" href="@Url.Action("Detail", "Customer", new { id = feeRefundApply.Customer.Id })">
                                @(feeRefundApply.CustomerCodeCache)
                            </a>
                        </div>
                        <div>
                            <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(feeRefundApply.Order.Id)" target="_blank">
                                @feeRefundApply.OrderCode
                            </a>
                        </div>
                        <div>
                            <a href="javascript:loadListByOrderCode('@(feeRefundApply.Order.Code)')">
                                订单共<span style="@(applyCountStyleColor)">@(feeRefundApply.OrderApplyCountCache)</span>条申请
                            </a>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @(feeRefundApply.Type.Name)
                        </div>
                        <div>
                            @(feeRefundApply.Status.Name)
                        </div>
                    </td>
                    <td style="text-align: right;">
                        @feeRefundApply.Amount
                    </td>
                    <td class="break-word">
                        <div>
                            @ListDataUtil.RenderStringWithDiv(feeRefundApply.PayType?.Name)
                        </div>
                        <div style="color: #08008c;">
                            @ListDataUtil.RenderStringWithDiv(feeRefundApply.ReasonContent)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @(feeRefundApply.ApplyUser?.UserName)
                        </div>
                        <div>
                            @ListDataUtil.RenderDateTimeWithDiv(feeRefundApply.ApplyTime)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        @ListDataUtil.RenderStringWithDiv(feeRefundApply.ApproveUser?.UserName)
                        @ListDataUtil.RenderDateTimeWithDiv(feeRefundApply.ApproveTime)
                    </td>
                    <td class="break-word">
                        <div>
                            @ListDataUtil.RenderStringWithDiv(feeRefundApply.ApplyMemo)
                        </div>
                        <div style="color: #08008c;">
                            @ListDataUtil.RenderStringWithDiv(feeRefundApply.ApproveMemo)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @feeRefundApply.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                        <div>
                            @feeRefundApply.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="11">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadFeeRefundApplyList" })
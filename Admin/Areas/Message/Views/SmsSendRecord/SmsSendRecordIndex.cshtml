@using shunda.Admin.Areas.Message.Models.SmsSendRecord
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Message
@model shunda.Admin.Areas.Message.Models.SmsSendRecord.SmsSendRecordIndexModel
@{
    ViewData[ViewDataKey.Title] = "短信发送记录";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="message-menu">消息推送</li>
    <li class="active" data-menu="message-sms-send-record-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="mobileQuery">手机</label>&nbsp;<input id="mobileQuery" style="width: 120px; height: 30px;" placeholder="手机查询"/>&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadSmsSendRecordList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="smsSendRecordList" data-page-index="0" data-sort-field="@(nameof(SmsSendRecordInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="smsSendRecordDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadSmsSendRecordList();
    });

    function sortSmsSendRecordList(sortField, sortDir) {
        var list = $('#smsSendRecordList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadSmsSendRecordList();
    }

    function loadSmsSendRecordList(pageIndex) {
        var list = $('#smsSendRecordList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "SmsSendRecord")",
            type: "POST",
            data: {
                "@(nameof(SmsSendRecordListQueryParam.MobileQuery))": $("#mobileQuery").val(),
                "@(nameof(SmsSendRecordListQueryParam.PageIndex))": pageIndex,
                "@(nameof(SmsSendRecordListQueryParam.SortField))": sortField,
                "@(nameof(SmsSendRecordListQueryParam.SortDir))": sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#smsSendRecordList').html(data);

                initListTable("#tblSmsSendRecordList");
            }
        });
    }

</script>
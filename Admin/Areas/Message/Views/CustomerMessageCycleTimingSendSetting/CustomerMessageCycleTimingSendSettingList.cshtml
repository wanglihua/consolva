@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Message
@model shunda.Admin.Areas.Message.Models.CustomerMessageCycleTimingSendSetting.CustomerMessageCycleTimingSendSettingListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadCustomerMessageCycleTimingSendSettingList" })

<table id="tblCustomerMessageCycleTimingSendSettingList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="customerMessageCycleTimingSendSettingCheckAll"></label><input id="customerMessageCycleTimingSendSettingCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 150px; text-align: center;">
                <a field="@(nameof(CustomerMessageCycleTimingSendSettingInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerMessageCycleTimingSendSettingList">消息类型</a>
            </th>
            <th style="width: 300px;">
                <a field="@(nameof(CustomerMessageCycleTimingSendSettingInfo.WechatMessageTemplate1))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerMessageCycleTimingSendSettingList">微信消息模板</a>
            </th>
            <th style="width: 300px;">
                <a field="@(nameof(CustomerMessageCycleTimingSendSettingInfo.SmsMessageTemplate))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerMessageCycleTimingSendSettingList">短信消息模板</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(nameof(CustomerMessageCycleTimingSendSettingInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerMessageCycleTimingSendSettingList">启用状态</a>
                </div>
                <div>
                    <a field="@(nameof(CustomerMessageCycleTimingSendSettingInfo.ClientCustomizable))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerMessageCycleTimingSendSettingList">客户端定制</a>
                </div>
            </th>
            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(nameof(CustomerMessageCycleTimingSendSettingInfo.SmsSend))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerMessageCycleTimingSendSettingList">SMS发送</a>
                </div>
                <div>
                    <a field="@(nameof(CustomerMessageCycleTimingSendSettingInfo.WechatSend))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerMessageCycleTimingSendSettingList">微信发送</a>
                </div>
            </th>
            <th style="width: 80px;text-align: center;">
                发送周期
            </th>
            <th style="width: 80px;text-align: center;">
                发送时间
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CustomerMessageCycleTimingSendSettingList != null && Model.CustomerMessageCycleTimingSendSettingList.Count() != 0)
        {
            int order = 1;
            foreach (CustomerMessageCycleTimingSendSettingInfo setting in Model.CustomerMessageCycleTimingSendSettingList)
            {
                <tr ondblclick="showCustomerMessageCycleTimingSendSettingDetail(@(setting.Id));">
                    <td style="text-align: center;">
                        <label for="customerMessageCycleTimingSendSettingCheck_@(setting.Id)"></label><input id="customerMessageCycleTimingSendSettingCheck_@(setting.Id)" type="checkbox" class="ace" value="@setting.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">@setting.Type?.Name</td>
                    <td class="break-word">@setting.WechatMessageTemplate1</td>
                    <td class="break-word">@setting.SmsMessageTemplate</td>
                    <td style="text-align: center;">
                        <div>
                            @if (setting.Status == CustomerMessageSettingStatus.Disabled)
                            {
                                <span style="color: red;">@setting.Status.Name</span>
                            }
                            else
                            {
                                <span style="color: blue;">@setting.Status.Name</span>
                            }
                        </div>
                        <div>
                            @if (setting.ClientCustomizable == true)
                            {
                                <span style="color: blue;">可以定制</span>
                            }
                            else
                            {
                                <span>不能定制</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: center;">
                        @ListDataUtil.RenderBoolWithDiv(setting.SmsSend)
                        @ListDataUtil.RenderBoolWithDiv(setting.WechatSend)
                    </td>
                    <td style="text-align: center;">
                        @if (setting.IntervalType == CustomerMessageCycleTimingSendIntervalType.Weeks)
                        {
                            <span>@(setting.IntervalWeeks)</span>
                            <span>周</span>
                        }

                        @if (setting.IntervalType == CustomerMessageCycleTimingSendIntervalType.Days)
                        {
                            <span>@(setting.IntervalDays)</span>
                            <span>天</span>
                        }
                    </td>
                    <td style="text-align: center;">
                        @if (setting.IntervalType == CustomerMessageCycleTimingSendIntervalType.Weeks)
                        {
                            <span>周</span>
                            <span>@(setting.SendWeekday)</span>
                            <span>,</span>
                        }
                        <span>@(setting.SendHour)</span><span>时</span>
                    </td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadCustomerMessageCycleTimingSendSettingList" })
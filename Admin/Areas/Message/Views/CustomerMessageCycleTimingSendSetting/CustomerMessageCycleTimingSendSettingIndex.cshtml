@using shunda.Admin.Areas.Message.Models.CustomerMessageCycleTimingSendSetting
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Message
@model shunda.Admin.Areas.Message.Models.CustomerMessageCycleTimingSendSetting.CustomerMessageCycleTimingSendSettingIndexModel
@{
    ViewData[ViewDataKey.Title] = "定时任务推送设置列表";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="message-menu">消息推送</li>
    <li class="active" data-menu="message-customer-message-cycle-timing-send-setting-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div id="customerMessageCycleTimingSendSettingList" data-page-index="0" data-sort-field="@(nameof(CustomerMessageCycleTimingSendSettingInfo.Id))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="customerMessageCycleTimingSendSettingDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadCustomerMessageCycleTimingSendSettingList();
    });

    function sortCustomerMessageCycleTimingSendSettingList(sortField, sortDir) {
        var list = $('#customerMessageCycleTimingSendSettingList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadCustomerMessageCycleTimingSendSettingList();
    }

    function loadCustomerMessageCycleTimingSendSettingList(pageIndex) {
        var list = $('#customerMessageCycleTimingSendSettingList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "CustomerMessageCycleTimingSendSetting")",
            type: "POST",
            data: {
                '@(nameof(CustomerMessageCycleTimingSendSettingListQueryParam.PageIndex))': pageIndex,
                '@(nameof(CustomerMessageCycleTimingSendSettingListQueryParam.SortField))': sortField,
                '@(nameof(CustomerMessageCycleTimingSendSettingListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#customerMessageCycleTimingSendSettingList').html(data);

                initListTable("#tblCustomerMessageCycleTimingSendSettingList");
            }
        });
    }

    function showCustomerMessageCycleTimingSendSettingDetail(id) {
        $("#customerMessageCycleTimingSendSettingDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#customerMessageCycleTimingSendSettingDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "CustomerMessageCycleTimingSendSetting")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#customerMessageCycleTimingSendSettingDetailDialogWrapper").html(data);
                $("#customerMessageCycleTimingSendSettingDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveCustomerMessageCycleTimingSendSetting() {
        var form = $("#customerMessageCycleTimingSendSettingDetailForm");
        var valid = validate(form,
            {
                'CustomerMessageCycleTimingSendSetting.TypeId': {
                    required: true,
                    digits: true 
                },
                'CustomerMessageCycleTimingSendSetting.WechatTemplateId': {
                    required: true,
                    digits: true 
                },
                'CustomerMessageCycleTimingSendSetting.WechatMessageTemplate1': {
                    required: true,
                    maxlength: 500
                },
                'CustomerMessageCycleTimingSendSetting.WechatMessageTemplate2': {
                    maxlength: 500
                },
                'CustomerMessageCycleTimingSendSetting.WechatMessageTemplate3': {
                    maxlength: 500
                },
                'CustomerMessageCycleTimingSendSetting.SmsMessageTemplate': {
                    required: true,
                    maxlength: 500
                },
                'CustomerMessageCycleTimingSendSetting.StatusId': {
                    required: true,
                    digits: true 
                },
                'CustomerMessageCycleTimingSendSetting.SmsSend': {
                    required: true
                },
                'CustomerMessageCycleTimingSendSetting.WechatSend': {
                    required: true
                }
            });

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "CustomerMessageCycleTimingSendSetting")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#customerMessageCycleTimingSendSettingDetailDialog').modal('hide');
                    loadCustomerMessageCycleTimingSendSettingList();
                }
            });
        }
    }

</script>
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain
@using shunda.Domain.Message
@model shunda.Admin.Areas.Message.Models.CustomerMessageClientUrl.CustomerMessageClientUrlDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="customerMessageClientUrlDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">客户消息客户端URL详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="customerMessageClientUrlDetailForm" class="form-horizontal" role="form">
                    <input asp-for="CustomerMessageClientUrlId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="MessageType" class="col-xs-2 control-label">消息类型</label>
                                <div class="col-xs-10">
                                    <select asp-for="MessageType" required="required" digits="true" class="input-sm form-control">
                                        <option value=""></option>
                                        @foreach(CustomerMessageType type in Model.MessageTypeList) {
                                            <option value="@(type.Id)">@(type.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="TerminalType" class="col-xs-2 control-label">终端类型</label>
                                <div class="col-xs-10">
                                    <select asp-for="TerminalType" required="required" digits="true" class="input-sm form-control">
                                        <option value=""></option>
                                        @foreach(TerminalType type in Model.TerminalTypeList) {
                                            <option value="@(type.Id)">@(type.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ClientUrl" class="col-xs-2 control-label">客户端URL</label>
                                <div class="col-xs-10">
                                    <input asp-for="ClientUrl" type="text" required="required" maxlength="200" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveCustomerMessageClientUrl();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
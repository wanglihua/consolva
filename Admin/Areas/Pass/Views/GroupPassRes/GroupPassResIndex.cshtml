@using shunda.Admin.Areas.Pass.Models.GroupPassRes
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Pass
@model shunda.Admin.Areas.Pass.Models.GroupPassRes.GroupPassResIndexModel
@{
    ViewData[ViewDataKey.Title] = "群组资源授权";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="auth-menu">权限管理</li>
    <li class="active" data-menu="auth-group-index-menu">
        <a asp-controller="Group" asp-action="Index">群组列表</a>
    </li>
    <li>群组（<span>@Model.Group.Code</span>&nbsp;<span>@Model.Group.Name</span>）资源授权</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadGroupPassResList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <a type="button" class="btn btn-info btn-sm" asp-controller="Group" asp-action="Index">
        <i class="ace-icon fa fa-arrow-left"></i>
        返回
    </a>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="cateNameQuery">资源类别</label>&nbsp;<input id="cateNameQuery" name="cateNameQuery" style="width: 100px; height: 30px;" placeholder="资源类别查询"/>&nbsp;
    <label for="passResNameQuery">资源名称</label>&nbsp;<input id="passResNameQuery" name="passResNameQuery" style="width: 100px; height: 30px;" placeholder="资源名称查询"/>&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadGroupPassResList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="groupPassResList" data-page-index="0" data-sort-field="@(nameof(GroupPassResInfo.Id))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="groupPassResDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadGroupPassResList();
    });

    function sortGroupPassResList(sortField, sortDir) {
        var list = $('#groupPassResList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadGroupPassResList();
    }

    function loadGroupPassResList(pageIndex) {
        var list = $('#groupPassResList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "GroupPassRes")",
            type: "POST",
            data: {
                '@(nameof(GroupPassResListQueryParam.GroupId))': @(Model.GroupId),
                '@(nameof(GroupPassResListQueryParam.CateNameQuery))': $("#cateNameQuery").val(),
                '@(nameof(GroupPassResListQueryParam.PassResNameQuery))': $("#passResNameQuery").val(),
                '@(nameof(GroupPassResListQueryParam.PageIndex))': pageIndex,
                '@(nameof(GroupPassResListQueryParam.SortField))': sortField,
                '@(nameof(GroupPassResListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#groupPassResList').html(data);

                initListTable("#tblGroupPassResList");
            }
        });
    }

    function grantGroupPassRes(passResId) {
        showMask("提交中...");
        $.ajax({
            url: '@Url.Action("Grant", "GroupPassRes")',
            type: "POST",
            data: {
                '@(nameof(GroupPassResGrantModel.GroupId))': @Model.GroupId,
                '@(nameof(GroupPassResGrantModel.PassResId))': passResId
            },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $.msg.show(data.message);
                loadGroupPassResList();
            }
        });
    }

    function revokeGroupPassRes(passResId) {
        showMask("提交中...");
        $.ajax({
            url: '@Url.Action("Revoke", "GroupPassRes")',
            type: "POST",
            data: {
                '@(nameof(GroupPassResRevokeModel.GroupId))': @Model.GroupId,
                '@(nameof(GroupPassResRevokeModel.PassResId))': passResId
            },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $.msg.show(data.message);
                loadGroupPassResList();
            }
        });
    }

</script>
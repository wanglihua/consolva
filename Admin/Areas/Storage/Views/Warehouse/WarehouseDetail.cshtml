@using shunda.Core.Web
@model shunda.Admin.Areas.Storage.Models.Warehouse.WarehouseDetailModel

@{
    ViewData[ViewDataKey.Title] = "仓库详细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="storage-menu">仓储管理</li>
    <li class="active" data-menu="storage-warehouse-index-menu">
        <a asp-controller="Warehouse" asp-action="Index">仓库列表</a>
    </li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button class="btn btn-success btn-sm" onclick="saveWarehouse();">
        <i class="ace-icon fa fa-floppy-o"></i>
        保存
    </button>
    <a type="button" class="btn btn-info btn-sm" asp-controller="Warehouse" asp-action="Index">
        <i class="ace-icon fa fa-arrow-left"></i>
        返回
    </a>
</div>

<div>
    <div class="widget-box" style="border-style: none; width: 880px;">
        <div class="widget-body">
            <div class="widget-main">
                <form id="warehouseDetailForm" class="form-horizontal" role="form">
                    <input asp-for="Warehouse.Id" type="hidden"/>
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.Code" class="col-xs-2 control-label">编码</label>
                                <div class="col-xs-10">
                                    <input asp-for="Warehouse.Code" type="text" class="input-sm form-control" required="required" maxlength="100"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.Name" class="col-xs-2 control-label">名称</label>
                                <div class="col-xs-10">
                                    <input asp-for="Warehouse.Name" type="text" class="input-sm form-control" required="required" maxlength="200"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.Description" class="col-xs-2 control-label">描述</label>
                                <div class="col-xs-10">
                                    <textarea asp-for="Warehouse.Description" rows="2" class="input-sm form-control"  required="required" maxlength="500"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.Area" class="col-xs-2 control-label">省市街道</label>
                                <div class="col-xs-10">
                                    <input asp-for="Warehouse.Area" type="text" class="input-sm form-control" required="required" maxlength="300"/>
                                    <div class="help-block" style="color: #990000;">这个省市街道会被用于客户填写快递单的收件省市街道</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.Address" class="col-xs-2 control-label">详细地址</label>
                                <div class="col-xs-10">
                                    <textarea asp-for="Warehouse.Address" rows="2" class="input-sm form-control"  required="required" maxlength="500"></textarea>
                                    <div class="help-block" style="color: #990000;">不包括省市街道部分，这个详细地址会被用于客户填写快递单的收件地址</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.Phone" class="col-xs-2 control-label">联系电话</label>
                                <div class="col-xs-10">
                                    <input asp-for="Warehouse.Phone" type="text" class="input-sm form-control" required="required" maxlength="30"/>
                                    <div class="help-block" style="color: #990000;">这个联系电话会被用于客户填写快递单的收件联系电话</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.Zipcode" class="col-xs-2 control-label">邮编</label>
                                <div class="col-xs-10">
                                    <input asp-for="Warehouse.Zipcode" type="text" class="input-sm form-control" required="required" maxlength="10"/>
                                    <div class="help-block" style="color: #990000;">这个邮编会被用于客户填写快递单的收件邮编</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.OuterStatus" class="col-xs-2 control-label">对外状态</label>
                                <div class="col-xs-10">
                                    <select asp-for="Warehouse.OuterStatus" class="input-sm form-control">
                                        @foreach (var warehouseStatus in Model.WarehouseStatusList) {
                                            if (Model.Warehouse.OuterStatus == warehouseStatus) {
                                                <option value="@warehouseStatus.Id" selected="selected">@warehouseStatus.Name</option>
                                            } else {
                                                <option value="@warehouseStatus.Id">@warehouseStatus.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.InnerStatus" class="col-xs-2 control-label">对内状态</label>
                                <div class="col-xs-10">
                                    <select asp-for="Warehouse.InnerStatus" class="input-sm form-control">
                                        @foreach (var warehouseStatus in Model.WarehouseStatusList) {
                                            if (Model.Warehouse.InnerStatus == warehouseStatus) {
                                                <option value="@warehouseStatus.Id" selected="selected">@warehouseStatus.Name</option>
                                            } else {
                                                <option value="@warehouseStatus.Id">@warehouseStatus.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Warehouse.OrderNum" class="col-xs-2 control-label">排序字段</label>
                                <div class="col-xs-10">
                                    <input asp-for="Warehouse.OrderNum" type="number" class="input-sm form-control" required="required" step="1" number="true" min="0"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">

    function saveWarehouse() {
        var form = $("#warehouseDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "Warehouse")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);

                    if (data.create) {
                        setTimeout("showWarehouseDetail(" + data.id + ")", 1000);
                    }
                }
            });
        }
    }

    function showWarehouseDetail(id) {
        var url = "@Url.Action("Detail", "Warehouse", new { id = 88888 })";
        url = url.replace("88888", id);
        window.location.href = url;
    }

</script>
@using shunda.Admin.Areas.Storage.Models.Shelf
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Storage
@model shunda.Admin.Areas.Storage.Models.Shelf.ShelfIndexModel
@{
    ViewData[ViewDataKey.Title] = "货架列表";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="storage-menu">仓储管理</li>
    <li class="active" data-menu="storage-warehouse-index-menu">
        <a asp-controller="Warehouse" asp-action="Index">仓库列表</a>
    </li>
    <li>仓库（<span>@Model.Warehouse.Code</span>&nbsp;<span>@Model.Warehouse.Name</span>）@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadShelfList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showShelfDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteShelf()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
    <button type="button" class="btn btn-purple btn-sm" onclick="updateStorageLocExpress()">
        <i class="ace-icon fa fa-refresh"></i>
        更新仓位快递单
    </button>
    <a type="button" class="btn btn-info btn-sm" asp-controller="Warehouse" asp-action="Index">
        <i class="ace-icon fa fa-arrow-left"></i>
        返回
    </a>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="shelfTypeIdQuery">货架类型</label>&nbsp;
    <select id="shelfTypeIdQuery" name="shelfTypeIdQuery" style="width: 100px; height: 30px;" onchange="loadShelfList();">
        <option value="0">货架类型</option>
        @foreach (var shelfTypeInfo in Model.ShelfTypeList)
        {
            <option value="@shelfTypeInfo.Id">@shelfTypeInfo.Name</option>
        }
    </select>&nbsp;
    <label for="codeQuery">编码</label>&nbsp;<input id="codeQuery" name="codeQuery" style="width: 100px; height: 30px;" placeholder="编码查询"/>&nbsp;
    <label for="nameQuery">货架名</label>&nbsp;<input id="nameQuery" name="nameQuery" style="width: 100px; height: 30px;" placeholder="货架名查询"/>&nbsp;
    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadShelfList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>


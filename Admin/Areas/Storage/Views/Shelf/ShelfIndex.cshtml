<div id="shelfList" data-page-index="0" data-sort-field="@(nameof(ShelfInfo.Status))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="shelfDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadShelfList();
    });

    function sortShelfList(sortField, sortDir) {
        var list = $('#shelfList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadShelfList();
    }

    function loadShelfList(pageIndex) {
        var list = $('#shelfList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "Shelf")",
            type: "POST",
            data: {
                '@(nameof(ShelfListQueryParam.WarehouseId))': @Model.WarehouseId,
                '@(nameof(ShelfListQueryParam.ShelfTypeQuery))': $('#shelfTypeIdQuery').val(),
                '@(nameof(ShelfListQueryParam.CodeQuery))': $('#codeQuery').val(),
                '@(nameof(ShelfListQueryParam.NameQuery))': $('#nameQuery').val(),
                '@(nameof(ShelfListQueryParam.PageIndex))': pageIndex,
                '@(nameof(ShelfListQueryParam.SortField))': sortField,
                '@(nameof(ShelfListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#shelfList').html(data);

                initListTable("#tblShelfList");
            }
        });
    }

    function showShelfDetail(id) {
        $("#shelfDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#shelfDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "Shelf")',
            type: "POST",
            data: {
                "@(nameof(ShelfDetailModel.Id))": id,
                "@(nameof(ShelfDetailModel.WarehouseId))": @Model.WarehouseId
            },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#shelfDetailDialogWrapper").html(data);
                $("#shelfDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveShelf() {
        var form = $("#shelfDetailForm");
        var valid = validate(form,
            {
                'Shelf.Code': {
                    required: true,
                    maxlength: 50
                },
                'Shelf.Name': {
                    required: true,
                    maxlength: 255
                },
                'Shelf.TypeId': {
                    required: true,
                    digits: true
                },
                'Shelf.StatusId': {
                    required: true,
                    digits: true
                },
                'Shelf.OrderNum': {
                    required: true,
                    digits: true
                },
                'Shelf.WarehouseId': {
                    required: true,
                    digits: true
                }
            });

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "Shelf")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#shelfDetailDialog').modal('hide');
                    loadShelfList();
                }
            });
        }
    }

    function deleteShelf() {
        var idList = getSelectIdList('#tblShelfList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "Shelf")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        loadShelfList();
                    }
                });
            }
        );
    }
    
    function updateStorageLocExpress() {
        showMask("提交中...");
        $.ajax({
            url: '@Url.Action("UpdateStorageLocExpress", "Shelf")',
            type: "POST",
            data: {},
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                } 
                
                $.msg.show(data.message);
            }
        });
    }

</script>
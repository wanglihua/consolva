@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderList
@using shunda.Core.Web
@using shunda.Domain.Express
@using shunda.Domain.LogisticsOrder
@using shunda.Service.Express
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderDetail.LogisticsOrderDetailIndexModel

@{
    ViewData[ViewDataKey.Title] = "订单详细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-order-menu">物流订单</li>

    @if (Model.MenuType == OrderListMenuType.Active) {
        <li class="active" data-menu="logistics-order-order-list-active-menu">活动订单</li>
    }

    @if (Model.MenuType == OrderListMenuType.Complete) {
        <li class="active" data-menu="logistics-order-order-list-complete-menu">正常结束订单</li>
    }

    @if (Model.MenuType == OrderListMenuType.Cancel) {
        <li class="active" data-menu="logistics-order-order-list-cancel-menu">作废订单</li>
    }
    <li>@(Model.Order.Code)</li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

@section Style
{
    <style>

        div.detailSubTitle {
            margin: 10px 0;
            padding: 5px 0;
            font-weight: bold;
            border-bottom: lightgray 1px solid;
            color: #2a62bc;
        }
        
        div.more {
            margin: 10px 0;
            padding: 5px 0;        
            font-weight: bold;
            float: right;
        }
                
    </style>
}

@if (Model.CanCancelOrder) {
    <div class="gridToolBar clearfix">
        <button type="button" class="btn btn-danger btn-sm" onclick="cancelOrder()">
            <i class="ace-icon fa fa-trash-o"></i>
            订单作废
        </button>
    </div>
}

@if (Model.CanCompleteOrder) {
    <div class="gridToolBar clearfix">
        <button type="button" class="btn btn-purple btn-sm" onclick="completeOrder()">
            <i class="ace-icon fa fa-gear"></i>
            完成订单
        </button>
    </div>
}

<div class="widget-box" style="border-style: none; width: 1150px;">
    <div class="widget-body">
        <div class="widget-main">
            <form id="logisticsOrderDetailForm" class="form-horizontal" role="form">
                @* 基本信息 *@
                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelBaseInfo').toggle();">
                            <div style="float: left;">
                                基本信息
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelBaseInfo" style="display: none;">
                            <input asp-for="Order.Id" type="hidden"/>
                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.Code" class="col-xs-4 control-label">订单编号</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.Code" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.Country.Name" class="col-xs-4 control-label">国家</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.Country.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.GoodsType.Name" class="col-xs-4 control-label">物品类型</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.GoodsType.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.CreateMethod.Name" class="col-xs-4 control-label">创建方式</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.CreateMethod.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.CustomerCode" class="col-xs-4 control-label">客户</label>
                                        <div class="col-xs-8">
                                            <a asp-area="Customer" asp-controller="Customer" asp-action="Detail" asp-route-id="@(Model.Order.Customer.Id)" target="_blank" style="line-height: 28px;">@(Model.Order.CustomerCode)</a>
                                            @if (string.IsNullOrWhiteSpace(Model.Order.Customer.CustomerCharacter) == false) {
                                                <span>(@(Model.Order.Customer.CustomerCharacter))</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.OrderStatus" class="col-xs-4 control-label">订单状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.OrderStatus.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.PayStatus" class="col-xs-4 control-label">支付状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.PayStatus.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label for="logisticsOrderPayType" class="col-xs-4 control-label">支付方式</label>
                                        <div class="col-xs-8">
                                            <input id="logisticsOrderPayType" name="LogisticsOrder.PayType" type="text" value="@(Model.Order.PayType?.Name)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label for="orderGoodsValue" class="col-xs-4 control-label">货品总值</label>
                                        <div class="col-xs-8">
                                            <div class="input-group">
                                                <input id="orderGoodsValue" asp-for="Order.GoodsValue" type="text" disabled="disabled" class="input-sm form-control"/>
                                                <span class="input-group-addon">RMB</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.OrderAmount" class="col-xs-4 control-label">订单总额</label>
                                        <div class="col-xs-8">
                                            <div class="input-group">
                                                <input asp-for="Order.OrderAmount" type="text" disabled="disabled" class="input-sm form-control"/>
                                                <span class="input-group-addon">RMB</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.PaidAmount" class="col-xs-4 control-label">支付金额</label>
                                        <div class="col-xs-8">
                                            <div class="input-group">
                                                <input asp-for="Order.PaidAmount" type="text" disabled="disabled" class="input-sm form-control"/>
                                                <span class="input-group-addon">RMB</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.CreateTime" class="col-xs-4 control-label">创建时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.CreateTime" value="@(Model.Order.CreateTime.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.PayTime" class="col-xs-4 control-label">支付时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.PayTime" value="@(Model.Order.PayTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.SubmitPackTime" class="col-xs-4 control-label">提交打包时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.SubmitPackTime" value="@(Model.Order.SubmitPackTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.CompletePackTime" class="col-xs-4 control-label">完成打包时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.CompletePackTime" value="@(Model.Order.CompletePackTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.TransferTime" class="col-xs-4 control-label">转运时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.TransferTime" value="@(Model.Order.TransferTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.DeliverTime" class="col-xs-4 control-label">签收时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.DeliverTime" value="@(Model.Order.DeliverTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.RepackType" class="col-xs-4 control-label">打包方式</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.RepackType" type="text" disabled="disabled" class="input-sm form-control" value="@(Model.RepackTypeTitle)"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Order.Insurance" class="col-xs-2 control-label">保险</label>
                                        <div class="col-xs-10">
                                            <input asp-for="Order.Insurance.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-12">
                                    <div class="form-group">
                                        <label asp-for="Order.Gst" class="col-xs-1 control-label">纳税申报</label>
                                        <div class="col-xs-11">
                                            <input asp-for="Order.Gst.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                @* 订单备注 *@
                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelRemark').toggle();">
                            <div style="float: left;">
                                订单备注
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelRemark" style="display: none;">
                            <div class="row">
                                <div id="orderRemarkListWrapper">
                                    @(await Component.InvokeAsync("LogisticsOrderRemarkList", new { orderId = Model.Order.Id }))
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* 物流信息 *@
                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelLogisticsInfo').toggle();">
                            <div style="float: left;">
                                物流信息
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelLogisticsInfo" style="display: none;">
                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.Country" class="col-xs-4 control-label">目的国家</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.Country" type="text" value="@(Model.Order.Country.Name)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.Warehouse" class="col-xs-4 control-label">收货仓库</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.Warehouse" type="text" value="@(Model.Order.Warehouse.Name)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Order.FirstModeType" class="col-xs-4 control-label">头程物流类型</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Order.FirstModeType" type="text" value="@(Model.Order.FirstModeType.Name)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (Model.OrderFirstModeList.Count == 0) {
                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="Order.FirstMode" class="col-xs-2 control-label">头程物流方式</label>
                                            <div class="col-xs-10">
                                                <input asp-for="Order.FirstMode" type="text" value="@(Model.Order.FirstMode.Name)" disabled="disabled" class="input-sm form-control"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-3">
                                        <div class="form-group">
                                            <label asp-for="Order.GoodsType" class="col-xs-4 control-label">物品类型</label>
                                            <div class="col-xs-8">
                                                <input asp-for="Order.GoodsType" type="text" value="@(Model.Order.GoodsType.Name)" disabled="disabled" class="input-sm form-control"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-3">
                                        <div class="form-group">
                                            <label for="InterTrackingNo" class="col-xs-4 control-label">国际单号</label>
                                            <div class="col-xs-8">
                                                <input id="InterTrackingNo" type="text" value="" disabled="disabled" class="input-sm form-control"/>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            } else {
                                foreach (var orderFirstMode in Model.OrderFirstModeList) {
                                    <div class="row">

                                        <div class="col-xs-6">
                                            <div class="form-group">
                                                <label for="orderFirstModeName@(orderFirstMode.Id)" class="col-xs-2 control-label">头程物流方式</label>
                                                <div class="col-xs-10">
                                                    <input id="orderFirstModeName@(orderFirstMode.Id)" type="text" value="@(orderFirstMode.FirstMode.Name)" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="orderFirstModeGoodsType@(orderFirstMode.Id)" class="col-xs-4 control-label">物品类型</label>
                                                <div class="col-xs-8">
                                                    <input id="orderFirstModeGoodsType@(orderFirstMode.Id)" type="text" value="@(orderFirstMode.GoodsType.Name)" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="orderFirstModeTrackingNo@(orderFirstMode.Id)" class="col-xs-4 control-label">国际单号</label>
                                                <div class="col-xs-8">
                                                    @if (string.IsNullOrWhiteSpace(orderFirstMode.TrackingNo)) {
                                                        <input id="orderFirstModeTrackingNo@(orderFirstMode.Id)" type="text" value="@(orderFirstMode.TrackingNo)" disabled="disabled" class="input-sm form-control"/>
                                                    } else {
                                                        <a style="cursor: pointer; line-height: 28px;" onclick="showSeventeenTrackNumberEvent('@(orderFirstMode.TrackingNo)')">@ListDataUtil.Render(orderFirstMode.TrackingNo)</a>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                }
                            }

                        </div>
                    </div>
                </div>

                @* 收货地址 *@
                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelAddress').toggle();">
                            <div style="float: left;">
                                收货地址
                            </div>
                            <div style="float:right; cursor: pointer;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelAddress" style="display: none;">
                            <div class="row">
                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.FirstName" class="col-xs-4 control-label">收货人</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.FirstName" type="text" disabled="disabled" class="input-sm form-control" style="width: 48%; display: inline-block;"/>
                                            <input asp-for="ReceiveAddress.LastName" type="text" disabled="disabled" class="input-sm form-control" style="width: 48%; display: inline-block;"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Mobile" class="col-xs-4 control-label">手机</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Mobile" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Country" class="col-xs-4 control-label">国家</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Country" value="@(Model.ReceiveAddress.Country.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.State" class="col-xs-4 control-label">州</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.State" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.City" class="col-xs-4 control-label">城市</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.City" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Zipcode" class="col-xs-4 control-label">邮政编码</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Zipcode" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Tfn" class="col-xs-4 control-label">ABN/ACN</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Tfn" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Company" class="col-xs-4 control-label">公司</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Company" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Address" class="col-xs-2 control-label">地址</label>
                                        <div class="col-xs-10">
                                            @if (string.IsNullOrWhiteSpace(Model.ReceiveAddress.UnitLoc)) {
                                                <input asp-for="ReceiveAddress.Address" type="text" disabled="disabled" class="input-sm form-control"/>
                                            } else {
                                                <input asp-for="ReceiveAddress.Address" type="text" disabled="disabled" value="@(Model.ReceiveAddress.UnitLoc), @(Model.ReceiveAddress.Address)" class="input-sm form-control"/>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* 发货地址 *@
                @*
                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelSenderAddress').toggle();">
                            <div style="float: left;">
                                发货地址
                            </div>
                            <div style="float:right; cursor: pointer;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelSenderAddress" style="display: none;">
                            <div class="row">
                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Name" class="col-xs-4 control-label">发货人</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Mobile" class="col-xs-4 control-label">手机</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Mobile" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Zipcode" class="col-xs-4 control-label">邮政编码</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Zipcode" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3" style="visibility: hidden;">
                                    <div class="form-group">
                                        <label class="col-xs-4 control-label">&nbsp;</label>
                                        <div class="col-xs-8">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Province" class="col-xs-4 control-label">省份</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Province" value="@(Model.SendAddress.Province.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">

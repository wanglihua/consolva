                        <div id="panelPhoto" style="display: none;">
                            @{
                                IList<ExpressPhotoType> photoTypeList = Model.PhotoList.Select(e => e.Type).Distinct().OrderBy(e => e.Id).ToList();
                            }

                            @if (Model.PhotoList != null && Model.PhotoList.Count() != 0) {
                                <ul id="orderPhotoList" class="nav nav-tabs">
                                    @{
                                        int index = 0;
                                        foreach (ExpressPhotoType photoType in photoTypeList) {
                                            if (index == 0) {
                                                <li class="active">
                                                    <a data-toggle="tab" href="#photoTab_@(photoType.Id)" aria-expanded="true">
                                                        @(photoType.Name)
                                                    </a>
                                                </li>
                                            } else {
                                                <li>
                                                    <a data-toggle="tab" href="#photoTab_@(photoType.Id)" aria-expanded="false">
                                                        @(photoType.Name)
                                                    </a>
                                                </li>
                                            }

                                            index += 1;
                                        }
                                    }
                                </ul>

                                <div class="tab-content">
                                    @{
                                        index = 0;
                                        foreach (ExpressPhotoType photoType in photoTypeList) {
                                            string activeClass = "";
                                            if (index == 0) {
                                                activeClass = " active in ";
                                            }

                                            <div id="photoTab_@(photoType.Id)" class="tab-pane fade @(activeClass)">

                                                @{
                                                    IList<ExpressPhotoInfo> typePhotoList = Model.PhotoList.Where(e => e.Type.Id == photoType.Id).ToList();
                                                    IList<string> trackingNoList = typePhotoList.Select(e => e.Express?.TrackingNo ?? "").Distinct().ToList();

                                                    int trackingNoIndex = 0;
                                                    foreach (string trackingNo in trackingNoList) {
                                                        string backgroundColorStyle = "";
                                                        if (trackingNoIndex % 2 == 1) {
                                                            backgroundColorStyle = " background-color: #f2f2f2; ";
                                                        }

                                                        <div style="@(backgroundColorStyle)">
                                                            @if (string.IsNullOrWhiteSpace(trackingNo) == false) {
                                                                <div style="margin: 0 5px; font-size: 18px; line-height: 20px; font-weight: bold; border-bottom: 1px solid rgb(128,128,128);">@(trackingNo)</div>
                                                            }
                                                            <div>
                                                                @{
                                                                    IList<ExpressPhotoInfo> expressPhotoList = typePhotoList.Where(e => (e.Express?.TrackingNo ?? "") == trackingNo).ToList();
                                                                    foreach (ExpressPhotoInfo photo in expressPhotoList) {
                                                                        <a href="@(photo.BigImageFullUrlCache)" target="_blank" style="display: inline-block; margin: 5px;">
                                                                            <img alt="" src="@(photo.SmallImageFullUrlCache)" style="height: 100px;"/>
                                                                        </a>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>

                                                        trackingNoIndex += 1;
                                                    }
                                                }

                                            </div>

                                            index += 1;
                                        }
                                    }
                                </div>
                            } else {
                                <div style="padding: 5px;">
                                    暂时没有数据！
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* 操作记录 *@
                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelOrderAction').toggle();">
                            <div style="float: left;">
                                操作记录
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelOrderAction" style="display: none;">
                            <table id="tblLogisticsOrderActionList" class="data-list-table table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 50px; text-align: center;">序号</th>
                                        <th style="width: 100px; text-align: center;">
                                            操作人
                                        </th>
                                        <th style="width: 130px; text-align: center;">
                                            操作时间
                                        </th>
                                        <th style="width: 150px; text-align: center;">
                                            操作类型
                                        </th>
                                        <th>
                                            操作描述
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.LogisticsOrderActionList.Count != 0) {
                                        int order = 1;
                                        foreach (LogisticsOrderActionInfo logisticsOrderAction in Model.LogisticsOrderActionList) {
                                            <tr>
                                                <td style="text-align: center;">@(order++)</td>
                                                <td style="text-align: center;">@logisticsOrderAction.User?.UserName</td>
                                                <td style="text-align: center;">@logisticsOrderAction.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                                <td style="text-align: center;">@logisticsOrderAction.Type.Name</td>
                                                <td class="break-word">@logisticsOrderAction.ActionDesc</td>
                                            </tr>
                                        }
                                    } else {
                                        <tr>
                                            <td colspan="5">
                                                暂时没有数据！
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>


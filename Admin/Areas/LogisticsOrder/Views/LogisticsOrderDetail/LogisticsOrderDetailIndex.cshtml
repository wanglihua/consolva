@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderList
@using shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderRemark
@using shunda.Core.Web
@using shunda.Domain.LogisticsOrder
@using shunda.Service.Express
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderDetail.LogisticsOrderDetailIndexModel

@{
    ViewData[ViewDataKey.Title] = "订单详细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-order-menu">物流订单</li>

    @if (Model.MenuType == OrderListMenuType.Active) {
        <li class="active" data-menu="logistics-order-order-list-active-menu">活动订单</li>
    }

    @if (Model.MenuType == OrderListMenuType.Complete) {
        <li class="active" data-menu="logistics-order-order-list-complete-menu">正常结束订单</li>
    }

    @if (Model.MenuType == OrderListMenuType.Cancel) {
        <li class="active" data-menu="logistics-order-order-list-cancel-menu">作废订单</li>
    }
    <li>@(Model.LogisticsOrder.Code)</li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

@section Style
{
    <style>

        div.detailSubTitle {
            margin: 10px 0;
            padding: 5px 0;
            font-weight: bold;
            border-bottom: lightgray 1px solid;
            color: #2a62bc;
        }
        
        div.more {
            margin: 10px 0;
            padding: 5px 0;        
            font-weight: bold;
            float: right;
        }
                
    </style>
}

<div class="widget-box" style="border-style: none; width: 1150px;">
    <div class="widget-body">
        <div class="widget-main">
            <form id="logisticsOrderDetailForm" class="form-horizontal" role="form">
                @* 基本信息 *@
                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelBaseInfo').toggle();">
                            <div style="float: left;">
                                基本信息
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelBaseInfo" style="display: none;">
                            <input asp-for="LogisticsOrder.Id" type="hidden"/>
                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.Code" class="col-xs-4 control-label">订单编号</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.Code" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.Country.Name" class="col-xs-4 control-label">国家</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.Country.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.GoodsType.Name" class="col-xs-4 control-label">物品类型</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.GoodsType.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.CreateMethod.Name" class="col-xs-4 control-label">创建方式</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.CreateMethod.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.CustomerCode" class="col-xs-4 control-label">客户</label>
                                        <div class="col-xs-8">
                                            <a asp-area="Customer" asp-controller="Customer" asp-action="Detail" asp-route-id="@(Model.LogisticsOrder.Customer.Id)" target="_blank" style="line-height: 28px;">@(Model.LogisticsOrder.CustomerCode)</a>
                                            @if (string.IsNullOrWhiteSpace(Model.LogisticsOrder.Customer.CustomerCharacter) == false) {
                                                <span>(@(Model.LogisticsOrder.Customer.CustomerCharacter))</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.OrderStatus" class="col-xs-4 control-label">订单状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.OrderStatus.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.PayStatus" class="col-xs-4 control-label">支付状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.PayStatus.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label for="logisticsOrderPayType" class="col-xs-4 control-label">支付方式</label>
                                        <div class="col-xs-8">
                                            <input id="logisticsOrderPayType" name="LogisticsOrder.PayType" type="text" value="@(Model.LogisticsOrder.PayType?.Name)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.GoodsValue" class="col-xs-4 control-label">商品总价</label>
                                        <div class="col-xs-8">
                                            <div class="input-group">
                                                <input asp-for="LogisticsOrder.GoodsValue" type="text" disabled="disabled" class="input-sm form-control"/>
                                                <span class="input-group-addon">RMB</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.OrderAmount" class="col-xs-4 control-label">订单总额</label>
                                        <div class="col-xs-8">
                                            <div class="input-group">
                                                <input asp-for="LogisticsOrder.OrderAmount" type="text" disabled="disabled" class="input-sm form-control"/>
                                                <span class="input-group-addon">RMB</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.PaidAmount" class="col-xs-4 control-label">支付金额</label>
                                        <div class="col-xs-8">
                                            <div class="input-group">
                                                <input asp-for="LogisticsOrder.PaidAmount" type="text" disabled="disabled" class="input-sm form-control"/>
                                                <span class="input-group-addon">RMB</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.CreateTime" class="col-xs-4 control-label">创建时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.CreateTime" value="@(Model.LogisticsOrder.CreateTime.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.PayTime" class="col-xs-4 control-label">支付时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.PayTime" value="@(Model.LogisticsOrder.PayTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.SubmitPackTime" class="col-xs-4 control-label">提交打包时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.SubmitPackTime" value="@(Model.LogisticsOrder.SubmitPackTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.CompletePackTime" class="col-xs-4 control-label">完成打包时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.CompletePackTime" value="@(Model.LogisticsOrder.CompletePackTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.TransferTime" class="col-xs-4 control-label">转运时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.TransferTime" value="@(Model.LogisticsOrder.TransferTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.DeliverTime" class="col-xs-4 control-label">签收时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.DeliverTime" value="@(Model.LogisticsOrder.DeliverTime?.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.RepackType" class="col-xs-4 control-label">打包方式</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.RepackType" type="text" disabled="disabled" class="input-sm form-control" value="@Model.LogisticsOrder.RepackType.Name"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.Insurance" class="col-xs-2 control-label">保险</label>
                                        <div class="col-xs-10">
                                            <input asp-for="LogisticsOrder.Insurance.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-12">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.Gst" class="col-xs-1 control-label">纳税申报</label>
                                        <div class="col-xs-11">
                                            <input asp-for="LogisticsOrder.Gst.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                @* todo 代支付链接和二维码 补上 *@

                            </div>
                        </div>
                    </div>
                </div>

                @* 订单备注 *@
                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelRemark').toggle();">
                            <div style="float: left;">
                                订单备注
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelRemark" style="display: none;">
                            <div class="row">
                                <div style="margin-bottom: 10px; text-align: right;">
                                    <a class="btn btn-mini btn-primary" href="javascript:showLogisticsOrderRemarkDetail();">添加备注</a>
                                </div>

                                <div id="orderRemarkListWrapper">
                                    <partial name="~/Areas/LogisticsOrder/Views/LogisticsOrderRemark/LogisticsOrderRemarkOrderRemarkList.cshtml" model="new LogisticsOrderRemarkOrderRemarkListModel() { LogisticsOrderRemarkList = Model.OrderRemarkList, OrderId = Model.LogisticsOrder.Id }"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelLogisticsInfo').toggle();">
                            <div style="float: left;">
                                物流信息
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelLogisticsInfo" style="display: none;">
                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.Country" class="col-xs-4 control-label">目的国家</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.Country" type="text" value="@(Model.LogisticsOrder.Country.Name)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.Warehouse" class="col-xs-4 control-label">收货仓库</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.Warehouse" type="text" value="@(Model.LogisticsOrder.Warehouse.Name)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.FirstType" class="col-xs-4 control-label">头程物流类型</label>
                                        <div class="col-xs-8">
                                            <input asp-for="LogisticsOrder.FirstType" type="text" value="@(Model.LogisticsOrder.FirstType.Name)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label for="LogisticsOrder.FirstMode.Code" class="col-xs-4 control-label">头程物流编号</label>
                                        <div class="col-xs-8">
                                            <input id="LogisticsOrder.FirstMode.Code" type="text" value="@(Model.LogisticsOrder.FirstMode.Code)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="LogisticsOrder.FirstMode" class="col-xs-2 control-label">头程物流方式</label>
                                        <div class="col-xs-10">
                                            <input asp-for="LogisticsOrder.FirstMode" type="text" value="@(Model.LogisticsOrder.FirstMode.Name)" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelAddress').toggle();">
                            <div style="float: left;">
                                收货地址
                            </div>
                            <div style="float:right; cursor: pointer;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelAddress" style="display: none;">
                            <div class="row">
                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.FirstName" class="col-xs-4 control-label">收货人</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.FirstName" type="text" disabled="disabled" class="input-sm form-control" style="width: 48%; display: inline-block;"/>
                                            <input asp-for="ReceiveAddress.LastName" type="text" disabled="disabled" class="input-sm form-control" style="width: 48%; display: inline-block;"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Mobile" class="col-xs-4 control-label">手机</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Mobile" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Country" class="col-xs-4 control-label">国家</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Country" value="@(Model.ReceiveAddress.Country.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.State" class="col-xs-4 control-label">州</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.State" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.City" class="col-xs-4 control-label">城市</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.City" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Zipcode" class="col-xs-4 control-label">邮政编码</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Zipcode" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Tfn" class="col-xs-4 control-label">ABN/ACN</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Tfn" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Company" class="col-xs-4 control-label">公司</label>
                                        <div class="col-xs-8">
                                            <input asp-for="ReceiveAddress.Company" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="ReceiveAddress.Address" class="col-xs-2 control-label">地址</label>
                                        <div class="col-xs-10">
                                            @if (string.IsNullOrWhiteSpace(Model.ReceiveAddress.UnitLoc)) {
                                                <input asp-for="ReceiveAddress.Address" type="text" disabled="disabled" class="input-sm form-control"/>
                                            } else {
                                                <input asp-for="ReceiveAddress.Address" type="text" disabled="disabled" value="@(Model.ReceiveAddress.UnitLoc), @(Model.ReceiveAddress.Address)" class="input-sm form-control"/>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelSenderAddress').toggle();">
                            <div style="float: left;">
                                发货地址
                            </div>
                            <div style="float:right; cursor: pointer;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelSenderAddress" style="display: none;">
                            <div class="row">
                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Name" class="col-xs-4 control-label">发货人</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Mobile" class="col-xs-4 control-label">手机</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Mobile" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Zipcode" class="col-xs-4 control-label">邮政编码</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Zipcode" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3" style="visibility: hidden;">
                                    <div class="form-group">
                                        <label class="col-xs-4 control-label">&nbsp;</label>
                                        <div class="col-xs-8">
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Province" class="col-xs-4 control-label">省份</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Province" value="@(Model.SendAddress.Province.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.City" class="col-xs-4 control-label">城市</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.City" value="@(Model.SendAddress.City.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Area" class="col-xs-4 control-label">区县</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Area" value="@(Model.SendAddress.Area.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Street" class="col-xs-4 control-label">街道</label>
                                        <div class="col-xs-8">
                                            <input asp-for="SendAddress.Street" value="@(Model.SendAddress.Street.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="SendAddress.Address" class="col-xs-2 control-label">地址</label>
                                        <div class="col-xs-10">
                                            <input asp-for="SendAddress.Address" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelOrderExpress').toggle();">
                            <div style="float: left;">
                                订单商品
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelOrderExpress" style="display: none;">

                            @{
                                int expressNum = 0;
                                foreach (var express in Model.ExpressList) {
                                    expressNum++;

                                    <div class="row" style="padding-top: 10px; background-color: #E1E0F1;">
                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="express_@(express.Id)_num" class="col-xs-4 control-label">快递单序号</label>
                                                <div class="col-xs-8">
                                                    <input id="express_@(express.Id)_num" value="#@(expressNum)" type="text" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="express_@(express.Id)_tracking_no" class="col-xs-4 control-label">快递单号</label>
                                                <div class="col-xs-8">
                                                    @*<input id="express_@(express.Id)_tracking_no" value="@(express.TrackingNo)" type="text" disabled="disabled" class="input-sm form-control"/>*@
                                                    <a asp-area="Express" asp-controller="Express" asp-action="Detail" asp-route-id="@(express.Id)" asp-route-cateId="@(ExpressListMenuCate.All.Id)" target="_blank" style="line-height: 28px;">@(express.TrackingNo)</a>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="express_@(express.Id)_checkin_tracking_no" class="col-xs-4 control-label">入库跟踪号</label>
                                                <div class="col-xs-8">
                                                    <input id="express_@(express.Id)_checkin_tracking_no" value="@(express.CheckinTrackingNo)" type="text" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="express_@(express.Id)_goods_type" class="col-xs-4 control-label">物品类型</label>
                                                <div class="col-xs-8">
                                                    <input id="express_@(express.Id)_goods_type" value="@(express.GoodsType.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="express_@(express.Id)_status" class="col-xs-4 control-label">快递状态</label>
                                                <div class="col-xs-8">
                                                    <input id="express_@(express.Id)_status" value="@(express.Status.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="express_@(express.Id)_add_time" class="col-xs-4 control-label">入库时间</label>
                                                <div class="col-xs-8">
                                                    <input id="express_@(express.Id)_add_time" value="@(express.AddTime.ToString("yyyy-MM-dd HH:mm"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    int expressGoodsNum = 0;
                                    foreach (var expressGoods in express.ExpressGoodsListCache) {
                                        expressGoodsNum++;
                                        <div class="row" style="padding-top: 10px; background-color: #FFEFC1;">

                                            <div class="col-xs-3">
                                                <div class="form-group">
                                                    <label for="express_goods_@(expressGoods.Id)_num" class="col-xs-4 control-label">物品序号</label>
                                                    <div class="col-xs-8">
                                                        <input id="express_goods_@(expressGoods.Id)_num" value="#@(expressGoodsNum)" type="text" disabled="disabled" class="input-sm form-control"/>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xs-3">
                                                <div class="form-group">
                                                    <label for="express_goods_@(expressGoods.Id)_goods_name" class="col-xs-4 control-label">物品名称</label>
                                                    <div class="col-xs-8">
                                                        <input id="express_goods_@(expressGoods.Id)_goods_name" value="@(expressGoods.Goods.Name)" type="text" disabled="disabled" class="input-sm form-control"/>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xs-3">
                                                <div class="form-group">
                                                    <label for="express_goods_@(expressGoods.Id)_price" class="col-xs-4 control-label">单价</label>
                                                    <div class="col-xs-8">
                                                        <div class="input-group">
                                                            <input id="express_goods_@(expressGoods.Id)_price" value="@(expressGoods.Price.ToString("#0.00"))" type="text" disabled="disabled" class="input-sm form-control"/>
                                                            <span class="input-group-addon">RMB</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xs-3">
                                                <div class="form-group">
                                                    <label for="express_goods_@(expressGoods.Id)_quantity" class="col-xs-4 control-label">数量</label>
                                                    <div class="col-xs-8">
                                                        <div class="input-group">
                                                            <input id="express_goods_@(expressGoods.Id)_quantity" value="@(expressGoods.Quantity)" type="text" disabled="disabled" class="input-sm form-control"/>
                                                            <span class="input-group-addon">@(expressGoods.Unit)</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    }
                                }
                            }

                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-12">
                        <div class="detailSubTitle" style="cursor: pointer;" onclick="$('#panelOrderAction').toggle();">
                            <div style="float: left;">
                                操作记录
                            </div>
                            <div style="float: right;">
                                显示/隐藏
                            </div>
                            <div style="clear: both;"></div>
                        </div>
                        <div id="panelOrderAction" style="display: none;">
                            <table id="tblLogisticsOrderActionList" class="data-list-table table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 50px; text-align: center;">序号</th>
                                        <th style="width: 100px; text-align: center;">
                                            操作人
                                        </th>
                                        <th style="width: 130px; text-align: center;">
                                            操作时间
                                        </th>
                                        <th style="width: 150px; text-align: center;">
                                            操作类型
                                        </th>
                                        <th>
                                            操作描述
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.LogisticsOrderActionList.Count != 0) {
                                        int order = 1;
                                        foreach (LogisticsOrderActionInfo logisticsOrderAction in Model.LogisticsOrderActionList) {
                                            <tr>
                                                <td style="text-align: center;">@(order++)</td>
                                                <td style="text-align: center;">@logisticsOrderAction.User?.UserName</td>
                                                <td style="text-align: center;">@logisticsOrderAction.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                                <td style="text-align: center;">@logisticsOrderAction.Type?.Name</td>
                                                <td class="break-word">@logisticsOrderAction.ActionDesc</td>
                                            </tr>
                                        }
                                    } else {
                                        <tr>
                                            <td colspan="5">
                                                暂时没有数据！
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

<div id="logisticsOrderRemarkDetailDialogWrapper"></div>
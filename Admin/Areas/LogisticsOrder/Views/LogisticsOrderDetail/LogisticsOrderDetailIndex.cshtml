<script type="text/javascript">
    function cancelOrder() {
        $.msg.confirm("确认要作废订单吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("CancelOrder", "LogisticsOrderDetail")',
                    type: "POST",
                    data: { "id": "@(Model.Order.Id)" },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        
                        setTimeout(function() {
                            window.location.reload();
                        }, 1000);
                    }
                });
            }
        );
    }

    function completeOrder() {
        $.msg.confirm("确认要完成订单吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("CompleteOrder", "LogisticsOrderDetail")',
                    type: "POST",
                    data: { "id": "@(Model.Order.Id)" },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        
                        setTimeout(function() {
                            window.location.reload();
                        }, 1000);
                    }
                });
            }
        );
    }
</script>
@section Breadcrumb {
    <li class="parent" data-menu="logistics-order-menu">物流订单</li>
    <li class="active" data-menu="logistics-order-seventeen-track-carrier-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-purple btn-sm" onclick="syncCarrierList()">
        <i class="ace-icon fa fa-gears"></i>
        同步数据
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadSeventeenTrackCarrierList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="seventeenTrackCarrierList" data-page-index="0" data-sort-field="@(nameof(SeventeenTrackCarrierInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="seventeenTrackCarrierDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadSeventeenTrackCarrierList();
    });

    function sortSeventeenTrackCarrierList(sortField, sortDir) {
        var list = $('#seventeenTrackCarrierList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadSeventeenTrackCarrierList();
    }

    function loadSeventeenTrackCarrierList(pageIndex) {
        var list = $('#seventeenTrackCarrierList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "SeventeenTrackCarrier")",
            type: "POST",
            data: {
                "@(nameof(SeventeenTrackCarrierListQueryParam.PageIndex))": pageIndex,
                "@(nameof(SeventeenTrackCarrierListQueryParam.SortField))": sortField,
                "@(nameof(SeventeenTrackCarrierListQueryParam.SortDir))": sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#seventeenTrackCarrierList').html(data);

                initListTable("#tblSeventeenTrackCarrierList");
            }
        });
    }

    function showSeventeenTrackCarrierDetail(id) {
        $("#seventeenTrackCarrierDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#seventeenTrackCarrierDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "SeventeenTrackCarrier")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#seventeenTrackCarrierDetailDialogWrapper").html(data);
                $("#seventeenTrackCarrierDetailDialog").modal(modalOptions);
            }
        });
    }
    
    function syncCarrierList() {
        showMask("数据同步中...");

        $.ajax({
            url: '@Url.Action("Sync", "SeventeenTrackCarrier")',
            type: "POST",
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }
                
                loadSeventeenTrackCarrierList();
            }
        });
    }

</script>
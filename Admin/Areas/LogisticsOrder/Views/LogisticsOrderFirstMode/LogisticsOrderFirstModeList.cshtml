@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.LogisticsOrder
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderFirstMode.LogisticsOrderFirstModeListModel

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsOrderFirstModeList" }))

<table id="tblLogisticsOrderFirstModeList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="logisticsOrderFirstModeCheckAll"></label><input id="logisticsOrderFirstModeCheckAll" type="checkbox" class="ace checkall" /><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.OrderAlias).@(nameof(LogisticsOrderFirstModeInfo.Order.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">物流订单</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsOrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.OrderCode))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">订单编号</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsOrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.GoodsType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">物品类型</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsOrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.FirstType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">物流方式类型</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.FirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.FirstMode.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">物流方式</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsOrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.Channel))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">渠道类型</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsOrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.VolumeWeightDenominator))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">体积重分母</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsOrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.TrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">快递单号</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsOrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">创建时间</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsOrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">修改时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.LogisticsOrderFirstModeList.Count != 0) {
            int index = 0;
            foreach (LogisticsOrderFirstModeInfo logisticsOrderFirstMode in Model.LogisticsOrderFirstModeList) {
                <tr ondblclick="showLogisticsOrderFirstModeDetail(@(logisticsOrderFirstMode.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="logisticsOrderFirstModeCheck_@(logisticsOrderFirstMode.Id)"></label><input id="logisticsOrderFirstModeCheck_@(logisticsOrderFirstMode.Id)" type="checkbox" class="ace" value="@logisticsOrderFirstMode.Id" /><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(Model.ItemBegin + index++)</td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsOrderFirstMode.Order?.Id)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsOrderFirstMode.OrderCode)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsOrderFirstMode.GoodsType.Name)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsOrderFirstMode.FirstType.Name)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsOrderFirstMode.FirstMode?.Id)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsOrderFirstMode.Channel.Name)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsOrderFirstMode.VolumeWeightDenominator)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsOrderFirstMode.TrackingNo)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @logisticsOrderFirstMode.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @logisticsOrderFirstMode.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="13">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsOrderFirstModeList" }))
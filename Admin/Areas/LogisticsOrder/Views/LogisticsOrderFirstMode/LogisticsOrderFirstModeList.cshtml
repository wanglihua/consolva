@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.LogisticsOrder
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderFirstMode.LogisticsOrderFirstModeListModel

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsOrderFirstModeList" }))

<table id="tblLogisticsOrderFirstModeList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="logisticsOrderFirstModeCheckAll"></label><input id="logisticsOrderFirstModeCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.OrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.OrderCode))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">订单编号</a>
                </div>
            </th>

            <th style="width: 360px; text-align: left;">
                <div>
                    <a field="@(Model.FirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.FirstMode.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">物流方式</a>
                </div>
            </th>

            <th style="width: 90px; text-align: center;">
                <div>
                    <a field="@(Model.OrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.GoodsType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">物品类型</a>
                </div>
            </th>

            <th style="width: 220px; text-align: center;">
                <div>
                    <a field="@(Model.OrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.TrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">国际单号</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.OrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">创建时间</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.OrderFirstModeAlias).@(nameof(LogisticsOrderFirstModeInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderFirstModeList">修改时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.LogisticsOrderFirstModeList.Count != 0) {
            int index = 0;
            foreach (LogisticsOrderFirstModeInfo orderFirstMode in Model.LogisticsOrderFirstModeList) {
                <tr ondblclick="showLogisticsOrderFirstModeDetail(@(orderFirstMode.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="logisticsOrderFirstModeCheck_@(orderFirstMode.Id)"></label><input id="logisticsOrderFirstModeCheck_@(orderFirstMode.Id)" type="checkbox" class="ace" value="@orderFirstMode.Id"/><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(Model.ItemBegin + index++)</td>

                    <td style="text-align: center;">
                        <div>
                            <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(orderFirstMode.Order.Id)" target="_blank">
                                @ListDataUtil.Render(orderFirstMode.OrderCode)
                            </a>
                        </div>
                    </td>

                    <td style="text-align: left;">
                        <div>
                            @ListDataUtil.Render(orderFirstMode.FirstMode.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(orderFirstMode.GoodsType.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(orderFirstMode.TrackingNo)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @orderFirstMode.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @orderFirstMode.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="9">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsOrderFirstModeList" }))
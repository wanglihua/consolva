@using shunda.Domain
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderFirstMode.LogisticsOrderFirstModeDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="logisticsOrderFirstModeDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">订单订单物流方式详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="logisticsOrderFirstModeDetailForm" class="form-horizontal" role="form">
                    <input asp-for="OrderFirstModeId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="OrderCode" class="col-xs-2 control-label">订单编号</label>
                                <div class="col-xs-10">
                                    <input asp-for="OrderCode" type="text" required="required" class="input-sm form-control" disabled="disabled"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="FirstModeName" class="col-xs-2 control-label">物流方式</label>
                                <div class="col-xs-10">
                                    <input asp-for="FirstModeName" type="text" required="required" class="input-sm form-control" disabled="disabled"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="GoodsType" class="col-xs-2 control-label">物品类型</label>
                                <div class="col-xs-10">
                                    <input asp-for="GoodsType" type="text" value="@(Model.GoodsType.Name)" required="required" class="input-sm form-control" disabled="disabled"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="TrackingNo" class="col-xs-2 control-label">国际单号</label>
                                <div class="col-xs-10">
                                    <input asp-for="TrackingNo" type="text" required="required" maxlength="30" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveLogisticsOrderFirstMode();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
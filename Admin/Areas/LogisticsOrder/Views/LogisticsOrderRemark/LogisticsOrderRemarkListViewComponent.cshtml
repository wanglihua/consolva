@{
    Layout = null;
}
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Service.Express
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderRemark.LogisticsOrderRemarkListViewComponentModel
@if (Model.ShowOrderRemarkAdd && Model.CanOrderRemarkEdit) {
    <div style="margin-bottom: 10px; text-align: right;">
        <a class="btn btn-mini btn-primary" href="javascript:showLogisticsOrderRemarkDetail();">添加备注</a>
    </div>
}
<table id="tblLogisticsOrderRemarkList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 90px; text-align: center;">
                类型
            </th>
            <th style="width: 120px; text-align: center;">
                快递单号
            </th>
            <th>
                备注
            </th>
            <th style="width: 100px; text-align: center;">
                备注人
            </th>
            <th style="width: 120px; text-align: center;">
                备注时间
            </th>
            <th style="width: 90px; text-align: center;">
                操作
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.OrderRemarkList.Count != 0 || Model.ExpressRemarkList.Count != 0) {
            int order = 1;

            foreach (var remark in Model.ExpressRemarkList) {
                <tr>
                    <td style="text-align: center;">@(order++)</td>
                    <td style="text-align: center;">
                        @(remark.Type.Name)
                    </td>
                    <td style="text-align: center;">
                        <a asp-area="Express" asp-controller="ExpressDetail" asp-action="Index" asp-route-id="@(remark.Express.Id)" asp-route-cateId="@(ExpressListMenuCate.All.Id)" target="_blank">@(remark.Express.TrackingNo)</a>
                    </td>
                    <td class="break-word" style="color: red; font-weight: bold;">
                        @(remark.Content)
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @if (remark.AddUser != null) {
                                <span>@(remark.AddUser.UserName)</span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @(remark.CreateTime.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <a asp-area="Express" asp-controller="ExpressDetail" asp-action="Index" asp-route-id="@(remark.Express.Id)" asp-route-cateId="@(ExpressListMenuCate.All.Id)" target="_blank">快递单详细</a>
                    </td>
                </tr>
            }

            foreach (var remark in Model.OrderRemarkList) {
                <tr>
                    <td style="text-align: center;">@(order++)</td>
                    <td style="text-align: center;">
                        @(remark.Type.Name)
                    </td>
                    <td style="text-align: center;">
                        <span>订单备注</span>
                    </td>
                    <td class="break-word" style="color: red; font-weight: bold;">
                        @(remark.Content)
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @if (remark.AddUser != null) {
                                <span>@(remark.AddUser.UserName)</span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @(remark.CreateTime.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </td>
                    <td style="text-align: center;">
                        @if (Model.CanOrderRemarkEdit) {
                            <a href="javascript:deleteLogisticsOrderRemark('@(remark.Id)');">删除</a>
                        }
                    </td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="7">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
    function showLogisticsOrderRemarkDetail() {
        $("#logisticsOrderRemarkDetailDialogWrapper").html("");

        showMask("加载中...");
        $.ajax({
            url: '@Url.Action("Detail", "LogisticsOrderRemark", new { Area = "LogisticsOrder" })',
            type: "POST",
            data: { "orderId": "@(Model.OrderId)" },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#logisticsOrderRemarkDetailDialogWrapper").html(data);
                $("#logisticsOrderRemarkDetailDialog").modal(modalOptions);
            }
        });
    }   

    function saveLogisticsOrderRemark() {
        var form = $("#logisticsOrderRemarkDetailForm");
        var valid = validate(form);        
        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "LogisticsOrderRemark", new { Area = "LogisticsOrder" })',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#logisticsOrderRemarkDetailDialog').modal('hide');
                    loadLogisticsOrderRemarkList();
                }
            });
        }
    }
    
    function loadLogisticsOrderRemarkList() {
        showMask("加载中...");
        $.ajax({
            url: '@Url.Action("OrderRemarkList", "LogisticsOrderRemark", new { Area = "LogisticsOrder" })',
            type: "POST",
            data: { "orderId": "@(Model.OrderId)" },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#orderRemarkListWrapper").html(data);
            }
        });
    }       
    
    function deleteLogisticsOrderRemark(id) {
        $.msg.confirm("确认要删除订单备注吗？", function() {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("SingleDelete", "LogisticsOrderRemark", new { Area = "LogisticsOrder" })',
                type: "POST",
                data: { "id": id },
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }
                    
                    $.msg.show(data.message);
    
                    loadLogisticsOrderRemarkList();
                }
            });
        });
    }

</script>
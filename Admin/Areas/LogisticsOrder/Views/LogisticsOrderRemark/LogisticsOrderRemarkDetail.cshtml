@using Microsoft.AspNetCore.Mvc.TagHelpers
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderRemark.LogisticsOrderRemarkDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="logisticsOrderRemarkDetailDialog">
    <div class="modal-dialog" style="width: 840px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">添加订单备注</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="logisticsOrderRemarkDetailForm" class="form-horizontal" role="form">
                    <input asp-for="Id" type="hidden"/>
                    <div class="row">

                        <input type="hidden" asp-for="OrderId" required="required"/>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="OrderCode" class="col-xs-2 control-label">订单</label>
                                <div class="col-xs-10">
                                    <input asp-for="OrderCode" type="text" class="input-sm form-control" disabled="disabled"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Content" class="col-xs-2 control-label">备注</label>
                                <div class="col-xs-10">
                                    <textarea asp-for="Content" required="required" maxlength="300" rows="3" class="input-sm form-control"></textarea>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button id="btnSaveLogisticsOrderRemark" type="button" class="btn btn-success btn-sm" onclick="saveLogisticsOrderRemark();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
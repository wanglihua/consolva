@using shunda.Core.Config
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderDetailOrderPack.LogisticsOrderDetailOrderPackListViewCompenentModel

@{
    Layout = null;
}

@if (Model.OrderFirstModeList.Count > 0) {
    foreach (var orderFirstMode in Model.OrderFirstModeList) {
        <table id="tblLogisticsOrderPackList" class="data-list-table table table-striped table-bordered table-hover">
            <caption style="padding: 8px; font-weight: bold; color: #2a62bc;">@(orderFirstMode.FirstMode.Name)</caption>
            <thead>
                <tr>
                    <th style="width: 50px; text-align: center;">序号</th>
                    <th style="width: 100px; text-align: center;">
                        <div>物品类型</div>
                    </th>
                    <th style="width: 120px; text-align: center;">
                        单箱长宽高（cm）
                    </th>
                    <th style="width: 120px; text-align: center;">
                        单箱体积（m<sup style="font-size: 8px;">3</sup>）
                    </th>
                    <th style="width: 120px; text-align: center;">
                        单箱体积重（Kg）
                    </th>
                    <th style="width: 120px; text-align: center;">
                        单箱实重（Kg）
                    </th>
                    <th style="width: 80px; text-align: center;">
                        箱数
                    </th>
                    <th style="width: 150px; text-align: center;">
                        箱号
                    </th>
                    <th style="width: 180px; text-align: center;">
                        快递单号
                    </th>
                    <th style="width: 130px; text-align: center;">
                        物品名称
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (orderFirstMode.OrderPackListCache.Count != 0) {
                    int order = 1;
                    foreach (var orderPack in orderFirstMode.OrderPackListCache) {
                        <tr>
                            <td style="text-align: center;">@(order++)</td>
                            <td style="text-align: center;">
                                <div style="color: blue;">
                                    @(orderPack.GoodsType.Name)
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <div>长：@orderPack.Length.ToString("#0.0")cm</div>
                                <div>宽：@orderPack.Width.ToString("#0.0")cm</div>
                                <div>高：@orderPack.Height.ToString("#0.0")cm</div>
                            </td>
                            <td style="text-align: center;">
                                <div>
                                    @((orderPack.Length * orderPack.Width * orderPack.Height / 100_00_00).ToString("#0.000000"))&nbsp;立方
                                </div>
                                @if (Model.HasModifyOrderPackDataPass) {
                                    <div>
                                        <a href="javascript:showOrderPackDetail('@(orderPack.Id)');">修改长宽高重量</a>
                                    </div>
                                }
                            </td>
                            <td style="text-align: center;">@(orderPack.Length * orderPack.Width * orderPack.Height / orderPack.OrderFirstMode.VolumeWeightDenominator).ToString("#0.000")&nbsp;Kg</td>
                            <td style="text-align: center;">@orderPack.Weight.ToString("#0.000")&nbsp;Kg</td>
                            <td style="text-align: center;">@orderPack.PackageCount</td>
                            <td style="text-align: center;" class="break-word">
                                <span>@(string.Join("，", orderPack.PackBoxCodeListCache))</span>
                            </td>
                            <td style="text-align: center;" class="break-word">
                                <span>@(string.Join("，", orderPack.TrackingNoListCache))</span>
                            </td>
                            <td style="text-align: center;" class="break-word">
                                <span>@(string.Join("，", orderPack.GoodsNameListCache))</span>
                            </td>
                            <td></td>
                        </tr>
                    }

                    <tr>
                        <td style="text-align: center;"></td>
                        <td style="text-align: center;"></td>
                        <td style="text-align: center;" class="break-word">该物品类型打包后小计：</td>
                        <td style="text-align: center;">
                            <div>总体积</div>
                            <div>@(orderFirstMode.OrderPackListCache.Sum(e => (e.Length * e.Width * e.Height / 100_00_00)).ToString("#0.000000"))&nbsp;立方</div>
                        </td>
                        <td style="text-align: center;">
                            <div>总体积重：</div>
                            <div>@(orderFirstMode.OrderPackListCache.Sum(e => (e.Length * e.Width * e.Height / e.OrderFirstMode.VolumeWeightDenominator)).ToString("#0.000"))&nbsp;Kg</div>
                        </td>
                        <td style="text-align: center;">
                            <div>总实际重：</div>
                            <div>@(orderFirstMode.OrderPackListCache.Sum(e => e.Weight).ToString("#0.000"))&nbsp;Kg</div>
                        </td>
                        <td style="text-align: center;">
                            <div>总箱数</div>
                            <div>@(orderFirstMode.OrderPackListCache.Sum(e => e.PackageCount))&nbsp;箱</div>
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <table class="data-list-table table table-striped table-bordered table-hover">
        <caption style="padding: 8px; font-weight: bold; color: #2a62bc;">订单总计</caption>
        <thead>
            <tr>
                <th style="width: 50px; text-align: center;"></th>
                <th style="width: 80px; text-align: center;">
                </th>
                <th style="width: 120px; text-align: center;">
                </th>
                <th style="width: 120px; text-align: center;">
                    总体积（m<sup style="font-size: 8px;">3</sup>）
                </th>
                <th style="width: 120px; text-align: center;">
                    总体积重（Kg）
                </th>
                <th style="width: 120px; text-align: center;">
                    总重量（Kg）
                </th>
                <th style="width: 80px; text-align: center;">
                    总箱数
                </th>
                <th style="width: 100px; text-align: center;">
                    最长边
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="text-align: center;"></td>
                <td style="text-align: center;"></td>
                <td style="text-align: center;" class="break-word">该订单打包后总计：</td>
                <td style="text-align: center;">
                    <div>@((Model.OrderPackData.TotalVolume / 1000000).ToString("#0.000000"))&nbsp;立方</div>
                </td>
                <td style="text-align: center;">
                    <div>@(Model.OrderPackData.TotalVolumeWeight.ToString("#0.000"))&nbsp;Kg</div>
                </td>
                <td style="text-align: center;">
                    <div>@(Model.OrderPackData.TotalActualWeight.ToString("#0.000"))&nbsp;Kg</div>
                </td>
                <td style="text-align: center;">
                    <div>@(Model.OrderPackData.TotalPackageCount)&nbsp;箱</div>
                </td>
                <td style="text-align: center;">
                    <div>@(Model.OrderPackData.MaxSideLength)&nbsp;cm</div>
                </td>
                <td>
                </td>
            </tr>
        </tbody>
    </table>
} else {
    <table id="tblLogisticsOrderPackList" class="data-list-table table table-striped table-bordered table-hover">
        <thead>
            <tr>
                <th style="width: 50px; text-align: center;">序号</th>
                <th style="width: 120px; text-align: center;">
                    物品类型
                </th>
                <th style="width: 280px; text-align: center;">
                    单箱 长*宽*高（cm）
                </th>
                <th style="width: 220px; text-align: center;">
                    单箱体积（m<sup style="font-size: 8px;">3</sup>）
                </th>
                <th style="width: 180px; text-align: center;">
                    单箱重量（Kg）
                </th>
                <th style="width: 120px; text-align: center;">
                    箱数
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="7">
                    暂时没有数据！
                </td>
            </tr>
        </tbody>
    </table>
}
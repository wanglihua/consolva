@using shunda.Core.Web
@using shunda.Domain.LogisticsOrder
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderList.LogisticsOrderListModel
@{
    Layout = null;
}

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsOrderList" })

<table id="tblLogisticsOrderList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="logisticsOrderCheckAll"></label><input id="logisticsOrderCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.Code))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">订单编号</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.Customer)).@(nameof(LogisticsOrderInfo.Customer.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">客户ID</a>
                </div>
            </th>

            <th style="width: 90px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.OrderStatus))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">订单状态</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.GoodsType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">产品类型</a>
                </div>
            </th>
            <th style="width: 90px; text-align: right;">
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.GoodsValue))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">物品货值</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.OrderAmount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">费用总额</a>
                </div>
            </th>
            <th style="width: 90px; text-align: right;">
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.ArrearsAmountFormula))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">欠费金额</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.PayStatus))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">支付状态</a>
                </div>
            </th>
            <th style="width: 90px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.Country))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        国家
                    </a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.Warehouse))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        收货仓库
                    </a>
                </div>
            </th>
            <th style="width: 180px;">
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.FirstType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        头程类型
                    </a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.FirstMode))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        头程方式
                    </a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        创建时间
                    </a>
                </div>
                @*
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.TransferTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        转运时间
                    </a>
                </div>
                *@
                <div>
                    <a field="@(nameof(LogisticsOrderInfo.DeliverTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        签收时间
                    </a>
                </div>
            </th>
            <th style="width: 70px; text-align: right;">
                <div>
                    <span>体积重</span>
                </div>
                <div>
                    <span>实际重</span>
                </div>
            </th>
            <th style="width: 70px; text-align: right;">
                <div>
                    <span>最长边</span>
                </div>
                <div>
                    <span>总箱数</span>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.OrderList.Count != 0) {
            int order = 1;
            foreach (LogisticsOrderInfo logisticsOrder in Model.OrderList) {
                var packData = logisticsOrder.PackDataCache;

                <tr ondblclick="showOrderDetail(@(logisticsOrder.Id))">
                    <td style="text-align: center;">
                        <label for="logisticsOrderCheck_@(logisticsOrder.Id)"></label><input id="logisticsOrderCheck_@(logisticsOrder.Id)" type="checkbox" class="ace" value="@logisticsOrder.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center; background-color: @(logisticsOrder.ListColorCache);">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;" class="break-word">
                        <div class="break-word">
                            <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(logisticsOrder.Id)" target="_blank">
                                @logisticsOrder.Code
                            </a>
                        </div>
                        <div>
                            <a href="@Url.Action("Detail", "Customer", new { id = logisticsOrder.Customer.Id })" target="_blank">
                                <span>@(logisticsOrder.CustomerCode)</span>
                            </a>
                            @if (string.IsNullOrWhiteSpace(logisticsOrder.Customer.CustomerCharacter) == false) {
                                <span>(@(logisticsOrder.Customer.CustomerCharacter))</span>
                            }
                            @{
                                string orderRemark = logisticsOrder.OrderRemarkCache;
                                if (string.IsNullOrWhiteSpace(orderRemark) == false) {
                                    <span>&nbsp;<i class="fa fa-file-text order_customer_note_title" title="@(orderRemark)" style="color:burlywood;"></i></span>
                                }
                            }
                        </div>
                        @*
                        <div>
                            <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(logisticsOrder.Id)" target="_blank">查看详细</a>
                        </div>
                        *@
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @(logisticsOrder.OrderStatus.Name)
                        </div>
                        <div>
                            @if (string.IsNullOrWhiteSpace(logisticsOrder.GoodsType.Name) == false) {
                                <span>@logisticsOrder.GoodsType.Name</span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <div>
                            ￥@logisticsOrder.GoodsValue
                        </div>
                        <div>
                            ￥@logisticsOrder.OrderAmount
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <div>
                            ￥@logisticsOrder.ArrearsAmountFormula.ToString("#0.00")
                        </div>
                        <div>
                            <span>
                                @logisticsOrder.PayStatus.Name
                            </span>
                            @if (string.IsNullOrWhiteSpace(logisticsOrder.PayType.Name) == false) {
                                <span>(@(logisticsOrder.PayType.Name))</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @logisticsOrder.Country.Name
                        </div>
                        <div>
                            <span>@(logisticsOrder.Warehouse.Name)</span>
                        </div>
                    </td>
                    <td class="break-word">
                        <div>
                            @(logisticsOrder.FirstType.Name)
                        </div>
                        <div>
                            @(logisticsOrder.FirstMode.Name)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        @ListDataUtil.RenderDateTimeWithDiv(logisticsOrder.CreateTime)
                        @* @ListDataUtil.RenderDateTimeWithDiv(logisticsOrder.TransferTime) *@
                        @ListDataUtil.RenderDateTimeWithDiv(logisticsOrder.DeliverTime)
                    </td>
                    <td style="text-align: right;">
                        <div>
                            @if (packData != null) {
                                <span>
                                    @packData.TotalVolumeWeight.ToString("#0.000")Kg
                                </span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                        <div>
                            @if (packData != null) {
                                <span>
                                    @packData.TotalActualWeight.ToString("#0.000")Kg
                                </span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <div>
                            @if (packData != null) {
                                <span>
                                    @packData.MaxSideLength.ToString("#0.00")cm
                                </span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                        <div>
                            @if (packData != null) {
                                <span>
                                    @(packData.TotalPackageCount)件
                                </span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="12">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsOrderList" })
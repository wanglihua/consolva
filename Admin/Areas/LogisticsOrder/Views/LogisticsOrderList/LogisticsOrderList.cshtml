@using shunda.Core.Web
@using shunda.Domain.LogisticsOrder
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderList.LogisticsOrderListModel
@{
    Layout = null;
}

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsOrderList" })

<table id="tblLogisticsOrderList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="logisticsOrderCheckAll"></label><input id="logisticsOrderCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.OrderCate))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">订单类别</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.Code))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">订单编号</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.CustomerCode))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">客户ID</a>
                </div>
            </th>

            <th style="width: 90px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.OrderStatus))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">订单状态</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.GoodsType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">物品类型</a>
                </div>
            </th>
            <th style="width: 90px; text-align: right;">
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.GoodsValue))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">物品货值</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.OrderAmount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">费用总额</a>
                </div>
            </th>
            <th style="width: 90px; text-align: right;">
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.ArrearsAmount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">欠费金额</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.PayStatus))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">支付状态</a>
                </div>
            </th>
            <th style="width: 90px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.Country))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        国家
                    </a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.WarehouseId))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        收货仓库
                    </a>
                </div>
            </th>
            <th style="width: 180px;">
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.FirstModeType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        头程类型
                    </a>
                </div>
                <div>
                    <span>
                        头程方式
                    </span>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        创建时间
                    </a>
                </div>
                @*
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.TransferTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        转运时间
                    </a>
                </div>
                *@
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.DeliverTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">
                        签收时间
                    </a>
                </div>
            </th>
            <th style="width: 70px; text-align: right;">
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.TotalVolumeWeight))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">体积重</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.TotalActualWeight))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">实际重</a>
                </div>
            </th>
            <th style="width: 70px; text-align: right;">
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.MaxSideLength))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">最长边</a>
                </div>
                <div>
                    <a field="@(nameof(LogisticsOrderListViewInfo.TotalPackPackageCount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsOrderList">总箱数</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.OrderList.Count != 0) {
            int orderNum = 1;
            foreach (var order in Model.OrderList) {
                <tr ondblclick="showOrderDetail(@(order.Id))">
                    <td style="text-align: center;">
                        <label for="logisticsOrderCheck_@(order.Id)"></label><input id="logisticsOrderCheck_@(order.Id)" type="checkbox" class="ace" value="@order.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center; background-color: @(order.ListColorCache);">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + orderNum++)</td>
                    <td style="text-align: center;">
                        <div>
                            <span>
                                @order.OrderCate.Name
                            </span>
                        </div>
                        <div class="break-word">
                            <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(order.Id)" target="_blank">
                                @order.Code
                            </a>
                        </div>
                        <div>
                            <a href="@Url.Action("Detail", "Customer", new { id = order.CustomerId, Area = "Customer" })" target="_blank">
                                <span>@(order.CustomerCode)</span>
                            </a>
                            @if (string.IsNullOrWhiteSpace(order.CustomerCharacter) == false) {
                                <span>(@(order.CustomerCharacter))</span>
                            }
                            @{
                                string orderRemark = order.OrderRemarkCache;
                                if (string.IsNullOrWhiteSpace(orderRemark) == false) {
                                    <span>&nbsp;<i class="fa fa-file-text order_customer_note_title" title="@(orderRemark)" style="color:burlywood;"></i></span>
                                }
                            }
                        </div>
                        @*
                        <div>
                            <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(logisticsOrder.Id)" target="_blank">查看详细</a>
                        </div>
                        *@
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @(order.OrderStatus.Name)
                        </div>
                        <div>
                            @if (string.IsNullOrWhiteSpace(order.GoodsType.Name) == false) {
                                <span>@order.GoodsType.Name</span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <div>
                            ￥@order.GoodsValue
                        </div>
                        <div>
                            ￥@order.OrderAmount
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <div>
                            ￥@order.ArrearsAmount.ToString("#0.00")
                        </div>
                        <div>
                            <span>
                                @order.PayStatus.Name
                            </span>
                            @if (string.IsNullOrWhiteSpace(order.PayType.Name) == false) {
                                <span>(@(order.PayType.Name))</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @order.Country.Name
                        </div>
                        <div>
                            <span>@(order.WarehouseName)</span>
                        </div>
                    </td>
                    <td class="break-word">
                        <div>
                            @(order.FirstModeType.Name)
                        </div>
                        <div>
                            @* @(logisticsOrder.FirstMode.Name) *@
                            @(order.FirstModeNameCache)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        @ListDataUtil.RenderDateTimeWithDiv(order.CreateTime)
                        @* @ListDataUtil.RenderDateTimeWithDiv(logisticsOrder.TransferTime) *@
                        @ListDataUtil.RenderDateTimeWithDiv(order.DeliverTime)
                    </td>
                    <td style="text-align: right;">
                        <div>
                            @if (order.TotalVolumeWeight != null) {
                                <span>
                                    @ListDataUtil.Render(order.TotalVolumeWeight, "#0.000")Kg
                                </span>
                            } else {
                                <span>-</span>
                            }

                        </div>
                        <div>
                            @if (order.TotalActualWeight != null) {
                                <span>
                                    @ListDataUtil.Render(order.TotalActualWeight, "#0.000")Kg
                                </span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <div>
                            @if (order.MaxSideLength != null) {
                                <span>
                                    @ListDataUtil.Render(order.MaxSideLength, "#0.00")cm
                                </span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                        <div>
                            @if (order.TotalPackPackageCount != null) {
                                <span>
                                    @ListDataUtil.Render(order.TotalPackPackageCount)件
                                </span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="12">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsOrderList" })
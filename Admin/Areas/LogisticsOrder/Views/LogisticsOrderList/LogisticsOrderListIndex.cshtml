@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderList
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Fee
@using shunda.Domain.Logistics
@using shunda.Domain.LogisticsOrder
@using shunda.Domain.Storage
@model shunda.Admin.Areas.LogisticsOrder.Models.LogisticsOrderList.LogisticsOrderListIndexModel

@{
    if (Model.MenuType == OrderListMenuType.Active) {
        ViewData[ViewDataKey.Title] = "活动订单";
    }

    if (Model.MenuType == OrderListMenuType.Complete) {
        ViewData[ViewDataKey.Title] = "正常结束订单";
    }

    if (Model.MenuType == OrderListMenuType.Cancel) {
        ViewData[ViewDataKey.Title] = "作废订单";
    }

    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-order-menu">物流订单</li>

    @if (Model.MenuType == OrderListMenuType.Active) {
        <li class="active" data-menu="logistics-order-order-list-active-menu">@(ViewData[ViewDataKey.Title])</li>
    }

    @if (Model.MenuType == OrderListMenuType.Complete) {
        <li class="active" data-menu="logistics-order-order-list-complete-menu">@(ViewData[ViewDataKey.Title])</li>
    }

    @if (Model.MenuType == OrderListMenuType.Cancel) {
        <li class="active" data-menu="logistics-order-order-list-cancel-menu">@(ViewData[ViewDataKey.Title])</li>
    }
}

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="countryQuery">国家</label>&nbsp;
    <select id="countryQuery" style="width: 100px; height: 30px;">
        <option value="0">国家查询</option>
        @foreach (var country in Model.CountryList) {
            <option value="@country.Id">@country.Name</option>
        }
    </select>&nbsp;
    <label for="orderIdQuery">订单ID</label>&nbsp;<input id="orderIdQuery" autocomplete="off" style="width: 100px; height: 30px;" placeholder="订单ID查询"/>&nbsp;

    <label for="codeQuery">订单编号</label>&nbsp;<input id="codeQuery" autocomplete="off" style="width: 120px; height: 30px;" placeholder="订单编号查询"/>&nbsp;

    <label for="trackingNoQuery">快递单号</label>&nbsp;<input id="trackingNoQuery" autocomplete="off" style="width: 120px; height: 30px;" placeholder="快递单号查询"/>&nbsp;

    <label for="customerCodeQuery">客户ID</label>&nbsp;<input id="customerCodeQuery" autocomplete="off" style="width: 100px; height: 30px;" placeholder="客户ID查询"/>&nbsp;

    <label for="mobileQuery">手机号</label>&nbsp;<input id="mobileQuery" autocomplete="off" style="width: 100px; height: 30px;" placeholder="手机号查询"/>&nbsp;

    <label for="orderStatusQuery">订单状态</label>&nbsp;
    <select id="orderStatusQuery" style="width: 100px; height: 30px;">
        <option value="0">订单状态</option>
        @foreach (LogisticsOrderStatus logisticsOrderStatus in Model.OrderStatusList) {
            <option value="@logisticsOrderStatus.Id">@logisticsOrderStatus.Name</option>
        }
    </select>&nbsp;

    <label for="payStatusQuery">支付状态</label>&nbsp;
    <select id="payStatusQuery" style="width: 80px; height: 30px;">
        <option value="0">支付状态</option>
        @foreach (PayStatus payStatus in Model.PayStatusList) {
            <option value="@payStatus.Id">@payStatus.Name</option>
        }
    </select>&nbsp;

    <label for="receivingWarehouseIdQuery">收货仓</label>&nbsp;
    <select id="receivingWarehouseIdQuery" style="width: 100px; height: 30px;">
        <option value="0">收货仓</option>
        @foreach (WarehouseInfo warehouse in Model.ReceivingWarehouseList) {
            <option value="@warehouse.Id">@warehouse.Name</option>
        }
    </select>&nbsp;

    <label for="firstModeTypeQuery">头程物流</label>&nbsp;
    <select id="firstModeTypeQuery" style="width: 100px; height: 30px;">
        <option value="0">头程物流</option>
        @foreach (LogisticsModeType modeType in Model.FirstModeTypeList) {
            <option value="@modeType.Id">@modeType.Name</option>
        }
    </select>&nbsp;

    <label for="beginDateQuery">开始日期</label>&nbsp;<input id="beginDateQuery" style="width: 90px; height: 30px;" placeholder="开始日期" autocomplete="off"/>&nbsp;

    <label for="endDateQuery">截止日期</label>&nbsp;<input id="endDateQuery" style="width: 90px; height: 30px;" placeholder="截止日期" autocomplete="off"/>&nbsp;

    <label for="timeRangeTypeQuery">时间段类型</label>&nbsp;
    <select id="timeRangeTypeQuery" style="width: 110px; height: 30px;">
        @foreach (var rangeType in Model.TimeRangeTypeList) {
            <option value="@rangeType.Id">@rangeType.Name</option>
        }
    </select>&nbsp;

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadLogisticsOrderList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
    @if (Model.MenuType != OrderListMenuType.Cancel) {
        <button class="btn btn-purple btn-sm" style="margin-bottom: 3px; height: 30px;" onclick="exportOrder()">
            <i class="ace-icon fa fa-file-excel-o"></i>
            订单导出
        </button>

        <script type="text/javascript">
            function exportOrder() {
                $.msg.confirm("确认要导出订单吗？", function() {
                    var url = '@Url.Action("Export", "LogisticsOrderList")?' + params;
                    $('<form method="post" action="' + url + '"></form>').appendTo('body').submit().remove();
                    
                    downloadFile({
                        url: "@Url.Action("Export", "LogisticsOrderList")",
                        data: {
                            '@(nameof(LogisticsOrderListQueryParam.MenuType))': '@(Model.MenuType)',
                            '@(nameof(LogisticsOrderListQueryParam.CountryQuery))': $('#countryQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.OrderIdQuery))': $('#orderIdQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.CodeQuery))': $('#codeQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.TrackingNoQuery))': $('#trackingNoQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.CustomerCodeQuery))': $('#customerCodeQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.MobileQuery))': $('#mobileQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.OrderStatusQuery))': $('#orderStatusQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.PayStatusQuery))': $('#payStatusQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.ReceivingWarehouseIdQuery))': $('#receivingWarehouseIdQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.FirstModeTypeQuery))': $('#firstModeTypeQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.BeginDateQuery))': $('#beginDateQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.EndDateQuery))': $('#endDateQuery').val(),
                            '@(nameof(LogisticsOrderListQueryParam.TimeRangeTypeQuery))': $('#timeRangeTypeQuery').val(),
                            }
                        }); 
                });
            }
        </script>

        @if (Model.MenuType == OrderListMenuType.Active && Model.CanImportOrder) {
            <button id="btnImport" class="btn btn-pink btn-sm" style="margin-bottom: 3px; height: 30px;">
                <i class="ace-icon fa fa-file-excel-o"></i>
                订单导入
            </button>

            <div style="line-height: 22px;">
                <a href="/static/excel-template/logistic-order/order_create_template.xlsx">下载订单导入模板</a>
            </div>
        }

        <script type="text/javascript">
            $(function(){
                initUploader();
            });
        
            function initUploader() {
        
                var url = '@Url.Action("Import", "LogisticsOrderList")';
        
                var uploader = new plupload.Uploader({
                    runtimes: 'html5,flash,html4',
                    multi_selection: false,
        
                    browse_button: 'btnImport',
                    file_data_name: "excelFile",
                    url: url,
                    max_file_size: '10000kb',
        
                    filters: [
                        {title: "Excel文件", extensions: "xlsx"}
                    ],
        
                    flash_swf_url: '/plupload/js/Moxie.swf',
        
                    init: {
                        FilesAdded: function () {
                            showMask("上传中，请稍候...");
                            uploader.start();
                        },
                        FileUploaded: function (up, file, response) {
                            hideMask();
                            var result = JSON.parse(response.response);
                            if (result.success !== true) {
                                $.msg.error(result.message);
                                return;
                            } 
                            loadLogisticsOrderList();
                            $.msg.show(result.message);
                        },
                        Error: function (up, err) {
                            $.msg.error("上传发生错误：" + err.code + ", " + err.message);
                        }
                    }
                });
        
                uploader.init();
            }  
        </script>
    }
</div>

<div id="logisticsOrderList" data-page-index="0" data-sort-field="@(nameof(LogisticsOrderInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="logisticsOrderDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function(){
        $('#beginDateQuery').datetimepicker({
            locale: "zh-cn",
            format: 'L'
        });

        $('#endDateQuery').datetimepicker({
            locale: "zh-cn",
            format: 'L',
            useCurrent: false
        });

        $("#beginDateQuery").on("dp.change", function (e) {
            $('#endDateQuery').data("DateTimePicker").minDate(e.date);
        });

        $("#endDateQuery").on("dp.change", function (e) {
            $('#beginDateQuery').data("DateTimePicker").maxDate(e.date);
        });

        loadLogisticsOrderList();
    });

    function sortLogisticsOrderList(sortField, sortDir) {
        var list = $('#logisticsOrderList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadLogisticsOrderList();
    }

    function loadLogisticsOrderList(pageIndex) {
        var list = $('#logisticsOrderList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "LogisticsOrderList")",
            type: "POST",
            data: {
                '@(nameof(LogisticsOrderListQueryParam.MenuType))': '@(Model.MenuType)',
                '@(nameof(LogisticsOrderListQueryParam.CountryQuery))': $('#countryQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.OrderIdQuery))': $('#orderIdQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.CodeQuery))': $('#codeQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.TrackingNoQuery))': $('#trackingNoQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.CustomerCodeQuery))': $('#customerCodeQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.MobileQuery))': $('#mobileQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.OrderStatusQuery))': $('#orderStatusQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.PayStatusQuery))': $('#payStatusQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.ReceivingWarehouseIdQuery))': $('#receivingWarehouseIdQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.FirstModeTypeQuery))': $('#firstModeTypeQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.BeginDateQuery))': $('#beginDateQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.EndDateQuery))': $('#endDateQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.TimeRangeTypeQuery))': $('#timeRangeTypeQuery').val(),
                '@(nameof(LogisticsOrderListQueryParam.PageIndex))': pageIndex,
                '@(nameof(LogisticsOrderListQueryParam.SortField))': sortField,
                '@(nameof(LogisticsOrderListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsOrderList').html(data);

                initListTable("#tblLogisticsOrderList");

                $(".order_customer_note_title").poshytip({
                    showTimeout: 0
                });
            }
        });
    }
    
    function showOrderDetail(id) {
        var url = "@Url.Action("Index", "LogisticsOrderDetail", new { id = 88888 })";
        url = url.replace(/88888/, id);
        window.open(url, "_blank");
    }

</script>
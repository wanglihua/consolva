@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.LogisticsTrack
@model SeventeenTrackNumberEventIndexModel
@using shunda.Admin.Areas.LogisticsTrack.Models.SeventeenTrackNumberEvent
@{
    ViewData[ViewDataKey.Title] = "17TRACK快递单跟踪明细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-track-menu">物流跟踪</li>
    <li class="active" data-menu="logistics-track-seventeen-track-number-menu">快递单号:@(Model.TrackNumber.TrackingNo)</li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

<div id="seventeenTrackNumberEventList" data-page-index="0" data-sort-field="@(nameof(SeventeenTrackNumberEventInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="seventeenTrackNumberEventDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadSeventeenTrackNumberEventList();
    });

    function sortSeventeenTrackNumberEventList(sortField, sortDir) {
        var list = $('#seventeenTrackNumberEventList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadSeventeenTrackNumberEventList();
    }

    function loadSeventeenTrackNumberEventList(pageIndex) {
        var list = $('#seventeenTrackNumberEventList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "SeventeenTrackNumberEvent")",
            type: "POST",
            data: {
                "@(nameof(SeventeenTrackNumberEventListQueryParam.TrackNumberId))": "@(Model.TrackNumberId)"
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#seventeenTrackNumberEventList').html(data);

                initListTable("#tblSeventeenTrackNumberEventList");
            }
        });
    }

</script>
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.LogisticsTrack
@model SeventeenTrackNumberEventIndexModel
@using shunda.Admin.Areas.LogisticsTrack.Models.SeventeenTrackNumberEvent
@{
    Layout = null;
}

<div class="modal fade" id="seventeenTrackNumberEventDialog">
    <div class="modal-dialog" style="width: 840px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">17TRACK快递单跟踪明细 @(Model.TrackNumber.TrackingNo)</h4>
            </div>
            <div class="modal-body clearfix">

                <form id="seventeenTrackNumberEvenForm" class="form-horizontal" role="form">

                    

                    <table id="tblSeventeenTrackNumberEventList" class="data-list-table table table-striped table-bordered table-hover">
                        <caption>
                            <span>快递单号:@(Model.TrackNumber.TrackingNo), 运输商:@(Model.TrackNumber.CarrierKey)&nbsp;@(Model.TrackNumber.CarrierName)</span>
                        </caption>
                        <thead>
                            <tr>
                                <th style="width: 60px; text-align: center;">序号</th>

                                <th style="width: 120px; text-align: center;">
                                    <div>
                                        <span>时间</span>
                                    </div>
                                </th>

                                <th style="width: 120px; text-align: center;">
                                    <div>
                                        <span>里程碑状态</span>
                                    </div>
                                </th>

                                <th style="width: 450px; text-align: center;">
                                    <div>
                                        <span>描述</span>
                                    </div>
                                </th>

                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SeventeenTrackNumberEventList.Count != 0) {
                                int orderNumber = 1;
                                foreach (SeventeenTrackNumberEventInfo seventeenTrackNumberEvent in Model.SeventeenTrackNumberEventList) {
                                    <tr>
                                        <td style="text-align: center;">@(orderNumber++)</td>

                                        <td style="text-align: center;">
                                            <div>
                                                @ListDataUtil.Render(seventeenTrackNumberEvent.EventTime)
                                            </div>
                                        </td>

                                        <td style="text-align: center;">
                                            <div>
                                                @ListDataUtil.Render(seventeenTrackNumberEvent.Stage)
                                            </div>
                                        </td>

                                        <td style="text-align: left;" class="break-word">
                                            <div>
                                                @ListDataUtil.Render(seventeenTrackNumberEvent.EventDesc)
                                            </div>
                                        </td>

                                        <td></td>
                                    </tr>
                                }
                            } else {
                                <tr>
                                    <td colspan="5">
                                        暂时没有数据！
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
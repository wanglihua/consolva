<div id="seventeenTrackNumberEventDialogWrapper"></div>
<script type="text/javascript">
    function showSeventeenTrackNumberEvent(trackNumberId) {
        $("#seventeenTrackNumberEventDialogWrapper").html("");

        showMask("加载中...");
        $.ajax({
            url: '@Url.Action("Index", "SeventeenTrackNumberEvent")',
            type: "POST",
            data: { "trackNumberId": trackNumberId },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#seventeenTrackNumberEventDialogWrapper").html(data);
                $("#seventeenTrackNumberEventDialog").modal(modalOptions);
            }
        });
    }
</script>
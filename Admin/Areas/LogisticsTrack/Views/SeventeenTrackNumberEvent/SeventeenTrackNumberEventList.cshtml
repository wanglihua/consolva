@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.LogisticsTrack
@model shunda.Admin.Areas.LogisticsTrack.Models.SeventeenTrackNumberEvent.SeventeenTrackNumberEventListModel

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadSeventeenTrackNumberEventList" }))

<table id="tblSeventeenTrackNumberEventList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="seventeenTrackNumberEventCheckAll"></label><input id="seventeenTrackNumberEventCheckAll" type="checkbox" class="ace checkall" /><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.TrackNumberAlias).@(nameof(SeventeenTrackNumberEventInfo.TrackNumber.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberEventList">17TRACK注册快递单</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberEventAlias).@(nameof(SeventeenTrackNumberEventInfo.EventTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberEventList">时间</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberEventAlias).@(nameof(SeventeenTrackNumberEventInfo.EventDesc))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberEventList">描述</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberEventAlias).@(nameof(SeventeenTrackNumberEventInfo.Stage))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberEventList">里程碑状态</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberEventAlias).@(nameof(SeventeenTrackNumberEventInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberEventList">创建时间</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberEventAlias).@(nameof(SeventeenTrackNumberEventInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberEventList">修改时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.SeventeenTrackNumberEventList.Count != 0) {
            int index = 0;
            foreach (SeventeenTrackNumberEventInfo seventeenTrackNumberEvent in Model.SeventeenTrackNumberEventList) {
                <tr ondblclick="showSeventeenTrackNumberEventDetail(@(seventeenTrackNumberEvent.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="seventeenTrackNumberEventCheck_@(seventeenTrackNumberEvent.Id)"></label><input id="seventeenTrackNumberEventCheck_@(seventeenTrackNumberEvent.Id)" type="checkbox" class="ace" value="@seventeenTrackNumberEvent.Id" /><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(Model.ItemBegin + index++)</td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumberEvent.TrackNumber?.Id)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumberEvent.EventTime)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumberEvent.EventDesc)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumberEvent.Stage)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @seventeenTrackNumberEvent.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @seventeenTrackNumberEvent.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="9">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadSeventeenTrackNumberEventList" }))
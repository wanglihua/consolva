@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.LogisticsTrack
@model shunda.Admin.Areas.LogisticsTrack.Models.SeventeenTrackCarrier.SeventeenTrackCarrierListModel

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadSeventeenTrackCarrierList" }))

<table id="tblSeventeenTrackCarrierList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="seventeenTrackCarrierCheckAll"></label><input id="seventeenTrackCarrierCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackCarrierAlias).@(nameof(SeventeenTrackCarrierInfo.CarrierKey))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackCarrierList">编号</a>
                </div>
            </th>

            <th style="width: 250px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackCarrierAlias).@(nameof(SeventeenTrackCarrierInfo.CarrierName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackCarrierList">名称</a>
                </div>
            </th>

            <th style="width: 250px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackCarrierAlias).@(nameof(SeventeenTrackCarrierInfo.NameZhCn))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackCarrierList">中文名称1</a>
                </div>
            </th>

            <th style="width: 250px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackCarrierAlias).@(nameof(SeventeenTrackCarrierInfo.NameZhHk))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackCarrierList">中文名称2</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackCarrierAlias).@(nameof(SeventeenTrackCarrierInfo.CountryCode))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackCarrierList">国家编号</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackCarrierAlias).@(nameof(SeventeenTrackCarrierInfo.CountryIso))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackCarrierList">国家代码</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackCarrierAlias).@(nameof(SeventeenTrackCarrierInfo.CarrierGroup))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackCarrierList">分组编号</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.SeventeenTrackCarrierList.Count != 0) {
            int index = 0;
            foreach (SeventeenTrackCarrierInfo carrier in Model.SeventeenTrackCarrierList) {
                <tr ondblclick="showSeventeenTrackCarrierDetail(@(carrier.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="seventeenTrackCarrierCheck_@(carrier.Id)"></label><input id="seventeenTrackCarrierCheck_@(carrier.Id)" type="checkbox" class="ace" value="@carrier.Id"/><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(Model.ItemBegin + index++)</td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(carrier.CarrierKey)
                        </div>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @ListDataUtil.Render(carrier.CarrierName)
                        </div>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @ListDataUtil.Render(carrier.NameZhCn)
                        </div>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @ListDataUtil.Render(carrier.NameZhHk)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(carrier.CountryCode)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(carrier.CountryIso)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(carrier.CarrierGroup)
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="10">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadSeventeenTrackCarrierList" }))
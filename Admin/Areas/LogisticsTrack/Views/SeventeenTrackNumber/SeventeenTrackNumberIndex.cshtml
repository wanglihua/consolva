@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.LogisticsTrack
@model SeventeenTrackNumberIndexModel
@using shunda.Admin.Areas.LogisticsTrack.Models.SeventeenTrackNumber
@{
    ViewData[ViewDataKey.Title] = "17TRACK注册单号";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-track-menu">物流跟踪</li>
    <li class="active" data-menu="logistics-track-seventeen-track-number-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">

    <label for="trackingNoQuery">快递单号</label>&nbsp;<input id="trackingNoQuery" autocomplete="off" style="width: 220px; height: 30px;" placeholder="快递单号查询"/>&nbsp;
    <label for="carrierKeyQuery">运输商代码</label>&nbsp;<input id="carrierKeyQuery" autocomplete="off" style="width: 100px; height: 30px;" placeholder="运输商代码查询"/>&nbsp;
    <label for="carrierNameQuery">运输商名称</label>&nbsp;<input id="carrierNameQuery" autocomplete="off" style="width: 150px; height: 30px;" placeholder="运输商名称模糊查询"/>&nbsp;
    
    <label for="statusQuery">状态</label>&nbsp;
    <select id="statusQuery" style="width: 100px; height: 30px;">
        <option value="0">状态查询</option>
        @foreach (var status in Model.StatusList) {
            <option value="@status.Id">@status.Name</option>
        }
    </select>&nbsp;    

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadSeventeenTrackNumberList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="seventeenTrackNumberList" data-page-index="0" data-sort-field="@(nameof(SeventeenTrackNumberInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="seventeenTrackNumberDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadSeventeenTrackNumberList();
    });

    function sortSeventeenTrackNumberList(sortField, sortDir) {
        var list = $('#seventeenTrackNumberList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadSeventeenTrackNumberList();
    }

    function loadSeventeenTrackNumberList(pageIndex) {
        var list = $('#seventeenTrackNumberList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "SeventeenTrackNumber")",
            type: "POST",
            data: {
                "@(nameof(SeventeenTrackNumberListQueryParam.TrackingNoQuery))": $("#trackingNoQuery").val(),
                "@(nameof(SeventeenTrackNumberListQueryParam.CarrierKeyQuery))": $("#carrierKeyQuery").val(),
                "@(nameof(SeventeenTrackNumberListQueryParam.CarrierNameQuery))": $("#carrierNameQuery").val(),
                "@(nameof(SeventeenTrackNumberListQueryParam.StatusQuery))": $("#statusQuery").val(),
                "@(nameof(SeventeenTrackNumberListQueryParam.PageIndex))": pageIndex,
                "@(nameof(SeventeenTrackNumberListQueryParam.SortField))": sortField,
                "@(nameof(SeventeenTrackNumberListQueryParam.SortDir))": sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#seventeenTrackNumberList').html(data);

                initListTable("#tblSeventeenTrackNumberList");
            }
        });
    }

    function showSeventeenTrackNumberDetail(id) {
        $("#seventeenTrackNumberDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#seventeenTrackNumberDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "SeventeenTrackNumber")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#seventeenTrackNumberDetailDialogWrapper").html(data);
                $("#seventeenTrackNumberDetailDialog").modal(modalOptions);
            }
        });
    }

</script>

<partial name="~/Areas/LogisticsTrack/Views/SeventeenTrackNumberEvent/SeventeenTrackNumberEventDialogWrapperByTrackNumberId.cshtml"/>
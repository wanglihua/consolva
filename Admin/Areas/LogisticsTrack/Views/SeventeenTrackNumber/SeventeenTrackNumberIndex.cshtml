@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.LogisticsTrack
@model SeventeenTrackNumberIndexModel
@using shunda.Admin.Areas.LogisticsTrack.Models.SeventeenTrackNumber
@{
    ViewData[ViewDataKey.Title] = "17TRACK注册单号";
    Layout = "_AdminLayout";
}

@*

        <li id="logistics-track-menu">
            <a href="#" class="dropdown-toggle">
                <i class="menu-icon fa fa-copy"></i>
                <span class="menu-text">物流跟踪</span>
                <b class="arrow fa fa-angle-down"></b>
            </a>
            <b class="arrow"></b>

@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.LogisticsTrack
@model shunda.Admin.Areas.LogisticsTrack.Models.SeventeenTrackNumber.SeventeenTrackNumberListModel

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadSeventeenTrackNumberList" }))

<table id="tblSeventeenTrackNumberList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="seventeenTrackNumberCheckAll"></label><input id="seventeenTrackNumberCheckAll" type="checkbox" class="ace checkall" /><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberAlias).@(nameof(SeventeenTrackNumberInfo.TrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberList">快递单号</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberAlias).@(nameof(SeventeenTrackNumberInfo.CarrierKey))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberList">服务商代码</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberAlias).@(nameof(SeventeenTrackNumberInfo.CarrierName))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberList">服务商名称</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberAlias).@(nameof(SeventeenTrackNumberInfo.Origin))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberList">运输商识别</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberAlias).@(nameof(SeventeenTrackNumberInfo.ErrorCode))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberList">错误代码</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberAlias).@(nameof(SeventeenTrackNumberInfo.ErrorMessage))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberList">错误描述</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberAlias).@(nameof(SeventeenTrackNumberInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberList">状态</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberAlias).@(nameof(SeventeenTrackNumberInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberList">创建时间</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.SeventeenTrackNumberAlias).@(nameof(SeventeenTrackNumberInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSeventeenTrackNumberList">修改时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.SeventeenTrackNumberList.Count != 0) {
            int index = 0;
            foreach (SeventeenTrackNumberInfo seventeenTrackNumber in Model.SeventeenTrackNumberList) {
                <tr ondblclick="showSeventeenTrackNumberDetail(@(seventeenTrackNumber.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="seventeenTrackNumberCheck_@(seventeenTrackNumber.Id)"></label><input id="seventeenTrackNumberCheck_@(seventeenTrackNumber.Id)" type="checkbox" class="ace" value="@seventeenTrackNumber.Id" /><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(Model.ItemBegin + index++)</td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumber.TrackingNo)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumber.CarrierKey)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumber.CarrierName)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumber.Origin.Name)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumber.ErrorCode)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumber.ErrorMessage)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(seventeenTrackNumber.Status.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @seventeenTrackNumber.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @seventeenTrackNumber.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="12">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadSeventeenTrackNumberList" }))
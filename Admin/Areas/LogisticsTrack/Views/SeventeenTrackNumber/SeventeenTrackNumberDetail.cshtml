@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain
@using shunda.Domain.LogisticsTrack
@model shunda.Admin.Areas.LogisticsTrack.Models.SeventeenTrackNumber.SeventeenTrackNumberDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="seventeenTrackNumberDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">17TRACK注册单号详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="seventeenTrackNumberDetailForm" class="form-horizontal" role="form">
                    <input asp-for="SeventeenTrackNumberId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="TrackingNo" class="col-xs-2 control-label">快递单号</label>
                                <div class="col-xs-10">
                                    <input asp-for="TrackingNo" type="text" required="required" maxlength="30" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="CarrierKey" class="col-xs-2 control-label">服务商代码</label>
                                <div class="col-xs-10">
                                    <input asp-for="CarrierKey" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="CarrierName" class="col-xs-2 control-label">服务商名称</label>
                                <div class="col-xs-10">
                                    <input asp-for="CarrierName" type="text" required="required" maxlength="100" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Origin" class="col-xs-2 control-label">运输商识别</label>
                                <div class="col-xs-10">
                                    <select asp-for="Origin" required="required" digits="true" class="input-sm form-control">
                                        <option value=""></option>
                                        @foreach(SeventeenTrackNumberOrigin type in Model.OriginList) {
                                            <option value="@(type.Id)">@(type.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ErrorCode" class="col-xs-2 control-label">错误代码</label>
                                <div class="col-xs-10">
                                    <input asp-for="ErrorCode" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ErrorMessage" class="col-xs-2 control-label">错误描述</label>
                                <div class="col-xs-10">
                                    <input asp-for="ErrorMessage" type="text" required="required" maxlength="300" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Status" class="col-xs-2 control-label">状态</label>
                                <div class="col-xs-10">
                                    <select asp-for="Status" required="required" digits="true" class="input-sm form-control">
                                        <option value=""></option>
                                        @foreach(SeventeenTrackNumberStatus type in Model.StatusList) {
                                            <option value="@(type.Id)">@(type.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveSeventeenTrackNumber();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
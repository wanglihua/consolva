@using shunda.Core.Web
@model shunda.Admin.Areas.Wechat.Models.WechatOfficialAccountMenu.WechatOfficialAccountMenuIndexModel

@{
    ViewData[ViewDataKey.Title] = "微信公众号菜单";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="wechat-menu">微信设置</li>
    <li class="active" data-menu="wechat-official-account-menu-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-success btn-sm" onclick="createMenu();">
        <i class="ace-icon fa fa-plus"></i>
        创建菜单
    </button>

    <button type="button" class="btn btn-danger btn-sm" onclick="createMenu();">
        <i class="ace-icon fa fa-remove"></i>
        删除菜单
    </button>
</div>

<script type="text/javascript">
    
    function createMenu() {
        $.msg.confirm("确认要创建微信公众号菜单吗？", function() {
            $.ajax({
                url: '@Url.Action("Create", "WechatOfficialAccountMenu")',
                type: "POST",
                success: function(data) {
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    } 
                    
                    $.msg.show(data.message);
                }
            });
        });
    }
    
    function deleteMenu() {
        $.msg.confirm("确认要删除微信公众号菜单吗？", function() {
            $.ajax({
                url: '@Url.Action("Delete", "WechatOfficialAccountMenu")',
                type: "POST",
                success: function(data) {
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    } 
                    
                    $.msg.show(data.message);
                }
            });
        });
    }
</script>
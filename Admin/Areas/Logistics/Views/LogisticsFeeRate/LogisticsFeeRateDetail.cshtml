<script type="text/javascript">

    function saveLogisticsFeeRate() {
        var form = $("#logisticsFeeRateDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "LogisticsFeeRate")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);

                    if (data.create) {
                        setTimeout("showDetail(" + data.id + ")", 1000);
                    }

                    //return;
                }
            });
        }
        else
        {
            $.msg.error("存在页面数据录入错误，请检查录入数据！");
        }
    }

    function showLogisticsFeeRateDetail(id) {
        var url = "@Url.Action("Detail", "LogisticsFeeRate", new { id = 88888 })";
        url = url.replace("88888", id);
        window.location.href = url;
    }

</script>
@using shunda.Core.Config
@using shunda.Core.Web
@model shunda.Admin.Areas.Logistics.Models.LogisticsFeeRate.LogisticsFeeRateDetailModel
@{
    ViewData[ViewDataKey.Title] = "物流费率详细";
    Layout = "_AdminLayout";
}

@section Style {
    <style>
    div.widget-box {
        margin-bottom: 10px;
    }

    div.widget-box > div.widget-header {
        min-height: 28px;
    }

    div.widget-box > div.widget-header > h4.widget-title {
        font-size: 12px;
        line-height: 28px;
        padding: 0;
        margin: 0;
        display: inline;
    }

    div.widget-box > div.widget-body > div.widget-main {
        padding: 8px 10px 0;
    }
</style>
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-menu">物流设置</li>
    <li class="active" data-menu="logistics-logistics-fee-rate-index-menu">
        <a asp-controller="LogisticsFeeRate" asp-action="Index">通用费率</a>
    </li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button class="btn btn-success btn-sm" onclick="saveLogisticsFeeRate();">
        <i class="ace-icon fa fa-floppy-o"></i>
        保存
    </button>
    <a type="button" class="btn btn-info btn-sm" asp-controller="LogisticsFeeRate" asp-action="Index">
        <i class="ace-icon fa fa-arrow-left"></i>
        返回
    </a>
</div>

<div>
    <div class="widget-box" style="border-style: none; width: 860px;">
        <div class="widget-body">
            <div class="widget-main">
                <form id="logisticsFeeRateDetailForm" class="form-horizontal" role="form">
                    <input asp-for="LogisticsFeeRate.Id" type="hidden"/>

                    <div class="widget-box">
                        <div class="widget-header">
                            <h4 class="widget-title">
                                基本信息
                            </h4>
                        </div>
                        <div class="widget-body">
                            <div class="widget-main">
                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.Name" class="col-xs-4 control-label">名称</label>
                                            <div class="col-xs-8">
                                                <input asp-for="LogisticsFeeRate.Name" type="text" required="required" maxlength="200" class="input-sm form-control"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.Status" class="col-xs-4 control-label">状态</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.Status" class="input-sm form-control">
                                                    @foreach (var status in Model.StatusList) {
                                                        <option value="@status.Id">@status.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="widget-box">
                        <div class="widget-header">
                            <h4 class="widget-title">
                                计量取向
                            </h4>
                        </div>
                        <div class="widget-body">
                            <div class="widget-main">
                                <div class="row">
                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.CareVolumeWeight" class="col-xs-4 control-label">考虑体积重</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.CareVolumeWeight" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，不考虑</option>
                                                    <option value="@(true.ToString())">是，考虑</option>
                                                </select>
                                                <div class="help-block">考虑体积重启用后，跟体积重相关的逻辑才会启用。</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.VolumeDenominator" class="col-xs-4 control-label">体积重分母</label>
                                            <div class="col-xs-8">
                                                <input asp-for="LogisticsFeeRate.VolumeDenominator" type="number" required="required" min="1" step="1" class="input-sm form-control"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.CareVolumeActualWeightRatio" class="col-xs-4 control-label">考虑体积重实际重倍率</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.CareVolumeActualWeightRatio" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，不考虑</option>
                                                    <option value="@(true.ToString())">是，考虑</option>
                                                </select>
                                                <div class="help-block">考虑体积重启用后，这个配置才会起作用。</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.MinVolumeActualWeightRatio" class="col-xs-4 control-label">体积重实际重最小倍率</label>
                                            <div class="col-xs-8">
                                                <input asp-for="LogisticsFeeRate.MinVolumeActualWeightRatio" type="number" class="input-sm form-control"/>
                                                <div class="help-block">大于这个倍率，考虑体积重。考虑体积重启用，考虑体积重实际重倍率，这个设置才会起作用。</div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.VolumeWeightCareMaxSideLength" class="col-xs-4 control-label">体积重考虑最长边</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.VolumeWeightCareMaxSideLength" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，不考虑</option>
                                                    <option value="@(true.ToString())">是，考虑</option>
                                                </select>
                                                <div class="help-block">考虑体积重启用后，这个配置才会起作用。</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.VolumeWeightMaxSideLengthBegin" class="col-xs-4 control-label">体积重最长边起始</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.VolumeWeightMaxSideLengthBegin" type="number" class="input-sm form-control"/>
                                                    <span class="input-group-addon">cm</span>
                                                </div>
                                                <div class="help-block">大于这个长度，考虑体积重。考虑体积重启用，体积重考虑最长边，这个设置才会起作用。</div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.CareSideSum" class="col-xs-4 control-label">考虑三边之和</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.CareSideSum" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，不考虑</option>
                                                    <option value="@(true.ToString())">是，考虑</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.VolumeWeightResultType" class="col-xs-4 control-label">体积重计算取向</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.VolumeWeightResultType" class="input-sm form-control">
                                                    @foreach (var orientationInfo in Model.VolumeWeightResultTypeList) {
                                                        <option value="@orientationInfo.Id">@orientationInfo.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.VolumeActualWeightMiddle" class="col-xs-4 control-label">体积重实际重折中</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.VolumeActualWeightMiddle" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，不启用</option>
                                                    <option value="@(true.ToString())">是，启用</option>
                                                </select>
                                                <div class="help-block">启用时需要同时启用考虑体积重，否则启用无效。</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6" style="visibility: hidden;height: 61px;">
                                        <div class="form-group">
                                            <label for="nothing1" class="col-xs-4 control-label">&nbsp;</label>
                                            <div class="col-xs-8">
                                                <input id="nothing1" type="text"/>
                                            </div>
                                            <div class="help-block">&nbsp;</div>
                                        </div>
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.CareGoodsVolumePrice" class="col-xs-4 control-label">考虑体积货值</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.CareGoodsVolumePrice" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，不考虑</option>
                                                    <option value="@(true.ToString())">是，考虑</option>
                                                </select>
                                                <div class="help-block">是否启用实际货值与体积货值最大值计算</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.GoodsVolumePrice" class="col-xs-4 control-label">体积货值</label>
                                            <div class="col-xs-8">
                                                <input asp-for="LogisticsFeeRate.GoodsVolumePrice" type="number" min="0" step="1" class="input-sm form-control"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="widget-box">
                        <div class="widget-header">
                            <h4 class="widget-title">
                                长度
                            </h4>
                        </div>
                        <div class="widget-body">
                            <div class="widget-main">
                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.HasLengthStart" class="col-xs-4 control-label">长度起步</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.HasLengthStart" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，无长度起步</option>
                                                    <option value="@(true.ToString())">是，有长度起步</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.LengthStart" class="col-xs-4 control-label">起步长度</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.LengthStart" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">cm</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.HasLengthLimit" class="col-xs-4 control-label">长度限制</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.HasLengthLimit" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，无限制</option>
                                                    <option value="@(true.ToString())">是，有限制</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.LengthLimit" class="col-xs-4 control-label">限制长度</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.LengthLimit" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">cm</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.CanOverLength" class="col-xs-4 control-label">能否超长</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.CanOverLength" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，不能超长</option>
                                                    <option value="@(true.ToString())">是，可以超长</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.OverLengthStep" class="col-xs-4 control-label">超长阶梯</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.OverLengthStep" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">cm</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.OverLengthStepFee" class="col-xs-4 control-label">超长阶梯收费</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.OverLengthStepFee" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">RMB/次</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.OverLengthFeeEveryPack" class="col-xs-4 control-label">超长是否按件计费</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.OverLengthFeeEveryPack" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，只收一件</option>
                                                    <option value="@(true.ToString())">是，按实际超长件数</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.HasOverLengthCapAmount" class="col-xs-4 control-label">是否费用封顶</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.HasOverLengthCapAmount" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，无封顶</option>
                                                    <option value="@(true.ToString())">是，有封顶</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.OverLengthCapAmount" class="col-xs-4 control-label">封顶金额</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.OverLengthCapAmount" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">RMB</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="widget-box">
                        <div class="widget-header">
                            <h4 class="widget-title">
                                单箱重量
                            </h4>
                        </div>
                        <div class="widget-body">
                            <div class="widget-main">
                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.HasSingleWeightStart" class="col-xs-4 control-label">单箱重量起步</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.HasSingleWeightStart" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，无单箱重量起步</option>
                                                    <option value="@(true.ToString())">是，有单箱重量起步</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.SingleWeightStart" class="col-xs-4 control-label">单箱起步重量</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.SingleWeightStart" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">kg</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.HasSingleWeightLimit" class="col-xs-4 control-label">单箱重量限制</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.HasSingleWeightLimit" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，无限制</option>
                                                    <option value="@(true.ToString())">是，有限制</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.SingleWeightLimit" class="col-xs-4 control-label">单箱限制重量</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.SingleWeightLimit" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">kg</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.CanSingleOverWeight" class="col-xs-4 control-label">单箱能否超重</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.CanSingleOverWeight" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，不能超重</option>
                                                    <option value="@(true.ToString())">是，可以超重</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.SingleOverWeightStep" class="col-xs-4 control-label">单箱超重阶梯</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.SingleOverWeightStep" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">kg</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.SingleOverWeightStepFee" class="col-xs-4 control-label">单箱超重阶梯收费</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.SingleOverWeightStepFee" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">RMB/次</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6" style="height: 37px;"></div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.HasSingleOverWeightCapAmount" class="col-xs-4 control-label">是否费用封顶</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.HasSingleOverWeightCapAmount" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，无封顶</option>
                                                    <option value="@(true.ToString())">是，有封顶</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.SingleOverWeightCapAmount" class="col-xs-4 control-label">封顶金额</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.SingleOverWeightCapAmount" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">RMB</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="widget-box">
                        <div class="widget-header">
                            <h4 class="widget-title">
                                平均单箱重量
                            </h4>
                        </div>
                        <div class="widget-body">
                            <div class="widget-main">
                                <div class="row">

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.HasAverageWeightStart" class="col-xs-4 control-label">平均单箱重量起步</label>
                                            <div class="col-xs-8">
                                                <select asp-for="LogisticsFeeRate.HasAverageWeightStart" required="required" class="input-sm form-control">
                                                    <option value="@(false.ToString())">否，无平均单箱重量起步</option>
                                                    <option value="@(true.ToString())">是，有平均单箱重量起步</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">
                                            <label asp-for="LogisticsFeeRate.AverageWeightStart" class="col-xs-4 control-label">平均单箱起步重量</label>
                                            <div class="col-xs-8">
                                                <div class="input-group">
                                                    <input asp-for="LogisticsFeeRate.AverageWeightStart" type="number" min="0" step="1" class="input-sm form-control"/>
                                                    <span class="input-group-addon">kg</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-6">
                                        <div class="form-group">

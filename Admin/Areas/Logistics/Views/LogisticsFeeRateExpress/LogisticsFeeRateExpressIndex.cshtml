@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Core.Web
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsFeeRateExpress.LogisticsFeeRateExpressIndexModel
@{
    ViewData[ViewDataKey.Title] = Model.LogisticsMode.Code + " " + Model.LogisticsMode.Name + " 具体费率";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-menu">物流设置</li>
    <li class="active" data-menu="logistics-logistics-mode-index-menu">
        <a asp-controller="LogisticsMode" asp-action="Index" asp-route-typeId="@(Model.LogisticsMode.Type.Id)">物流列表</a>
    </li>

    @if (Model.LogisticsMode.Cate == LogisticsModeCate.Inner)
    {
        <li>
            <a asp-controller="LogisticsModeInner" asp-action="Index" asp-route-typeId="@(Model.LogisticsMode.Type.Id)">内部物流列表</a>
        </li>
    }

    <li>
        @(ViewData[ViewDataKey.Title])
    </li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-success btn-sm" onclick="saveLogisticsFeeRateExpress();">
        <i class="ace-icon fa fa-floppy-o"></i>
        保存
    </button>

    @if (Model.LogisticsMode.Cate == LogisticsModeCate.Customer)
    {
        <a type="button" class="btn btn-info btn-sm" asp-controller="LogisticsMode" asp-action="Index" asp-route-typeId="@(Model.LogisticsMode.Type.Id)">
            <i class="ace-icon fa fa-arrow-left"></i>
            返回
        </a>
    }

    @if (Model.LogisticsMode.Cate == LogisticsModeCate.Inner)
    {
        <a type="button" class="btn btn-info btn-sm" asp-controller="LogisticsModeInner" asp-action="Index" asp-route-typeId="@(Model.LogisticsMode.Type.Id)">
            <i class="ace-icon fa fa-arrow-left"></i>
            返回
        </a>
    }

</div>

<div>
    <div class="widget-box" style="border-style: none; width: 780px;">
        <div class="widget-body">
            <div class="widget-main">
                <form id="logisticsFeeRateExpressDetailForm" class="form-horizontal" role="form">
                    <input asp-for="LogisticsFeeRateExpress.Id" type="hidden"/>
                    <input asp-for="LogisticsFeeRateExpress.LogisticsModeId" type="hidden"/>
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsFeeRateExpress.StartWeight" class="col-xs-3 control-label">起步重量</label>
                                <div class="col-xs-9">
                                    <div class="input-group">
                                        <input asp-for="LogisticsFeeRateExpress.StartWeight" type="number" step="0.1" required="required" class="input-sm form-control"/>
                                        <span class="input-group-addon">kg</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsFeeRateExpress.StartPrice" class="col-xs-3 control-label">起步价格</label>
                                <div class="col-xs-9">
                                    <div class="input-group">
                                        <input asp-for="LogisticsFeeRateExpress.StartPrice" type="number" step="1" required="required" class="input-sm form-control"/>
                                        <span class="input-group-addon">RMB</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsFeeRateExpress.StepWeight" class="col-xs-3 control-label">阶梯重量</label>
                                <div class="col-xs-9">
                                    <div class="input-group">
                                        <input asp-for="LogisticsFeeRateExpress.StepWeight" type="number" step="0.1" required="required" class="input-sm form-control"/>
                                        <span class="input-group-addon">kg</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsFeeRateExpress.StepPrice" class="col-xs-3 control-label">阶梯价格</label>
                                <div class="col-xs-9">
                                    <div class="input-group">
                                        <input asp-for="LogisticsFeeRateExpress.StepPrice" type="number" step="1" required="required" class="input-sm form-control"/>
                                        <span class="input-group-addon">RMB</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsFeeRateExpress.StartFreeMinWeight" class="col-xs-3 control-label">首重免费最小总重</label>
                                <div class="col-xs-9">
                                    <div class="input-group">
                                        <input asp-for="LogisticsFeeRateExpress.StartFreeMinWeight" type="number" step="1" class="input-sm form-control"/>
                                        <span class="input-group-addon">kg</span>
                                    </div>
                                    <div class="help-block">保存大于0的数值，将启用首重免费; 保存等于0或者小于0的数值，将禁用首重免费。</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsFeeRateExpress.WeightBreakStart" class="col-xs-3 control-label">重量满减起始重量</label>
                                <div class="col-xs-9">
                                    <div class="input-group">
                                        <span class="input-group-addon">满</span>
                                        <input asp-for="LogisticsFeeRateExpress.WeightBreakStart" type="number" step="1" class="input-sm form-control"/>
                                        <span class="input-group-addon">kg</span>
                                    </div>
                                    <div class="help-block">保存大于0的数据，将启用重量满减优惠；保存等于0或者小于0的数值，将禁用重量满减优惠。</div>
                                    <div class="help-block">满，减 同时设置正确后启用重量满减。</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsFeeRateExpress.WeightBreakDiscount" class="col-xs-3 control-label">重量满减优惠重量</label>
                                <div class="col-xs-9">
                                    <div class="input-group">
                                        <span class="input-group-addon">减</span>
                                        <input asp-for="LogisticsFeeRateExpress.WeightBreakDiscount" type="number" step="0.1" class="input-sm form-control"/>
                                        <span class="input-group-addon">kg</span>
                                    </div>
                                    <div class="help-block">保存大于0的数据，将启用重量满减优惠；保存等于0或者小于0的数值，将禁用重量满减优惠。</div>
                                    <div class="help-block">满，减 同时设置正确后启用重量满减。</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function saveLogisticsFeeRateExpress() {
        var form = $("#logisticsFeeRateExpressDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "LogisticsFeeRateExpress")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        //return;
                    } else {
                        $("#LogisticsFeeRateExpress_Id").val(data.id);
                        $.msg.show(data.message);
                        //return;
                    }
                }
            });
        }
    }

</script>
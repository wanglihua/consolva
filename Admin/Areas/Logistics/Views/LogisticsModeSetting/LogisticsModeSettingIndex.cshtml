@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Logistics
@model LogisticsModeSettingIndexModel
@using shunda.Admin.Areas.Logistics.Models.LogisticsModeSetting
@{
    ViewData[ViewDataKey.Title] = "物流配置";
    Layout = "_AdminLayout";
}

@*

        <li id="logistics-menu">
            <a href="#" class="dropdown-toggle">
                <i class="menu-icon fa fa-copy"></i>
                <span class="menu-text">物流配置</span>
                <b class="arrow fa fa-angle-down"></b>
            </a>
            <b class="arrow"></b>
            <ul class="submenu">

                <li id="logistics-logistics-mode-setting-menu">
                    <a asp-area="Logistics" asp-controller="LogisticsModeSetting" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>物流配置

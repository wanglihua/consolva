@section Breadcrumb {
    <li class="parent" data-menu="logistics-menu">物流配置</li>
    <li class="active" data-menu="logistics-logistics-mode-setting-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadLogisticsModeSettingList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showLogisticsModeSettingDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteLogisticsModeSetting()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadLogisticsModeSettingList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="logisticsModeSettingList" data-page-index="0" data-sort-field="@(nameof(LogisticsModeSettingInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="logisticsModeSettingDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadLogisticsModeSettingList();
    });

    function sortLogisticsModeSettingList(sortField, sortDir) {
        var list = $('#logisticsModeSettingList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadLogisticsModeSettingList();
    }

    function loadLogisticsModeSettingList(pageIndex) {
        var list = $('#logisticsModeSettingList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "LogisticsModeSetting")",
            type: "POST",
            data: {
                "@(nameof(LogisticsModeSettingListQueryParam.PageIndex))": pageIndex,
                "@(nameof(LogisticsModeSettingListQueryParam.SortField))": sortField,
                "@(nameof(LogisticsModeSettingListQueryParam.SortDir))": sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsModeSettingList').html(data);

                initListTable("#tblLogisticsModeSettingList");
            }
        });
    }

    function showLogisticsModeSettingDetail(id) {
        $("#logisticsModeSettingDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#logisticsModeSettingDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "LogisticsModeSetting")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#logisticsModeSettingDetailDialogWrapper").html(data);
                $("#logisticsModeSettingDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveLogisticsModeSetting() {
        var form = $("#logisticsModeSettingDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "LogisticsModeSetting")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#logisticsModeSettingDetailDialog').modal('hide');
                    loadLogisticsModeSettingList();
                }
            });
        }
    }

    function deleteLogisticsModeSetting() {
        var idList = getSelectIdList('#tblLogisticsModeSettingList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "LogisticsModeSetting")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        loadLogisticsModeSettingList();
                    }
                });
            }
        );
    }

</script>
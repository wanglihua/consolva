@using shunda.Core.Web
@model shunda.Admin.Areas.Logistics.Models.LogisticsModeSetting.LogisticsModeSettingIndexModel
@{
    ViewData[ViewDataKey.Title] = "物流配置";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-menu">物流配置</li>
    <li class="active" data-menu="logistics-logistics-mode-setting-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button class="btn btn-success btn-sm" onclick="saveLogisticsModeSetting();">
        <i class="ace-icon fa fa-floppy-o"></i>
        保存
    </button>
</div>

<div class="widget-box" style="border-style: none; width: 860px;">
    <div class="widget-body">
        <div class="widget-main">
            <form id="logisticsModeSettingDetailForm" class="form-horizontal" role="form">
                <input asp-for="LogisticsModeSettingId" type="hidden"/>

                <div class="row">

                    <div class="col-xs-6">
                        <div class="form-group">
                            <label asp-for="VolumeWeightDenominator" class="col-xs-4 control-label">默认体积重分母</label>
                            <div class="col-xs-8">
                                <input asp-for="VolumeWeightDenominator" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>
                                <div class="help-block">计算体积重时，如果还没跟具体物流方式关联，就用这里的体积重分母计算。</div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-xs-6">
                        <div class="form-group">
                            <label asp-for="HasFreePackageLimit" class="col-xs-4 control-label">免费数量限制</label>
                            <div class="col-xs-8">
                                <select asp-for="HasFreePackageLimit" required="required" class="input-sm form-control">
                                    <option value="@(false.ToString())">否，无限制</option>
                                    <option value="@(true.ToString())">是，有限制</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-6">
                        <div class="form-group">
                            <label asp-for="FreePackageLimit" class="col-xs-4 control-label">免费快递单号数量</label>
                            <div class="col-xs-8">
                                <div class="input-group">
                                    <input asp-for="FreePackageLimit" type="number" min="0" step="1" class="input-sm form-control"/>
                                    <span class="input-group-addon">个</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">

                    <div class="col-xs-6">
                        <div class="form-group">
                            <label asp-for="ExtraPackageFee" class="col-xs-4 control-label">额外快递单号收费</label>
                            <div class="col-xs-8">
                                <div class="input-group">
                                    <input asp-for="ExtraPackageFee" type="number" min="0" step="1" class="input-sm form-control"/>
                                    <span class="input-group-addon">RMB/个</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-6" style="height: 37px;"></div>

                </div>

                <div class="row">

                    <div class="col-xs-6">
                        <div class="form-group">
                            <label asp-for="HasExtraPackageFeeCapAmount" class="col-xs-4 control-label">是否费用封顶</label>
                            <div class="col-xs-8">
                                <select asp-for="HasExtraPackageFeeCapAmount" required="required" class="input-sm form-control">
                                    <option value="@(false.ToString())">否，无封顶</option>
                                    <option value="@(true.ToString())">是，有封顶</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-6">
                        <div class="form-group">
                            <label asp-for="ExtraPackageFeeCapAmount" class="col-xs-4 control-label">封顶金额</label>
                            <div class="col-xs-8">
                                <div class="input-group">
                                    <input asp-for="ExtraPackageFeeCapAmount" type="number" min="0" step="1" class="input-sm form-control"/>
                                    <span class="input-group-addon">RMB</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </form>
        </div>
    </div>
</div>

<script type="text/javascript">

    function saveLogisticsModeSetting() {
        var form = $("#logisticsModeSettingDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "LogisticsModeSetting")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                }
            });
        }
    }

</script>
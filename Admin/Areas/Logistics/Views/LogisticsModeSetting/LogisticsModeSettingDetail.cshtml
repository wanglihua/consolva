@using shunda.Domain
@model shunda.Admin.Areas.Logistics.Models.LogisticsModeSetting.LogisticsModeSettingDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="logisticsModeSettingDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">物流配置详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="logisticsModeSettingDetailForm" class="form-horizontal" role="form">
                    <input asp-for="LogisticsModeSettingId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="VolumeWeightDenominator" class="col-xs-2 control-label">默认体积重分母</label>
                                <div class="col-xs-10">
                                    <input asp-for="VolumeWeightDenominator" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="HasFreePackageLimit" class="col-xs-2 control-label">是否有免费包裹数量限制</label>
                                <div class="col-xs-10">
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="FreePackageLimit" class="col-xs-2 control-label">免费包裹数量限制</label>
                                <div class="col-xs-10">
                                    <input asp-for="FreePackageLimit" type="number" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ExtraPackageFee" class="col-xs-2 control-label">额外包裹收费</label>
                                <div class="col-xs-10">
                                    <input asp-for="ExtraPackageFee" type="number" number="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="HasExtraPackageFeeCapAmount" class="col-xs-2 control-label">是否有额外包裹收费封顶金额</label>
                                <div class="col-xs-10">
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ExtraPackageFeeCapAmount" class="col-xs-2 control-label">额外包裹收费封顶金额</label>
                                <div class="col-xs-10">
                                    <input asp-for="ExtraPackageFeeCapAmount" type="number" number="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveLogisticsModeSetting();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
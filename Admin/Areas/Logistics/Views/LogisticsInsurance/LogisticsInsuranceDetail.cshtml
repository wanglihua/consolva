@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Core.Web
@model shunda.Admin.Areas.Logistics.Models.LogisticsInsurance.LogisticsInsuranceDetailModel

@{
    ViewData[ViewDataKey.Title] = "保险详细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-menu">物流设置</li>
    <li class="active" data-menu="logistics-logistics-insurance-index-menu">
        <a asp-controller="LogisticsInsurance" asp-action="Index">保险列表</a>
    </li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button class="btn btn-success btn-sm" onclick="saveLogisticsInsurance();">
        <i class="ace-icon fa fa-floppy-o"></i>
        保存
    </button>
    <a type="button" class="btn btn-info btn-sm" asp-controller="LogisticsInsurance" asp-action="Index">
        <i class="ace-icon fa fa-arrow-left"></i>
        返回
    </a>
</div>

<div>
    <div class="widget-box" style="border-style: none; width: 780px;">
        <div class="widget-body">
            <div class="widget-main">
                <form id="logisticsInsuranceDetailForm" class="form-horizontal" role="form">
                    <input asp-for="LogisticsInsurance.Id" type="hidden"/>
                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsInsurance.Name" class="col-xs-2 control-label">名称</label>
                                <div class="col-xs-10">
                                    <input asp-for="LogisticsInsurance.Name" type="text" required="required" maxlength="50" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsInsurance.CalcBaseType" class="col-xs-2 control-label">计算基数</label>
                                <div class="col-xs-10">
                                    <select asp-for="LogisticsInsurance.CalcBaseType" required="required" class="input-sm form-control">
                                        @foreach (var baseType in Model.FeeCalcBaseTypeList) {
                                            <option value="@baseType.Id">@baseType.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsInsurance.Type" class="col-xs-2 control-label">费用类型</label>
                                <div class="col-xs-10">
                                    <select asp-for="LogisticsInsurance.Type" required="required" class="input-sm form-control">
                                        @foreach (var logisticsInsuranceType in Model.LogisticsInsuranceTypeList) {
                                            <option value="@logisticsInsuranceType.Id">@logisticsInsuranceType.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsInsurance.FeeRate" class="col-xs-2 control-label">费率/金额</label>
                                <div class="col-xs-10">
                                    <input asp-for="LogisticsInsurance.FeeRate" type="number" step="1" required="required" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsInsurance.OrderNum" class="col-xs-2 control-label">排序</label>
                                <div class="col-xs-10">
                                    <input asp-for="LogisticsInsurance.OrderNum" type="number" step="1" class="input-sm form-control"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsInsurance.Status" class="col-xs-2 control-label">状态</label>
                                <div class="col-xs-10">
                                    <select asp-for="LogisticsInsurance.Status" required="required" class="input-sm form-control">
                                        @foreach (var logisticsInsuranceStatus in Model.LogisticsInsuranceStatusList) {
                                            <option value="@logisticsInsuranceStatus.Id">@logisticsInsuranceStatus.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="LogisticsInsurance.Content" class="col-xs-2 control-label">保险条款</label>
                                <div class="col-xs-10">
                                    <textarea id="content" asp-for="LogisticsInsurance.Content" rows="5" maxlength="800" class="input-sm form-control"></textarea>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function saveLogisticsInsurance() {
        var form = $("#logisticsInsuranceDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "LogisticsInsurance")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);

                    if (data.create) {
                        setTimeout("showDetail(" + data.id + ")", 1000);
                    }
                }
            });
        }
    }

    function showDetail(id) {
        var url = "@Url.Action("Detail", "LogisticsInsurance", new { id = 88888 })";
        url = url.replace("88888", id);
        window.location.href = url;
    }
</script>
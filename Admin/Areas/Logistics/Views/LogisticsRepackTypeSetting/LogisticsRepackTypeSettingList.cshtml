@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsRepackTypeSetting.LogisticsRepackTypeSettingListModel

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsRepackTypeSettingList" }))

<table id="tblLogisticsRepackTypeSettingList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="logisticsRepackTypeSettingCheckAll"></label><input id="logisticsRepackTypeSettingCheckAll" type="checkbox" class="ace checkall" /><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 90px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsRepackTypeSettingAlias).@(nameof(LogisticsRepackTypeSettingInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsRepackTypeSettingList">打包类型</a>
                </div>
            </th>

            <th style="width: 220px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsRepackTypeSettingAlias).@(nameof(LogisticsRepackTypeSettingInfo.Title))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsRepackTypeSettingList">标题</a>
                </div>
            </th>

            <th style="width: 70px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsRepackTypeSettingAlias).@(nameof(LogisticsRepackTypeSettingInfo.OrderNum))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsRepackTypeSettingList">排序</a>
                </div>
            </th>

            <th style="width: 80px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsRepackTypeSettingAlias).@(nameof(LogisticsRepackTypeSettingInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsRepackTypeSettingList">状态</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsRepackTypeSettingAlias).@(nameof(LogisticsRepackTypeSettingInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsRepackTypeSettingList">创建时间</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.LogisticsRepackTypeSettingAlias).@(nameof(LogisticsRepackTypeSettingInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsRepackTypeSettingList">修改时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.LogisticsRepackTypeSettingList.Count != 0) {
            int index = 1;
            foreach (LogisticsRepackTypeSettingInfo logisticsRepackTypeSetting in Model.LogisticsRepackTypeSettingList) {
                <tr ondblclick="showLogisticsRepackTypeSettingDetail(@(logisticsRepackTypeSetting.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="logisticsRepackTypeSettingCheck_@(logisticsRepackTypeSetting.Id)"></label><input id="logisticsRepackTypeSettingCheck_@(logisticsRepackTypeSetting.Id)" type="checkbox" class="ace" value="@logisticsRepackTypeSetting.Id" /><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(Model.ItemBegin + index++)</td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsRepackTypeSetting.Type.Name)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsRepackTypeSetting.Title)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsRepackTypeSetting.OrderNum)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsRepackTypeSetting.Status.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @logisticsRepackTypeSetting.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @logisticsRepackTypeSetting.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="9">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadLogisticsRepackTypeSettingList" }))
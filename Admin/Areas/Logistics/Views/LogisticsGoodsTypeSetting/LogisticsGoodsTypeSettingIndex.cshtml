@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Logistics
@model LogisticsGoodsTypeSettingIndexModel
@using shunda.Admin.Areas.Logistics.Models.LogisticsGoodsTypeSetting
@{
    ViewData[ViewDataKey.Title] = "物品类型设置";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="goods-menu">物品管理</li>
    <li class="active" data-menu="goods-logistics-goods-type-setting-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div id="logisticsGoodsTypeSettingList" data-page-index="0" data-sort-field="@(nameof(LogisticsGoodsTypeSettingInfo.Id))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="logisticsGoodsTypeSettingDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadLogisticsGoodsTypeSettingList();
    });

    function sortLogisticsGoodsTypeSettingList(sortField, sortDir) {
        var list = $('#logisticsGoodsTypeSettingList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadLogisticsGoodsTypeSettingList();
    }

    function loadLogisticsGoodsTypeSettingList(pageIndex) {
        var list = $('#logisticsGoodsTypeSettingList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "LogisticsGoodsTypeSetting")",
            type: "POST",
            data: {
                "@(nameof(LogisticsGoodsTypeSettingListQueryParam.PageIndex))": pageIndex,
                "@(nameof(LogisticsGoodsTypeSettingListQueryParam.SortField))": sortField,
                "@(nameof(LogisticsGoodsTypeSettingListQueryParam.SortDir))": sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsGoodsTypeSettingList').html(data);

                initListTable("#tblLogisticsGoodsTypeSettingList");
            }
        });
    }

    function showLogisticsGoodsTypeSettingDetail(id) {
        $("#logisticsGoodsTypeSettingDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#logisticsGoodsTypeSettingDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "LogisticsGoodsTypeSetting")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#logisticsGoodsTypeSettingDetailDialogWrapper").html(data);
                $("#logisticsGoodsTypeSettingDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveLogisticsGoodsTypeSetting() {
        var form = $("#logisticsGoodsTypeSettingDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "LogisticsGoodsTypeSetting")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#logisticsGoodsTypeSettingDetailDialog').modal('hide');
                    loadLogisticsGoodsTypeSettingList();
                }
            });
        }
    }

</script>
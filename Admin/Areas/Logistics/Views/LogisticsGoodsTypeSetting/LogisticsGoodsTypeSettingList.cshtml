@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsGoodsTypeSetting.LogisticsGoodsTypeSettingListModel

<table id="tblLogisticsGoodsTypeSettingList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="logisticsGoodsTypeSettingCheckAll"></label><input id="logisticsGoodsTypeSettingCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <span>物品类型</span>
                </div>
            </th>

            <th style="width: 300px; text-align: center;">
                <div>
                    <span>物品类型说明</span>
                </div>
            </th>

            <th style="width: 300px; text-align: center;">
                <div>
                    <span>常见品名</span>
                </div>
            </th>

            <th style="width: 80px; text-align: center;">
                <div>
                    <span>状态</span>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <span>创建时间</span>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <span>修改时间</span>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.LogisticsGoodsTypeSettingList.Count != 0) {
            int order = 0;
            foreach (LogisticsGoodsTypeSettingInfo logisticsGoodsTypeSetting in Model.LogisticsGoodsTypeSettingList) {
                <tr ondblclick="showLogisticsGoodsTypeSettingDetail(@(logisticsGoodsTypeSetting.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="logisticsGoodsTypeSettingCheck_@(logisticsGoodsTypeSetting.Id)"></label><input id="logisticsGoodsTypeSettingCheck_@(logisticsGoodsTypeSetting.Id)" type="checkbox" class="ace" value="@logisticsGoodsTypeSetting.Id"/><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(order++)</td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsGoodsTypeSetting.Type.Name)
                        </div>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @ListDataUtil.Render(logisticsGoodsTypeSetting.Description)
                        </div>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @ListDataUtil.Render(logisticsGoodsTypeSetting.SampleGoods)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(logisticsGoodsTypeSetting.Status.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @logisticsGoodsTypeSetting.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @logisticsGoodsTypeSetting.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="9">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>
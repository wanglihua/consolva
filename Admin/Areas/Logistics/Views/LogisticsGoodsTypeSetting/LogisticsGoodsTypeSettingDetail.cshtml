@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsGoodsTypeSetting.LogisticsGoodsTypeSettingDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="logisticsGoodsTypeSettingDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">物品类型设置详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="logisticsGoodsTypeSettingDetailForm" class="form-horizontal" role="form">
                    <input asp-for="LogisticsGoodsTypeSettingId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Type" class="col-xs-2 control-label">物品类型</label>
                                <div class="col-xs-10">
                                    <select asp-for="Type" required="required" digits="true" class="input-sm form-control" disabled="disabled">
                                        <option value=""></option>
                                        @foreach(LogisticsGoodsType type in Model.TypeList) {
                                            <option value="@(type.Id)">@(type.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Description" class="col-xs-2 control-label">物品类型说明</label>
                                <div class="col-xs-10">
                                    <textarea asp-for="Description" rows="5" required="required" maxlength="800" class="input-sm form-control" autocomplete="off"></textarea>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="SampleGoods" class="col-xs-2 control-label">常见品名</label>
                                <div class="col-xs-10">
                                    <textarea asp-for="SampleGoods" rows="5" required="required" maxlength="800" class="input-sm form-control" autocomplete="off"></textarea>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Status" class="col-xs-2 control-label">状态</label>
                                <div class="col-xs-10">
                                    <select asp-for="Status" required="required" digits="true" class="input-sm form-control">
                                        <option value=""></option>
                                        @foreach(LogisticsGoodsTypeStatus type in Model.StatusList) {
                                            <option value="@(type.Id)">@(type.Name)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveLogisticsGoodsTypeSetting();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
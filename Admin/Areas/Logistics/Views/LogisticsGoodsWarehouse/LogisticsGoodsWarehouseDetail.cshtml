@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsGoodsWarehouse.LogisticsGoodsWarehouseDetailModel
@{
    Layout = null;
}

<div class="modal fade" id="logisticsGoodsDetailDialog">
    <div class="modal-dialog" style="width: 840px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">物品扩展名详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="logisticsGoodsDetailForm" class="form-horizontal" role="form">
                    <input asp-for="GoodsId" type="hidden"/>
                    <div class="row">
                        <div class="col-xs-12">

                            <div class="row">

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Type" class="col-xs-4 control-label">物品类型</label>
                                        <div class="col-xs-8">
                                            <select id="goodsType" asp-for="Type" class="input-sm form-control">
                                                @foreach (LogisticsGoodsType goodsType in Model.TypeList)
                                                {
                                                    <option value="@(goodsType.Id)">@(goodsType.Name)</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="Name" class="col-xs-4 control-label">扩展名</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Name" type="text" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="BrandName" class="col-xs-4 control-label">品牌名</label>
                                        <div class="col-xs-8">
                                            <input asp-for="BrandName" type="text" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <div class="form-group">
                                        <label asp-for="CreateExpressTrackingNo" class="col-xs-4 control-label">创建单号</label>
                                        <div class="col-xs-8">
                                            <input asp-for="CreateExpressTrackingNo" type="text" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            @*
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="form-group">
                                        <label class="col-xs-2 control-label">
                                            <a id="btnUploadImage" style="cursor: pointer;">上传图片</a>
                                        </label>
                                        <div class="col-xs-10">
                                            <div id="imageList">
                                                @foreach (var image in Model.ImageList)
                                                {
                                                    <div id="image_@(image.Id)" style="float: left; margin: 5px;">
                                                        <div>

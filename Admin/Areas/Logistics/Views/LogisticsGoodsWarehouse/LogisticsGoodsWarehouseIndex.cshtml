@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.Logistics.Models.LogisticsGoodsWarehouse
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsGoodsWarehouse.LogisticsGoodsWarehouseIndexModel
@{
    ViewData[ViewDataKey.Title] = "扩展名添加";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="goods-menu">物品管理</li>
    <li class="active" data-menu="goods-logistics-goods-warehouse-search-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadLogisticsGoodsList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showLogisticsGoodsDetail()">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteLogisticsGoods()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
    <button id="btnImport" class="btn btn-success btn-sm">
        <i class="ace-icon fa fa-plus"></i>
        导入
    </button>
    <button class="btn btn-purple btn-sm" onclick="exportLogisticsGoods()">
        <i class="ace-icon fa fa-file-excel-o"></i>
        导出
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="goodsTypeQuery">物品类型</label>&nbsp;
    <select id="goodsTypeQuery" style="width: 140px; height: 30px;">
        <option value="">物品类型查询</option>
        @foreach (LogisticsGoodsType goodsType in Model.GoodsTypeList)
        {
            <option value="@(goodsType.Id)">@(goodsType.Name)</option>
        }
    </select> &nbsp;
    
    <label for="nameQuery">扩展名</label>&nbsp;
    <input id="nameQuery" name="nameQuery" style="width: 130px; height: 30px;" placeholder="扩展名查询"/>&nbsp;

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadLogisticsGoodsList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
    <button type="button" class="btn btn-success btn-sm" style="margin-bottom: 3px; height: 30px;" onclick="showLogisticsGoodsDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
</div>

<div id="logisticsGoodsList" data-page-index="0" data-sort-field="@(nameof(LogisticsGoodsInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="logisticsGoodsDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadLogisticsGoodsList();
    });

    function sortLogisticsGoodsList(sortField, sortDir) {
        var list = $('#logisticsGoodsList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadLogisticsGoodsList();
    }

    function loadLogisticsGoodsList(pageIndex) {
        var list = $('#logisticsGoodsList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "LogisticsGoodsWarehouse")",
            type: "POST",
            data: {
                '@(nameof(LogisticsGoodsWarehouseListQueryParam.GoodsTypeQuery))': $('#goodsTypeQuery').val(),
                '@(nameof(LogisticsGoodsWarehouseListQueryParam.NameQuery))': $('#nameQuery').val(),
                '@(nameof(LogisticsGoodsWarehouseListQueryParam.PageIndex))': pageIndex,
                '@(nameof(LogisticsGoodsWarehouseListQueryParam.SortField))': sortField,
                '@(nameof(LogisticsGoodsWarehouseListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsGoodsList').html(data);

                initListTable("#tblLogisticsGoodsList");
            }
        });
    }

    function deleteLogisticsGoods() {
        var idList = getSelectIdList('#tblLogisticsGoodsList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "LogisticsGoodsWarehouse")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        loadLogisticsGoodsList();
                    }
                });
            }
        );
    }

</script>

<script type="text/javascript">

    function showLogisticsGoodsDetail(id) {
        $("#logisticsGoodsDetailDialogWrapper").html("");

        showMask("加载中...");

        $.ajax({
            url: '@Url.Action("Detail", "LogisticsGoodsWarehouse")',
            type: "POST",
            data: {
                "@(nameof(LogisticsGoodsWarehouseListQueryParam.GoodsId))": id,
                '@(nameof(LogisticsGoodsWarehouseListQueryParam.GoodsTypeQuery))': $('#goodsTypeQuery').val(),
                "@(nameof(LogisticsGoodsWarehouseListQueryParam.NameQuery))": $("#nameQuery").val()
            },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#logisticsGoodsDetailDialogWrapper").html(data);
                $("#logisticsGoodsDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveLogisticsGoods() {
        var form = $("#logisticsGoodsDetailForm");
        var valid = validate(form,
            {
                'Name': {
                    required: true,
                    maxlength: 200
                },
                'TypeId': {
                    required: true,
                    digits: true
                },
                'HasBrand': {
                    required: true
                },
                'BrandName': {
                    required: false,
                    maxlength: 200
                },
                'HasBattery': {
                    required: true
                },
                'HasBamboo': {
                    required: true
                },
                'HasWoodPackage': {
                    required: true
                },
                'IsSpecial': {
                    required: true
                },                
                'IsForbidden': {
                    required: true
                }
            });

        if (valid) {
            showMask("提交中...");

            $.ajax({
                url: '@Url.Action("Save", "LogisticsGoodsWarehouse")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();

                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#logisticsGoodsDetailDialog').modal('hide');
                    loadLogisticsGoodsList(0);
                }
            });
        }
    }

    $(function(){
        initUploader();
    });

    function initUploader() {

        var url = '@Url.Action("Import", "LogisticsGoodsWarehouse")';

        var uploader = new plupload.Uploader({
            runtimes: 'html5,flash,html4',
            multi_selection: false,

            browse_button: 'btnImport',
            file_data_name: "excelFile",
            url: url,
            max_file_size: '10000kb',

            filters: [
                {title: "Excel文件", extensions: "xlsx"}
            ],

            flash_swf_url: '/plupload/js/Moxie.swf',

            init: {
                FilesAdded: function () {
                    showMask("上传中，请稍候...");
                    uploader.start();
                },
                FileUploaded: function (up, file, response) {
                    hideMask();
                    var result = JSON.parse(response.response);
                    if (result.success !== true) {
                        $.msg.error(result.message);
                    } else {
                        loadLogisticsGoodsList();
                        $.msg.show(result.message);
                    }
                },
                Error: function (up, err) {
                    $.msg.error("上传发生错误：" + err.code + ", " + err.message);
                }
            }
        });

        uploader.init();
    }

    function exportLogisticsGoods() {
        var params = $.param({
            '@(nameof(LogisticsGoodsWarehouseListQueryParam.GoodsTypeQuery))': $('#goodsTypeQuery').val(),
            '@(nameof(LogisticsGoodsWarehouseListQueryParam.NameQuery))': $('#nameQuery').val()
        });

        var url = '@Url.Action("Export", "LogisticsGoodsWarehouse")?' + params;
        $('<form method="post" action="' + url + '"></form>').appendTo('body').submit().remove();
    }

</script>
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Logistics
@model LogisticsFeeRateExpressEntryIndexModel
@using shunda.Admin.Areas.Logistics.Models.LogisticsFeeRateExpressEntry
@{
    ViewData[ViewDataKey.Title] = Model.LogisticsMode.Code + " " + Model.LogisticsMode.Name + " 快递具体费率明细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="logistics-menu">物流设置</li>
    <li class="active" data-menu="logistics-logistics-mode-index-menu">
        <a asp-controller="LogisticsMode" asp-action="Index" asp-route-countryId="@(Model.LogisticsMode.Country.Id)">物流列表</a>
    </li>

    @if (Model.LogisticsMode.Cate == LogisticsModeCate.Inner) {
        <li>
            <a asp-controller="LogisticsModeInner" asp-action="Index" asp-route-countryId="@(Model.LogisticsMode.Country.Id)">内部物流列表</a>
        </li>
    }

    <li>
        @(ViewData[ViewDataKey.Title])
    </li>
}

<div class="gridToolBar clearfix">

    @if (Model.LogisticsMode.Cate == LogisticsModeCate.Customer) {
        <a type="button" class="btn btn-info btn-sm" asp-controller="LogisticsMode" asp-action="Index" asp-route-countryId="@(Model.LogisticsMode.Country.Id)">
            <i class="ace-icon fa fa-arrow-left"></i>
            返回
        </a>
    }

    @if (Model.LogisticsMode.Cate == LogisticsModeCate.Inner) {
        <a type="button" class="btn btn-info btn-sm" asp-controller="LogisticsModeInner" asp-action="Index" asp-route-countryId="@(Model.LogisticsMode.Country.Id)">
            <i class="ace-icon fa fa-arrow-left"></i>
            返回
        </a>
    }

</div>

<div style="margin-bottom: 18px;">
    <ul class="nav nav-tabs">
        <li>
            <a asp-area="Logistics" asp-controller="LogisticsFeeRateExpress" asp-action="Index" asp-route-logisticsModeId="@(Model.LogisticsMode.Id)">基本费率</a>
        </li>
        <li class="active">
            <a asp-area="Logistics" asp-controller="LogisticsFeeRateExpressEntry" asp-action="Index" asp-route-feeRateExpressId="@(Model.FeeRateExpress.Id)">明细费率</a>
        </li>
    </ul>
</div>

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadLogisticsFeeRateExpressEntryList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showLogisticsFeeRateExpressEntryDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteLogisticsFeeRateExpressEntry()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

<div id="logisticsFeeRateExpressEntryList" data-page-index="0" data-sort-field="@(nameof(LogisticsFeeRateExpressEntryInfo.BeginWeight))" data-sort-dir="@(SortDirection.Asc)">
</div>

<div id="logisticsFeeRateExpressEntryDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadLogisticsFeeRateExpressEntryList();
    });

    function sortLogisticsFeeRateExpressEntryList(sortField, sortDir) {
        var list = $('#logisticsFeeRateExpressEntryList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadLogisticsFeeRateExpressEntryList();
    }

    function loadLogisticsFeeRateExpressEntryList(pageIndex) {
        var list = $('#logisticsFeeRateExpressEntryList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "LogisticsFeeRateExpressEntry")",
            type: "POST",
            data: {
                "@(nameof(LogisticsFeeRateExpressEntryListQueryParam.FeeRateExpressId))": "@(Model.FeeRateExpress.Id)",
                "@(nameof(LogisticsFeeRateExpressEntryListQueryParam.PageIndex))": pageIndex,
                "@(nameof(LogisticsFeeRateExpressEntryListQueryParam.SortField))": sortField,
                "@(nameof(LogisticsFeeRateExpressEntryListQueryParam.SortDir))": sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#logisticsFeeRateExpressEntryList').html(data);

                initListTable("#tblLogisticsFeeRateExpressEntryList");
            }
        });
    }

    function showLogisticsFeeRateExpressEntryDetail(id) {
        $("#logisticsFeeRateExpressEntryDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#logisticsFeeRateExpressEntryDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "LogisticsFeeRateExpressEntry")',
            type: "POST",
            data: { 
                "@(nameof(LogisticsFeeRateExpressEntryDetailParam.Id))": id,
                "@(nameof(LogisticsFeeRateExpressEntryDetailParam.FeeRateExpressId))": "@(Model.FeeRateExpress.Id)",
            },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#logisticsFeeRateExpressEntryDetailDialogWrapper").html(data);
                $("#logisticsFeeRateExpressEntryDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveLogisticsFeeRateExpressEntry() {
        var form = $("#logisticsFeeRateExpressEntryDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "LogisticsFeeRateExpressEntry")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#logisticsFeeRateExpressEntryDetailDialog').modal('hide');
                    loadLogisticsFeeRateExpressEntryList();
                }
            });
        }
    }

    function deleteLogisticsFeeRateExpressEntry() {
        var idList = getSelectIdList('#tblLogisticsFeeRateExpressEntryList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "LogisticsFeeRateExpressEntry")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        loadLogisticsFeeRateExpressEntryList();
                    }
                });
            }
        );
    }

</script>
@using shunda.Domain
@model shunda.Admin.Areas.Logistics.Models.LogisticsFeeRateExpressEntry.LogisticsFeeRateExpressEntryDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="logisticsFeeRateExpressEntryDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">快递具体费率明细详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="logisticsFeeRateExpressEntryDetailForm" class="form-horizontal" role="form">
                    <input asp-for="FeeRateExpressEntryId" type="hidden"/>
                    <input asp-for="FeeRateExpressId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="BeginWeight" class="col-xs-2 control-label">开始重量</label>
                                <div class="col-xs-10">
                                    <div class="input-group">
                                        <input asp-for="BeginWeight" type="number" required="required" number="true" class="input-sm form-control" autocomplete="off"/>
                                        <span class="input-group-addon">KG</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="EndWeight" class="col-xs-2 control-label">结束重量</label>
                                <div class="col-xs-10">
                                    <div class="input-group">
                                        <input asp-for="EndWeight" type="number" required="required" number="true" class="input-sm form-control" autocomplete="off"/>
                                        <span class="input-group-addon">KG</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="FeeByKilogram" class="col-xs-2 control-label">按公斤计费</label>
                                <div class="col-xs-10">
                                    <select asp-for="FeeByKilogram" required="required" class="input-sm form-control">
                                        <option value="@(true.ToString())">是，按公斤向上取整计费</option>
                                        <option value="@(false.ToString())">否，不按公斤向上取整计费</option>
                                    </select>
                                    <div class="help-block">如果不是整数的公斤，就向上取整，如7.1公斤的取8公斤计算。</div>
                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveLogisticsFeeRateExpressEntry();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Logistics
@model shunda.Admin.Areas.Logistics.Models.LogisticsFeeRateExpressEntry.LogisticsFeeRateExpressEntryListModel

<table id="tblLogisticsFeeRateExpressEntryList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="logisticsFeeRateExpressEntryCheckAll"></label><input id="logisticsFeeRateExpressEntryCheckAll" type="checkbox" class="ace checkall" /><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.FeeRateExpressAlias).@(nameof(LogisticsFeeRateExpressEntryInfo.FeeRateExpress.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsFeeRateExpressEntryList">快递具体费率</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.FeeRateExpressEntryAlias).@(nameof(LogisticsFeeRateExpressEntryInfo.BeginWeight))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsFeeRateExpressEntryList">开始重量</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.FeeRateExpressEntryAlias).@(nameof(LogisticsFeeRateExpressEntryInfo.EndWeight))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsFeeRateExpressEntryList">结束重量</a>
                </div>
            </th>

            <th style="width: 180px; text-align: center;">
                <div>
                    <a field="@(Model.FeeRateExpressEntryAlias).@(nameof(LogisticsFeeRateExpressEntryInfo.FeeByKilogram))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsFeeRateExpressEntryList">是否按公斤计费</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.FeeRateExpressEntryAlias).@(nameof(LogisticsFeeRateExpressEntryInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsFeeRateExpressEntryList">创建时间</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.FeeRateExpressEntryAlias).@(nameof(LogisticsFeeRateExpressEntryInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortLogisticsFeeRateExpressEntryList">修改时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.EntryList.Count != 0) {
            int itemIndex = 0;
            foreach (LogisticsFeeRateExpressEntryInfo entry in Model.EntryList) {
                <tr ondblclick="showLogisticsFeeRateExpressEntryDetail(@(entry.Id));">
                    <td style="text-align: center;">
                        <div>
                            <label for="logisticsFeeRateExpressEntryCheck_@(entry.Id)"></label><input id="logisticsFeeRateExpressEntryCheck_@(entry.Id)" type="checkbox" class="ace" value="@entry.Id" /><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(Model.ItemBegin + itemIndex++)</td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(entry.FeeRateExpress?.Id)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(entry.BeginWeight)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(entry.EndWeight)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(entry.FeeByKilogram)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @entry.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @entry.UpdateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="9">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>
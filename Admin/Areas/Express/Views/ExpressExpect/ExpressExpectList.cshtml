@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Express
@using shunda.Service.Express
@model shunda.Admin.Areas.Express.Models.ExpressExpect.ExpressExpectListModel

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadExpressExpectList" }))

<table id="tblExpressExpectList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <div>
                    <label for="expressExpectCheckAll"></label><input id="expressExpectCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
                </div>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.CustomerAlias).@(nameof(ExpressExpectInfo.Customer.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressExpectList">客户</a>
                </div>
            </th>

            <th style="width: 150px; text-align: center;">
                <div>
                    <a field="@(Model.ExpressExpectAlias).@(nameof(ExpressExpectInfo.TrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressExpectList">快递单号</a>
                </div>
            </th>

            <th style="width: 110px; text-align: right;">
                <div>
                    <a field="@(Model.ExpressExpectAlias).@(nameof(ExpressExpectInfo.TrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressExpectList">货品总值</a>
                </div>
            </th>

            <th style="width: 280px; text-align: center;">
                <div>
                    <a field="@(Model.ExpressExpectAlias).@(nameof(ExpressExpectInfo.Description))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressExpectList">备注</a>
                </div>
            </th>

            <th style="width: 130px; text-align: center;">
                <div>
                    <a field="@(Model.ExpressExpectAlias).@(nameof(ExpressExpectInfo.OverdueMsgSent))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressExpectList">超期未入库提醒</a>
                </div>
            </th>

            <th style="width: 100px; text-align: center;">
                <div>
                    <a field="@(Model.ExpressExpectAlias).@(nameof(ExpressExpectInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressExpectList">状态</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.ExpressExpectAlias).@(nameof(ExpressExpectInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressExpectList">创建时间</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(Model.ExpressExpectAlias).@(nameof(ExpressExpectInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressExpectList">修改时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ExpressExpectList.Count != 0) {
            var itemIndex = 0;
            foreach (var expressExpect in Model.ExpressExpectList) {
                <tr>
                    <td style="text-align: center;">
                        <div>
                            <label for="expressExpectCheck_@(expressExpect.Id)"></label><input id="expressExpectCheck_@(expressExpect.Id)" type="checkbox" class="ace" value="@expressExpect.Id"/><span class="lbl"></span>
                        </div>
                    </td>
                    <td style="text-align: center;">@(Model.ItemBegin + itemIndex++)</td>

                    <td style="text-align: center;">
                        <div>
                            <a asp-area="Customer" asp-controller="Customer" asp-action="Detail" asp-route-id="@(expressExpect.Customer.Id)" target="_blank">
                                @ListDataUtil.Render(expressExpect.CustomerCodeCache)
                            </a>
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @if (expressExpect.Status == ExpressExpectStatus.Checkin) {
                                <a asp-area="Express" asp-controller="ExpressDetail" asp-action="TrackingNo" asp-route-trackingNo="@(expressExpect.TrackingNo)">
                                    @ListDataUtil.Render(expressExpect.TrackingNo)
                                </a>
                            } else {
                                @ListDataUtil.Render(expressExpect.TrackingNo)
                            }
                        </div>
                    </td>

                    <td style="text-align: right;">
                        <div>
                            @ListDataUtil.Render(expressExpect.GoodsValue)<span>&nbsp;</span><span>RMB</span>
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(expressExpect.Description)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(expressExpect.OverdueMsgSent)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(expressExpect.Status.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @expressExpect.CreateTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @expressExpect.LastEditTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </td>

                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="11">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadExpressExpectList" }))
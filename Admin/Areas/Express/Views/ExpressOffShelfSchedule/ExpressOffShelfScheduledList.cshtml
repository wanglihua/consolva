@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Express
@using shunda.Domain.LogisticsOrder
@using shunda.Domain.Storage
@using shunda.Service.Express
@model shunda.Admin.Areas.Express.Models.ExpressOffShelfSchedule.ExpressOffShelfScheduledListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadScheduledList" })

<table id="tblScheduledList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="scheduledCheckAll"></label><input id="scheduledCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 130px; text-align: center;">
                <div>
                    <a field="cg.@(nameof(ExpressInfo.CheckinTrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">入库跟踪号</a>
                </div>
                <div>
                    <a field="cg.@(nameof(ExpressInfo.TrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">快递单号</a>
                </div>
            </th>
            <th style="width: 90px; text-align: center;">
                <div>
                    <span>体积(M<sup>3</sup>)</span>
                </div>
                <div>
                    <span>重量(KG)</span>
                </div>
                <div>
                    <span>包裹数量</span>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="w.@(nameof(WarehouseInfo.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">当前仓库</a>
                </div>
                <div>
                    <a field="sl.@(nameof(StorageLocInfo.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">当前仓位号</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="order.@(nameof(LogisticsOrderInfo.FirstMode))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">头程物流</a>
                </div>
                <div>
                    <a field="cg.@(nameof(ExpressInfo.GoodsType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">物品类型</a>
                </div>
            </th>

            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="cg.@(nameof(ExpressInfo.Customer))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">认领客户</a>
                </div>
                <div>
                    <a field="cg.@(nameof(ExpressInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">快递状态</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="order.@(nameof(LogisticsOrderInfo.Code))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">所在订单</a>
                </div>
                <div>
                    <a field="order.@(nameof(LogisticsOrderInfo.OrderStatus))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">订单状态</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(ExpressShelfScheduleInfo.User))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">分配人员</a>
                </div>
                <div>
                    <a field="@(nameof(ExpressShelfScheduleInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortScheduledList">分配时间</a>
                </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ScheduledList != null && Model.ScheduledList.Count != 0) {
            int order = 1;
            foreach (ExpressShelfScheduleInfo schedule in Model.ScheduledList) {
                <tr>
                    <td style="text-align: center;">
                        <label for="scheduledCheck_@(schedule.Id)"></label><input id="scheduledCheck_@(schedule.Id)" type="checkbox" class="ace" value="@schedule.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">
                        <div>
                            <a href="@Url.Action("Index", "ExpressDetail", new { cateId = ExpressListMenuCate.All.Id, id = schedule.Express.Id })" target="_blank">
                                @ListDataUtil.Render(schedule.Express.CheckinTrackingNo)
                            </a>
                        </div>
                        <div style="color: blue;">
                            <a href="@Url.Action("Index", "ExpressDetail", new { cateId = ExpressListMenuCate.All.Id, id = schedule.Express.Id })" target="_blank">
                                @schedule.Express.TrackingNo
                            </a>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render((schedule.Express.ExpressSizeWeightListCache == null || schedule.Express.ExpressSizeWeightListCache.Count == 0) ? 0 : schedule.Express.ExpressSizeWeightListCache.Sum(e => e.GetVolumeCache() * e.PackageCount), "#0.000000")
                        </div>
                        <div style="color: blue;">
                            @ListDataUtil.Render((schedule.Express.ExpressSizeWeightListCache == null || schedule.Express.ExpressSizeWeightListCache.Count == 0) ? 0 : schedule.Express.ExpressSizeWeightListCache.Sum(e => e.Weight * e.PackageCount), "#0.000")
                        </div>
                        <div>
                            @ListDataUtil.Render(schedule.Express.PackageCount)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.RenderStringWithDiv(schedule.Express.Warehouse.Name)
                        </div>
                        <div style="color: blue;">
                            @ListDataUtil.RenderStringWithDiv(schedule.Express.StorageLocNameCache)
                        </div>
                    </td>

                    <td style="text-align: center;" class="break-word">
                        <div style="color: blue;">
                            @ListDataUtil.RenderStringWithDiv(schedule.Express.Order?.FirstMode.Name)
                        </div>
                        <div>
                            @ListDataUtil.RenderStringWithDiv(schedule.Express.GoodsType.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @if (string.IsNullOrWhiteSpace(schedule.Express.Customer?.CheckinCode) == false) {
                                <span>@schedule.Express.Customer?.CheckinCode</span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                        <div>
                            @(schedule.Express.Status?.Name)
                        </div>
                    </td>

                    <td style="text-align: center;" class="break-word">
                        <div>
                            @if (string.IsNullOrWhiteSpace(schedule.Express.OrderCode) == false) {
                                <a target="_blank" href="@Url.Action("Index", "LogisticsOrderDetail", new { id = (schedule.Express.Order?.Id ?? 0) })">
                                    <span>@schedule.Express.OrderCode</span>
                                </a>
                            } else {
                                <span>-</span>
                            }
                        </div>
                        <div>
                            @ListDataUtil.RenderStringWithDiv(schedule.Express.Order?.OrderStatus?.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render(schedule.User?.LoginName)
                        </div>
                        <div>
                            @ListDataUtil.Render(schedule.CreateTime)
                        </div>
                    </td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="10">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadScheduledList" })
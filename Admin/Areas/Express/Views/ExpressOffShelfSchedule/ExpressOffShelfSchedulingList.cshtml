@{
    Layout = null;
}
@using shunda.Core.Web
@using shunda.Domain.Express
@using shunda.Domain.LogisticsOrder
@using shunda.Service.Express
@model shunda.Admin.Areas.Express.Models.ExpressOffShelfSchedule.ExpressOffShelfSchedulingListModel

@*
<div>
    <span style="font-size: 12px; font-weight: bold;">货架：</span>&nbsp;&nbsp;
    <input id="scheduleShelfCheckAll" type="checkbox" class="ace scheduleShelfCheckBox"/><span class="lbl"></span><label for="scheduleShelfCheckAll" style="color: blue;">全选</label><span>&nbsp;&nbsp;</span>
    <span id="scheduleShelfList">
        @foreach (ShelfInfo scheduleShelf in Model.ShelfList)
        {
            <span>
                <input id="scheduleShelf_@(scheduleShelf.Id)" type="checkbox" class="ace scheduleShelfCheckBox" value="@(scheduleShelf.Id)" data-shelfName="@(scheduleShelf.Name)" onclick="loadSchedulingList()"/><span class="lbl"></span><label for="scheduleShelf_@(scheduleShelf.Id)">@(scheduleShelf.Name)</label><span>&nbsp;&nbsp;</span>
            </span>
        }
    </span>
</div>
*@

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadSchedulingList"})

<table id="tblSchedulingList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="schedulingCheckAll"></label><input id="schedulingCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 130px; text-align: center;">
                <div>
                    <a field="@(nameof(ExpressInfo.CheckinTrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">入库跟踪号</a>
                </div>
                <div>
                    <a field="@(nameof(ExpressInfo.TrackingNo))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">快递单号</a>
                </div>
            </th>
            <th style="width: 90px; text-align: center;">
                <div>
                    <span>体积(M<sup>3</sup>)</span>
                </div>
                <div>
                    <span>重量(KG)</span>
                </div>
                <div>
                    <span>包裹数量</span>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(ExpressInfo.Warehouse))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">当前仓库</a>
                </div>
                <div>
                    <a field="@(nameof(ExpressInfo.StorageLoc))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">当前仓位号</a>
                </div>
            </th>
            <th style="width: 140px; text-align: center;">
                <div>
                    <a field="order.@(nameof(LogisticsOrderInfo.FirstMode))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">头程物流</a>
                </div>
                <div>
                    <a field="@(nameof(ExpressInfo.GoodsType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">物品类型</a>
                </div>
            </th>
            <th style="width: 120px; text-align: center;">
                <div>
                    <a field="@(nameof(ExpressInfo.Customer))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">认领客户</a>
                </div>
                <div>
                    <a field="@(nameof(ExpressInfo.Status))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">快递状态</a>
                </div>
            </th>
            <th style="width: 125px; text-align: center;">
                <div>
                    <a field="order.@(nameof(LogisticsOrderInfo.Id))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">所在订单</a>
                </div>
                <div>
                    <a field="order.@(nameof(LogisticsOrderInfo.OrderStatus))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">订单状态</a>
                </div>
                <div>
                    <a field="order.@(nameof(LogisticsOrderInfo.SubmitPackTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortSchedulingList">提交打包时间</a>
                </div>                
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.SchedulingList != null && Model.SchedulingList.Count != 0)
        {
            int order = 1;
            foreach (ExpressInfo express in Model.SchedulingList)
            {
                <tr>
                    <td style="text-align: center;">
                        <label for="schedulingCheck_@(express.Id)"></label><input id="schedulingCheck_@(express.Id)" type="checkbox" class="ace" value="@express.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">
                        <div>
                            <a href="@Url.Action("Index", "ExpressDetail", new {cateId = ExpressListMenuCate.All.Id, id = express.Id})" target="_blank">
                                @ListDataUtil.Render(express.CheckinTrackingNo)
                            </a>
                        </div>
                        <div style="color: blue;">
                            <a href="@Url.Action("Index", "ExpressDetail", new {cateId = ExpressListMenuCate.All.Id, id = express.Id})" target="_blank">
                                @express.TrackingNo
                            </a>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.Render((express.ExpressSizeWeightListCache == null || express.ExpressSizeWeightListCache.Count == 0) ? 0 : express.ExpressSizeWeightListCache.Sum(e => e.GetSingleVolumeCache() * e.PackageCount), "#0.000000")
                        </div>
                        <div style="color: blue;">
                            @ListDataUtil.Render((express.ExpressSizeWeightListCache == null || express.ExpressSizeWeightListCache.Count == 0) ? 0 : express.ExpressSizeWeightListCache.Sum(e => e.Weight * e.PackageCount), "#0.000")
                        </div>
                        <div>
                            @ListDataUtil.Render(express.PackageCount)
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <div>
                            @ListDataUtil.RenderStringWithDiv(express.Warehouse.Name)
                        </div>
                        <div style="color: blue;">
                            @ListDataUtil.RenderStringWithDiv(express.StorageLocNameCache)
                        </div>
                    </td>

                    <td style="text-align: center;" class="break-word">
                        <div style="color: blue;">
                            @ListDataUtil.RenderStringWithDiv(express.Order?.FirstMode.Name)
                        </div>
                        <div>
                            @ListDataUtil.RenderStringWithDiv(express.GoodsType.Name)
                        </div>
                    </td>

                    <td style="text-align: center;">
                        <div>
                            @if (string.IsNullOrWhiteSpace(express.Customer?.CheckinCode) == false)
                            {
                                <span>@express.Customer?.CheckinCode</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </div>
                        <div>
                            @(express.Status?.Name)
                        </div>
                    </td>

                    <td style="text-align: center;" class="break-word">
                        <div>
                            @if (string.IsNullOrWhiteSpace(express.OrderCode) == false)
                            {
                                <a target="_blank" href="@Url.Action("Index", "LogisticsOrderDetail", new {id = (express.Order?.Id ?? 0)})">
                                    <span>@express.OrderCode</span>
                                </a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </div>
                        <div>
                            @ListDataUtil.RenderStringWithDiv(express.Order?.OrderStatus.Name)
                        </div>
                        <div>
                            @ListDataUtil.Render(express.Order?.SubmitPackTime)
                        </div>                        
                    </td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new {model = Model, loadListFunc = "loadSchedulingList"})
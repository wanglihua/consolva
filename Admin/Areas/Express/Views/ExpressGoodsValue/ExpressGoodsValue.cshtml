@{
    Layout = null;
}

<div id="expressGoodsValueDialogWrapper"></div>

<script type="text/javascript">
    function showExpressGoodsValue(id) {
        $("#expressGoodsValueDialogWrapper").html("");

        showMask("加载中...");

        $.ajax({
            url: '@Url.Action("Show", "ExpressGoodsValue", new { Area = "Express" })',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#expressGoodsValueDialogWrapper").html(data);
                $("#expressGoodsValueDialog").modal(modalOptions);
            }
        });
    }

    function saveExpressGoodsValue() {
        var form = $("#expressGoodsValueForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "ExpressGoodsValue", new { Area = "Express" })',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $("#expressGoodsValue" + data.data.expressId).val(data.data.expressGoodsValue);
                    $("#orderGoodsValue").val(data.data.orderGoodsValue);
                    
                    $("#expressGoodsValueDialog").modal('hide');
                }
            });
        }
    }
</script>
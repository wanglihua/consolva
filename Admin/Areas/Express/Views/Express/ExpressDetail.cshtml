                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.Status.Name" class="col-xs-4 control-label">状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.Status.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.PackageCount" class="col-xs-4 control-label">包裹数量</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.PackageCount" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.BillCustomerCode" class="col-xs-4 control-label">面单客户</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.BillCustomerCode" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="ExpressExpect!.CustomerCodeCache" class="col-xs-4 control-label">预报客户</label>
                                        <div class="col-xs-8">
                                            @if (Model.ExpressExpect != null) {
                                                <label class="control-label">
                                                    <a href="@Url.Action("Detail", "Customer", new { id = Model.ExpressExpect?.Customer?.Id ?? 0 })" target="_blank">@(Model.ExpressExpect?.CustomerCodeCache)</a>
                                                </label>
                                            } else {
                                                <input asp-for="ExpressExpect!.CustomerCodeCache" type="text" disabled="disabled" class="input-sm form-control"/>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.ShelfStatus.Name" class="col-xs-4 control-label">上架状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.ShelfStatus.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">

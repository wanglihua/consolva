                                                    function printLabelW10H05Old() {
                                                        showMask("处理中...");
                                                        $.ajax({
                                                            url: '@Url.Action("GetPrintDataById", "ExpressCheckin")',
                                                            type: "POST",
                                                            data: {
                                                                "expressId": "@(Model.Express.Id)"
                                                            },
                                                            success: function(data) {
                                                                hideMask();
                                                
                                                                if (data.success === false) {
                                                                    $.msg.error(data.message);
                                                                    return;
                                                                } 
                                                                
                                                                printCheckinLabelCommonW10H05Old(data, 1, 1, 2); // 1 打印数量， 2 申领件

                                        <div class="col-xs-8">
                                            <input asp-for="Express.AddTime" type="text" value="@(Model.Express.AddTime.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>


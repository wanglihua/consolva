                                        <label asp-for="Express.PackingUser!.UserName" class="col-xs-4 control-label">入流动仓人员</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.PackingUser!.UserName" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>


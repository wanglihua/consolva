                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.OffShelfUser!.UserName" class="col-xs-4 control-label">下架人员</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.OffShelfUser!.UserName" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.OffShelfTime" class="col-xs-4 control-label">下架时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.OffShelfTime" type="text" value="@(Model.Express.OffShelfTime?.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                <div class="col-xs-3">

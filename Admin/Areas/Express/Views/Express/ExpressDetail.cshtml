@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.Express.Models.Express
@using shunda.Core.Web
@using shunda.Domain.Express
@using shunda.Service.Express
@model shunda.Admin.Areas.Express.Models.Express.ExpressDetailModel

@{
    ViewData[ViewDataKey.Title] = "快递详细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="express-menu">快递管理</li>
    @if (Model.Cate == ExpressListMenuCate.All) {
        <li class="active" data-menu="express-detail-menu">快递详细</li>
    } else if (Model.Cate == ExpressListMenuCate.Expect) {
        <li class="active" data-menu="express-expect-menu">已预报</li>
    } else if (Model.Cate == ExpressListMenuCate.NotOrderLong) {
        <li class="active" data-menu="express-not-order-long-menu">长期未出库</li>
    } else if (Model.Cate == ExpressListMenuCate.NotPicked) {
        <li class="active" data-menu="express-not-picked-menu">未认领</li>
    } else if (Model.Cate == ExpressListMenuCate.NotPickedLong) {
        <li class="active" data-menu="express-not-picked-long-menu">长期未认领</li>
    } else if (Model.Cate == ExpressListMenuCate.Dumped) {
        <li class="active" data-menu="express-dumped-menu">已堆存</li>
    } else if (Model.Cate == ExpressListMenuCate.OnShelf) {
        <li class="active" data-menu="express-on-shelf-menu">已上架</li>
    } else if (Model.Cate == ExpressListMenuCate.Picked) {
        <li class="active" data-menu="express-picked-menu">已认领</li>
    } else if (Model.Cate == ExpressListMenuCate.ToOffShelf) {
        <li class="active" data-menu="express-to-off-shelf-menu">待下架</li>
    } else if (Model.Cate == ExpressListMenuCate.ToOnShelf) {
        <li class="active" data-menu="express-to-on-shelf-menu">待上架</li>
    } else if (Model.Cate == ExpressListMenuCate.Return) {
        <li class="active" data-menu="express-return-index-menu">退运池</li>
    } else if (Model.Cate == ExpressListMenuCate.WoodFrame) {
        <li class="active" data-menu="express-wood-frame-menu">打木架</li>
    } else if (Model.Cate == ExpressListMenuCate.BarkClean) {
        <li class="active" data-menu="express-bark-clean-menu">清理树皮杂物</li>
    } else {
        <li class="active" data-menu="express-detail-menu">@(ViewData[ViewDataKey.Title])</li>
    }
    <li>
        <span>快递单号</span>
        <span>
            @(Model.Express.TrackingNo)
        </span>
        <span>&nbsp;</span>
        <span>入库号跟踪号</span>
        <span>
            @(Model.Express.CheckinTrackingNo)
        </span>
    </li>
}

@section Style {
    <style type="text/css">
    
        div.detailSubTitle {
            margin: 10px 0;
            padding: 5px 0;
            font-weight: bold;
            border-bottom: lightgray 1px solid;
            color: #2a62bc;
        }
        
        
    </style>
}

<div class="widget-box" style="border-style: none; width: 1100px;">
    <div class="widget-body">
        <div class="widget-main">
            <form id="expressDetailForm" class="form-horizontal" role="form">

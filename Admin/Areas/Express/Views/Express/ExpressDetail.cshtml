                                    <div class="form-group">
                                        <label asp-for="Express.PackingTime" class="col-xs-4 control-label">入流动仓时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.PackingTime" type="text" value="@(Model.Express.PackingTime?.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="row">

                                @{
                                    int seq = 0;
                                    foreach (UserTimeItem userTime in Model.PackUserTimeList) {
                                        seq = seq + 1;

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="pack_user_@(seq)" class="col-xs-4 control-label">打包人员@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="pack_user_@(seq)" type="text" disabled="disabled" class="input-sm form-control" value="@(userTime.User.UserName)"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="pack_time_@(seq)" class="col-xs-4 control-label">打包时间@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="pack_time_@(seq)" type="text" value="@(userTime.Time.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                            </div>

                            <div class="row">

                                @{
                                    seq = 0;
                                    foreach (UserTimeItem userTime in Model.ShipUserTimeList) {
                                        seq = seq + 1;

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="ship_user_@(seq)" class="col-xs-4 control-label">发货人员@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="ship_user_@(seq)" type="text" disabled="disabled" class="input-sm form-control" value="@(userTime.User.UserName)"/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-xs-3">
                                            <div class="form-group">
                                                <label for="ship_time_@(seq)" class="col-xs-4 control-label">发货时间@(seq == 1 ? "" : seq.ToString())</label>
                                                <div class="col-xs-8">
                                                    <input id="ship_time_@(seq)" type="text" value="@(userTime.Time.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                            </div>


                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Customer!.CustomerCodeCache" class="col-xs-4 control-label">认领客户</label>
                                        <div class="col-xs-8">
                                            @*<input asp-for="Customer.CustomerCode" type="text" disabled="disabled" class="input-sm form-control"/>*@
                                            @if (Model.Customer != null) {
                                                <label class="control-label">
                                                    <a href="@Url.Action("Detail", "Customer", new { id = Model.Customer?.Id ?? 0 })" target="_blank">@(Model.Customer?.CustomerCodeCache)</a>
                                                </label>
                                            } else {
                                                <input asp-for="Customer!.CustomerCodeCache" type="text" disabled="disabled" class="input-sm form-control"/>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.ClaimTime" class="col-xs-4 control-label">认领时间</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.ClaimTime" type="text" value="@(Model.Express.ClaimTime?.ToString("yyyy-MM-dd HH:mm"))" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.Order!.Code" class="col-xs-4 control-label">所在订单</label>
                                        <div class="col-xs-8">
                                            @if (Model.Express.Order != null) {
                                                <label class="control-label">
                                                    <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Detail" asp-route-id="@(Model.Express.Order?.Id ?? 0)" target="_blank">
                                                        @(Model.Express.Order?.Code)
                                                    </a>
                                                </label>
                                            } else {
                                                <input asp-for="Express.Order!.Code" type="text" disabled="disabled" class="input-sm form-control"/>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.Order!.OrderStatus.Name" class="col-xs-4 control-label">订单状态</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.Order!.OrderStatus.Name" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">

                                @foreach (var remark in Model.ExpressRemarkList) {
                                    if (remark.Type == ExpressRemarkType.Service) {
                                        <div class="col-xs-6">
                                            <div class="form-group">
                                                <label for="remark_@(remark.Id)" class="col-xs-2 control-label">@(remark.Type.Name)</label>
                                                <div class="col-xs-10">
                                                    @if (Model.CanCustomerServiceRemark == false) {
                                                        <textarea id="serviceRemark" rows="2" disabled="disabled" class="input-sm form-control"></textarea>
                                                    } else {
                                                        <textarea id="serviceRemark"  rows="2" class="input-sm form-control"></textarea>
                                                        <div style="padding: 5px 0; text-align: right; width: 100%">
                                                            <button type="button" class="btn btn-xs btn-default" onclick="saveServiceRemark()">保存客服留言</button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    } else {
                                        <div class="col-xs-6">
                                            <div class="form-group">
                                                <label for="remark_@(remark.Id)" class="col-xs-2 control-label">@(remark.Type.Name)</label>
                                                <div class="col-xs-10">
                                                    <textarea id="remark_@(remark.Id)" rows="2" disabled="disabled" class="input-sm form-control"></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                                <script type="text/javascript">
                                    function saveServiceRemark()
                                    {
                                        showMask("数据加载中，请稍候");
                                
                                        $.ajax({
                                            url: "@Url.Action("SaveExpressCustomerServiceRemark", "Express")",
                                            type: "POST",
                                            data: {
                                                'expressId': @(Model.Express.Id),
                                                'serviceRemark': $('#serviceRemark').val()
                                            },
                                            success: function(data) {
                                                hideMask();
                                
                                                if (data.success === false) {
                                                    $.msg.error(data.message);
                                                    return;
                                                }
                                                
                                                $.msg.show(data.message);
                                            }
                                        });
                                    }
                                </script>

                            </div>

                            <div class="row">

                                <div class="col-xs-12">
                                    <div class="form-group">
                                        <label class="col-xs-1 control-label">标签预览</label>
                                        <div class="col-xs-11">

                        </div>

                        <div id="panelBaseInfo" style="display: block;">
                            <div class="row">

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.CheckinTrackingNo" class="col-xs-4 control-label">澳拼入库号</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.CheckinTrackingNo" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <label asp-for="Express.TrackingNo" class="col-xs-4 control-label">快递单号</label>
                                        <div class="col-xs-8">
                                            <input asp-for="Express.TrackingNo" type="text" disabled="disabled" class="input-sm form-control"/>
                                        </div>
                                    </div>
                                </div>


@{
    Layout = null;
}
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Domain.Express
@using shunda.Service.Express
@model shunda.Admin.Areas.Express.Models.ExpressPhoto.ExpressPhotoListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadExpressPhotoList" })

<table id="tblExpressPhotoList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="expressPhotoCheckAll"></label><input id="expressPhotoCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 100px; text-align: center;">
                客户
            </th>
            <th style="width: 120px; text-align: center;">
                物流订单
            </th>
            <th style="width: 180px; text-align: center;">
                快递单号
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ExpressPhotoInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressPhotoList">类型</a>
            </th>
            <th style="width: 250px;">
                <span>图片</span>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ExpressPhotoInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressPhotoList">添加时间</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(ExpressPhotoInfo.User))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressPhotoList">拍照人</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ExpressPhotoList != null && Model.ExpressPhotoList.Count() != 0) {
            var order = 1;
            foreach (var expressPhoto in Model.ExpressPhotoList) {
                <tr>
                    <td style="text-align: center;">
                        <label for="expressPhotoCheck_@(expressPhoto.Id)"></label><input id="expressPhotoCheck_@(expressPhoto.Id)" type="checkbox" class="ace" value="@expressPhoto.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">
                        <a href="@Url.Action("Detail", "Customer", new { id = expressPhoto.Customer?.Id })" target="_blank">
                            @expressPhoto.CustomerCodeCache
                        </a>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        @if (expressPhoto.Order != null) {
                            <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(expressPhoto.Order.Id)" target="_blank">
                                @expressPhoto.OrderCode
                            </a>
                        }
                    </td>
                    <td style="text-align: center;" class="break-word">
                        @if (expressPhoto.Express != null) {
                            <a asp-area="Express" asp-controller="ExpressDetail" asp-action="Index" asp-route-cateId="@(ExpressListMenuCate.All.Id)" asp-route-id="@(expressPhoto.Express.Id)" target="_blank">
                                <span>@expressPhoto.TrackingNo</span>
                            </a>
                        } else {
                            <span>@expressPhoto.TrackingNo</span>
                        }

                    </td>
                    <td style="text-align: center;">
                        @expressPhoto.Type?.Name
                    </td>
                    <td>
                        <a href="@(expressPhoto.BigImageFullUrlCache)" target="_blank">
                            <img src="@(expressPhoto.SmallImageFullUrlCache)" alt="" style="max-width: 180px; max-height: 100px;"/>
                        </a>
                    </td>
                    <td style="text-align: center;">@expressPhoto.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="text-align: center;">@(expressPhoto.User?.UserName)</td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="10">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadExpressPhotoList" })
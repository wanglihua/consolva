@using Microsoft.AspNetCore.Mvc.TagHelpers
@using shunda.Admin.Areas.Express.Models.ExpressVideo
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Express
@model shunda.Admin.Areas.Express.Models.ExpressVideo.ExpressVideoIndexModel
@{
    ViewData[ViewDataKey.Title] = "快递单视频";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="express-menu">快递管理</li>
    <li class="active" data-menu="express-video-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadExpressVideoList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>

    @if (Model.CanExpressPhotoDelete)
    {
        <button type="button" class="btn btn-danger btn-sm" onclick="deleteExpressVideo()">
            <i class="ace-icon fa fa-trash-o"></i>
            删除
        </button>
    }

</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="typeIdQuery">类型</label>&nbsp;
    <select id="typeIdQuery" name="typeIdQuery" style="width: 100px; height: 30px;" placeholder="类型查询">
        <option value="0">类型查询</option>
        @foreach (ExpressVideoType videoType in Model.VideoTypeList)
        {
            <option value="@(videoType.Id)">@(videoType.Name)</option>
        }
    </select> &nbsp;
    <label for="customerCodeQuery">客户ID</label>&nbsp;<input id="customerCodeQuery" name="customerCodeQuery" style="width: 100px; height: 30px;" placeholder="客户ID查询"/>&nbsp;
    <label for="orderCodeQuery">订单编号</label>&nbsp;<input id="orderCodeQuery" name="orderCodeQuery" style="width: 100px; height: 30px;" placeholder="订单编号查询"/>&nbsp;
    <label for="trackingNoQuery">快递单号</label>&nbsp;<input id="trackingNoQuery" name="trackingNoQuery" style="width: 180px; height: 30px;" placeholder="快递单号查询"/>&nbsp;
    
    <label for="beginDateQuery">开始日期</label>&nbsp;<input id="beginDateQuery" name="beginDateQuery" style="width: 90px; height: 30px;" placeholder="开始日期" autocomplete="off"/>&nbsp;
    <label for="endDateQuery">截止日期</label>&nbsp;<input id="endDateQuery" name="endDateQuery" style="width: 90px; height: 30px;" placeholder="截止日期" autocomplete="off"/>&nbsp;
    
    <label for="userNameQuery">拍照人</label>&nbsp;<input id="userNameQuery" name="userNameQuery" style="width: 90px; height: 30px;" placeholder="拍照人查询" autocomplete="off"/>&nbsp;

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadExpressVideoList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="expressVideoList" data-page-index="0" data-sort-field="@(nameof(ExpressVideoInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="expressVideoDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        $('#beginDateQuery').datetimepicker({
            locale: "zh-cn",
            format: 'L'
        });

        $('#endDateQuery').datetimepicker({
            locale: "zh-cn",
            format: 'L',
            useCurrent: false
        });

        $("#beginDateQuery").on("dp.change", function (e) {
            $('#endDateQuery').data("DateTimePicker").minDate(e.date);
        });

        $("#endDateQuery").on("dp.change", function (e) {
            $('#beginDateQuery').data("DateTimePicker").maxDate(e.date);
        });
        
        loadExpressVideoList();
    });

    function sortExpressVideoList(sortField, sortDir) {
        var list = $('#expressVideoList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadExpressVideoList();
    }

    function loadExpressVideoList(pageIndex) {
        var list = $('#expressVideoList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "ExpressVideo")",
            type: "POST",
            data: {
                '@(nameof(ExpressVideoListQueryParam.TypeQuery))': $('#typeIdQuery').val(),
                '@(nameof(ExpressVideoListQueryParam.CustomerCodeQuery))': $('#customerCodeQuery').val(),
                '@(nameof(ExpressVideoListQueryParam.OrderCodeQuery))': $('#orderCodeQuery').val(),
                '@(nameof(ExpressVideoListQueryParam.TrackingNoQuery))': $('#trackingNoQuery').val(),
                '@(nameof(ExpressVideoListQueryParam.BeginDateQuery))': $('#beginDateQuery').val(),
                '@(nameof(ExpressVideoListQueryParam.EndDateQuery))': $('#endDateQuery').val(),    
                '@(nameof(ExpressVideoListQueryParam.UserNameQuery))': $('#userNameQuery').val(),                
                '@(nameof(ExpressVideoListQueryParam.PageIndex))': pageIndex,
                '@(nameof(ExpressVideoListQueryParam.SortField))': sortField,
                '@(nameof(ExpressVideoListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#expressVideoList').html(data);

                initListTable("#tblExpressVideoList");
            }
        });
    }

    function deleteExpressVideo() {
        var idList = getSelectIdList('#tblExpressVideoList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                $.ajax({
                    url: '@Url.Action("Delete", "ExpressVideo")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        loadExpressVideoList();
                    }
                });
            }
        );
    }

</script>
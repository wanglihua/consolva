@{
    Layout = null;
}
@using shunda.Domain.Express
@using shunda.Service.Express
@model shunda.Admin.Areas.Express.Models.ExpressVideo.ExpressVideoListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadExpressVideoList" })

<table id="tblExpressVideoList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="expressVideoCheckAll"></label><input id="expressVideoCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 100px; text-align: center;">
                客户
            </th>
            <th style="width: 120px; text-align: center;">
                物流订单
            </th>
            <th style="width: 180px; text-align: center;">
                快递单号
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ExpressVideoInfo.Type))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressVideoList">类型</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <span>视频</span>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(ExpressVideoInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressVideoList">添加时间</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(ExpressVideoInfo.User))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortExpressVideoList">录制人</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ExpressVideoList != null && Model.ExpressVideoList.Count() != 0) {
            int order = 1;
            foreach (ExpressVideoInfo expressVideo in Model.ExpressVideoList) {
                <tr>
                    <td style="text-align: center;">
                        <label for="expressVideoCheck_@(expressVideo.Id)"></label><input id="expressVideoCheck_@(expressVideo.Id)" type="checkbox" class="ace" value="@expressVideo.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">
                        <a href="@Url.Action("Detail", "Customer", new { id = expressVideo.Customer?.Id })" target="_blank">
                            @expressVideo.CustomerCodeCache
                        </a>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        @if (expressVideo.Order != null) {
                            <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(expressVideo.Order.Id)" target="_blank">
                                @expressVideo.Order?.Code
                            </a>
                        }
                    </td>
                    <td style="text-align: center;" class="break-word">
                        @if (expressVideo.Express != null) {
                            <a asp-area="Express" asp-controller="ExpressDetail" asp-action="Index" asp-route-cateId="@(ExpressListMenuCate.All.Id)" asp-route-id="@(expressVideo.Express.Id)" target="_blank">
                                @expressVideo.TrackingNo
                            </a>
                        } else {
                            <span>@expressVideo.TrackingNo</span>
                        }

                    </td>
                    <td style="text-align: center;">
                        @expressVideo.Type?.Name
                    </td>
                    <td style="text-align: center;">
                        <a href="@(expressVideo.VideoFullUrlCache)" target="_blank">查看视频</a>
                    </td>
                    <td style="text-align: center;">@expressVideo.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="text-align: center;">@(expressVideo.User?.UserName)</td>
                    <td></td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="10">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadExpressVideoList" })
@{
    Layout = null;
}
@using shunda.Domain.Express
@model shunda.Admin.Areas.Express.Models.ExpressRemark.ExpressRemarkListModel
<table id="tblExpressRemarkList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 90px; text-align: center;">
                类型
            </th>
            <th>
                备注
            </th>
            <th style="width: 100px; text-align: center;">
                备注人
            </th>
            <th style="width: 120px; text-align: center;">
                备注时间
            </th>
            <th style="width: 90px; text-align: center;">
                操作
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ExpressRemarkList.Count != 0) {
            int order = 1;
            foreach (ExpressRemarkInfo expressRemark in Model.ExpressRemarkList) {
                <tr>
                    <td style="text-align: center;">@(order++)</td>
                    <td style="text-align: center;">
                        @(expressRemark.Type.Name)
                    </td>
                    <td class="break-word">
                        @(expressRemark.Content)
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @if (expressRemark.AddUser != null) {
                                <span>@(expressRemark.AddUser.UserName)</span>
                            } else {
                                <span>-</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: center;" class="break-word">
                        <div>
                            @(expressRemark.CreateTime.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <a href="javascript:deleteExpressRemark('@(expressRemark.Id)');">删除</a>
                    </td>
                </tr>
            }
        } else {
            <tr>
                <td colspan="6">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
    function showExpressRemarkDetail() {
        $("#expressRemarkDetailDialogWrapper").html("");

        showMask("加载中...");
        $.ajax({
            url: '@Url.Action("Detail", "ExpressRemark")',
            type: "POST",
            data: { "expressId": "@(Model.ExpressId)" },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#expressRemarkDetailDialogWrapper").html(data);
                $("#expressRemarkDetailDialog").modal(modalOptions);
            }
        });
    }   

    function saveExpressRemark() {
        var form = $("#expressRemarkDetailForm");
        var valid = validate(form);                                
        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "ExpressRemark")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        //return;
                    } else {
                        $.msg.show(data.message);
                        $('#expressRemarkDetailDialog').modal('hide');
                        loadExpressRemarkList();
                        //return;
                    }
                }
            });
        }
    }
    
    function loadExpressRemarkList() {
        showMask("加载中...");
        $.ajax({
            url: '@Url.Action("ExpressRemarkList", "ExpressRemark")',
            type: "POST",
            data: { "expressId": "@(Model.ExpressId)" },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#orderRemarkListWrapper").html(data);
            }
        });
    }       
    
    function deleteExpressRemark(id) {
        $.msg.confirm("确认要删除订单备注吗？", function() {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("SingleDelete", "ExpressRemark")',
                type: "POST",
                data: { "id": id },
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }
                    
                    $.msg.show(data.message);
    
                    loadExpressRemarkList();
                }
            });
        });
    }

</script>
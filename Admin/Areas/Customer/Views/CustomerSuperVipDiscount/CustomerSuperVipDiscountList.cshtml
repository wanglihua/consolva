@{
    Layout = null;
}
@using shunda.Domain.Customer
@model shunda.Admin.Areas.Customer.Models.CustomerSuperVipDiscount.CustomerSuperVipDiscountListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadCustomerSuperVipDiscountList" })

<table id="tblCustomerSuperVipDiscountList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="customerSuperVipDiscountCheckAll"></label><input id="customerSuperVipDiscountCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(CustomerSuperVipDiscountInfo.Customer))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerSuperVipDiscountList">客户</a>
            </th>
            <th style="width: 150px; text-align: center;">
                <a field="@(nameof(CustomerSuperVipDiscountInfo.Description))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerSuperVipDiscountList">备注</a>
            </th>
            <th style="width: 110px; text-align: center;">
                <a field="@(nameof(CustomerSuperVipDiscountInfo.Discount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerSuperVipDiscountList">折扣</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(CustomerSuperVipDiscountInfo.User))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerSuperVipDiscountList">操作用户</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(CustomerSuperVipDiscountInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerSuperVipDiscountList">创建时间</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(CustomerSuperVipDiscountInfo.UpdateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerSuperVipDiscountList">修改时间</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CustomerSuperVipDiscountList != null && Model.CustomerSuperVipDiscountList.Count() != 0)
        {
            var order = 1;
            foreach (var customerSuperVipDiscount in Model.CustomerSuperVipDiscountList)
            {
                <tr ondblclick="showCustomerSuperVipDiscountDetail(@(customerSuperVipDiscount.Id));">
                    <td style="text-align: center;">
                        <label for="customerSuperVipDiscountCheck_@(customerSuperVipDiscount.Id)"></label><input id="customerSuperVipDiscountCheck_@(customerSuperVipDiscount.Id)" type="checkbox" class="ace" value="@customerSuperVipDiscount.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">
                        <a asp-area="Customer" asp-controller="Customer" asp-action="Detail" asp-route-Id="@(customerSuperVipDiscount.Customer.Id)" target="_blank">
                            @customerSuperVipDiscount.CustomerCodeCache
                        </a>
                    </td>
                    <td style="text-align: left;" class="break-word">
                        @customerSuperVipDiscount.Description
                    </td>
                    <td style="text-align: center;">
                        @(customerSuperVipDiscount.Discount)%
                    </td>
                    <td style="text-align: center;" class="break-word">
                        @(customerSuperVipDiscount.User.UserName)
                    </td>
                    <td style="text-align: center;">@customerSuperVipDiscount.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="text-align: center;">@customerSuperVipDiscount.UpdateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadCustomerSuperVipDiscountList" })
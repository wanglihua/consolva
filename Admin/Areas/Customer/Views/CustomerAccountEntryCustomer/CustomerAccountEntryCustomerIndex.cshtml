@using shunda.Admin.Areas.Customer.Models.CustomerAccountEntryCustomer
@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Customer
@model shunda.Admin.Areas.Customer.Models.CustomerAccountEntryCustomer.CustomerAccountEntryCustomerIndexModel
@{
    ViewData[ViewDataKey.Title] = "客户余额明细";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="customer-menu">客户管理</li>
    <li class="active" data-menu="customer-customer-index-menu">
        <a href="@Url.Action("Index","Customer")">客户列表</a>
    </li>
    <li>
        <a target="_blank" href="@Url.Action("Detail", "Customer", new {id = Model.Customer.Id})"><span>@Model.Customer.CustomerCodeCache</span></a>
    </li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

<div id="customerAccountEntryList" data-page-index="0" data-sort-field="@(nameof(CustomerAccountEntryInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="customerAccountEntryDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadCustomerAccountEntryList();
    });

    function sortCustomerAccountEntryList(sortField, sortDir) {
        var list = $('#customerAccountEntryList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadCustomerAccountEntryList();
    }

    function loadCustomerAccountEntryList(pageIndex) {
        var list = $('#customerAccountEntryList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "CustomerAccountEntryCustomer")",
            type: "POST",
            data: {
                '@(nameof(CustomerAccountEntryCustomerListQueryParam.CustomerId))': @Model.Customer.Id,
                '@(nameof(CustomerAccountEntryCustomerListQueryParam.PageIndex))': pageIndex,
                '@(nameof(CustomerAccountEntryCustomerListQueryParam.SortField))': sortField,
                '@(nameof(CustomerAccountEntryCustomerListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#customerAccountEntryList').html(data);

                initListTable("#tblCustomerAccountEntryList");
            }
        });
    }

</script>
@using shunda.Core.Web
@model shunda.Admin.Areas.Customer.Models.CustomerSupperPassword.CustomerSupperPasswordIndexModel
@{
    ViewData[ViewDataKey.Title] = "超级密码";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="customer-menu">会员管理</li>
    <li class="active" data-menu="customer-customer-supper-password-index-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div id="query">
    <label for="customerCode">客户数字ID</label>&nbsp;<input id="customerCode" name="customerCode" style="width: 180px; height: 30px;" placeholder="请输入客户ID"/>&nbsp;
    <button type="button" class="btn btn-success btn-sm" onclick="generateCustomerSupperPassword()" style="margin-bottom: 3px; height: 30px;">
        <i class="ace-icon fa fa-plus"></i>
        生成超级密码
    </button>
</div>

<div id="supperPassword" style="display: none;">
    <img id="supperPasswordQrCode" style="width: 400px; height: 400px;" alt="" src=""/>
    <div style="width: 400px;text-align: center;margin: 8px;">有效期 @(Model.PasswordExpireMinutes) 分钟</div>
    <div id="customerDescription" style="width: 400px; text-align: center; margin: 8px;"></div>
</div>

<script type="text/javascript">

    function generateCustomerSupperPassword() {
        $("#supperPassword").hide();

        var customerCode = $("#customerCode").val();

        if(customerCode === "")
        {
            $.msg.error("请输入 客户ID 或者 客户注册手机号 ！");
            return;
        }

        $.ajax({
            url: '@Url.Action("Generate", "CustomerSupperPassword")',
            type: "POST",
            data: {
                "customerCode": customerCode
            },
            success: function(data) {
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                } 
                
                $.msg.show(data.message);

                var qrCodeImageUrl = "@Url.Action("Svg", "QrCode", new { code = "88888" })";
                qrCodeImageUrl = qrCodeImageUrl.replace(/88888/, data.password);

                $("#supperPasswordQrCode").attr("src", qrCodeImageUrl);
                $("#customerDescription").html(data.customerDescription);

                $("#supperPassword").show();
            }
        });
    }

</script>
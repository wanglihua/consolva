@using shunda.Core.Web
@using shunda.Domain
@using shunda.Domain.Customer
@model shunda.Admin.Areas.Customer.Models.CustomerAddress.CustomerAddressIndexModel
@{
    ViewData[ViewDataKey.Title] = "客户收发地址";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="customer-menu">客户管理</li>
    <li class="active" data-menu="customer-customer-index-menu">
        <a href="@Url.Action("Index", "Customer")">客户列表</a>
    </li>
    <li>
        <a target="_blank" href="@Url.Action("Detail", "Customer", new { id = Model.Customer.Id })">
            <span>@Model.Customer.CustomerCodeCache</span>
        </a>
    </li>
    <li>@(ViewData[ViewDataKey.Title])</li>
}

<div id="customerAddressList">

    @if (Model.CustomerReceiveAddressList != null && Model.CustomerReceiveAddressList.Count != 0)
    {
        int index = 1;
        foreach (CustomerReceiveAddressInfo customerAddress in Model.CustomerReceiveAddressList)
        {
            <div class="addressBox">
                <div class="order-num">
                    <span>#@(index++)&nbsp;</span>
                    <span style="background-color: green; color: white;">@(customerAddress.Country.Name)&nbsp;</span>
                    <span>
                        <a href="javascript:receiveDetail('@(customerAddress.Id)');" class="btn btn-minier btn-yellow">
                            <i class="ace-icon fa fa-pencil"></i>
                            编辑
                        </a>
                    </span>
                </div>
                <table class="addressTable">
                    <tr>
                        <td class="addressLabel">
                            <span >收货人</span>
                        </td>
                        <td class="addressDetail" style="width: 100px;">
                            <span>@customerAddress.FirstName</span><span>&nbsp;</span><span>@customerAddress.LastName</span>
                        </td>

                        <td class="addressLabel">
                            <span>手机</span>
                        </td>
                        <td class="addressDetail">
                            <span>@customerAddress.Mobile</span>
                        </td>

                        <td class="addressLabel">
                            <span></span>
                        </td>
                        <td class="addressDetail">
                            <span></span>
                        </td>
                    </tr>

                    <tr>
                        <td class="addressLabel">
                            <span>州</span>
                        </td>
                        <td class="addressDetail">
                            <span>@customerAddress.State</span>
                        </td>

                        <td class="addressLabel">
                            <span>城市</span>
                        </td>
                        <td class="addressDetail" style="width: 200px;">
                            <span>@customerAddress.City</span>
                        </td>

                        <td class="addressLabel">
                            <span>地址</span>
                        </td>
                        <td class="addressDetail" style="width: 250px">
                            @if (string.IsNullOrWhiteSpace(customerAddress.UnitLoc) == false)
                            {
                                <span>@(customerAddress.UnitLoc), </span>
                            }
                            <span>@customerAddress.Address</span>
                        </td>
                    </tr>

                    <tr>
                        <td class="addressLabel">
                            <span>邮政编码</span>
                        </td>
                        <td class="addressDetail">
                            <span>@customerAddress.Zipcode</span>
                        </td>

                        <td class="addressLabel">
                            <span>ABN/ACN</span>
                        </td>
                        <td class="addressDetail">
                            <span>@customerAddress.Tfn</span>
                        </td>

                        <td class="addressLabel">
                            <span>公司</span>
                        </td>
                        <td class="addressDetail">
                            <span>@customerAddress.Company</span>
                        </td>
                    </tr>

                    <tr>
                        <td class="addressLabel">
                            <span>默认地址</span>
                        </td>
                        <td class="addressDetail">
                            @if (customerAddress.IsDefault)
                            {
                                <span class="default-address">是</span>
                            }
                            else
                            {
                                <span>否</span>
                            }
                        </td>
                        <td class="addressLabel">
                            <span>地址状态</span>
                        </td>
                        <td class="addressDetail">
                            <span>@(customerAddress.Status.Name)</span>
                        </td>
                    </tr>
                </table>
            </div>
        }
    }
    else
    {
        <div class="addressBox">
            <span>暂时没有数据！</span>
        </div>
    }

    @if (Model.CustomerSendAddressList != null && Model.CustomerSendAddressList.Count() != 0)
    {
        int index = 1;
        foreach (CustomerSendAddressInfo address in Model.CustomerSendAddressList)
        {
            <div class="addressBox">
                <div class="order-num">#@(index++)&nbsp;<span style="background-color: red; color: white;">中</span></div>
                <table class="addressTable">
                    <tr>
                        <td class="addressLabel">
                            <span >发货人</span>
                        </td>
                        <td class="addressDetail" style="width: 100px;">
                            <span>@(address.Name)</span>
                        </td>

                        <td class="addressLabel">
                            <span>手机</span>
                        </td>
                        <td class="addressDetail">
                            <span>@address.Mobile</span>
                        </td>

                        <td class="addressLabel">
                            <span></span>
                        </td>
                        <td class="addressDetail">
                            <span></span>
                        </td>
                    </tr>

                    <tr>
                        <td class="addressLabel">
                            <span>省份</span>
                        </td>
                        <td class="addressDetail">
                            <span>@address.Province.Name</span>
                        </td>

                        <td class="addressLabel">
                            <span>城市</span>
                        </td>
                        <td class="addressDetail" style="width: 200px;">
                            <span>@address.City.Name</span>
                        </td>

                        <td class="addressLabel">
                            <span>地址</span>
                        </td>
                        <td class="addressDetail" style="width: 250px">
                            <span>@address.Address</span>
                        </td>
                    </tr>

                    <tr>
                        <td class="addressLabel">
                            <span>邮政编码</span>
                        </td>
                        <td class="addressDetail">
                            <span>@address.Zipcode</span>
                        </td>

                        <td class="addressLabel">
                            <span>公司</span>
                        </td>
                        <td class="addressDetail">
                            <span>@address.Company</span>
                        </td>

                        <td class="addressLabel">
                            <span>&nbsp;</span>
                        </td>
                        <td class="addressDetail">
                            <span>&nbsp;</span>
                        </td>

                    </tr>

                    <tr>
                        <td class="addressLabel">
                            <span>默认地址</span>
                        </td>
                        <td class="addressDetail">
                            @if (address.IsDefault)
                            {
                                <span class="default-address">是</span>
                            }
                            else
                            {
                                <span>否</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        }
    }
    else
    {
        <div class="addressBox">
            <span>暂时没有数据！</span>
        </div>
    }

</div>

<div id="customerAddressReceiverDetailDialogWrapper"></div>

<script type="text/javascript">

    function receiveDetail(id) {
        $("#customerAddressReceiverDetailDialogWrapper").html("");

        showMask("加载中...");

        $.ajax({
            url: '@Url.Action("ReceiveDetail", "CustomerAddress")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#customerAddressReceiverDetailDialogWrapper").html(data);
                $("#customerAddressReceiverDetailDialog").modal(modalOptions);
            }
        });
    }
    
    function receiveSave() {
        var form = $("#customerAddressReceiverDetailForm");
        var valid = validate(form);
        
        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("ReceiveSave", "CustomerAddress")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    } 

                    $.msg.show(data.message);
                    $('#customerAddressReceiverDetailDialog').modal('hide');

                    setTimeout(function() {
                        window.location.reload();
                    }, 1000);
                }
            });
        }
    }

</script>
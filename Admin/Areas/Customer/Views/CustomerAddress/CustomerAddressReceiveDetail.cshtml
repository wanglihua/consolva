@using Microsoft.AspNetCore.Mvc.TagHelpers
@model shunda.Admin.Areas.Customer.Models.CustomerAddress.CustomerAddressReceiveDetailModel

@{
    Layout = null;
}

<div class="modal fade" id="customerAddressReceiverDetailDialog">
    <div class="modal-dialog" style="width: 780px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">客户收货地址详细</h4>
            </div>
            <div class="modal-body clearfix">

                <form id="customerAddressReceiverDetailForm" action="" method="post" class="form-horizontal" role="form">
                    <input asp-for="Id" type="hidden"/>
                    <input asp-for="CustomerId" type="hidden"/>
                    <div class="col-xs-12">
                        <div class="row">

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="FirstName" class="col-xs-4 control-label">名(first name)</label>
                                    <div class="col-xs-8">
                                        <input asp-for="FirstName" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="LastName" class="col-xs-4 control-label">姓(last name)</label>
                                    <div class="col-xs-8">
                                        <input asp-for="LastName" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="Mobile" class="col-xs-4 control-label">手机号码</label>
                                    <div class="col-xs-8">
                                        <input asp-for="Mobile" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="UnitLoc" class="col-xs-4 control-label">Unit号</label>
                                    <div class="col-xs-8">
                                        <input asp-for="UnitLoc" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">

                            <div class="col-xs-12">
                                <div class="form-group">
                                    <label asp-for="Address" class="col-xs-2 control-label">门牌号/路名</label>
                                    <div class="col-xs-10">
                                        <input asp-for="Address" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-12">
                                <div class="form-group">
                                    <label asp-for="City" class="col-xs-2 control-label">区/Suburb</label>
                                    <div class="col-xs-10">
                                        <input asp-for="City" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="State" class="col-xs-4 control-label">省/州</label>
                                    <div class="col-xs-8">
                                        <input asp-for="State" type="text"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="Zipcode" class="col-xs-4 control-label">邮编</label>
                                    <div class="col-xs-8">
                                        <input asp-for="Zipcode" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="Tfn" class="col-xs-4 control-label">ABN/ACN</label>
                                    <div class="col-xs-8">
                                        <input asp-for="Tfn" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="Company" class="col-xs-4 control-label">公司</label>
                                    <div class="col-xs-8">
                                        <input asp-for="Company" type="text" class="input-sm form-control"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                        
                        <div class="row">
                            <div class="col-xs-6">
                                <div class="form-group">
                                    <label asp-for="Country" class="col-xs-4 control-label">国家</label>
                                    <div class="col-xs-8">
                                        <select asp-for="Country" class="input-sm form-control">
                                            <option value="0"></option>
                                            @foreach (var country in Model.CountryList) {
                                                <option value="@(country.Id)">@(country.Name)</option>
                                            }
                                            
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-6">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="receiveSave();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
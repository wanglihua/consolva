@using shunda.Domain
@model shunda.Admin.Areas.Customer.Models.CustomerChargeAwardSetting.CustomerChargeAwardSettingDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="customerChargeAwardSettingDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">客户充值优惠设置详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="customerChargeAwardSettingDetailForm" class="form-horizontal" role="form">
                    <input asp-for="CustomerChargeAwardSettingId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="AmountBegin" class="col-xs-2 control-label">最小充值金额</label>
                                <div class="col-xs-10">
                                    <input asp-for="AmountBegin" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="AmountEnd" class="col-xs-2 control-label">最大充值金额</label>
                                <div class="col-xs-10">
                                    <input asp-for="AmountEnd" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="Award" class="col-xs-2 control-label">奖励金额</label>
                                <div class="col-xs-10">
                                    <input asp-for="Award" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveCustomerChargeAwardSetting();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
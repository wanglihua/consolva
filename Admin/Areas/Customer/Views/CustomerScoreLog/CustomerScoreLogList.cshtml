@{
    Layout = null;
}
@using shunda.Domain.Customer
@model shunda.Admin.Areas.Customer.Models.CustomerScoreLog.CustomerScoreLogListModel

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadCustomerScoreLogList" })

<table id="tblCustomerScoreLogList" class="data-list-table table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label for="customerScoreLogCheckAll"></label><input id="customerScoreLogCheckAll" type="checkbox" class="ace checkall"/><span class="lbl"></span>
            </th>
            <th style="width: 50px; text-align: center;">序号</th>
            <th style="width: 80px; text-align: center;">
                <a field="@(nameof(CustomerScoreLogInfo.Customer))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerScoreLogList">会员</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(CustomerScoreLogInfo.ScoreType))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerScoreLogList">积分类型</a>
            </th>
            <th style="width: 90px; text-align: center;">
                <a field="@(nameof(CustomerScoreLogInfo.Score))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerScoreLogList">变动积分</a>
            </th>
            <th style="width: 90px; text-align: center;">
                <a field="@(nameof(CustomerScoreLogInfo.IsValidScore))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerScoreLogList">有效积分</a>
            </th>
            <th style="width: 100px; text-align: center;">
                <a field="@(nameof(CustomerScoreLogInfo.LogisticsOrderCode))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerScoreLogList">订单编号</a>
            </th>
            <th style="width: 90px; text-align: center;">
                <a field="@(nameof(CustomerScoreLogInfo.LogisticsOrderCustomer))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerScoreLogList">订单会员</a>
            </th>
            <th style="width: 90px; text-align: center;">
                <a field="@(nameof(CustomerScoreLogInfo.Amount))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerScoreLogList">金额</a>
            </th>
            <th style="width: 200px;">
                <a field="@(nameof(CustomerScoreLogInfo.Description))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerScoreLogList">变动描述</a>
            </th>
            <th style="width: 120px; text-align: center;">
                <a field="@(nameof(CustomerScoreLogInfo.CreateTime))" sort-field="@Model.ListPager.SortField" sort-dir="@Model.ListPager.SortDir" sort-list-func="sortCustomerScoreLogList">积分时间</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CustomerScoreLogList != null && Model.CustomerScoreLogList.Count() != 0)
        {
            var order = 1;
            foreach (var customerScoreLog in Model.CustomerScoreLogList)
            {
                <tr>
                    <td style="text-align: center;">
                        <label for="customerScoreLogCheck_@(customerScoreLog.Id)"></label><input id="customerScoreLogCheck_@(customerScoreLog.Id)" type="checkbox" class="ace" value="@customerScoreLog.Id"/><span class="lbl"></span>
                    </td>
                    <td style="text-align: center;">@(Model.ListPager.PageIndex * Model.ListPager.PageSize + order++)</td>
                    <td style="text-align: center;">@customerScoreLog.CustomerCodeCache</td>
                    <td style="text-align: center;">@customerScoreLog.ScoreType.Name</td>
                    <td style="text-align: center;">@customerScoreLog.Score.ToString("#0.00")</td>
                    <td style="text-align: center;">
                        @if (customerScoreLog.IsValidScore)
                        {
                            <span>是</span>
                        }
                        else
                        {
                            <span>否</span>
                        }
                    </td>

                    <td style="text-align: center;">
                        <a asp-area="LogisticsOrder" asp-controller="LogisticsOrderDetail" asp-action="Index" asp-route-id="@(customerScoreLog.LogisticsOrder?.Id)" target="_blank">
                            @customerScoreLog.LogisticsOrderCode
                        </a>
                    </td>
                    <td style="text-align: center;">@customerScoreLog.LogisticsOrderCustomerCodeCache</td>
                    <td style="text-align: center;">@customerScoreLog.Amount.ToString("#0.00")</td>
                    <td>@customerScoreLog.Description</td>
                    <td style="text-align: center;">@customerScoreLog.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td></td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="12">
                    暂时没有数据！
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("ListPager", new { model = Model, loadListFunc = "loadCustomerScoreLogList" })
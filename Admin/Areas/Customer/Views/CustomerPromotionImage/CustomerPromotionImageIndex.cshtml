@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Customer
@model CustomerPromotionImageIndexModel
@using shunda.Admin.Areas.Customer.Models.CustomerPromotionImage
@{
    ViewData[ViewDataKey.Title] = "客户推广图片";
    Layout = "_AdminLayout";
}

@*

        <li id="customer-menu">
            <a href="#" class="dropdown-toggle">
                <i class="menu-icon fa fa-copy"></i>
                <span class="menu-text">客户管理</span>
                <b class="arrow fa fa-angle-down"></b>
            </a>
            <b class="arrow"></b>
            <ul class="submenu">

                <li id="customer-customer-promotion-image-menu">
                    <a asp-area="Customer" asp-controller="CustomerPromotionImage" asp-action="Index">
                        <i class="menu-icon fa fa-caret-right"></i>客户推广图片

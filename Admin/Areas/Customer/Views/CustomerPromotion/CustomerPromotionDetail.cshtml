@using shunda.Domain
@model shunda.Admin.Areas.Customer.Models.CustomerPromotion.CustomerPromotionDetailModel
@{
    Layout = null;
}
<div class="modal fade" id="customerPromotionDetailDialog">
    <div class="modal-dialog" style="width: 640px;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="True"></button>
                <h4 class="modal-title">客户推广详细</h4>
            </div>
            <div class="modal-body clearfix">
                <form id="customerPromotionDetailForm" class="form-horizontal" role="form">
                    <input asp-for="CustomerPromotionId" type="hidden"/>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ParentId" class="col-xs-2 control-label">父id</label>
                                <div class="col-xs-10">
                                    <input asp-for="ParentId" type="number" required="required" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ChildId" class="col-xs-2 control-label">子id</label>
                                <div class="col-xs-10">
                                    <input asp-for="ChildId" type="number" digits="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="OpenId" class="col-xs-2 control-label">open id</label>
                                <div class="col-xs-10">
                                    <input asp-for="OpenId" type="text" maxlength="100" class="input-sm form-control" autocomplete="off"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-xs-12">
                            <div class="form-group">
                                <label asp-for="ChildPayAmount" class="col-xs-2 control-label">下家消费金额</label>
                                <div class="col-xs-10">
                                    <input asp-for="ChildPayAmount" type="number" number="true" class="input-sm form-control" autocomplete="off"/>

                                </div>
                            </div>
                        </div>

                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btn-sm" onclick="saveCustomerPromotion();">
                    <i class="ace-icon fa fa-floppy-o"></i>
                    保存
                </button>
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">
                    <i class="ace-icon fa fa-times"></i>
                    关闭
                </button>
            </div>
        </div>
    </div>
</div>
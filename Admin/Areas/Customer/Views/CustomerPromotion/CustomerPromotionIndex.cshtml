@section Breadcrumb {
    <li class="parent" data-menu="customer-menu">客户管理</li>
    <li class="active" data-menu="customer-customer-promotion-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadCustomerPromotionList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>
    <button type="button" class="btn btn-success btn-sm" onclick="showCustomerPromotionDetail(0)">
        <i class="ace-icon fa fa-plus"></i>
        新增
    </button>
    <button type="button" class="btn btn-danger btn-sm" onclick="deleteCustomerPromotion()">
        <i class="ace-icon fa fa-trash-o"></i>
        删除
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadCustomerPromotionList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="customerPromotionList" data-page-index="0" data-sort-field="@(nameof(CustomerPromotionInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="customerPromotionDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        loadCustomerPromotionList();
    });

    function sortCustomerPromotionList(sortField, sortDir) {
        var list = $('#customerPromotionList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadCustomerPromotionList();
    }

    function loadCustomerPromotionList(pageIndex) {
        var list = $('#customerPromotionList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "CustomerPromotion")",
            type: "POST",
            data: {
                "@(nameof(CustomerPromotionListQueryParam.PageIndex))": pageIndex,
                "@(nameof(CustomerPromotionListQueryParam.SortField))": sortField,
                "@(nameof(CustomerPromotionListQueryParam.SortDir))": sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#customerPromotionList').html(data);

                initListTable("#tblCustomerPromotionList");
            }
        });
    }

    function showCustomerPromotionDetail(id) {
        $("#customerPromotionDetailDialogWrapper").html("");

        showMask("加载中...");
        // $("#customerPromotionDetailForm").clearValidation();

        $.ajax({
            url: '@Url.Action("Detail", "CustomerPromotion")',
            type: "POST",
            data: { "id": id },
            success: function(data) {
                hideMask();
                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $("#customerPromotionDetailDialogWrapper").html(data);
                $("#customerPromotionDetailDialog").modal(modalOptions);
            }
        });
    }

    function saveCustomerPromotion() {
        var form = $("#customerPromotionDetailForm");
        var valid = validate(form);

        if (valid) {
            showMask("提交中...");
            $.ajax({
                url: '@Url.Action("Save", "CustomerPromotion")',
                type: "POST",
                data: form.serialize(),
                success: function(data) {
                    hideMask();
                    if (data.success === false) {
                        $.msg.error(data.message);
                        return;
                    }

                    $.msg.show(data.message);
                    $('#customerPromotionDetailDialog').modal('hide');
                    loadCustomerPromotionList();
                }
            });
        }
    }

    function deleteCustomerPromotion() {
        var idList = getSelectIdList('#tblCustomerPromotionList');

        if (idList.length === 0) {
            $.msg.alert("请选择数据！");
            return;
        }

        $.msg.confirm("确认要删除吗？",
            function() {
                showMask("提交中...");
                $.ajax({
                    url: '@Url.Action("Delete", "CustomerPromotion")',
                    type: "POST",
                    data: { "idList": idList },
                    success: function(data) {
                        hideMask();
                        if (data.success === false) {
                            $.msg.error(data.message);
                            return;
                        }

                        $.msg.show(data.message);
                        loadCustomerPromotionList();
                    }
                });
            }
        );
    }

</script>
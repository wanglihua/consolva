@using shunda.Core
@using shunda.Core.Web
@using shunda.Domain.Customer
@model CustomerPromotionIndexModel
@using shunda.Admin.Areas.Customer.Models.CustomerPromotion
@{
    ViewData[ViewDataKey.Title] = "客户推广";
    Layout = "_AdminLayout";
}

@section Breadcrumb {
    <li class="parent" data-menu="customer-menu">客户管理</li>
    <li class="active" data-menu="customer-customer-promotion-menu">@(ViewData[ViewDataKey.Title])</li>
}

<div class="gridToolBar clearfix">
    <button type="button" class="btn btn-primary btn-sm" onclick="loadCustomerPromotionList(0)">
        <i class="ace-icon fa fa-refresh"></i>
        刷新
    </button>

    <button class="btn btn-pink btn-sm" onclick="updateChildPayAmount()">
        <i class="ace-icon fa fa-gear"></i>
        更新下家支付总额
    </button>

    <button type="button" class="btn btn-purple btn-sm" onclick="exportData()">
        <i class="ace-icon fa fa-file-excel-o"></i>
        导出
    </button>
</div>

<div id="query" style="margin-top: 10px; margin-bottom: 10px; line-height: 40px;">
    <label for="parentCustomerCode">上家会员</label>&nbsp;<input id="parentCustomerCode" name="parentCustomerCode" style="width: 100px; height: 30px;" placeholder="上家会员ID查询"/>&nbsp;
    <label for="childCustomerCode">下家会员Id</label>&nbsp;<input id="childCustomerCode" name="childCustomerCode" style="width: 100px; height: 30px;" placeholder="下家会员ID查询"/>&nbsp;
    <label for="childCustomerCode">下家OpenId</label>&nbsp;<input id="childOpenId" name="childOpenId" style="width: 150px; height: 30px;" placeholder="下家OpenId查询"/>&nbsp;
    <label for="beginDateQuery">开始日期</label>&nbsp;<input id="beginDateQuery" name="beginDateQuery" style="width: 90px; height: 30px;" placeholder="开始日期" autocomplete="off"/>&nbsp;
    <label for="endDateQuery">截止日期</label>&nbsp;<input id="endDateQuery" name="endDateQuery" style="width: 90px; height: 30px;" placeholder="截止日期" autocomplete="off"/>&nbsp;

    <button type="button" class="btn btn-mini btn-primary" style="margin-bottom: 3px; height: 30px;" onclick="loadCustomerPromotionList(0)">
        &nbsp;<i class="ace-icon fa fa-search"></i>查&nbsp;询&nbsp;
    </button>
</div>

<div id="customerPromotionList" data-page-index="0" data-sort-field="@(nameof(CustomerPromotionInfo.Id))" data-sort-dir="@(SortDirection.Desc)">
</div>

<div id="customerPromotionDetailDialogWrapper"></div>
<script type="text/javascript">

    $(function() {
        $('#beginDateQuery').datetimepicker({
            locale: "zh-cn",
            format: 'L'
        });

        $('#endDateQuery').datetimepicker({
            locale: "zh-cn",
            format: 'L',
            useCurrent: false
        });

        $("#beginDateQuery").on("dp.change", function (e) {
            $('#endDateQuery').data("DateTimePicker").minDate(e.date);
        });

        $("#endDateQuery").on("dp.change", function (e) {
            $('#beginDateQuery').data("DateTimePicker").maxDate(e.date);
        });

        loadCustomerPromotionList();
    });

    function sortCustomerPromotionList(sortField, sortDir) {
        var list = $('#customerPromotionList');
        list.data('sort-field', sortField);
        list.data('sort-dir', sortDir);

        loadCustomerPromotionList();
    }


    function loadCustomerPromotionList(pageIndex) {
        var list = $('#customerPromotionList');

        if (pageIndex === null || pageIndex === undefined) {
            pageIndex = list.data("page-index");
        } else {
            list.data("page-index", pageIndex);
        }

        var sortField = list.data('sort-field');
        var sortDir = list.data('sort-dir');

        showMask("数据加载中，请稍候");

        $.ajax({
            url: "@Url.Action("List", "CustomerPromotion")",
            type: "POST",
            data: {
                '@(nameof(CustomerPromotionListQueryParam.ChildOpenId))': $("#childOpenId").val(),
                '@(nameof(CustomerPromotionListQueryParam.ParentCustomerCode))': $("#parentCustomerCode").val(),
                '@(nameof(CustomerPromotionListQueryParam.ChildCustomerCode))': $("#childCustomerCode").val(),
                '@(nameof(CustomerPromotionListQueryParam.BeginDateQuery))': $('#beginDateQuery').val(),
                '@(nameof(CustomerPromotionListQueryParam.EndDateQuery))': $('#endDateQuery').val(),                
                '@(nameof(CustomerPromotionListQueryParam.PageIndex))': pageIndex,
                '@(nameof(CustomerPromotionListQueryParam.SortField))': sortField,
                '@(nameof(CustomerPromotionListQueryParam.SortDir))': sortDir
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $('#customerPromotionList').html(data);

                initListTable("#tblCustomerPromotionList");
            }
        });
    }

    function exportData() {
        downLoadFile({
            url: "@Url.Action("Export", "CustomerPromotion")",
            data: {
                '@(nameof(CustomerPromotionListQueryParam.ChildOpenId))': $("#childOpenId").val(),
                '@(nameof(CustomerPromotionListQueryParam.ParentCustomerCode))': $("#parentCustomerCode").val(),
                '@(nameof(CustomerPromotionListQueryParam.ChildCustomerCode))': $("#childCustomerCode").val(),
                '@(nameof(CustomerPromotionListQueryParam.BeginDateQuery))': $('#beginDateQuery').val(),
                '@(nameof(CustomerPromotionListQueryParam.EndDateQuery))': $('#endDateQuery').val()
            }
        });
    }
    
    function  updateChildPayAmount() {
        showMask("处理中，请稍候");

        $.ajax({
            url: "@Url.Action("UpdateChildPayAmount", "CustomerPromotion")",
            type: "POST",
            data: {
            },
            success: function(data) {
                hideMask();

                if (data.success === false) {
                    $.msg.error(data.message);
                    return;
                }

                $.msg.show(data.message);
                loadCustomerPromotionList();
            }
        });
    }

</script>
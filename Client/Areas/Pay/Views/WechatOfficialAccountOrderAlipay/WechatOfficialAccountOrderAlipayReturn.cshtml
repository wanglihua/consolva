@using shunda.Core.Web
@model shunda.Client.Areas.Pay.Models.WechatOfficialAccountOrderAlipay.WechatOfficialAccountOrderAlipayReturnModel
@{
    Layout = "_ClientSite";
    if (Model.Success) {
        ViewData[ViewDataKey.Title] = "支付成功";
    } else {
        ViewData[ViewDataKey.Title] = "支付失败";
    }
}

<div style="padding: 20px;">
    @if (Model.Success) {
        <span style="font-weight: bold;font-size: 28px; color: green;">@(Model.Message)</span>
    } else {
        <span style="font-weight: bold;font-size: 28px; color: red;">@(Model.Message)</span>
    }
</div>
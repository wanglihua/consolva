@using shunda.Core.Web
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="zh-cn">
    <head>
        <title>@(ViewData[ViewDataKey.Title])</title>

        <meta charset="utf-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge, chrome=1">
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
        <link rel="stylesheet" type="text/css" href="/static/client/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true"/>
        <link rel="stylesheet" type="text/css" href="/static/client/css/client.css" asp-append-version="true"/>

        @(await RenderSectionAsync("Style", false))

        <script type="text/javascript" src="/static/client/lib/jquery/jquery.min.js" asp-append-version="true"></script>
        <script type="text/javascript" src="/static/client/lib/bootstrap/js/bootstrap.min.js" asp-append-version="true"></script>
        <script type="text/javascript" src="/static/client/js/client.js" asp-append-version="true"></script>
    </head>
    <body>
        <div>
            @RenderBody()
        </div>
    </body>
</html>
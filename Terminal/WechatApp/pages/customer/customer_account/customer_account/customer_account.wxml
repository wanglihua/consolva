<!--pages/customer/customer_account/customer_account/customer_account.wxml-->
<view class="container">
    <van-cell-group title="余额">
        <van-cell title="当前余额" value="{{ currentAmount }}">
            <van-icon slot="icon" class-prefix="iconfont" name="account" class="cell-left-icon"/>
        </van-cell>
        <van-cell title="余额明细" is-link link-type="navigateTo" url="../customer_account_entry/customer_account_entry">
            <van-icon slot="icon" class-prefix="iconfont" name="account-entry" class="cell-left-icon"/>
        </van-cell>                
    </van-cell-group>
    <view style="margin-top: 80rpx;"></view>
    <van-cell-group title="余额充值">
        <van-field label="充值金额" placeholder="请输入充值金额" model:value="{{ chargeAmount }}" error="{{ amountInputHasError }}" error-message="{{ amountInputErrorMsg }}" type="number" border="{{ false }}">
            <!-- <van-icon slot="left-icon" class-prefix="iconfont" name="charge" class="cell-left-icon" /> -->
            <view slot="right-icon">RMB</view>
        </van-field>           
    </van-cell-group>    

    <van-cell-group custom-class="detail-buttons" border="{{false}}">
        <van-cell border="{{false}}">
            <van-button type="info" class-prefix="iconfont" icon="charge" block bind:click="onChargeClick">充值</van-button>
        </van-cell>    
        <van-cell border="{{false}}">
            <van-button type="default" class-prefix="iconfont" icon="back" plain block bind:click="onBackClick" style="margin-top: 10rpx;">返回</van-button>
        </van-cell>
    </van-cell-group>    
</view>
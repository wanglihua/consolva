<!--pages/customer/customer_account/customer_account_entry/customer_account_entry.wxml-->
<header/>
<view class="container">
    <van-cell-group title="余额明细"/>

    <block wx:if="{{ entryCount === 0 }}">
        <van-empty description="暂时没有数据项！"/>
    </block>
    <block wx:else>
        <block wx:for="{{ entryList }}" wx:key="id" wx:for-item="entry" wx:for-index="index">
            <van-cell-group custom-class="items">
                <van-cell title="{{ index + 1 }}、{{ entry.amount }}" value="{{ entry.createTime }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title-short" value-class="item-header-value-long"/>
                <van-cell title="{{ entry.changeTypeName }}{{ entry.amount }}元，变动前余额 {{ entry.amountBefore }}元，变动后余额 {{ entry.amountAfter}}元，{{ entry.description }}" border="{{ false }}" custom-class="item"/>
                <view class="item-last-vspace"/>
            </van-cell-group>
        </block>
        <view class="bottom-divider">
            <van-divider contentPosition="center">共 {{ entryCount }} 项</van-divider>
        </view>
    </block>
</view>
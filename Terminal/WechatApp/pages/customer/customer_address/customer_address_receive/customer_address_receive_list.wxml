<header/>
<view class="container">
    <!-- 
    <van-tabs active="receive" duration="{{ 0 }}" lazy-render="{{ false }}" bind:click="onTabClick">
        <van-tab name="receive" title="收货地址"/>
        <van-tab name="send" title="发货地址"/>
    </van-tabs>
     -->

    <view style="padding: 10rpx 10rpx;">
        <van-button type="info" class-prefix="iconfont" icon="add" plain block bind:click="onAddCustomerReceiveAddress">添加收货地址</van-button>
    </view>

    <block wx:if="{{ receiveAddressCount === 0 }}">
        <van-empty description="您还没有添加任何收货地址！"/>
    </block>
    <block wx:else>
        <block wx:for="{{ receiveAddressList }}" wx:key="id" wx:for-item="address" wx:for-index="index">
            <van-cell-group custom-class="items" bind:tap="onActionCellClick" data-item="{{ address }}">
                <van-cell title="{{ index + 1 }}、{{ address.firstName }} {{ address.lastName }}" value="{{ address.defaultStr }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value"/>
                <van-cell title="国家: {{ address.country }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="收货人: {{ address.firstName }} {{ address.lastName }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="手机号码: {{ address.mobile }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="地址: {{ address.fullAddress }}" border="{{ false }}" custom-class="item"/>
                <view class="item-last-vspace"/>
                <van-cell title="操作" value="{{address.actions}}" border="{{ false }}" is-link bind:click="onActionCellClick" data-item="{{ address }}" custom-class="item-footer" value-class="item-footer-value"/>
            </van-cell-group>
        </block>
    </block>

    <van-action-sheet title="{{ currentAddress.firstName }} {{ currentAddress.lastName }}" show="{{ showActionSheet }}" actions="{{ actionSheetActions }}" bind:close="onActionSheetCloseClick" bind:click-overlay="onActionSheetCloseClick" bind:select="onActionSheetSelect"/>    
</view>
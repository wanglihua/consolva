<!--pages/customer/customer_address/customer_address_receive/customer_address_receive_detail.wxml-->
<header/>
<view class="container">
    <van-cell-group title="添加收货地址">
        <van-field model:value="{{ countryId }}" label="国家" placeholder="请输入国家" border="{{ false }}"/>
        <van-field model:value="{{ firstName }}" label="first name" placeholder="请输入名(first name)" border="{{ false }}"/>
        <van-field model:value="{{ lastName }}" label="first name" placeholder="请输入姓(last name)" border="{{ false }}"/>
        <van-field model:value="{{ address }}" label="门牌号/路名" type="textarea" autosize="{{ {minHeight:60, maxHeight:120 } }}" placeholder="请输入备注" border="{{ false }}"/>
    </van-cell-group>
    <van-cell-group custom-class="detail-buttons" border="{{false}}">
        <van-cell border="{{false}}">
            <van-button type="info" class-prefix="iconfont" icon="save" block bind:click="onSaveClick">保存</van-button>
        </van-cell>
        <van-cell border="{{false}}">
            <van-button type="default" class-prefix="iconfont" icon="back" plain block bind:click="onCancelClick" style="margin-top: 10rpx;">取消</van-button>
        </van-cell>
    </van-cell-group>
</view>

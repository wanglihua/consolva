<!--pages/customer/customer_address/customer_address_receive/customer_address_receive_detail.wxml-->
<header/>
<view class="container">
    <van-cell-group title="添加收货地址">
        <van-field model:value="{{ countryFieldValue }}" label="国家" placeholder="请选择收货国家" border="{{ false }}" custom-style="padding-bottom: 0;" is-link readonly bind:tap="onCountryFieldTap" />
        <van-popup show="{{ showCountrySelect }}" round position="bottom">
            <van-cascader
                    value="{{ countryCascaderValue }}"
                    title="选择收货国家"
                    options="{{ countryOptions }}"
                    bind:close="onCountrySelectClose"
                    bind:finish="onCountrySelectFinish"
            />
        </van-popup>
        <van-field model:value="{{ firstName }}" label="first name" placeholder="请输入名(first name)" border="{{ false }}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ lastName }}" label="last name" placeholder="请输入姓(last name)" border="{{ false }}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ mobile }}" label="手机号码" placeholder="请输入手机号码" border="{{ false }}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ unitLoc }}" label="Unit号" placeholder="公寓或办公楼地址务必填写Unit号" border="{{ false }}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ address }}" label="门牌号/路名" type="textarea" autosize="{{ {minHeight:30, maxHeight:120} }}" placeholder="请输入门牌号/路名" border="{{ false }}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ city }}" label="city/suburb" placeholder="请输入city/suburb" border="{{ false }}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ state }}" label="州" placeholder="请输入州" border="{{ false }}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ zipcode }}" label="邮编" placeholder="请输入邮编" border="{{ false }}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ tfn }}" label="ABN/ACN" placeholder="ABN/ACN(可不填)" border="{{ false }}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ company }}" label="公司/店铺名" placeholder="公司/店铺名(建议填写)" border="{{ false }}"/>
    </van-cell-group>
    <van-cell-group custom-class="detail-buttons" border="{{false}}">
        <van-cell border="{{false}}">
            <van-button type="info" class-prefix="iconfont" icon="save" block bind:click="onSaveClick">保存</van-button>
        </van-cell>
        <van-cell border="{{false}}">
            <van-button type="default" class-prefix="iconfont" icon="back" plain block bind:click="onCancelClick" style="margin-top: 10rpx;">取消</van-button>
        </van-cell>
    </van-cell-group>
</view>

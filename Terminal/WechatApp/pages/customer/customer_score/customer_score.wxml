<header/>
<view class="container">
    <van-cell-group title="积分">
        <van-cell title="历史总积分" value="{{ totalScore }}">
            <van-icon slot="icon" class-prefix="iconfont" name="score" class="cell-left-icon"/>
        </van-cell>
        <van-cell title="剩余积分" value="{{ validScore }}">
            <van-icon slot="icon" class-prefix="iconfont" name="score" class="cell-left-icon"/>
        </van-cell>
        <van-cell title="VIP等级" value="{{ vipRank }}">
            <van-icon slot="icon" class-prefix="iconfont" name="vip" class="cell-left-icon"/>
        </van-cell>
        <van-cell title="积分明细" is-link link-type="navigateTo" url="./customer_score_log">
            <van-icon slot="icon" class-prefix="iconfont" name="score-log" class="cell-left-icon"/>
        </van-cell>
    </van-cell-group>
    <view style="margin-top: 80rpx;"></view>
    <van-cell-group title="积分换余额">
        <van-field label="兑换积分" placeholder="请输入要兑换的积分" model:value="{{ exchangeScore }}" error="{{ exchangeScoreInputHasError }}" error-message="{{ exchangeScoreInputErrorMsg }}" type="number" border="{{ false }}">
        </van-field>
    </van-cell-group>

    <van-cell-group custom-class="detail-buttons" border="{{false}}">
        <van-cell border="{{false}}">
            <van-button type="info" class-prefix="iconfont" icon="charge" block bind:click="onExchangeClick">兑换余额</van-button>
        </van-cell>
        <van-cell border="{{false}}">
            <van-button type="default" class-prefix="iconfont" icon="back" plain block bind:click="onBackClick" style="margin-top: 10rpx;">返回</van-button>
        </van-cell>
    </van-cell-group>
</view>
<header/>
<view class="container">
    <block wx:if="{{ hasBatchToPick === true }}">
        <view style="padding: 10rpx 0;">
            <van-button type="info" class-prefix="iconfont" icon="coupon" plain block bind:click="onCouponPickClick">
                领取优惠券
                <van-icon class-prefix="iconfont" name="double-right"/>
            </van-button>
        </view>
    </block>

    <van-cell-group title="我的优惠券"/>

    <block wx:if="{{ couponCount === 0 }}">
        <van-empty description="您当前没有可用的优惠券！"/>
    </block>
    <block wx:else>
        <block wx:for="{{ couponList }}" wx:key="id" wx:for-item="coupon" wx:for-index="index">
            <van-cell-group custom-class="items">
                <van-cell title="{{ index + 1 }}、{{ coupon.rule }}" value="{{ coupon.type }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value" bind:click="onCouponHeaderClick" data-item="{{ coupon }}"/>
                <block wx:if="{{ coupon.show === true }}">
                    <van-cell title="编号" value="{{ coupon.code }}" border="{{ false }}" custom-class="item"/>
                    <van-cell title="有效期" value="{{ coupon.expire }}" border="{{ false }}" custom-class="item"/>
                    <van-cell title="优惠" value="{{ coupon.ruleDesc }}" border="{{ false }}" custom-class="item"/>
                    <view class="item-last-vspace"/>
                </block>
            </van-cell-group>
        </block>
    </block>
</view>
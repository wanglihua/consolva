<!--pages/express/express_claim/express_claim_detail/express_claim_detail.wxml-->
<view class="container">
    <van-cell-group title="申领件详细">
    </van-cell-group>

    <van-cell-group custom-class="item">
        <van-cell title="快递单详情" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value"/>
        <van-cell title="入库单号" value="{{ express.checkinTrackingNo }}" border="{{ false }}"/>
        <van-cell title="快递单号" value="{{ express.trackingNo }}" border="{{ false }}"/>
        <van-cell title="快递公司" value="{{ express.expressCompany }}" border="{{ false }}"/>
        <van-cell title="登记日期" value="{{ express.addDate }}" border="{{ false }}"/>
        <van-cell title="面单会员" value="{{ express.billCustomerCode }}" border="{{ false }}"/>
        <block wx:if="{{ express.warehouseRemark !== '' }}">
            <van-cell title="仓库备注" value="{{express.warehouseRemark}}" border="{{ false }}"/>
        </block>
    </van-cell-group>


</view>

<!--pages/express/express_claim/express_claim_pick/express_claim_pick.wxml-->
<header/>
<view class="container">
    <van-cell-group title="申领件认领"/>

    <van-cell-group custom-class="items">
        <van-cell title="快递单详情" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value"/>
        <van-cell title="入库单号" value="{{ express.checkinTrackingNo }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="快递单号" value="{{ express.trackingNo }}" border="{{ false }}" custom-class="item"/>
        <van-field value="{{ express.trackingNoInput }}" label="单号补全" placeholder="请输入完整单号或隐藏部分" border="{{ false }}" custom-class="item" input-align="right" error-message-align="right" error="{{ express.trackingNoInputHasError }}" error-message="{{ express.trackingNoInputErrorMsg }}" bind:input="onTackingNoInput" custom-style="padding-bottom: 0;"/>
        <van-field value="{{ express.goodsValueInput }}" label="货品总值" placeholder="请输入快递单物品总货值" border="{{ false }}" custom-class="item" input-align="right" error-message-align="right" error="{{ express.goodsValueInputHasError }}" error-message="{{ express.goodsValueInputErrorMsg }}" bind:input="onGoodsValueInput" custom-style="padding-bottom: 0;">
            <view slot="right-icon">RMB</view>
        </van-field>
        <block wx:if="{{ express.expectDescription !== '' }}">
            <van-cell title="预报备注" value="{{express.expectDescription}}" border="{{ false }}" custom-class="item"/>
        </block>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <van-cell-group custom-class="items">
        <van-cell title="物品列表" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value"/>
        <block wx:for="{{ express.expressGoodsList }}" wx:key="id" wx:for-item="expressGoods" wx:for-index="index">
            <van-cell title="{{ index + 1 }}、{{ expressGoods.goodsName }}" value="{{ expressGoods.quantity }} {{ expressGoods.unit }}" title-class="item-title-long" value-class="item-value-short" border="{{ false }}" custom-class="item"/>
        </block>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <van-cell-group custom-class="detail-buttons" border="{{false}}">
        <van-cell border="{{false}}">
            <van-button type="info" class-prefix="iconfont" icon="claim-pick" block bind:click="onClaimClick" disabled="{{ btnClaimDisabled }}">{{ btnClaimText }}</van-button>
        </van-cell>
        <van-cell border="{{false}}">
            <van-button type="default" class-prefix="iconfont" icon="back" plain block bind:click="onBackClick" style="margin-top: 10rpx;">返回</van-button>
        </van-cell>
    </van-cell-group>
</view>

<header/>
<view class="container">
    <van-cell-group title="添加快递单号预报">
        <van-field model:value="{{ trackingNo }}" label="快递单号" placeholder="请输入预报快递单号" border="{{ false }}" error="{{ trackingNoHasError }}" error-message="{{trackingNoErrorMsg}}" custom-style="padding-bottom: 0;"/>
        <van-field model:value="{{ goodsValue }}" label="货品总值" placeholder="请输入快递单物品总货值" border="{{ false }}" error="{{ goodsValueHasError }}" error-message="{{ goodsValueErrorMsg }}" custom-style="padding-bottom: 0;">
            <view slot="right-icon">RMB</view>
        </van-field>
        <van-field model:value="{{ description }}" label="备注" type="textarea" autosize="{{ {minHeight:70, maxHeight:140 } }}" placeholder="如您有特殊物品，需要我们在入库时核对颜色、尺寸、质量等物品细节，请在该处注明! 我们会免费为您提供核对服务" border="{{ false }}"/>
    </van-cell-group>
    <van-cell-group custom-class="detail-buttons" border="{{false}}">
        <van-cell border="{{false}}">
            <van-button type="info" class-prefix="iconfont" icon="save" block bind:click="onSaveClick">保存</van-button>
        </van-cell>
        <van-cell border="{{false}}">
            <van-button type="default" class-prefix="iconfont" icon="back" plain block bind:click="onCancelClick" style="margin-top: 10rpx;">取消</van-button>
        </van-cell>
    </van-cell-group>
</view>
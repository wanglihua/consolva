<!--pages/express/express_checkin/express_checkin_detail.wxml-->
<header />
<view class="container">
    <van-cell-group title="已入库快递单详细" />

    <van-cell-group custom-class="items">
        <van-cell title="快递单详情" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value" />
        <van-cell title="入库单号" value="{{ express.checkinTrackingNo }}" border="{{ false }}" custom-class="item" />
        <van-cell title="快递单号" value="{{ express.trackingNo }}" border="{{ false }}" custom-class="item" />
        <!--<van-cell title="快递公司" value="{{ express.expressCompany }}" border="{{ false }}" custom-class="item" />-->
        <van-cell title="物品类型" value="{{ express.goodsType }}" border="{{ false }}" custom-class="item" />
        <van-cell title="登记日期" value="{{ express.addDate }}" border="{{ false }}" custom-class="item" />
        <block wx:if="{{ express.customerRemark && express.customerRemark !== '' }}">
            <van-cell title="客户备注" value="{{express.customerRemark}}" border="{{ false }}" custom-class="item" />
        </block>
        <block wx:if="{{ express.warehouseRemark && express.warehouseRemark !== '' }}">
            <van-cell title="仓库备注" value="{{express.warehouseRemark}}" border="{{ false }}" custom-class="item" />
        </block>
        <block wx:if="{{ express.serviceRemark && express.serviceRemark !== '' }}">
            <van-cell title="客服备注" value="{{express.serviceRemark}}" border="{{ false }}" custom-class="item" />
        </block>
        <view class="item-last-vspace" />
    </van-cell-group>

    <van-cell-group custom-class="items">
        <van-cell title="物品列表" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value" />
        <block wx:for="{{ express.goodsList }}" wx:key="id" wx:for-item="expressGoods" wx:for-index="index">
            <van-cell title="{{ index + 1 }}、{{ expressGoods.goodsName }}" value="{{ expressGoods.quantity }} {{ expressGoods.unit }}" border="{{ false }}" custom-class="item" />
        </block>
        <view class="item-last-vspace" />
    </van-cell-group>

    <van-cell-group custom-class="items">
        <van-cell title="尺寸/体积重/实际重" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value" />
        <block wx:if="{{ express.sizeWeightList && express.sizeWeightList.length !== 0 }}">
            <block wx:for="{{ express.sizeWeightList }}" wx:key="id" wx:for-item="sizeWeight" wx:for-index="index">
                <van-cell title="{{ index + 1 }}、单箱尺寸：{{ sizeWeight.length }}✕{{ sizeWeight.width }}✕{{ sizeWeight.height }}cm，单箱体积重：{{ sizeWeight.volumeWeight }}，单箱实际重：{{ sizeWeight.actualWeight }}，箱数：{{ sizeWeight.packageCount }}" border="{{ false }}" custom-class="item" />
            </block>
            <view class="item-last-vspace" />
            <block wx:if="{{ express.sizeWeightList.length > 1 }}">
                <van-cell title="总体积：{{ express.totalVolume }}立方，总体积重：{{ express.totalVolumeWeight }}kg，总实际重：{{ express.totalActualWeight }}kg，总箱数：{{ express.totalPackageCount }}" custom-class="item-footer" value-class="item-footer-value"></van-cell>
            </block>
        </block>
        <block wx:else>
            <van-cell title="暂时没有尺寸重量数据！" border="{{ false }}" />
        </block>
    </van-cell-group>

    <van-cell-group custom-class="items">
        <van-cell title="快递单图片" value="共{{ express.totalPhotoCount }}张" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value" />
        <block wx:if="{{ express.photoTypeList && express.photoTypeList.length !== 0 }}">
            <van-tabs>
                <block wx:for="{{ express.photoTypeList }}" wx:key="id" wx:for-item="photoType" wx:for-index="index">
                    <van-tab title="{{ photoType.name }}({{ photoType.photoCount }}张)" type="card">
                        <view style="margin: 18rpx 0;">
                            <block wx:for="{{ photoType.photoList }}" wx:key="id" wx:for-item="photo" wx:for-index="index">
                                <van-image height="160rpx" fit="heightFix" lazy-load src="{{ photo.smallUrl }}" bind:click="onSmallPhotoClick" data-item="{{ photo }}" use-loading-slot custom-class="express-detail-small-image">
                                    <van-loading slot="loading" type="spinner" size="20" vertical />
                                </van-image>
                            </block>
                        </view>
                    </van-tab>
                </block>
            </van-tabs>
            <van-popup show="{{ showBigPhoto }}" closeable position="bottom" custom-style="height: 95%; padding: 80rpx 10rpx 10rpx 10rpx;" bind:close="onBigPhotoClose">
                <van-image width="100%" height="100%" fit="contain" lazy-load src="{{ bigPhoto.bigUrl }}" use-loading-slot>
                    <van-loading slot="loading" type="spinner" size="20" vertical />
                </van-image>
            </van-popup>
        </block>
        <block wx:else>
            <van-cell title="暂时没有图片！" border="{{ false }}" />
        </block>
    </van-cell-group>

    <van-cell-group custom-class="detail-buttons" border="{{false}}">
        <van-cell border="{{false}}">
            <van-button type="default" class-prefix="iconfont" icon="back" plain block bind:click="onBackClick" style="margin-top: 10rpx;">返回</van-button>
        </van-cell>
    </van-cell-group>
</view>
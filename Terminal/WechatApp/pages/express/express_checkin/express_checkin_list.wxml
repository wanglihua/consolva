<!--pages/express/express_checkin/express_checkin_list/express_checkin_list.wxml-->
<header />
<van-sticky offset-top="{{ 46 }}">
    <view class="container-top" style="background-color: white;">
        <van-search model:value="{{ query }}" placeholder="快递单号，入库单号 模糊搜索" custom-class="search-bar" bind:search="onSearch" bind:change="onSearch" bind:clear="onSearchClear" />
        <van-divider hairline customStyle="margin: 0;" />
    </view>
</van-sticky>

<view class="container-bottom">
    <!--<van-cell-group title="已入库"/>-->
    <block wx:if="{{ expressTotalCount === 0 }}">
        <van-empty description="暂时没有数据项！" />
    </block>
    <block wx:else>
        <block wx:if="{{ expressGoodsValueCount > 0 }}">
            <block wx:for="{{ expressGoodsValueList }}" wx:key="id" wx:for-item="express" wx:for-index="index">
                <van-cell-group custom-class="items" bind:tap="onActionCellClick" data-item="{{ express }}">
                    <van-cell title="{{ index + 1 }}、{{ express.trackingNo }}(缺货值)" value="{{ express.goodsType }}" border="{{ false }}" custom-class="item-header-goods-value" title-class="item-header-title" value-class="{{ express.headerValueClass }}"/>
                    <van-cell title="快递单号" value="{{ express.trackingNo }}" border="{{ false }}" custom-class="item"/>
                    <!--<van-cell title="快递公司" value="{{ express.expressCompany }}" border="{{ false }}" custom-class="item"/>-->
                    <van-cell title="入库单号" value="{{ express.checkinTrackingNo }}" border="{{ false }}" custom-class="item"/>
                    <van-cell title="物品类型" value="{{ express.goodsType }}" value-class="item-goods-type{{ express.goodsTypeId }}" border="{{ false }}" custom-class="item"/>
                    <van-cell title="货品总值" value="{{ express.goodsValue }} RMB" border="{{ false }}" custom-class="item"/>
                    <van-cell title="登记日期" value="{{ express.addDate }}" border="{{ false }}" custom-class="item"/>
                    <block wx:if="{{ express.customerRemark && express.customerRemark !== '' }}">
                        <van-cell title="客户备注" value="{{express.customerRemark}}" border="{{ false }}" custom-class="item"/>
                    </block>
                    <block wx:if="{{ express.warehouseRemark && express.warehouseRemark !== '' }}">
                        <van-cell title="仓库备注" value="{{express.warehouseRemark}}" border="{{ false }}" custom-class="item"/>
                    </block>
                    <block wx:if="{{ express.serviceRemark && express.serviceRemark !== '' }}">
                        <van-cell title="客服备注" value="{{express.serviceRemark}}" border="{{ false }}" custom-class="item"/>
                    </block>
                    <van-cell title="物品" value="共 {{ express.goodsCount }} 项" border="{{ false }}" custom-class="item"/>
                    <block wx:for="{{ express.goodsList }}" wx:key="id" wx:for-item="goods" wx:for-index="goodsIndex">
                        <van-cell value="{{ goods.goodsName }} {{ goods.quantity }} {{ goods.unit }}" border="{{ false }}" custom-class="item"/>
                    </block>
                    <view class="item-last-vspace"/>
                    <van-cell title="操作" value="{{express.actions}}" border="{{ false }}" is-link bind:click="onActionCellClick" data-item="{{ express }}" custom-class="item-footer" value-class="item-footer-value"/>
                </van-cell-group>
            </block>
        </block>
        
        <block wx:if="{{ expressWaitOrderCount > 0 }}">
            <block wx:for="{{ expressWaitOrderList }}" wx:key="id" wx:for-item="express" wx:for-index="index">
                <van-cell-group custom-class="items" bind:tap="onActionCellClick" data-item="{{ express }}">
                    <van-cell title="{{ index + 1 }}、{{ express.trackingNo }}(已选择)" value="{{ express.goodsType }}" border="{{ false }}" custom-class="item-header-alt" title-class="item-header-title" value-class="{{ express.headerValueClass }}" />
                    <van-cell title="快递单号" value="{{ express.trackingNo }}" border="{{ false }}" custom-class="item" />
                    <!--<van-cell title="快递公司" value="{{ express.expressCompany }}" border="{{ false }}" custom-class="item"/>-->
                    <van-cell title="入库单号" value="{{ express.checkinTrackingNo }}" border="{{ false }}" custom-class="item" />
                    <van-cell title="物品类型" value="{{ express.goodsType }}" value-class="item-goods-type{{ express.goodsTypeId }}" border="{{ false }}" custom-class="item" />
                    <van-cell title="货品总值" value="{{ express.goodsValue }} RMB" border="{{ false }}" custom-class="item" />
                    <van-cell title="登记日期" value="{{ express.addDate }}" border="{{ false }}" custom-class="item" />
                    <block wx:if="{{ express.customerRemark && express.customerRemark !== '' }}">
                        <van-cell title="客户备注" value="{{express.customerRemark}}" border="{{ false }}" custom-class="item" />
                    </block>
                    <block wx:if="{{ express.warehouseRemark && express.warehouseRemark !== '' }}">
                        <van-cell title="仓库备注" value="{{express.warehouseRemark}}" border="{{ false }}" custom-class="item" />
                    </block>
                    <block wx:if="{{ express.serviceRemark && express.serviceRemark !== '' }}">
                        <van-cell title="客服备注" value="{{express.serviceRemark}}" border="{{ false }}" custom-class="item" />
                    </block>
                    <van-cell title="物品" value="共 {{ express.goodsCount }} 项" border="{{ false }}" custom-class="item" />
                    <block wx:for="{{ express.goodsList }}" wx:key="id" wx:for-item="goods" wx:for-index="goodsIndex">
                        <van-cell value="{{ goods.goodsName }} {{ goods.quantity }} {{ goods.unit }}" border="{{ false }}" custom-class="item" />
                    </block>
                    <view class="item-last-vspace" />
                    <van-cell title="操作" value="{{express.actions}}" border="{{ false }}" is-link bind:click="onActionCellClick" data-item="{{ express }}" custom-class="item-footer" value-class="item-footer-value" />
                </van-cell-group>
            </block>

            <view style="width: 100%; padding-bottom: 30rpx; border-top: 1px solid #ebedf0; background-color: white; position: fixed; left: 0; bottom: 0; z-index: 88;">
                <view style="padding: 10rpx 40rpx;">
                    <view style="padding: 4rpx; text-align: right;">
                        <text style="color: #646566; font-size: 12px;">已选择{{ expressWaitOrderCount }}个快递单</text>
                    </view>
                    <van-button type="info" class-prefix="iconfont" icon="create-order" block bind:click="onCreateOrderClick">
                        创建转运单
                        <van-icon class-prefix="iconfont" name="double-right" />
                    </van-button>
                </view>
            </view>
        </block>
        <block wx:if="{{ expressCheckinCount > 0 }}">
            <block wx:for="{{ expressCheckinList }}" wx:key="id" wx:for-item="express" wx:for-index="index">
                <van-cell-group custom-class="items" bind:tap="onActionCellClick" data-item="{{ express }}">
                    <van-cell title="{{ index + 1 }}、{{ express.trackingNo }}" value="{{ express.goodsType }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="{{ express.headerValueClass }}" />
                    <van-cell title="快递单号" value="{{ express.trackingNo }}" border="{{ false }}" custom-class="item" />
                    <!--<van-cell title="快递公司" value="{{ express.expressCompany }}" border="{{ false }}" custom-class="item"/>-->
                    <van-cell title="入库单号" value="{{ express.checkinTrackingNo }}" border="{{ false }}" custom-class="item" />
                    <van-cell title="物品类型" value="{{ express.goodsType }}" value-class="item-goods-type{{ express.goodsTypeId }}" border="{{ false }}" custom-class="item" />
                    <van-cell title="货品总值" value="{{ express.goodsValue }} RMB" border="{{ false }}" custom-class="item" />
                    <van-cell title="登记日期" value="{{ express.addDate }}" border="{{ false }}" custom-class="item" />
                    <block wx:if="{{ express.customerRemark && express.customerRemark !== '' }}">
                        <van-cell title="客户备注" value="{{express.customerRemark}}" border="{{ false }}" custom-class="item" />
                    </block>
                    <block wx:if="{{ express.warehouseRemark && express.warehouseRemark !== '' }}">
                        <van-cell title="仓库备注" value="{{express.warehouseRemark}}" border="{{ false }}" custom-class="item" />
                    </block>
                    <block wx:if="{{ express.serviceRemark && express.serviceRemark !== '' }}">
                        <van-cell title="客服备注" value="{{express.serviceRemark}}" border="{{ false }}" custom-class="item" />
                    </block>
                    <van-cell title="物品" value="共 {{ express.goodsCount }} 项" border="{{ false }}" custom-class="item" />
                    <block wx:for="{{ express.goodsList }}" wx:key="id" wx:for-item="goods" wx:for-index="goodsIndex">
                        <van-cell value="{{ goods.goodsName }} {{ goods.quantity }} {{ goods.unit }}" border="{{ false }}" custom-class="item" />
                    </block>
                    <view class="item-last-vspace" />
                    <van-cell title="操作" value="{{express.actions}}" border="{{ false }}" is-link bind:click="onActionCellClick" data-item="{{ express }}" custom-class="item-footer" value-class="item-footer-value" />
                </van-cell-group>
            </block>
        </block>

        <view class="bottom-divider">
            <van-divider contentPosition="center">共 {{ expressTotalCount }} 项</van-divider>
        </view>

        <view style="height: 200rpx; width: 100%;" />
    </block>

    <van-action-sheet title="快递单号 {{ currentExpress.trackingNo }}" show="{{ showActionSheet }}" actions="{{ actionSheetActions }}" bind:close="onActionSheetCloseClick" bind:click-overlay="onActionSheetCloseClick" bind:select="onActionSheetSelect" />
</view>
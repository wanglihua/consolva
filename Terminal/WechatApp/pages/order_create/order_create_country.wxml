<!--pages/order_create/order_create_country.wxml-->
<header/>
<view class="container">
    <van-cell-group title="目的国家"/>

    <block wx:for="{{ countryList }}" wx:key="id" wx:for-item="country" wx:for-index="index">
        <block wx:if="{{ country.id === selectCountryId }}">
            <van-cell-group custom-class="items">
                <van-cell title="{{ index + 1 }}、{{ country.name }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title-selected">
                    <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button-selected" bind:click="onCountryButtonClick" data-item="{{ country }}">已选择</van-button>
                </van-cell>
            </van-cell-group>
        </block>
        <block wx:else>
            <van-cell-group custom-class="items">
                <van-cell title="{{ index + 1 }}、{{ country.name }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title">
                    <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button" bind:click="onCountryButtonClick" data-item="{{ country }}">选择</van-button>
                </van-cell>
            </van-cell-group>
        </block>
    </block>

    <view class="bottom-btn-panel">
        <view class="bottom-btn-panel-inner">
            <van-row gutter="20">
                <van-col span="24">
                    <van-button type="default" size="small" plain block bind:click="onNextButtonClick">
                        下一步
                        <van-icon class-prefix="iconfont" name="next-step"/>
                    </van-button>
                </van-col>
            </van-row>
        </view>
    </view>
</view>
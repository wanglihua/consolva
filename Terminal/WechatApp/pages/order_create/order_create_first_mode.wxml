<!--pages/order_create/order_create_first_mode.wxml-->
<header/>
<view class="container">
    <van-cell-group title="头程物流"/>

    <block wx:if="{{ !firstModeList || firstModeList.length === 0 }}">
        <van-empty description="暂时没有符合的头程物流！"/>
    </block>
    <block wx:else>
        <block wx:for="{{ firstModeList }}" wx:key="id" wx:for-item="firstMode" wx:for-index="index">
            <block wx:if="{{ firstMode.modeId === selectFirstModeId }}">
                <van-cell-group custom-class="items">
                    <van-cell title="{{ index + 1 }}、{{ firstMode.modeName }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title-selected">
                        <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button-selected" bind:click="onFirstModeButtonClick" data-item="{{ firstMode }}">已选择</van-button>
                    </van-cell>
                </van-cell-group>
            </block>
            <block wx:else>
                <van-cell-group custom-class="items">
                    <van-cell title="{{ index + 1 }}、{{ firstMode.modeName }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title">
                        <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button" bind:click="onFirstModeButtonClick" data-item="{{ firstMode }}">选择</van-button>
                    </van-cell>
                </van-cell-group>
            </block>
        </block>
    </block>

    <view class="bottom-btn-panel">
        <view class="bottom-btn-panel-inner">
            <van-row gutter="20">
                <van-col span="12">
                    <van-button type="default" size="small" plain block bind:click="onPreButtonClick">
                        <van-icon class-prefix="iconfont" name="pre-step"/>
                        上一步
                    </van-button>
                </van-col>
                <van-col span="12">
                    <van-button type="default" size="small" plain block bind:click="onNextButtonClick">
                        下一步
                        <van-icon class-prefix="iconfont" name="next-step"/>
                    </van-button>
                </van-col>
            </van-row>
        </view>
    </view>
</view>
<!--pages/order_create/order_create_first_mode.wxml-->
<header/>
<view class="container">
    <van-cell-group title="物流方式-订单创建"/>

    <block wx:if="{{ !firstModeList || firstModeList.length === 0 }}">
        <van-empty description="暂时没有符合的物流方式！"/>
    </block>
    <block wx:else>
        <block wx:for="{{ firstModeList }}" wx:key="id" wx:for-item="firstMode" wx:for-index="index">
            <van-cell-group custom-class="items">
                <block wx:if="{{ firstMode.id === selectFirstModeId }}">
                    <van-cell title="{{ index + 1 }}、{{ firstMode.name }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title-selected">
                        <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button-selected" bind:click="onFirstModeButtonClick" data-item="{{ firstMode }}">已选择</van-button>
                    </van-cell>
                </block>
                <block wx:else>
                    <van-cell title="{{ index + 1 }}、{{ firstMode.name }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title">
                        <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button" bind:click="onFirstModeButtonClick" data-item="{{ firstMode }}">选择</van-button>
                    </van-cell>
                </block>
                <van-cell title="国家" value="{{ firstMode.country }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="类型" value="{{ firstMode.type }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="名称" value="{{ firstMode.name }}" border="{{ false }}" custom-class="item"/>
                <block wx:if="{{ firstMode.description && firstMode.description !== '' }}">
                    <van-cell title="描述" value="{{ firstMode.description }}" border="{{ false }}" custom-class="item"/>
                </block>
                <view class="item-last-vspace"/>
            </van-cell-group>
        </block>
    </block>

    <view class="bottom-btn-panel">
        <view class="bottom-btn-panel-inner">
            <van-row gutter="20">
                <van-col span="12">
                    <van-button type="default" size="small" plain block bind:click="onPreButtonClick">
                        <van-icon class-prefix="iconfont" name="pre-step"/>
                        上一步
                    </van-button>
                </van-col>
                <van-col span="12">
                    <van-button type="default" size="small" plain block bind:click="onNextButtonClick">
                        下一步
                        <van-icon class-prefix="iconfont" name="next-step"/>
                    </van-button>
                </van-col>
            </van-row>
        </view>
    </view>
</view>
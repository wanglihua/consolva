<!--pages/order_create/order_create_summary.wxml-->
<header/>
<view class="container">
    <van-cell-group title="订单汇总"/>

    <van-cell-group custom-class="items">
        <van-cell title="快递单号" border="{{ false }}" custom-class="item-header" title-class="item-header-title"/>
    </van-cell-group>

    <block wx:for="{{ expressList }}" wx:key="id" wx:for-item="express" wx:for-index="index">
        <van-cell-group custom-class="items">
            <van-cell title="{{ index + 1 }}、{{ express.trackingNo }}" border="{{ false }}" custom-class="sub-item-header" title-class="sub-item-header-title"/>
            <van-cell title="快递单号" value="{{ express.trackingNo }}" border="{{ false }}" custom-class="item"/>
            <!--<van-cell title="快递公司" value="{{ express.expressCompany }}" border="{{ false }}" custom-class="item"/>-->
            <van-cell title="入库单号" value="{{ express.checkinTrackingNo }}" border="{{ false }}" custom-class="item"/>
            <van-cell title="物品类型" value="{{ express.goodsType }}" border="{{ false }}" custom-class="item"/>
            <van-cell title="登记日期" value="{{ express.addDate }}" border="{{ false }}" custom-class="item"/>
            <block wx:if="{{ express.customerRemark && express.customerRemark !== '' }}">
                <van-cell title="客户备注" value="{{express.customerRemark}}" border="{{ false }}" custom-class="item"/>
            </block>
            <block wx:if="{{ express.warehouseRemark && express.warehouseRemark !== '' }}">
                <van-cell title="仓库备注" value="{{express.warehouseRemark}}" border="{{ false }}" custom-class="item"/>
            </block>
            <block wx:if="{{ express.serviceRemark && express.serviceRemark !== '' }}">
                <van-cell title="客服备注" value="{{express.serviceRemark}}" border="{{ false }}" custom-class="item"/>
            </block>
            <van-cell title="物品" value="共 {{ express.goodsCount }} 项" border="{{ false }}" custom-class="item"/>
            <block wx:for="{{ express.goodsList }}" wx:key="id" wx:for-item="goods" wx:for-index="goodsIndex">
                <van-cell value="{{ goods.goodsName }} {{ goods.quantity }}{{ goods.unit }} × {{ goods.price }}RMB" border="{{ false }}" custom-class="item"/>
            </block>
            <view class="item-last-vspace"/>
        </van-cell-group>
    </block>

    <van-cell-group custom-class="items">
        <van-cell title="快递单汇总" border="{{ false }}" custom-class="sub-item-header" title-class="sub-item-header-title"/>
        <van-cell title="物品类型" value="{{ goodsType }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="包裹数量" value="{{ totalPackageCount }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="总申报货值" value="{{ totalGoodsValue }}" border="{{ false }}" custom-class="item"/>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <van-cell-group custom-class="items">
        <van-cell title="物流方式" border="{{ false }}" custom-class="item-header" title-class="item-header-title"/>
        <van-cell title="国家" value="{{ firstMode.country }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="类型" value="{{ firstMode.type }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="名称" value="{{ firstMode.name }}" border="{{ false }}" custom-class="item"/>
        <block wx:if="{{ firstMode.description && firstMode.description !== '' }}">
            <block wx:if="{{ firstMode.description.length <= 20 }}">
                <van-cell title="描述" value="{{ firstMode.description }}" border="{{ false }}" custom-class="item"/>
            </block>
            <block wx:else>
                <van-cell title="描述" label="{{ firstMode.description }}" border="{{ false }}" custom-class="item"/>
            </block>
        </block>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <van-cell-group custom-class="items">
        <van-cell title="收货地址" border="{{ false }}" custom-class="item-header" title-class="item-header-title"/>
        <van-cell title="国家" value="{{ receiveAddress.country }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="收货人" value="{{ receiveAddress.firstName }} {{ receiveAddress.lastName }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="手机号码" value="{{ receiveAddress.mobile }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="地址" value="{{ receiveAddress.fullAddress }}" border="{{ false }}" custom-class="item"/>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <!--
    <van-cell-group custom-class="items">
        <van-cell title="发货地址" border="{{ false }}" custom-class="item-header" title-class="item-header-title"/>
        <van-cell title="收货人" value="{{ sendAddress.name }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="手机号码" value="{{ sendAddress.mobile }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="地区" value="{{ sendAddress.province }}{{ sendAddress.city }}{{ sendAddress.area }}{{ sendAddress.street }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="地址" value="{{ sendAddress.address }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="邮编" value="{{ sendAddress.zipcode }}" border="{{ false }}" custom-class="item"/>
        <view class="item-last-vspace"/>
    </van-cell-group>
    -->

    <van-cell-group custom-class="items">
        <van-cell title="保险和GST" border="{{ false }}" custom-class="item-header" title-class="item-header-title"/>
        <van-cell title="保险方案" value="{{ insurance.name }}" border="{{ false }}" custom-class="item"/>
        <block wx:if="{{ gst.name.length <= 20 }}">
            <van-cell title="GST方案" value="{{ gst.name }}" border="{{ false }}" custom-class="item"/>
        </block>
        <block wx:else>
            <van-cell title="GST方案" label="{{ gst.name }}" border="{{ false }}" custom-class="item"/>
        </block>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <van-cell-group custom-class="items">
        <van-cell title="打包方式和备注" border="{{ false }}" custom-class="item-header" title-class="item-header-title"/>
        <van-cell title="打包方式" value="{{ repackType.title }}" label="{{ repackType.description }}" border="{{ false }}" custom-class="item"/>
        <block wx:if="{{ remark.length <= 20 }}">
            <van-cell title="备注" value="{{ remark }}" border="{{ false }}" custom-class="item"/>
        </block>
        <block wx:else>
            <van-cell title="备注" label="{{ remark }}" border="{{ false }}" custom-class="item"/>
        </block>
        <view class="item-last-vspace"/>
    </van-cell-group>    

    <view class="bottom-btn-panel">
        <view class="bottom-btn-panel-inner">
            <van-row gutter="20">
                <van-col span="12">
                    <van-button type="default" size="small" plain block bind:click="onPreButtonClick">
                        <van-icon class-prefix="iconfont" name="pre-step"/>
                        上一步
                    </van-button>
                </van-col>
                <van-col span="12">
                    <van-button type="info" size="small" block bind:click="onNextButtonClick">
                        <van-icon class-prefix="iconfont" name="create-order"/>
                        确认提交转运单
                    </van-button>
                </van-col>
            </van-row>
        </view>
    </view>
</view>
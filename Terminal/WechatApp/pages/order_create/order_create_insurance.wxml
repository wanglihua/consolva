<!--pages/order_create/order_create_insurance.wxml-->
<header/>
<view class="container">
    <van-cell-group title="保险方案-订单创建"/>

    <block wx:if="{{ !insuranceList || insuranceList.length === 0 }}">
        <van-empty description="您暂时还没有{{ country }}的收货地址！"/>
    </block>
    <block wx:else>
        <block wx:for="{{ insuranceList }}" wx:key="id" wx:for-item="insurance" wx:for-index="index">
            <van-cell-group custom-class="items">
                <block wx:if="{{ insurance.id === selectInsuranceId }}">
                    <van-cell title="{{ index + 1 }}、{{ insurance.name }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title-selected">
                        <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button-selected" bind:click="onInsuranceButtonClick" data-item="{{ insurance }}">已选择</van-button>
                    </van-cell>
                </block>
                <block wx:else>
                    <van-cell title="{{ index + 1 }}、{{ insurance.name }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title">
                        <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button" bind:click="onInsuranceButtonClick" data-item="{{ insurance }}">选择</van-button>
                    </van-cell>
                </block>
                <van-cell title="{{ insurance.name }}" border="{{ false }}" custom-class="item">
                    <van-button slot="right-icon" type="default" size="mini" plain block custom-class="item-button-mini" bind:click="" data-item="{{ insurance }}">
                        <van-icon class-prefix="iconfont" name="view-detail"/>
                        查看详细
                    </van-button>
                </van-cell>
                <view class="item-last-vspace"/>
            </van-cell-group>
        </block>
    </block>

    <view class="bottom-btn-panel">
        <view class="bottom-btn-panel-inner">
            <van-row gutter="20">
                <van-col span="12">
                    <van-button type="default" size="small" plain block bind:click="onPreButtonClick">
                        <van-icon class-prefix="iconfont" name="pre-step"/>
                        上一步
                    </van-button>
                </van-col>
                <van-col span="12">
                    <van-button type="default" size="small" plain block bind:click="onNextButtonClick">
                        下一步
                        <van-icon class-prefix="iconfont" name="next-step"/>
                    </van-button>
                </van-col>
            </van-row>
        </view>
    </view>
</view>
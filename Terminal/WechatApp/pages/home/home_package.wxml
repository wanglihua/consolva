<header/>
<view class="container">
    <view style="background-color: white; margin-bottom: 20rpx; padding-top: 10px;">
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="express-expect" icon-class="home-grid-icon" badge="{{ homeData.expressExpectBadge }}" url="/pages/express/express_expect/express_expect_list" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">包裹预报</view>
                    <view class="grid-text-sub">快递预报 快速入库</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="checkin-list" icon-class="home-grid-icon" text="已入库" badge="{{ homeData.expressCheckinBadge }}" url="/pages/express/express_checkin/express_checkin_list" text-class="grid-text"/>
            <van-grid-item icon-prefix="iconfont" icon="express-return" icon-class="home-grid-icon" text="退运池" badge="{{ homeData.expressReturnBadge }}" url="/pages/express/express_return/express_return_list" text-class="grid-text"/>
        </van-grid>
    </view>

    <view style="background-color: white; margin-bottom: 20rpx; padding-top: 10px;">
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="pack-list" icon-class="home-grid-icon" text="待打包" badge="{{ homeData.orderSubmittedBadge }}" url="/pages/order/order_list_submitted" text-class="grid-text"/>
            <van-grid-item icon-prefix="iconfont" icon="pay-list" icon-class="home-grid-icon" text="待支付" badge="{{ homeData.orderPayBadge }}" url="/pages/order/order_list_pay" text-class="grid-text"/>
            <van-grid-item icon-prefix="iconfont" icon="waiting-transport" icon-class="home-grid-icon" text="待转运" badge="{{ homeData.orderWaitingTransportBadge }}" url="/pages/order/order_list_wait_transport" text-class="grid-text"/>
            <van-grid-item icon-prefix="iconfont" icon="transporting" icon-class="home-grid-icon" text="转运中" badge="{{ homeData.orderTransportingBadge }}" url="/pages/order/order_list_transporting" text-class="grid-text"/>
            <van-grid-item icon-prefix="iconfont" icon="order-history" icon-class="home-grid-icon" text="已交付" badge="{{ homeData.orderDeliveredBadge }}" url="/pages/order/order_list_delivered" text-class="grid-text"/>
        </van-grid>
    </view>

    <view style="background-color: white; margin-bottom: 20rpx; padding-top: 10px;">
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="claim-list" icon-class="home-grid-icon" text="包裹认领" badge="{{ homeData.expressClaimBadge }}" url="/pages/express/express_claim/express_claim_list" text-class="grid-text"/>
        </van-grid>
    </view>

    <van-tabbar active="{{ 1 }}" placeholder="{{ true }}" bind:change="onTabbarChange">
        <van-tabbar-item icon="wap-home-o">首页</van-tabbar-item>
        <van-tabbar-item icon="sign">包裹</van-tabbar-item>
        <van-tabbar-item icon="contact">我的</van-tabbar-item>
    </van-tabbar>
</view>
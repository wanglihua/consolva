<header/>
<view class="container">
    <view style="background-color: white; margin-bottom: 20rpx;">
        <view style="padding: 10px;">
            <view class="grid-icon-cate-title">国内包裹</view>
            <view class="grid-icon-cate-desc">从国内淘宝，京东，拼多多购买并邮寄到舜达仓库的包裹</view>
            <van-divider hairline/>
        </view>
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="express-expect" icon-class="home-grid-icon" badge="{{ homeData.expressExpectBadge }}" url="/pages/express/express_expect/express_expect_list" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">已预报</view>
                    <view class="grid-text-sub">已预报包裹数量</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="arrive-warehouse" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">已到仓</view>
                    <view class="grid-text-sub">已到仓待入库包裹</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="checkin-list" icon-class="home-grid-icon" badge="{{ homeData.expressCheckinBadge }}" url="/pages/express/express_checkin/express_checkin_list" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">已入库</view>
                    <view class="grid-text-sub">可提交转运单</view>
                </view>
            </van-grid-item>
        </van-grid>
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="exception-package" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">异常包裹</view>
                    <view class="grid-text-sub">入库有异常的包裹</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="express-return" icon-class="home-grid-icon" badge="{{ homeData.expressReturnBadge }}" url="/pages/express/express_return/express_return_list" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">退运池</view>
                    <view class="grid-text-sub">申请退运的包裹</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="returned" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">已退运</view>
                    <view class="grid-text-sub">退运处理完成的包裹</view>
                </view>
            </van-grid-item>
        </van-grid>
    </view>

    <view style="background-color: white; margin-bottom: 20rpx; padding-top: 10px;">
        <view style="padding: 10px;">
            <view class="grid-icon-cate-title">国际运单</view>
            <view class="grid-icon-cate-desc">您的包裹到舜达集运仓库后，并下单发往您海外地址的运单</view>
            <van-divider hairline/>
        </view>
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="pack-list" icon-class="home-grid-icon" badge="{{ homeData.orderSubmittedBadge }}" url="/pages/order/order_list_submitted" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">待打包</view>
                    <view class="grid-text-sub">待去除包装重新打包</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="pay-list" icon-class="home-grid-icon" badge="{{ homeData.orderPayBadge }}" url="/pages/order/order_list_pay" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">待付款</view>
                    <view class="grid-text-sub">已打包等待付款</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="waiting-transport" icon-class="home-grid-icon" badge="{{ homeData.orderWaitingTransportBadge }}" url="/pages/order/order_list_wait_transport" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">待发货</view>
                    <view class="grid-text-sub">已付款待转运发货</view>
                </view>
            </van-grid-item>
        </van-grid>
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="transporting" icon-class="home-grid-icon" badge="{{ homeData.orderTransportingBadge }}" url="/pages/order/order_list_transporting" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">已发货</view>
                    <view class="grid-text-sub">已从仓库转运发出</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="received" icon-class="home-grid-icon">
                <view slot="text">
                    <view class="grid-text-main">已签收</view>
                    <view class="grid-text-sub">物流动态显示签收</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="to-rate" icon-class="home-grid-icon">
                <view slot="text">
                    <view class="grid-text-main">待评价</view>
                    <view class="grid-text-sub">好评反馈,可得积分</view>
                </view>
            </van-grid-item>
        </van-grid>
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="order-history" icon-class="home-grid-icon" badge="{{ homeData.orderDeliveredBadge }}" url="/pages/order/order_list_delivered" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">已完成</view>
                    <view class="grid-text-sub">订单转运流程完结</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="express-return" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">订单退运</view>
                    <view class="grid-text-sub">打包后退运</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="returned" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">已退运</view>
                    <view class="grid-text-sub">仓库已退运完成</view>
                </view>
            </van-grid-item>
        </van-grid>
    </view>

    <view style="background-color: white; margin-bottom: 20rpx; padding-top: 10px;">
        <view style="padding: 10px;">
            <view class="grid-icon-cate-title">包裹认领</view>
            <view class="grid-icon-cate-desc">邮寄到舜达仓库，但包裹上既没有会员号又没有预报的包裹，可用快递单号搜索认领</view>
            <van-divider hairline/>
        </view>
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="claim-list" icon-class="home-grid-icon" badge="{{ homeData.expressClaimBadge }}" url="/pages/express/express_claim/express_claim_list" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">包裹认领</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
        </van-grid>
    </view>

    <van-tabbar active="{{ 1 }}" placeholder="{{ true }}" bind:change="onTabbarChange">
        <van-tabbar-item icon="wap-home-o">首页</van-tabbar-item>
        <van-tabbar-item icon="sign">包裹</van-tabbar-item>
        <van-tabbar-item icon="contact">我的</van-tabbar-item>
    </van-tabbar>
</view>
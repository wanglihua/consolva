<header/>
<view class="container">
    <view style="background-color: white; margin-bottom: 20rpx; padding-top: 10px;">
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="account" icon-class="home-grid-icon" text="余额充值" url="/pages/customer/customer_account/customer_account"/>
            <van-grid-item icon-prefix="iconfont" icon="coupon" icon-class="home-grid-icon" text="优惠券" badge="{{ homeData.couponBatchPickBadge }}" url="/pages/coupon/coupon_mine"/>
            <van-grid-item icon-prefix="iconfont" icon="message" icon-class="home-grid-icon" text="我的消息" badge="{{ homeData.newMessageBadge }}" url="/pages/message/message_list"/>
            <van-grid-item icon-prefix="iconfont" icon="message-setting" icon-class="home-grid-icon" text="消息定制" url="/pages/message/message_customize"/>
            <van-grid-item icon-prefix="iconfont" icon="address" icon-class="home-grid-icon" text="收货地址" url="/pages/customer/customer_address/customer_address_receive/customer_address_receive_list"/>
            <van-grid-item icon-prefix="iconfont" icon="score" icon-class="home-grid-icon" text="我的积分" url="/pages/customer/customer_score/customer_score"/>
            <van-grid-item icon-prefix="iconfont" icon="pay" icon-class="home-grid-icon" text="支付明细" url="/pages/customer/customer_pay/customer_pay"/>
        </van-grid>
    </view>

    <van-tabbar active="{{ 2 }}" placeholder="{{ true }}" bind:change="onTabbarChange">
        <van-tabbar-item icon="wap-home-o">首页</van-tabbar-item>
        <van-tabbar-item icon="sign">包裹</van-tabbar-item>
        <van-tabbar-item icon="contact">我的</van-tabbar-item>
    </van-tabbar>
</view>
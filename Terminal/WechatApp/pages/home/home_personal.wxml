<header/>
<view class="container">
    <view style="background-color: white; margin-bottom: 20rpx; padding-top: 10px;">
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="account" icon-class="home-grid-icon" url="/pages/customer/customer_account/customer_account" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">余额充值</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="coupon" icon-class="home-grid-icon" badge="{{ homeData.couponBatchPickBadge }}" url="/pages/coupon/coupon_mine" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">优惠券</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="message" icon-class="home-grid-icon" badge="{{ homeData.newMessageBadge }}" url="/pages/message/message_list" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">我的消息</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="message-setting" icon-class="home-grid-icon" url="/pages/message/message_customize" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">消息定制</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="address" icon-class="home-grid-icon" url="/pages/customer/customer_address/customer_address_receive/customer_address_receive_list" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">收货地址</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="score" icon-class="home-grid-icon" url="/pages/customer/customer_score/customer_score" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">我的积分</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="pay" icon-class="home-grid-icon" url="/pages/customer/customer_pay/customer_pay" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">支付明细</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="my-rate" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">我的评价</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="customer-promotion" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">我的推广</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="score-remark" icon-class="home-grid-icon" url="./home_web_view?url={{ homeData.scoreRemarkUrl }}&title=积分说明" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">积分说明</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="question" icon-class="home-grid-icon" url="./home_web_view?url={{ homeData.faqUrl }}&title=常见问题" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">常见问题</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="my-signed" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">我的签到</view>
                    <view class="grid-text-sub"></view>
                </view>
            </van-grid-item>
        </van-grid>
    </view>

    <van-tabbar active="{{ 2 }}" placeholder="{{ true }}" bind:change="onTabbarChange">
        <van-tabbar-item icon="wap-home-o">首页</van-tabbar-item>
        <van-tabbar-item icon="sign">包裹</van-tabbar-item>
        <van-tabbar-item icon="contact">我的</van-tabbar-item>
    </van-tabbar>
</view>
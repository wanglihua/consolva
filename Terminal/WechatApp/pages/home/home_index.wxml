<header/>
<view class="container">

    <block wx:if="{{ homeData.topImageList && homeData.topImageList.length > 0 }}">
        <view style="background-color: white; margin-bottom: 20rpx;">
            <swiper indicator-dots="{{ true }}" autoplay="{{ true }}" interval="3000" circular="{{ true }}" style="height: {{ topImageHeight }}px;">
                <block wx:for="{{ homeData.topImageList }}" wx:key="id" wx:for-item="image" wx:for-index="index">
                    <swiper-item>
                        <view class="top-image-item">
                            <van-image lazy-load loading="loading" fit="widthFix" width="100%" data-item="{{ image }}" src="{{ image.imageUrl }}" bind:click="onTopImageClick" bind:load="onTopImageLoad"/>
                        </view>
                    </swiper-item>
                </block>
            </swiper>
        </view>
    </block>

    <view style="background-color: white; margin-bottom: 20rpx; padding: 10px;">
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="notice" icon-class="home-grid-icon" badge="{{ homeData.newNoticeBadge }}" url="/pages/notice/notice_list" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">公告</view>
                    <view class="grid-text-sub">最新资讯 及时关注</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="warehouse-address" icon-class="home-grid-icon" url="/pages/instruction/instruction_warehouse_address" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">仓库地址</view>
                    <view class="grid-text-sub">仓库地址 一键复制</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="goods-type" icon-class="home-grid-icon" badge="{{ homeData.goodsTypeBadge }}" url="/pages/instruction/instruction_goods_type?url={{ homeData.goodsTypeUrl }}" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">物品分类</view>
                    <view class="grid-text-sub">物品分类 一目了然</view>
                </view>
            </van-grid-item>
        </van-grid>
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="promotion" icon-class="home-grid-icon" badge="{{ homeData.promotionBadge }}" url="/pages/instruction/instruction_promotion?url={{ homeData.promotionUrl }}" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">活动福利</view>
                    <view class="grid-text-sub">活动特惠 邀您参加</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="coupon" icon-class="home-grid-icon" badge="{{ homeData.couponBatchPickBadge }}" url="/pages/coupon/coupon_mine" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">优惠券</view>
                    <view class="grid-text-sub">券在我手 省钱我有</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="beginner-guide" icon-class="home-grid-icon" url="./home_web_view?url={{ homeData.beginnerGuideUrl }}&title=新手指南" text-class=" grid-text">
                <view slot="text">
                    <view class="grid-text-main">新手指南</view>
                    <view class="grid-text-sub">常见问题 快速解答</view>
                </view>
            </van-grid-item>
        </van-grid>
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="express-expect" icon-class="home-grid-icon" badge="{{ homeData.expressExpectBadge }}" url="/pages/express/express_expect/express_expect_list" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">包裹预报</view>
                    <view class="grid-text-sub">快递预报 优先入库</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="freight-desc" icon-class="home-grid-icon" badge="{{ homeData.freightDescBadge }}" url="/pages/instruction/instruction_freight_desc?url={{ homeData.freightDescUrl }}" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">运费说明</view>
                    <view class="grid-text-sub">路线报价 划算第一</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="estimate" icon-class="home-grid-icon" url="/pages/freight_estimate/freight_estimate_goods" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">运费试算</view>
                    <view class="grid-text-sub">超低运费 轻松试算</view>
                </view>
            </van-grid-item>
        </van-grid>
        <van-grid border="{{false}}" column-num="3">
            <van-grid-item icon-prefix="iconfont" icon="transport-limit" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">时效展示</view>
                    <view class="grid-text-sub">近期时效 供您参考</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="insurance-clause" icon-class="home-grid-icon" badge="{{ homeData.insuranceClauseBadge }}" url="/pages/instruction/instruction_insurance_clause?url={{ homeData.insuranceClauseUrl }}" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">保险条款</view>
                    <view class="grid-text-sub">寄货必看 理赔保障</view>
                </view>
            </van-grid-item>
            <van-grid-item icon-prefix="iconfont" icon="rate-order" icon-class="home-grid-icon" text-class="grid-text">
                <view slot="text">
                    <view class="grid-text-main">评价晒单</view>
                    <view class="grid-text-sub">评价晒单 可得积分</view>
                </view>
            </van-grid-item>
        </van-grid>
    </view>

    <view style="background-color: white; margin-bottom: 20rpx; padding: 0px;">
        <van-image lazy-load loading="loading" fit="widthFix" width="100%" src="https://hk.shundaquanqiu.com/static/client/images/order_simple_step.jpg?v=20230313" bind:click="onOrderSimpleStepClick"/>
    </view>

    <van-tabbar active="{{ 0 }}" placeholder="{{ true }}" bind:change="onTabbarChange">
        <van-tabbar-item icon="wap-home-o">首页</van-tabbar-item>
        <van-tabbar-item icon="sign">包裹</van-tabbar-item>
        <van-tabbar-item icon="contact">我的</van-tabbar-item>
    </van-tabbar>

    <van-popup show="{{ showFollowPopup }}" custom-style="width: 90%;" closeable bind:close="onFollowPopupClose">
        <view style="margin: 30px 10px 10px 10px;">
            <view style="padding: 5px;">
                <van-cell title="关注公众号跟踪最新讯息" link-type="navigateTo" border="{{ false }}" title-class="follow-title" url="./home_web_view?url={{ homeData.followTipUrl }}&title=关注公众号">
                    <van-button slot="right-icon" type="primary" size="small" plain block custom-class="item-button">立即关注</van-button>
                </van-cell>
            </view>
            <view style="padding: 5px;">
                <official-account></official-account>
            </view>
        </view>
    </van-popup>

</view>
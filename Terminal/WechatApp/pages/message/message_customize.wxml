<!--pages/message/message_customize/message_customize.wxml-->
<header/>
<view class="container">
    <block wx:if="{{ messageCustomizeCount === 0 }}">
        <van-empty description="暂时没有可定制的消息类型！"/>
    </block>
    <block wx:else>
        <van-cell-group title="消息定制">
            <block wx:for="{{ messageCustomizeList }}" wx:key="typeId" wx:for-item="messageCustomize" wx:for-index="index">
                <van-cell title="{{ index + 1 }}、{{ messageCustomize.title }}" label="{{ messageCustomize.description }}">
                    <view>
                        <view style="display:block;">
                            <van-switch checked="{{ messageCustomize.send }}" data-item="{{ messageCustomize }}" bind:change="onSwitchChange"/>
                        </view>
                        <view style="display:block;">
                            {{ messageCustomize.sendHint }}
                        </view>
                    </view>
                </van-cell>
            </block>
        </van-cell-group>
    </block>
</view>
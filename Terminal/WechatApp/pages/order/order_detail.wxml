<!--pages/order/order_detail.wxml-->
<header/>
<view class="container">
    <van-cell-group title="订单详细"/>
    <van-cell-group custom-class="items">
        <van-cell title="基本信息" value="" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value"/>
        <van-cell title="订单编号" value="{{ orderDetail.order.orderCode }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="订单状态" value="{{ orderDetail.order.orderStatus }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="物流类型" value="{{ orderDetail.order.firstModeType }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="物流名称" value="{{ orderDetail.order.firstModeName }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="创建时间" value="{{ orderDetail.order.createTime }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="打包时间" value="{{ orderDetail.order.packTime }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="转运时间" value="{{ orderDetail.order.transferTime }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="签收时间" value="{{ orderDetail.order.deliverTime }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="订单货值" value="¥ {{ orderDetail.order.goodsValue }}" border="{{ false }}" custom-class="item"/>
        <block wx:if="{{ orderDetail.order.hasPacked === true }}">
            <van-cell title="物流费用" value="¥ {{ orderDetail.order.orderAmount }}" border="{{ false }}" custom-class="item"/>
            <van-cell title="欠费总额" value="¥ {{ orderDetail.order.arearsAmount }}" border="{{ false }}" custom-class="item"/>
        </block>
        <block wx:if="{{ orderDetail.order.hasCheckinSizeWeightData === true }}">
            <van-cell title="入库包裹数" value="{{ orderDetail.order.checkinTotalPackageCount }} 个" border="{{ false }}" custom-class="item"/>
            <van-cell title="入库总体积" value="{{ orderDetail.order.checkinTotalVolume }} CBM" border="{{ false }}" custom-class="item"/>
            <van-cell title="入库总重量" value="{{ orderDetail.order.checkinTotalActualWeight }} KG" border="{{ false }}" custom-class="item"/>
        </block>
        <block wx:if="{{ orderDetail.order.hasPacked === true && orderDetail.hasOrderPackData === true }}">
            <van-cell title="打包包裹数" value="{{ orderDetail.orderPackData.totalPackageCount }} 个" border="{{ false }}" custom-class="item"/>
            <van-cell title="打包总体积" value="{{ orderDetail.orderPackData.totalVolume }} CBM" border="{{ false }}" custom-class="item"/>
            <van-cell title="打包总重量" value="{{ orderDetail.orderPackData.totalActualWeight }} KG" border="{{ false }}" custom-class="item"/>
        </block>
        <van-cell title="保险类型" value="{{ orderDetail.order.insurance }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="GST申报" value="{{ orderDetail.order.gst }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="打包方式" value="{{ orderDetail.order.repackType }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="客户备注" value="{{ orderDetail.order.customerRemark }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="仓库备注" value="{{ orderDetail.order.warehouseRemark }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="客服备注" value="{{ orderDetail.order.serviceRemark }}" border="{{ false }}" custom-class="item"/>
        <view class="item-last-vspace"/>

        <block wx:if="{{ orderDetail.firstMode.firstModeList.length > 0 }}">
            <van-cell title="物流信息" value="" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value"/>
            <block wx:if="{{ orderDetail.firstMode.firstModeList.length === 1 }}">
                <van-cell title="物流类型" value="{{ orderDetail.firstMode.firstModeList[0].modeType }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="发货渠道" value="{{ orderDetail.firstMode.firstModeList[0].channel }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="物流名称" value="{{ orderDetail.firstMode.firstModeList[0].modeName }}" border="{{ false }}" custom-class="item"/>
            </block>
            <block wx:else>
                <block wx:for="{{ orderDetail.firstMode.firstModeList }}" wx:key="id" wx:for-item="firstMode" wx:for-index="index">
                    <van-cell title="物流类型{{ index + 1 }}" value="{{ firstMode.modeType }}" border="{{ false }}" custom-class="item"/>
                    <van-cell title="发货渠道{{ index + 1 }}" value="{{ firstMode.channel }}" border="{{ false }}" custom-class="item"/>
                    <van-cell title="物流名称{{ index + 1 }}" value="{{ firstMode.modeName }}" border="{{ false }}" custom-class="item"/>
                </block>
            </block>
            <view class="item-last-vspace"/>
        </block>

        <van-cell title="收货地址" value="" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value"/>
        <van-cell title="收货人" value="{{ orderDetail.receiveAddress.firstName }} {{ orderDetail.receiveAddress.lastName }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="手机" value="{{ orderDetail.receiveAddress.mobile }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="国家" value="{{ orderDetail.receiveAddress.country }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="洲" value="{{ orderDetail.receiveAddress.state }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="城市" value="{{ orderDetail.receiveAddress.city }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="地址" value="{{ orderDetail.receiveAddress.address }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="邮编" value="{{ orderDetail.receiveAddress.zipcode }}" border="{{ false }}" custom-class="item"/>
        <view class="item-last-vspace"/>

        <van-cell title="发货地址" value="" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value"/>
        <van-cell title="发货人" value="{{ orderDetail.sendAddress.name }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="手机" value="{{ orderDetail.sendAddress.mobile }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="省市区域" value="{{ orderDetail.sendAddress.province }}{{ orderDetail.sendAddress.city }}{{ orderDetail.sendAddress.area }}{{ orderDetail.sendAddress.street }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="详细地址" value="{{ orderDetail.sendAddress.address }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="邮编" value="{{ orderDetail.sendAddress.zipcode }}" border="{{ false }}" custom-class="item"/>
        <view class="item-last-vspace"/>

        <van-cell title="订单商品" value="" border="{{ false }}" custom-class="item-header" title-class="item-header-title" value-class="item-header-value"/>
        <block wx:if="{{ orderDetail.expressList.length > 0 }}">
            <block wx:for="{{ orderDetail.expressList }}" wx:key="id" wx:for-item="express" wx:for-index="expressIndex">
                <view>
                    <van-cell title="快递单#{{ expressIndex + 1 }}" border="{{ true }}" custom-class="express-item"/>
                    <van-cell title="快递单号" value="{{ express.trackingNo }}" border="{{ false }}" custom-class="express-item"/>
                    <van-cell title="入库跟踪号" value="{{ express.checkinTrackingNo }}" border="{{ false }}" custom-class="express-item"/>
                    <van-cell title="物品类型" value="{{ express.goodsType }}" border="{{ false }}" custom-class="express-item"/>
                    <van-cell title="状态" value="{{ express.status }}" border="{{ false }}" custom-class="express-item"/>
                    <van-cell title="入库时间" value="{{ express.checkinTime }}" border="{{ false }}" custom-class="express-item"/>
                    <van-cell title="货品总值" value="{{ express.goodsValue }} RMB" border="{{ false }}" custom-class="express-item"/>
                    <view class="express-item-last-vspace"/>
                </view>

                <block wx:for="{{ express.expressGoodsList }}" wx:key="id" wx:for-item="expressGoods" wx:for-index="expressGoodsIndex">
                    <view>
                        <van-cell title="物品#{{ expressGoodsIndex + 1 }}" border="{{ true }}" custom-class="express-goods-item"/>
                        <van-cell title="物品名称" value="{{ expressGoods.goodsName }}" border="{{ false }}" custom-class="express-goods-item"/>
                        <van-cell title="物品类型" value="{{ expressGoods.goodsType }}" border="{{ false }}" custom-class="express-goods-item"/>
                        <van-cell title="数量" value="{{ expressGoods.quantity }} {{ expressGoods.unit }}" border="{{ false }}" custom-class="express-goods-item"/>
                        <view class="express-goods-item-last-vspace"/>
                    </view>
                </block>
            </block>
        </block>
    </van-cell-group>
</view>

<header/>
<view class="container">
    <van-cell-group title="订单支付费用"/>
    <van-cell-group custom-class="items">
        <van-cell title="订单编号" value="{{ orderCode }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="订单费用" value="{{ totalAmount }} RMB" border="{{ false }}" custom-class="item"/>

        <block wx:if="{{ hasCoupon }}">
            <van-cell title="优惠券折扣" value="{{ discountAmount }} RMB" border="{{ false }}" custom-class="item"/>
        </block>

        <van-cell title="已支付" value="{{ paidAmount }} RMB" border="{{ false }}" custom-class="item"/>
        <van-cell title="欠费金额" value="{{ arrearsAmount }} RMB" border="{{ false }}" custom-class="item"/>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <van-cell-group title="积分抵扣"/>
    <van-cell-group custom-class="items">
        <van-cell title="剩余积分" value="{{ customerScore }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="可抵扣积分" value="{{ scoreDeductScore }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="可抵扣金额" value="{{ scoreDeductAmount }}" border="{{ false }}" custom-class="item"/>
        <van-cell title="是否积分抵扣" border="{{ false }}" custom-class="item">
            <view>
                <view style="display:block;">
                    <van-switch checked="{{ scoreDeduct }}" bind:change="onScoreDeductSwitchChange"/>
                </view>
                <view style="display:block;">{{ scoreDeductMsg }}</view>
            </view>
        </van-cell>
        <view class="item-last-vspace"/>
    </van-cell-group>    

    <van-cell-group title="订单支付方式"/>
    <van-cell-group custom-class="items">
        <van-cell title="余额支付" is-link link-type="navigateTo" size="large" url="./order_pay_customer_account?orderId={{ orderId }}&couponId={{ couponId }}&scoreDeduct={{ scoreDeduct }}">
            <van-icon slot="icon" class-prefix="iconfont" name="account" class="cell-left-icon"/>
        </van-cell>

        <van-cell title="微信支付" is-link size="large" bind:click="onWechatPayClick">
            <van-icon slot="icon" class-prefix="iconfont" name="wechat-pay" class="cell-left-icon"/>
        </van-cell>

        <van-cell title="支付宝支付" is-link size="large" bind:click="onAlipayClick">
            <van-icon slot="icon" class-prefix="iconfont" name="alipay" class="cell-left-icon"/>
        </van-cell>

        <van-cell title="PayPal支付" is-link size="large" bind:click="onPaypalClick">
            <van-icon slot="icon" class-prefix="iconfont" name="paypal" class="cell-left-icon"/>
        </van-cell>        
    </van-cell-group>

</view>


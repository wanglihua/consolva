<!--pages/order/order_pay_coupon.wxml-->
<header/>
<view class="container">
    <van-cell-group title="优惠券"/>
    <block wx:if="{{ couponCount === 0 }}">
        <van-empty description="您当前没有可用的优惠券！"/>
    </block>
    <block wx:else>
        <block wx:for="{{ couponList }}" wx:key="id" wx:for-item="coupon" wx:for-index="index">
            <van-cell-group custom-class="items">

                <block wx:if="{{ couponId === coupon.id }}">
                    <van-cell title="{{ index + 1 }}、{{ coupon.rule }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title-selected">
                        <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button-selected" bind:click="onCouponButtonClick" data-item="{{ coupon }}">已选择</van-button>
                    </van-cell>
                </block>
                <block wx:else>
                    <van-cell title="{{ index + 1 }}、{{ coupon.rule }}" border="{{ false }}" custom-class="item-header" title-class="item-header-title">
                        <van-button slot="right-icon" type="default" size="small" plain block custom-class="item-button" bind:click="onCouponButtonClick" data-item="{{ coupon }}">选择</van-button>
                    </van-cell>
                </block>

                <van-cell title="编号" value="{{ coupon.code }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="类型" value="{{ coupon.type }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="有效期" value="{{ coupon.expire }}" border="{{ false }}" custom-class="item"/>
                <van-cell title="优惠" value="{{ coupon.ruleDesc }}" border="{{ false }}" custom-class="item"/>
                <view class="item-last-vspace"/>
            </van-cell-group>
        </block>
    </block>
</view>
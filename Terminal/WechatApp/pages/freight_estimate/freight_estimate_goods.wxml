<header/>
<view class="container">
    <van-cell-group title="录入物品信息"/>

    <van-cell-group custom-class="items">
        <van-field model:value="{{ goodsTypeFieldValue }}" label="物品类型" placeholder="请选择物品类型" border="{{ false }}" input-align="right" custom-style="padding-bottom: 0;" is-link readonly bind:tap="onGoodsTypeFieldTap"/>
        <van-popup show="{{ showGoodsTypeSelect }}" round position="bottom">
            <van-cascader
                    value="{{ goodsTypeCascaderValue }}"
                    title="选择物品类型"
                    options="{{ goodsTypeOptions }}"
                    bind:close="onGoodsTypeSelectClose"
                    bind:finish="onGoodsTypeSelectFinish"
            />
        </van-popup>

        <van-field label="总货值" placeholder="输入物品总货值" value="{{ goodsValue }}" border="{{ false }}" type="number" input-align="right" use-right-icon-slot bind:input="onGoodsValueInput" custom-style="padding-bottom: 0;">
            <view slot="right-icon">RMB</view>
        </van-field>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <van-cell-group custom-class="items">
        <block wx:for="{{ goodsList }}" wx:key="id" wx:for-item="goods" wx:for-index="index">
            <van-cell title="箱型{{ index + 1 }}(单位：CM, KG)" border="{{ false }}" custom-class="sub-item-header" title-class="sub-item-header-title"/>
            <van-row>
                <van-col span="12">
                    <van-field label="长度CM" placeholder="单件长度" value="{{ goods.length }}" border="{{ false }}" type="number" input-align="right" bind:input="onGoodsLengthInput" data-item="{{ goods }}" custom-style="padding-bottom: 0;"/>
                </van-col>
                <van-col span="12">
                    <van-field label="宽度CM" placeholder="单件宽度" value="{{ goods.width }}" border="{{ false }}" type="number" input-align="right" bind:input="onGoodsWidthInput" data-item="{{ goods }}" custom-style="padding-bottom: 0;"/>
                </van-col>
            </van-row>
            <van-row>
                <van-col span="12">
                    <van-field label="高度CM" placeholder="单件高度" value="{{ goods.height }}" border="{{ false }}" type="number" input-align="right" bind:input="onGoodsHeightInput" data-item="{{ goods }}" custom-style="padding-bottom: 0;"/>
                </van-col>
                <van-col span="12">
                    <van-field label="重量KG" placeholder="单件重量" value="{{ goods.weight }}" border="{{ false }}" type="number" input-align="right" bind:input="onGoodsWeightInput" data-item="{{ goods }}" custom-style="padding-bottom: 0;"/>
                </van-col>
            </van-row>
            <van-row>
                <van-col span="12">
                    <van-field label="箱数" placeholder="箱数" value="{{ goods.packageCount }}" border="{{ false }}" type="digit" input-align="right" bind:input="onGoodsPackageCountInput" data-item="{{ goods }}" custom-style="padding-bottom: 0;"/>
                </van-col>
                <van-col span="12">
                    <block wx:if="{{ index > 0 }}">
                        <view style="padding: 30rpx 15rpx;">
                            <van-button type="default" size="small" plain block bind:click="onRemoveGoodsButtonClick" data-item="{{ goods }}">
                                <van-icon class-prefix="iconfont" name="remove-from-order" color="red"/>
                                移除箱型
                            </van-button>
                        </view>
                    </block>
                </van-col>
            </van-row>
            <view class="item-last-vspace"/>
        </block>

        <van-row>
            <van-col offset="12" span="12">
                <view style="padding: 30rpx 15rpx;">
                    <van-button type="default" size="small" plain block bind:click="onAddGoodsButtonClick">
                        <van-icon class-prefix="iconfont" name="add" color="green"/>
                        添加箱型
                    </van-button>
                </view>
            </van-col>
        </van-row>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <view class="bottom-btn-panel">
        <view class="bottom-btn-panel-inner">
            <van-row gutter="20">
                <van-col span="24">
                    <van-button type="default" size="small" plain block bind:click="onNextButtonClick">
                        下一步
                        <van-icon class-prefix="iconfont" name="next-step"/>
                    </van-button>
                </van-col>
            </van-row>
        </view>
    </view>
</view>

<!--pages/freight_estimate/freight_estimate_goods.wxml-->
<header/>
<view class="container">
    <van-cell-group title="录入物品信息"/>

    <van-cell-group custom-class="items">
        <van-field label="总货值" placeholder="输入物品总货值" value="{{ goodsValue }}" border="{{ false }}" type="number" input-align="right" error-message-align="right" use-right-icon-slot bind:input="onGoodsValueInput" custom-style="padding-bottom: 0;">
            <view slot="right-icon">RMB</view>
        </van-field>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <view class="bottom-btn-panel">
        <view class="bottom-btn-panel-inner">
            <van-row gutter="20">
                <van-col span="24">
                    <van-button type="default" size="small" plain block bind:click="onNextButtonClick">
                        下一步
                        <van-icon class-prefix="iconfont" name="next-step"/>
                    </van-button>
                </van-col>
            </van-row>
        </view>
    </view>
</view>

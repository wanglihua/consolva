<header/>
<view class="container">
    <van-cell-group title="仓库地址"/>

    <van-cell-group custom-class="items">
        <van-cell title="收件人" value="{{ address.customerCode }}" border="{{ false }}" custom-class="item" clickable="{{ true }}" bind:click="onCustomerCodeClick">
            <view slot="right-icon">
                <view style="margin-left: 5px;">
                    <van-button type="info" size="mini" plain block round bind:click="onCustomerCodeClick">复制</van-button>
                </view>
            </view>
        </van-cell>
        <van-cell title="收件手机" value="{{ address.phone }}" border="{{ false }}" custom-class="item" clickable="{{ true }}" bind:click="onPhoneClick">
            <view slot="right-icon">
                <view style="margin-left: 5px;">
                    <van-button type="info" size="mini" plain block round bind:click="onPhoneClick">复制</van-button>
                </view>
            </view>
        </van-cell>
        <van-cell title="省市街道" value="{{ address.area }}" border="{{ false }}" custom-class="item" clickable="{{ true }}" bind:click="onAreaClick">
            <view slot="right-icon">
                <view style="margin-left: 5px;">
                    <van-button type="info" size="mini" plain block round bind:click="onAreaClick">复制</van-button>
                </view>
            </view>
        </van-cell>
        <van-cell title="详细地址" value="{{ address.address }}" border="{{ false }}" custom-class="item" clickable="{{ true }}" bind:click="onAddressClick">
            <view slot="right-icon">
                <view style="margin-left: 5px;">
                    <van-button type="info" size="mini" plain block round bind:click="onAddressClick">复制</van-button>
                </view>
            </view>
        </van-cell>
        <van-cell title="邮编" value="{{ address.zipcode }}" border="{{ false }}" custom-class="item" clickable="{{ true }}" bind:click="onZipcodeClick">
            <view slot="right-icon">
                <view style="margin-left: 5px;">
                    <van-button type="info" size="mini" plain block round bind:click="onZipcodeClick">复制</van-button>
                </view>
            </view>
        </van-cell>
        <view class="item-last-vspace"/>
    </van-cell-group>

    <van-cell-group custom-class="detail-buttons" border="{{false}}">
        <van-cell border="{{false}}">
            <van-button type="info" class-prefix="iconfont" icon="copy" block bind:click="onFullAddressCopyClick">复制仓库完整地址</van-button>
        </van-cell>
    </van-cell-group>
    
    <view class="tip">
        <view class="tip-title">温馨提示：</view>
        <view class="tip-content">●请务必填写收件人及详细地址中的六个字母的代码</view>
        <view class="tip-content">●不要做任何更改，避免无法将包裹登记在您的名下</view>
        <view class="tip-content">●请在邮寄物品后，及时在系统内进行预报，我们会在收到物品后为您自动入库</view>
        <view class="tip-content">●如果发现签收2天未入库，请及时联系客服确认（避免快递包裹上面的六个字母代码被隐藏）</view>
    </view>
</view>

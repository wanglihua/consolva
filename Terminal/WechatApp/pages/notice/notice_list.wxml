<!--pages/notice/notice_list.wxml-->
<header/>
<view class="container">
    <van-cell-group title="公告列表"/>

    <block wx:if="{{ noticeList.length === 0 }}">
        <van-empty description="暂时没有数据项！"/>
    </block>
    <block wx:else>
        <van-cell-group custom-class="items">
            <block wx:for="{{ noticeList }}" wx:key="id" wx:for-item="notice" wx:for-index="index">
                <van-cell title="{{ index + 1 }}、{{ notice.title }}({{ notice.date }})"
                          url="/pages/notice/notice_detail?url={{ notice.url }}"
                          is-link
                          title-class="item-title-long" value-class="item-value-short"/>
            </block>
        </van-cell-group>
    </block>
</view>

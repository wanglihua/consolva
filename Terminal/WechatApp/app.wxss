/**app.wxss**/

@import "assets/iconfont/iconfont.wxss";

.container {
    padding: 20rpx 20rpx 200rpx 20rpx;
    background-color: #f8f8f8;
}

.container-top {
    padding: 20rpx 20rpx 0 20rpx;
    background-color: #f8f8f8;
}

.container-middle {
    padding: 0rpx 20rpx;
    background-color: #f8f8f8;
}

.container-bottom {
    padding: 0 20rpx 200rpx 20rpx;
    background-color: #f8f8f8;
}

.home-grid-icon {
    color: #58727e;
}

.search-bar {
    margin: 0 0 15rpx 0 !important;
    padding: 0 !important;
}

.items {
    background-color: white !important;
    margin: 25rpx 0 25rpx 0;
}

.item-header {
    background-color: teal !important;
}

.item {
    padding-bottom: 0 !important;
}

.item-last-vspace {
    padding: 5px 0;
    width: 100%;
}

.item-header-alt {
    background-color: rgb(231, 174, 0) !important;
}

/* 这个要放在 item-header-title 的前面 */
.van-cell__title {
    /* color: #969799 !important;*/
    color: #646566 !important;
}

.item-header-title {
    color: white !important;
}

.item-header-value {
    color: white !important;
}

.cell-left-icon {
    color: rgb(175, 136, 15);
    margin-right: 10rpx;
}

.item-footer {
    background-color: #efefef !important;
}

.item-footer-value {
    flex: 3 !important;
}

.detail-buttons {
    width: 100%;
    margin: 30rpx 0;
}

.bottom-divider {
    margin-top: 40rpx;
}
/**app.wxss**/

@import "assets/iconfont/iconfont.wxss";

.container {
    padding: 10rpx;
    margin: 10rpx;
    background-color: white;
}

.container-top {
    padding: 10rpx 10rpx 0 10rpx;
    margin: 10rpx 10rpx 0 10rpx;
    background-color: white;
}

.container-middle {
    padding: 0rpx 10rpx;
    margin: 0rpx 10rpx;
    background-color: white;
}

.container-bottom {
    padding: 0 10rpx 10rpx 10rpx;
    margin: 0 10rpx 10rpx 10rpx;
    background-color: white;
}
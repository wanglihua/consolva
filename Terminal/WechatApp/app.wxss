/**app.wxss**/

@import "assets/iconfont/iconfont.wxss";

page {
    background-color: #f8f8f8;
}

.container {
    padding: 20rpx 20rpx 150rpx 20rpx;
}

.container-top {
    padding: 20rpx 20rpx 0 20rpx;
}

.container-middle {
    padding: 0rpx 20rpx;
}

.container-bottom {
    padding: 0 20rpx 150rpx 20rpx;
}

.home-grid-icon {
    color: #58727e;
}

.search-bar {
    margin: 0 0 15rpx 0 !important;
    padding: 0 !important;
}

/* 这个要放在 item-header-title 的前面 */
.van-cell__title {
    flex: 1 !important;
    /* color: #969799 !important;*/
    color: #646566 !important;
}

.van-cell__value {
    flex: 3 !important;
}

.items {
    background-color: white !important;
    margin: 25rpx 0 25rpx 0;
}

.item-header {
    background-color: teal !important;
}

.item {
    padding-bottom: 0 !important;
}

.item-last-vspace {
    padding: 5px 0;
    width: 100%;
}

.item-header-alt {
    background-color: rgb(231, 174, 0) !important;
}

.item-header-title {
    color: white !important;
    flex: 3 !important;
}

.item-header-title-selected {
    color: rgb(231, 174, 0) !important;
}

.item-header-value {
    color: white !important;
    flex: 1 !important;
}

.item-button {
    width: 180rpx !important;
    color: #646566 !important;
}

.item-button-selected {
    width: 180rpx !important;
    color: rgb(231, 174, 0) !important;
}

.item-button-mini {
    color: #646566 !important;
    padding: 1rpx 8rpx !important;
}

.cell-left-icon {
    color: rgb(175, 136, 15);
    margin-right: 10rpx;
}

.item-footer {
    background-color: #efefef !important;
}

.item-footer-value {
    flex: 3 !important;
}

.sub-item-header {
    background-color: transparent !important;
    border-bottom: 1px solid #ebedf0 !important;
}

.sub-item-header-title {
    color: #646566 !important;
    font-weight: bold !important;
}

.detail-buttons {
    width: 100%;
    margin: 30rpx 0;
}

.bottom-divider {
    margin-top: 40rpx;
}

.bottom-btn-panel {
    width: 100%;
    padding-top: 15rpx;
    padding-bottom: 30rpx;
    border-top: 1px solid #ebedf0;
    background-color: white;
    position: fixed;
    left: 0;
    bottom: 0;
    z-index: 88;
}

.bottom-btn-panel-inner {
    padding: 10rpx 40rpx;
}
<!--components/header.wxml-->
<van-nav-bar custom-style="z-index:99;"
             safe-area-inset-top="{{ false }}"
             fixed="{{ true }}"
             placeholder="{{ true }}"
             bind:click-left="onClickLeft"
             bind:click-right="onClickRight">
    <view slot="left">
        <view style="margin: 15px 0 0 -10px;">
            <van-image
                    width="132px"
                    height="40px"
                    fit="contain"
                    src="data:image/png;base64,"
            />
        </view>
    </view>
    <view slot="right">
        <view style="margin-right: -5px;">
            舜达{{ customerCode }}
        </view>
    </view>
</van-nav-bar>
<chat-icon/>